<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ROOT</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
  </ItemGroup>

  <Target Name="CopyAsUPMSWeb" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(OutputPath)ROOT.dll" DestinationFiles="$(OutputPath)UPMS.Web.dll" Condition="Exists('$(OutputPath)ROOT.dll')" />
    <Copy SourceFiles="$(OutputPath)ROOT.deps.json" DestinationFiles="$(OutputPath)UPMS.Web.deps.json" Condition="Exists('$(OutputPath)ROOT.deps.json')" />
    <Copy SourceFiles="$(OutputPath)ROOT.runtimeconfig.json" DestinationFiles="$(OutputPath)UPMS.Web.runtimeconfig.json" Condition="Exists('$(OutputPath)ROOT.runtimeconfig.json')" />
  </Target>

</Project>
