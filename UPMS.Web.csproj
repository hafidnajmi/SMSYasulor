<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ROOT</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="wwwroot\im-digital\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\dotnet\PPI.IM.Domain\**\*.cs" Exclude="wwwroot\im-digital\**\obj\**;wwwroot\im-digital\**\bin\**" LinkBase="ImDomain" />
    <Compile Include="wwwroot\im-digital\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\dotnet\PPI.IM.Infrastructure\**\*.cs" Exclude="wwwroot\im-digital\**\obj\**;wwwroot\im-digital\**\bin\**" LinkBase="ImInfrastructure" />
    <Compile Include="wwwroot\im-digital\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\dotnet\PPI.IM.Application\**\*.cs" Exclude="wwwroot\im-digital\**\obj\**;wwwroot\im-digital\**\bin\**" LinkBase="ImApplication" />
    <Compile Include="wwwroot\im-digital\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\dotnet\PPI.IM.WebApi\Controllers\*.cs" LinkBase="ImControllers" />
    <Compile Include="wwwroot\im-digital\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\IM_DIGITAL_FULL_PLUG_AND_PLAY\dotnet\PPI.IM.WebApi\Models\*.cs" LinkBase="ImModels" />
  </ItemGroup>

  <Target Name="CopyAsUPMSWeb" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(OutputPath)ROOT.dll" DestinationFiles="$(OutputPath)UPMS.Web.dll" Condition="Exists('$(OutputPath)ROOT.dll')" />
    <Copy SourceFiles="$(OutputPath)ROOT.deps.json" DestinationFiles="$(OutputPath)UPMS.Web.deps.json" Condition="Exists('$(OutputPath)ROOT.deps.json')" />
    <Copy SourceFiles="$(OutputPath)ROOT.runtimeconfig.json" DestinationFiles="$(OutputPath)UPMS.Web.runtimeconfig.json" Condition="Exists('$(OutputPath)ROOT.runtimeconfig.json')" />
  </Target>

  <!-- Copy wwwroot to output directory so static files work when Dewacloud runs from bin/Debug/net10.0/ or publish directory -->
  <Target Name="CopyWwwrootToOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <WwwrootFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*.*" Exclude="$(MSBuildProjectDirectory)\wwwroot\**\node_modules\**;$(MSBuildProjectDirectory)\wwwroot\**\.next\**" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwrootFiles)"
          DestinationFolder="$(OutputPath)wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WwwrootFiles)"
          DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)"
          Condition="'$(PublishDir)' != ''"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
