@using System.Text.Encodings.Web
@model UPMS.Web.Models.ViewModels.AdminManagementViewModel

@{
    ViewData["Title"] = "Admin Management Portal";
    var activeTab = Model.ActiveTab;
}

<!-- EMS Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81; font-family: Arial, Helvetica, sans-serif;">
            Admin Management Portal
        </h3>
        <p class="text-muted small mb-0">Procurement comparison, bidding history tracking, and outgoing stock approvals.</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-ems-outline btn-sm"><i class="bi bi-printer me-1"></i>Print View</button>
    </div>
</div>


<!-- EMS Main Tabs: Procurement Comparison, Bidding History, Approval Menu, Line Compatibility Center -->
<ul class="nav nav-tabs mb-4 ems-nav-tabs" style="border-radius:0;">
    <li class="nav-item">
        <a class="nav-link @(activeTab == "procurement" ? "active fw-bold text-primary" : "text-secondary")"
           asp-action="Index" asp-route-tab="procurement" style="border-radius:0; font-family: Arial, sans-serif;">
            <i class="bi bi-arrow-left-right me-2 text-primary"></i>Procurement Comparison
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "bidding" ? "active fw-bold text-primary" : "text-secondary")"
           asp-action="Index" asp-route-tab="bidding" style="border-radius:0; font-family: Arial, sans-serif;">
            <i class="bi bi-journal-text me-2 text-info"></i>Bidding History
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "approvals" ? "active fw-bold text-primary" : "text-secondary")"
           asp-action="Index" asp-route-tab="approvals" style="border-radius:0; font-family: Arial, sans-serif;">
            <i class="bi bi-shield-check me-2 text-warning"></i>Approval Menu
            @if (Model.PendingBarangKeluarApprovals.Count > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@Model.PendingBarangKeluarApprovals.Count</span>
            }
        </a>
    </li>
</ul>

<!-- ========================================================================= -->
<!-- TAB 1: PROCUREMENT COMPARISON -->
<!-- ========================================================================= -->
@if (activeTab == "procurement")
{
    <!-- KPI Summary Cards (Matching Python App) -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="ems-kpi-card ems-kpi-blue p-3">
                <div class="ems-kpi-title"><i class="bi bi-box-seam me-1"></i>TOTAL SPAREPARTS</div>
                <div class="ems-kpi-lg-value ems-text-blue">@Model.TotalMasterItems.ToString("N0")</div>
                <div class="ems-kpi-sub fw-semibold">All master spareparts in catalog</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ems-kpi-card ems-kpi-green p-3">
                <div class="ems-kpi-title"><i class="bi bi-currency-dollar me-1"></i>TOTAL INVENTORY VALUE</div>
                <div class="ems-kpi-lg-value ems-text-green">Rp @Model.TotalValuation.ToString("N0")</div>
                <div class="ems-kpi-sub fw-semibold">Total valuation of current stock</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ems-kpi-card ems-kpi-amber p-3">
                <div class="ems-kpi-title"><i class="bi bi-calculator me-1"></i>AVERAGE SPAREPART PRICE</div>
                <div class="ems-kpi-lg-value ems-text-amber">Rp @Model.AveragePrice.ToString("N0")</div>
                <div class="ems-kpi-sub fw-semibold">Average cost per sparepart</div>
            </div>
        </div>
    </div>

    <!-- Filter & Table Card (13 Columns + 50 items/page Pagination Matching Python App) -->
    <div class="ems-filter-card mb-4">
        <div class="ems-filter-header d-flex align-items-center justify-content-between">
            <span><i class="bi bi-arrow-left-right me-2 text-primary"></i>Procurement Comparison & Catalog Overview</span>
            <span class="badge bg-primary">Showing @Model.ProcurementItems.Count of @Model.FilteredTotalItems.ToString("N0") Items</span>
        </div>
        <div class="p-3 border-bottom bg-light">
            <form method="get" action="/AdminManagement" id="procFilterForm">
                <input type="hidden" name="tab" value="procurement" />
                <input type="hidden" name="page" value="1" />
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search part number, name, bin, UP area, supplier..." />
                            @if (!string.IsNullOrEmpty(Model.SearchQuery))
                            {
                                <a href="/AdminManagement?tab=procurement" class="btn btn-outline-secondary" title="Clear Search"><i class="bi bi-x"></i></a>
                            }
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="category" onchange="this.form.submit()" class="form-select form-select-sm">
                            <option value="">All Categories</option>
                            @foreach (var cat in Model.AvailableCategories)
                            {
                                if (cat == Model.CategoryFilter)
                                {
                                    <option value="@cat" selected="selected">@cat</option>
                                }
                                else
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="stock" onchange="this.form.submit()" class="form-select form-select-sm">
                            <option value="">All Stock Status</option>
                            @if (Model.StockFilter == "CRITICAL")
                            {
                                <option value="CRITICAL" selected="selected">Critical Low Stock</option>
                                <option value="NORMAL">Normal Stock</option>
                            }
                            else if (Model.StockFilter == "NORMAL")
                            {
                                <option value="CRITICAL">Critical Low Stock</option>
                                <option value="NORMAL" selected="selected">Normal Stock</option>
                            }
                            else
                            {
                                <option value="CRITICAL">Critical Low Stock</option>
                                <option value="NORMAL">Normal Stock</option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
        <div class="p-0">
            <div class="table-responsive">
                <table class="table-ems" id="procTable">
                    <thead>
                        <tr>
                            <th style="width:40px;">NO</th>
                            <th>UP AREA</th>
                            <th>PART NUMBER</th>
                            <th>BIN</th>
                            <th class="text-end">CUR STOCK</th>
                            <th class="text-end">SAFE STOCK</th>
                            <th>ITEM NAME</th>
                            <th>DETAIL</th>
                            <th class="text-end" style="min-width:140px; white-space:nowrap;">PRICE</th>
                            <th>SUPPLIER</th>
                            <th class="text-end" style="min-width:175px; white-space:nowrap;">TOTAL VALUE</th>
                            <th class="text-center" style="white-space:nowrap;">BIDDING</th>
                            <th class="text-center" style="min-width:180px; white-space:nowrap;">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProcurementItems.Any())
                        {
                            int rowNo = ((Model.Page - 1) * Model.PageSize) + 1;
                            foreach (var item in Model.ProcurementItems)
                            {
                                decimal unitPrice = item.CurrentUnitPrice ?? 0m;
                                decimal itemValuation = (item.CurrentStock ?? 0) * unitPrice;
                                bool isCritical = (item.CurrentStock ?? 0) < (item.SafetyStock ?? 0);
                                bool hasBidding = Model.BiddingMasterDataIds.Contains(item.Id);
                                <tr>
                                    <td class="text-center font-monospace text-muted" style="background-color:#F8FAFC; border-right:1px solid #E2E8F0;">@(rowNo++)</td>
                                    <td><span class="badge bg-light text-dark border fw-normal">@(item.UpArea ?? "-")</span></td>
                                    <td><span class="font-monospace text-primary">@item.Id</span></td>
                                    <td><span class="badge bg-light text-dark font-monospace border fw-normal">@(item.Bin ?? "-")</span></td>
                                    <td class="text-end @(isCritical ? "text-danger fw-semibold" : "text-dark")">@(item.CurrentStock ?? 0)</td>
                                    <td class="text-end font-monospace text-muted">@(item.SafetyStock ?? 0)</td>
                                    <td class="text-dark">@item.Item</td>
                                    <td style="max-width:220px;">
                                        @if (!string.IsNullOrWhiteSpace(item.Detail))
                                        {
                                            <span class="small text-secondary text-truncate d-inline-block align-middle" style="max-width:200px;" title="@item.Detail">
                                                @item.Detail
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-end font-monospace text-dark align-middle" style="white-space:nowrap;">Rp @unitPrice.ToString("N0")</td>
                                    <td class="text-dark small align-middle">@(item.Brand ?? "-")</td>
                                    <td class="text-end font-monospace text-primary align-middle" style="white-space:nowrap;">Rp @itemValuation.ToString("N0")</td>
                                    <td class="text-center">
                                        @if (hasBidding)
                                        {
                                            <span class="badge bg-success text-white small px-2">YES</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border small px-2">NO</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                         <div class="d-flex justify-content-center gap-1">
                                             <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:11px; height:24px; line-height:22px;"
                                                     onclick="showUpdatePriceModal('@item.Id', '@JavaScriptEncoder.Default.Encode(item.Item)', '@((long)unitPrice)', '@JavaScriptEncoder.Default.Encode(item.Brand ?? "")')"
                                                     title="Manage Supplier & Update Unit Price">
                                                 <i class="bi bi-shop me-1"></i>Price
                                             </button>
                                             <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size:11px; height:24px; line-height:22px;"
                                                     onclick="showHistoryPriceModal('@item.Id', '@JavaScriptEncoder.Default.Encode(item.Item)')"
                                                     title="View Full Price & Supplier History Records">
                                                 <i class="bi bi-clock-history me-1"></i>History Price
                                             </button>
                                         </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted py-4">No procurement items found matching query.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- High-Performance Smooth Pagination Footer (Matching Python App) -->
        <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
            @{
                int startRow = Model.FilteredTotalItems > 0 ? ((Model.Page - 1) * Model.PageSize) + 1 : 0;
                int endRow = Math.Min(Model.Page * Model.PageSize, Model.FilteredTotalItems);
            }
            <div class="small text-muted font-monospace">
                Showing <strong>@startRow</strong> to <strong>@endRow</strong> of <strong>@Model.FilteredTotalItems.ToString("N0")</strong> entries
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.CategoryFilter) || !string.IsNullOrEmpty(Model.StockFilter))
                {
                    <span class="badge bg-warning-subtle text-dark border ms-1">Filtered</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (Model.Page > 1)
                {
                    <a href="/AdminManagement?tab=procurement&page=@(Model.Page - 1)&search=@Model.SearchQuery&category=@Model.CategoryFilter&stock=@Model.StockFilter"
                       class="btn btn-sm btn-outline-secondary py-1 px-3">
                        <i class="bi bi-chevron-left me-1"></i>Prev
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-3" disabled><i class="bi bi-chevron-left me-1"></i>Prev</button>
                }

                <span class="badge bg-primary px-3 py-2 font-monospace">Page @Model.Page of @Model.TotalPages</span>

                @if (Model.Page < Model.TotalPages)
                {
                    <a href="/AdminManagement?tab=procurement&page=@(Model.Page + 1)&search=@Model.SearchQuery&category=@Model.CategoryFilter&stock=@Model.StockFilter"
                       class="btn btn-sm btn-outline-secondary py-1 px-3">
                        Next<i class="bi bi-chevron-right ms-1"></i>
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-3" disabled>Next<i class="bi bi-chevron-right ms-1"></i></button>
                }
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- TAB 2: BIDDING HISTORY -->
<!-- ========================================================================= -->
@if (activeTab == "bidding")
{
    <!-- Bidding KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="ems-kpi-card ems-kpi-blue p-3">
                <div class="ems-kpi-title"><i class="bi bi-journal-text me-1"></i>TOTAL BIDDING RECORDS</div>
                <div class="ems-kpi-lg-value ems-text-blue">@Model.BiddingRecords.Count.ToString("N0")</div>
                <div class="ems-kpi-sub fw-semibold">Recorded procurement biddings</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ems-kpi-card ems-kpi-green p-3">
                <div class="ems-kpi-title"><i class="bi bi-cash-stack me-1"></i>TOTAL BIDDING VALUE</div>
                <div class="ems-kpi-lg-value ems-text-green">Rp @Model.TotalBiddingValue.ToString("N0")</div>
                <div class="ems-kpi-sub fw-semibold">Cumulative awarded bidding amount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ems-kpi-card ems-kpi-amber p-3">
                <div class="ems-kpi-title"><i class="bi bi-award me-1"></i>TOP WINNING SUPPLIER</div>
                <div class="ems-kpi-lg-value ems-text-amber fs-4 text-truncate">@Model.TopSupplier</div>
                <div class="ems-kpi-sub fw-semibold">Most frequent awarded supplier</div>
            </div>
        </div>
    </div>

    <!-- Filter & Table Card -->
    <div class="ems-filter-card mb-4">
        <div class="ems-filter-header d-flex align-items-center justify-content-between">
            <span><i class="bi bi-journal-text me-2 text-info"></i>Bidding History & Awarded Quotes</span>
            <div class="d-flex gap-2 align-items-center">
                <form method="get" class="d-flex align-items-center gap-2 m-0">
                    <input type="hidden" name="tab" value="bidding" />
                    <select name="year" onchange="this.form.submit()" class="form-select form-select-sm" style="width:140px; border-radius:0;">
                        <option value="">All Years</option>
                        @foreach (var y in Model.BiddingYears)
                        {
                            <option value="@y" selected="@(Model.SelectedYear == y ? "selected" : null)">Year @y</option>
                        }
                    </select>
                </form>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="openCopyBiddingModal()" style="border-radius:0; font-family: Arial, sans-serif;"><i class="bi bi-copy me-1"></i>Copy Data Bidding</button>
                    <button type="button" class="btn btn-ems-primary btn-sm" onclick="openAddBiddingModal()"><i class="bi bi-plus-circle me-1"></i>Add Bidding Record</button>
                </div>
            </div>
        </div>
        <div class="p-3 border-bottom bg-light">
            <input type="text" id="biddingSearchInput" onkeyup="filterBiddingTable()" class="form-select form-select-sm" placeholder="🔍 Search bidding ID, master part ID, supplier name..." style="border-radius:0;" />
        </div>
        <div class="p-0">
            <div class="table-responsive">
                <table class="table-ems" id="biddingTable">
                    <thead>
                        <tr>
                            <th style="white-space:nowrap;">BIDDING ID</th>
                            <th style="white-space:nowrap;">TAHUN</th>
                            <th style="white-space:nowrap;">LINE</th>
                            <th style="min-width:110px; white-space:nowrap;">BIN</th>
                            <th style="min-width:130px; white-space:nowrap;">MASTER PART ID</th>
                            <th style="min-width:180px; white-space:nowrap;">NAMA ITEM</th>
                            <th style="min-width:180px; white-space:nowrap;">DETAIL</th>
                            <th style="white-space:nowrap;">BUDGET CODE</th>
                            <th class="text-center" style="white-space:nowrap;">QTY NEED</th>
                            <th class="text-center" style="white-space:nowrap;">SAFETY STK</th>
                            <th class="text-center" style="white-space:nowrap;">CURR STK</th>
                            <th class="text-center" style="white-space:nowrap;">QTY BID</th>
                            <th class="text-end" style="min-width:140px; white-space:nowrap;">PRICE (IDR)</th>
                            <th class="text-end" style="min-width:160px; white-space:nowrap;">TOTAL VALUE (RP)</th>
                            <th style="min-width:140px; white-space:nowrap;">SUPPLIER</th>
                            <th style="white-space:nowrap;">BID STATUS</th>
                            <th class="text-center" style="white-space:nowrap;">STATUS</th>
                            <th class="text-center" style="min-width:130px; white-space:nowrap;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.BiddingRecordDtos.Any())
                        {
                            foreach (var bid in Model.BiddingRecordDtos)
                            {
                                <tr>
                                    <td><span class="font-monospace text-primary">#@bid.Id</span></td>
                                    <td><span class="badge bg-light text-dark border fw-normal">@bid.BiddingYear</span></td>
                                    <td><span class="badge bg-secondary-subtle text-dark fw-normal">@bid.Line</span></td>
                                    <td><span class="font-monospace text-muted">@bid.Bin</span></td>
                                    <td><span class="font-monospace small text-primary">@bid.MasterDataId</span></td>
                                    <td class="text-dark">@bid.ItemName</td>
                                    <td class="small text-secondary">@bid.Detail</td>
                                    <td><span class="badge bg-info-subtle text-info border fw-normal">@bid.BudgetCode</span></td>
                                    <td class="text-center">@bid.QtyNeedYear</td>
                                    <td class="text-center">@bid.SafetyStock</td>
                                    <td class="text-center">@bid.CurrentStock</td>
                                    <td class="text-center text-primary">@bid.QtyBid</td>
                                    <td class="text-end font-monospace text-dark">Rp @bid.Price.ToString("N0")</td>
                                    <td class="text-end font-monospace text-success">Rp @bid.TotalValue.ToString("N0")</td>
                                    <td class="text-dark">@bid.SupplierName</td>
                                    <td><span class="small text-secondary">@bid.BiddingStage</span></td>
                                    <td class="text-center align-middle">
                                        @{
                                            var st = (bid.Status ?? "Completed").ToLower().Trim();
                                            string badgeCss = st == "pending" ? "bg-warning-subtle text-warning-emphasis border border-warning" :
                                                             (st == "cancelled" || st == "canceled") ? "bg-danger-subtle text-danger border border-danger" :
                                                             "bg-success-subtle text-success border border-success";
                                        }
                                        <span class="badge @badgeCss small">@(bid.Status ?? "Completed")</span>
                                    </td>
                                    <td class="text-center align-middle" style="white-space: nowrap;">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size:11px; border-radius:2px; font-family: Arial, sans-serif;" onclick="openEditBiddingModal(@bid.Id, '@bid.MasterDataId', '@JavaScriptEncoder.Default.Encode(bid.SupplierName ?? "")', @bid.BiddingYear, '@JavaScriptEncoder.Default.Encode(bid.BiddingStage ?? "")', @bid.Price, '@JavaScriptEncoder.Default.Encode(bid.Status ?? "Completed")', '@JavaScriptEncoder.Default.Encode(bid.Line ?? "")', '@JavaScriptEncoder.Default.Encode(bid.Bin ?? "")', '@JavaScriptEncoder.Default.Encode(bid.ItemName ?? "")', '@JavaScriptEncoder.Default.Encode(bid.Detail ?? "")', '@JavaScriptEncoder.Default.Encode(bid.BudgetCode ?? "")', @bid.QtyNeedYear, @bid.SafetyStock, @bid.CurrentStock)">
                                                <i class="bi bi-pencil me-1"></i>Edit
                                            </button>
                                            <form asp-action="DeleteBidding" asp-route-id="@bid.Id" method="post" class="d-inline m-0 p-0" onsubmit="return confirm('Hapus record bidding #@bid.Id?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size:11px; border-radius:2px; font-family: Arial, sans-serif;">
                                                    <i class="bi bi-trash me-1"></i>Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="18" class="text-center text-muted py-4">No bidding history records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- TAB 3: APPROVAL MENU -->
<!-- ========================================================================= -->
<!-- ========================================================================= -->
<!-- TAB 3: APPROVAL MENU (Pending Reviews Queue) -->
<!-- ========================================================================= -->
<!-- ========================================================================= -->
<!-- TAB 3: APPROVAL MENU (Matching Python App Admin Management Approval Queues) -->
<!-- ========================================================================= -->
<!-- ========================================================================= -->
<!-- TAB 3: APPROVAL MENU (Barang Keluar Queue) -->
<!-- ========================================================================= -->
@if (activeTab == "approvals")
{
    var pendingKeluar = Model.PendingBarangKeluarApprovals;

    <!-- Approval Barang Keluar Content (Matching Python ApprovalBarangKeluarContent) -->
    <div class="ems-filter-card mb-4" style="border-radius:0;">
        <div class="ems-filter-header d-block p-3 border-bottom bg-light">
            <h5 class="fw-bold mb-1" style="color: #0F4C81; font-family: Arial, sans-serif;">
                Barang Keluar Approvals Queue
            </h5>
            <p class="text-muted small mb-0" style="font-family: Arial, sans-serif;">
                Approve or reject outgoing sparepart transactions requested by users.
            </p>
        </div>
        <div class="p-0">
            <div class="table-responsive">
                <table class="table-ems mb-0" style="font-family: Arial, sans-serif;">
                    <thead>
                        <tr style="background-color: #F8FAFC;">
                            <th style="font-family: Arial, sans-serif;">TANGGAL</th>
                            <th style="font-family: Arial, sans-serif;">PART NUMBER</th>
                            <th style="font-family: Arial, sans-serif;">NAMA BARANG</th>
                            <th class="text-end" style="font-family: Arial, sans-serif;">QTY</th>
                            <th style="font-family: Arial, sans-serif;">LINE/MESIN</th>
                            <th style="font-family: Arial, sans-serif;">PIC</th>
                            <th style="font-family: Arial, sans-serif;">SUBMITTED BY</th>
                            <th class="text-center" style="font-family: Arial, sans-serif;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pendingKeluar.Any())
                        {
                            foreach (var item in pendingKeluar)
                            {
                                <tr>
                                    <td class="small text-muted">@item.Tanggal.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="font-monospace fw-bold text-primary">#(item.MasterDataId ?? "-")</span></td>
                                    <td class="fw-semibold">@item.ItemName</td>
                                    <td class="text-end text-danger fw-bold fs-6">-@item.Qty</td>
                                    <td>
                                        <span class="badge bg-light text-dark border me-1" style="border-radius:0;">@(item.Line ?? "-")</span>
                                        @if (!string.IsNullOrEmpty(item.Bin))
                                        {
                                            <span class="badge bg-light text-dark font-monospace border" style="border-radius:0;">BIN: @item.Bin</span>
                                        }
                                    </td>
                                    <td class="small">@(item.Pic ?? "-")</td>
                                    <td class="small text-secondary">@(item.RemName ?? "Technician")</td>
                                    <td class="text-center align-middle" style="white-space: nowrap;">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <form asp-action="ApproveKeluar" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success py-1 px-2" style="font-size:11px; border-radius:0; font-family: Arial, sans-serif;" title="Approve & Potong Stok">
                                                    <i class="bi bi-check-circle me-1"></i>Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectKeluar" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size:11px; border-radius:0; font-family: Arial, sans-serif;" title="Reject Request">
                                                    <i class="bi bi-x-circle me-1"></i>Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5" style="font-family: Arial, sans-serif;">
                                    <i class="bi bi-check-circle fs-3 d-block mb-2 text-success"></i>
                                    Tidak ada pengajuan Barang Keluar pending.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}



