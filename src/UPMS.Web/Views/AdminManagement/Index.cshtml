<!-- Add Bidding Modal -->
<div class="modal fade" id="addBiddingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:0; border: 1px solid var(--color-border);">
            <form asp-action="CreateBidding" method="post" id="addBiddingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="biddingMasterDataIdInput" name="MasterDataId" />
                
                <div class="modal-header py-2 px-3" style="background:#0F4C81; color:#fff; border-radius:0;">
                    <div>
                        <h6 class="modal-title fw-normal mb-0" style="font-size:14px; font-family: Arial, sans-serif;">
                            Tambah Bidding Baru
                        </h6>
                        <small class="text-white-50" style="font-size:11px;">Lengkapi data bidding dengan memilih dari Master Data atau isi manual</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
                </div>
                
                <div class="modal-body p-3 bg-light">
                    <!-- SECTION 1: Pilih & Cari dari Master Data -->
                    <div class="bg-white p-3 border mb-3">
                        <div class="mb-2 small text-uppercase" style="font-family: Arial, sans-serif; font-weight: bold; color: #0F4C81; border-left: 3px solid #0F4C81; padding-left: 8px;">
                            Pilih & Cari dari Master Data
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Search Sparepart</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="addBiddingSearchInput" class="form-control form-control-sm border-start-0" placeholder="Ketik Nama Item, Part Number (ID), atau BIN..." onkeyup="filterBiddingMasterPicker(this.value)" style="border-radius:0; font-family: Arial, sans-serif;" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Pilih Hasil Master Data</label>
                                <select id="addBiddingMasterPicker" class="form-select form-select-sm" onchange="onBiddingMasterSelected(this.value)" style="border-radius:0; font-family: Arial, sans-serif;">
                                    <option value="">-- Pilih Suku Cadang dari Master Data --</option>
                                    @foreach (var part in Model.AllMasterDataItems)
                                    {
                                        <option value="@part.Id" data-bin="@part.Bin" data-item="@part.Item" data-detail="@part.Detail" data-budget="@part.BudgetCode" data-line="@part.Line" data-need="@(part.QtyNeedYear ?? 0)" data-safety="@(part.SafetyStock ?? 0)" data-stock="@(part.CurrentStock ?? 0)" data-price="@(part.CurrentUnitPrice ?? 0m)" data-supplier="@part.Brand">
                                            [@(string.IsNullOrEmpty(part.Bin) ? "-" : part.Bin)] @part.Item (ID: @part.Id)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: Identifikasi -->
                    <div class="bg-white p-3 border mb-3">
                        <div class="mb-2 small text-uppercase" style="font-family: Arial, sans-serif; font-weight: bold; color: #0F4C81; border-left: 3px solid #0F4C81; padding-left: 8px;">
                            Identifikasi
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Tahun</label>
                                <select name="BiddingYear" id="biddingYearInput" class="form-select form-select-sm" style="border-radius:0; font-family: Arial, sans-serif;">
                                    @{
                                        int curY = DateTime.Now.Year;
                                        for (int y = curY - 2; y <= curY + 3; y++)
                                        {
                                            <option value="@y" selected="@(y == curY ? "selected" : null)">@y</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Line <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="text" id="biddingLineInput" name="Line" class="form-control form-control-sm bg-light" readonly placeholder="Line" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">BIN <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="text" id="biddingBinInput" name="bin" class="form-control form-control-sm bg-light" readonly placeholder="BIN" onchange="onBiddingBinChange(this.value)" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Nama Item <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="text" id="biddingItemNameInput" name="itemName" class="form-control form-control-sm bg-light" readonly placeholder="Nama Item" required style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Detail <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="text" id="biddingDetailInput" name="Detail" class="form-control form-control-sm bg-light" readonly placeholder="Detail" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Budget Code</label>
                                <input type="text" id="biddingBudgetCodeInput" name="BudgetCode" class="form-control form-control-sm" placeholder="Budget Code" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: Stock & Harga -->
                    <div class="bg-white p-3 border mb-3">
                        <div class="mb-2 small text-uppercase" style="font-family: Arial, sans-serif; font-weight: bold; color: #0F4C81; border-left: 3px solid #0F4C81; padding-left: 8px;">
                            Stock & Harga
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Qty Need/Year <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="number" id="biddingQtyNeedInput" class="form-control form-control-sm bg-light" readonly placeholder="Qty Need/Year" oninput="recalcBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Safety Stock <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="number" id="biddingSafetyStockInput" class="form-control form-control-sm bg-light" readonly placeholder="Safety Stock" oninput="recalcBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Current Stock <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="number" id="biddingCurrentStockInput" class="form-control form-control-sm bg-light" readonly placeholder="Current Stock" oninput="recalcBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Current Price (Rp)</label>
                                <input type="number" id="biddingCurrentPriceInput" name="Price" class="form-control form-control-sm font-monospace" placeholder="Current Price" oninput="recalcBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Current Supplier</label>
                                <input type="text" id="biddingSupplierInput" name="SupplierName" class="form-control form-control-sm" placeholder="Current Supplier" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Bid Status</label>
                                <select id="biddingStageInput" name="BiddingStage" class="form-select form-select-sm" style="border-radius:0; font-family: Arial, sans-serif;">
                                    <option value="1st">1st</option>
                                    <option value="Additional">Additional</option>
                                    <option value="Bidding 1">Bidding 1</option>
                                    <option value="Bidding 2">Bidding 2</option>
                                    <option value="Final Stage">Final Stage</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: Kalkulasi Otomatis -->
                    <div class="bg-white p-3 border">
                        <div class="mb-2 small text-uppercase" style="font-family: Arial, sans-serif; font-weight: bold; color: #0F4C81; border-left: 3px solid #0F4C81; padding-left: 8px;">
                            Kalkulasi Otomatis
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1">Qty Bid (Need + Safety − Stock)</label>
                                <input type="text" id="biddingQtyBidCalc" class="form-control form-control-sm font-monospace bg-light" readonly placeholder="0" style="border-radius:0;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1">Total Value (Qty Bid × Price)</label>
                                <input type="text" id="biddingValueCalc" class="form-control form-control-sm font-monospace fw-bold text-success bg-light" readonly placeholder="Rp 0" style="border-radius:0;" />
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer py-2 px-3 bg-light">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm"><i class="bi bi-floppy me-1"></i>Simpan Data</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Bidding Modal -->
