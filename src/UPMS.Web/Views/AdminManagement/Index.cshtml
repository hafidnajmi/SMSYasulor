                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Nama Item <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="text" id="editBiddingItemNameInput" name="itemName" class="form-control form-control-sm bg-light" readonly placeholder="Nama Item" required style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Detail <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="text" id="editBiddingDetailInput" name="detail" class="form-control form-control-sm bg-light" readonly placeholder="Detail" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Budget Code</label>
                                <input type="text" id="editBiddingBudgetCodeInput" name="budgetCode" class="form-control form-control-sm" placeholder="Budget Code" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: Stock & Harga -->
                    <div class="bg-white p-3 border mb-3">
                        <div class="mb-2 small text-uppercase" style="font-family: Arial, sans-serif; font-weight: bold; color: #0F4C81; border-left: 3px solid #0F4C81; padding-left: 8px;">
                            Stock & Harga
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Qty Need/Year <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="number" id="editBiddingQtyNeedInput" name="qtyNeedYear" class="form-control form-control-sm bg-light" readonly placeholder="Qty Need/Year" oninput="recalcEditBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Safety Stock <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="number" id="editBiddingSafetyStockInput" name="safetyStock" class="form-control form-control-sm bg-light" readonly placeholder="Safety Stock" oninput="recalcEditBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Current Stock <span class="badge bg-light text-muted border ms-1"><i class="bi bi-lock-fill me-1"></i>Catalog</span></label>
                                <input type="number" id="editBiddingCurrentStockInput" name="currentStock" class="form-control form-control-sm bg-light" readonly placeholder="Current Stock" oninput="recalcEditBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Current Price (Rp)</label>
                                <input type="number" id="editBiddingCurrentPriceInput" name="Price" class="form-control form-control-sm font-monospace" placeholder="Current Price" oninput="recalcEditBiddingSummary()" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Current Supplier</label>
                                <input type="text" id="editBiddingSupplierInput" name="SupplierName" class="form-control form-control-sm" placeholder="Current Supplier" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Bid Status</label>
                                <select id="editBiddingStageInput" name="BiddingStage" class="form-select form-select-sm" style="border-radius:0; font-family: Arial, sans-serif;">
                                    <option value="1st">1st</option>
                                    <option value="Additional">Additional</option>
                                    <option value="Bidding 1">Bidding 1</option>
                                    <option value="Bidding 2">Bidding 2</option>
                                    <option value="Final Stage">Final Stage</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Status</label>
                                <select id="editBiddingStatusInput" name="Status" class="form-select form-select-sm" style="border-radius:0; font-family: Arial, sans-serif;">
                                    <option value="Completed">Completed</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: Kalkulasi Otomatis -->
                    <div class="bg-white p-3 border">
                        <div class="mb-2 small text-uppercase" style="font-family: Arial, sans-serif; font-weight: bold; color: #0F4C81; border-left: 3px solid #0F4C81; padding-left: 8px;">
                            Kalkulasi Otomatis
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Qty Bid (Need + Safety − Stock)</label>
                                <input type="text" id="editBiddingQtyBidCalc" class="form-control form-control-sm font-monospace bg-light" readonly placeholder="0" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Total Value (Qty Bid × Price)</label>
                                <input type="text" id="editBiddingValueCalc" class="form-control form-control-sm font-monospace fw-bold text-success bg-light" readonly placeholder="Rp 0" style="border-radius:0; font-family: Arial, sans-serif;" />
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer py-2 px-3 bg-light">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm"><i class="bi bi-floppy me-1"></i>Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Copy Bidding Modal -->
<div class="modal fade" id="copyBiddingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:0; border: 1px solid var(--color-border);">
            <form asp-action="CopyBiddingYear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header py-2 px-3" style="background:#0F4C81; color:#fff; border-radius:0;">
                    <div>
                        <h6 class="modal-title fw-normal mb-0" style="font-size:14px; font-family: Arial, sans-serif;">
                            Copy Bidding ke Tahun Baru
                        </h6>
                        <small class="text-white-50" style="font-size:11px;">Duplikasi data bidding suku cadang antar tahun</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3 bg-light">
                    <!-- Info Banner -->
                    <div class="alert alert-info border-0 p-2 mb-3 small d-flex align-items-center" style="border-radius:0; background-color:#EFF6FF; color:#1E40AF;">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <div>Fitur ini menyalin seluruh item bidding dari tahun lama ke tahun baru secara otomatis untuk mempercepat proses pembuatan anggaran.</div>
                    </div>

                    <div class="bg-white p-3 border mb-3">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Tahun Asal (Copy dari)</label>
                                <select name="fromYear" id="copyFromYear" class="form-select form-select-sm" style="border-radius:0; font-family: Arial, sans-serif;" required>
                                    <option value="">-- Pilih Tahun Asal --</option>
                                    @foreach (var y in Model.BiddingYears)
                                    {
                                        <option value="@y">Tahun @y</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary mb-1" style="font-family: Arial, sans-serif;">Tahun Tujuan (Copy ke)</label>
                                <select name="toYear" id="copyToYear" class="form-select form-select-sm" style="border-radius:0; font-family: Arial, sans-serif;" required>
                                    @{
                                        int nextY = DateTime.Now.Year + 1;
                                        int curY3 = DateTime.Now.Year;
                                        for (int y = curY3 - 1; y <= nextY + 2; y++)
                                        {
                                            <option value="@y" selected="@(y == nextY ? "selected" : null)">Tahun @y</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-check mt-3 mb-0">
                            <input class="form-check-input" type="checkbox" name="overwrite" value="true" id="copyOverwriteCb" />
                            <label class="form-check-label small text-secondary" for="copyOverwriteCb" style="font-family: Arial, sans-serif;">
                                Timpa (overwrite) data jika suku cadang sudah ada di tahun tujuan
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm"><i class="bi bi-copy me-1"></i>Copy Data Bidding</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCopyBiddingModal() {
            var modal = new bootstrap.Modal(document.getElementById("copyBiddingModal"));
            modal.show();
        }
        function showDetailModal(title, detailText) {
            document.getElementById("detailModalTitle").innerText = title;
            document.getElementById("detailModalBody").innerText = detailText || "No detail specification recorded.";
            var modal = new bootstrap.Modal(document.getElementById("itemDetailModal"));
            modal.show();
        }

        function escapeHtml(text) {
            if (!text) return "";
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        async function loadSupplierOffers(masterDataId) {
            var spinner = document.getElementById("modalOffersSpinner");
            var wrapper = document.getElementById("modalOffersTableWrapper");
            var tbody = document.getElementById("modalOffersTbody");

            spinner.style.display = "block";
            wrapper.style.display = "none";
            tbody.innerHTML = "";

            try {
                var res = await fetch('/AdminManagement/GetSupplierOffersJson?masterDataId=' + encodeURIComponent(masterDataId));
                var data = await res.json();

                spinner.style.display = "none";
                wrapper.style.display = "block";

                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Belum ada data penawaran supplier. Silakan tambah penawaran di bawah.</td></tr>';
                    return;
                }

                var minPrice = Math.min(...data.map(d => Number(d.price) || 999999999));

                data.forEach(function(o) {
                    var tr = document.createElement("tr");
                    var isCheapest = (Number(o.price) === minPrice && minPrice > 0);

                    if (o.isSelected) {
                        tr.className = "table-success-subtle";
                    } else if (isCheapest) {
                        tr.className = "table-warning-subtle";
                    }

                    var priceFormatted = "Rp " + Number(o.price).toLocaleString("id-ID");
                    if (isCheapest) {
                        priceFormatted += ' <span class="badge bg-success text-white font-monospace ms-1" style="font-size:10px;"><i class="bi bi-tag-fill me-1"></i>Paling Murah</span>';
                    }

                    var statusCol = o.isSelected 
                        ? '<span class="badge bg-success text-white fw-normal"><i class="bi bi-check-circle me-1"></i>Selected (Pilihan)</span>' 
                        : `<button type="button" class="btn btn-sm btn-outline-success py-0 px-2 fw-normal" style="font-size:11px;" onclick="setPrimarySupplierOffer(${o.id})" title="Pilih supplier ini sebagai pilihan utama"><i class="bi bi-check-lg me-1"></i>Set Primary</button>`;

                    var actionBtns = `
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 me-1" style="font-size:11px;" onclick="editSupplierOfferRow('${escapeHtml(o.supplierName)}', ${o.price}, ${o.isSelected})" title="Edit Penawaran">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:11px;" onclick="deleteSupplierOffer(${o.id})" title="Hapus Penawaran">
                            <i class="bi bi-trash"></i>
                        </button>
                    `;

                    tr.innerHTML = `
                        <td class="text-primary fw-semibold">${escapeHtml(o.supplierName)}</td>
                        <td class="text-end font-monospace">${priceFormatted}</td>
                        <td><span class="small text-muted"><i class="bi bi-clock me-1"></i>${o.updatedAt} (${escapeHtml(o.updatedBy)})</span></td>
                        <td class="text-center">${statusCol}</td>
                        <td class="text-center">${actionBtns}</td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                spinner.innerHTML = `<div class="text-danger small py-2"><i class="bi bi-exclamation-circle me-1"></i>Error: ${err.message}</div>`;
            }
        }

        function editSupplierOfferRow(supplierName, price, isSelected) {
            var sel = document.getElementById("modalSupplierSelect");
            sel.value = supplierName;
            if (sel.selectedIndex <= 0 && supplierName) {
                document.getElementById("modalCustomSupplier").value = supplierName;
            } else {
                document.getElementById("modalCustomSupplier").value = "";
            }
            document.getElementById("modalNewPrice").value = price;
            document.getElementById("modalSetPrimaryCheck").checked = isSelected;
            document.getElementById("modalNewPrice").focus();
        }

        function showUpdatePriceModal(id, item, currentPrice, currentSupplier) {
            document.getElementById("modalMasterDataId").value = id;
            document.getElementById("modalItemLabel").innerText = id + " — " + item;
            document.getElementById("modalNewPrice").value = currentPrice || "";

            var sel = document.getElementById("modalSupplierSelect");
            var sup = currentSupplier || "";
            sel.value = sup;

            if (sel.selectedIndex <= 0 && sup.trim() !== "") {
                var matchOpt = Array.from(sel.options).find(o => o.value.toLowerCase() === sup.trim().toLowerCase());
                if (matchOpt) {
                    sel.value = matchOpt.value;
                    document.getElementById("modalCustomSupplier").value = "";
                } else {
                    document.getElementById("modalCustomSupplier").value = sup;
                }
            } else {
                document.getElementById("modalCustomSupplier").value = "";
            }

            loadSupplierOffers(id);

            var modal = new bootstrap.Modal(document.getElementById("updatePriceModal"));
            modal.show();
        }

        async function submitSupplierOfferAjax(e) {
            e.preventDefault();
            var masterDataId = document.getElementById("modalMasterDataId").value;
            var selVal = document.getElementById("modalSupplierSelect").value;
            var custVal = document.getElementById("modalCustomSupplier").value;
            var supplierName = (custVal && custVal.trim().length > 0) ? custVal.trim() : selVal.trim();
            var price = parseFloat(document.getElementById("modalNewPrice").value);
            var setAsPrimary = document.getElementById("modalSetPrimaryCheck").checked;

            if (!supplierName || isNaN(price) || price <= 0) {
                alert("Pilih/ketik nama Supplier dan masukkan harga yang valid.");
                return;
            }

            var formData = new URLSearchParams();
            formData.append("masterDataId", masterDataId);
            formData.append("supplierName", supplierName);
            formData.append("price", price);
            formData.append("setAsPrimary", setAsPrimary);

            try {
                var res = await fetch('/AdminManagement/SaveSupplierOfferAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                });
                var data = await res.json();
                if (data.success) {
                    loadSupplierOffers(masterDataId);
                    if (setAsPrimary) {
                        loadProcurementTableAjax();
                    }
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert("Gagal menyimpan penawaran: " + err.message);
            }
        }

        async function setPrimarySupplierOffer(offerId) {
            var masterDataId = document.getElementById("modalMasterDataId").value;
            var formData = new URLSearchParams();
            formData.append("offerId", offerId);

            try {
                var res = await fetch('/AdminManagement/SetPrimarySupplierOfferAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                });
                var data = await res.json();
                if (data.success) {
                    loadSupplierOffers(masterDataId);
                    loadProcurementTableAjax();
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert("Gagal memperbarui supplier utama: " + err.message);
            }
        }

        async function deleteSupplierOffer(offerId) {
            if (!confirm("Hapus penawaran harga supplier ini?")) return;
            var masterDataId = document.getElementById("modalMasterDataId").value;
            var formData = new URLSearchParams();
            formData.append("offerId", offerId);

            try {
                var res = await fetch('/AdminManagement/DeleteSupplierOfferAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                });
                var data = await res.json();
                if (data.success) {
                    loadSupplierOffers(masterDataId);
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert("Gagal menghapus penawaran: " + err.message);
            }
        }

        function loadProcurementTableAjax() {
            var url = window.location.href;
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(res => res.text())
                .then(html => {
                    var parser = new DOMParser();
                    var doc = parser.parseFromString(html, 'text/html');
                    var newTable = doc.getElementById('procTable');
                    var curTable = document.getElementById('procTable');
                    if (newTable && curTable) {
                        curTable.innerHTML = newTable.innerHTML;
                    }
                }).catch(() => {});
        }

        function openAddBiddingModal() {
            var modal = new bootstrap.Modal(document.getElementById("addBiddingModal"));
            modal.show();
        }

        function openEditBiddingModal(id, masterDataId, supplierName, year, stage, price, status, line, bin, item, detail, budgetCode, need, safety, stock) {
            document.getElementById("editBiddingId").value = id;
            document.getElementById("editBiddingHeader").innerText = "#" + id;
            document.getElementById("editBiddingMasterDataIdInput").value = masterDataId || "";
            document.getElementById("editBiddingSupplierInput").value = supplierName || "";
            if (document.getElementById("editBiddingYearDisplay")) {
                document.getElementById("editBiddingYearDisplay").value = year || new Date().getFullYear();
            }
            document.getElementById("editBiddingYearInput").value = year || new Date().getFullYear();
            document.getElementById("editBiddingStageInput").value = stage || "1st";
            document.getElementById("editBiddingCurrentPriceInput").value = price || 0;
            document.getElementById("editBiddingStatusInput").value = status || "Completed";

            document.getElementById("editBiddingLineInput").value = line || "";
            document.getElementById("editBiddingBinInput").value = bin || "";
            document.getElementById("editBiddingItemNameInput").value = item || masterDataId || "";
            document.getElementById("editBiddingDetailInput").value = detail || "";
            document.getElementById("editBiddingBudgetCodeInput").value = budgetCode || "";
            document.getElementById("editBiddingQtyNeedInput").value = need || 0;
            document.getElementById("editBiddingSafetyStockInput").value = safety || 0;
            document.getElementById("editBiddingCurrentStockInput").value = stock || 0;

            var select = document.getElementById("editBiddingMasterPicker");
            if (select) {
                select.value = masterDataId || "";
            }

            recalcEditBiddingSummary();

            var modal = new bootstrap.Modal(document.getElementById("editBiddingModal"));
            modal.show();
        }

        function filterEditBiddingMasterPicker(searchVal) {
            var s = (searchVal || "").toLowerCase().trim();
            var select = document.getElementById("editBiddingMasterPicker");
            if (!select) return;
            var opts = select.options;
            for (var i = 1; i < opts.length; i++) {
                var txt = opts[i].text.toLowerCase();
                if (!s || txt.includes(s)) {
                    opts[i].style.display = "";
                } else {
                    opts[i].style.display = "none";
                }
            }
        }

        function onEditBiddingMasterSelected(partId) {
            if (!partId) return;
            var select = document.getElementById("editBiddingMasterPicker");
            var selectedOpt = select.options[select.selectedIndex];
            if (!selectedOpt || !selectedOpt.value) return;

            document.getElementById("editBiddingMasterDataIdInput").value = partId;
            document.getElementById("editBiddingBinInput").value = selectedOpt.getAttribute("data-bin") || "";
            document.getElementById("editBiddingItemNameInput").value = selectedOpt.getAttribute("data-item") || "";
            document.getElementById("editBiddingDetailInput").value = selectedOpt.getAttribute("data-detail") || "";
            document.getElementById("editBiddingBudgetCodeInput").value = selectedOpt.getAttribute("data-budget") || "";
            document.getElementById("editBiddingLineInput").value = selectedOpt.getAttribute("data-line") || "";
            document.getElementById("editBiddingQtyNeedInput").value = selectedOpt.getAttribute("data-need") || 0;
            document.getElementById("editBiddingSafetyStockInput").value = selectedOpt.getAttribute("data-safety") || 0;
            document.getElementById("editBiddingCurrentStockInput").value = selectedOpt.getAttribute("data-stock") || 0;
            document.getElementById("editBiddingCurrentPriceInput").value = selectedOpt.getAttribute("data-price") || 0;
            document.getElementById("editBiddingSupplierInput").value = selectedOpt.getAttribute("data-supplier") || "";

            recalcEditBiddingSummary();
        }

        function onEditBiddingBinChange(binVal) {
            var b = (binVal || "").trim().toLowerCase();
            if (!b) return;
            var select = document.getElementById("editBiddingMasterPicker");
            for (var i = 1; i < select.options.length; i++) {
                var optBin = (select.options[i].getAttribute("data-bin") || "").trim().toLowerCase();
                if (optBin === b) {
                    select.selectedIndex = i;
                    onEditBiddingMasterSelected(select.options[i].value);
                    break;
                }
            }
        }

        function recalcEditBiddingSummary() {
            var need = parseFloat(document.getElementById("editBiddingQtyNeedInput").value) || 0;
            var safety = parseFloat(document.getElementById("editBiddingSafetyStockInput").value) || 0;
            var stock = parseFloat(document.getElementById("editBiddingCurrentStockInput").value) || 0;
            var price = parseFloat(document.getElementById("editBiddingCurrentPriceInput").value) || 0;

            var qtyBid = Math.max(0, need + safety - stock);
            var totalVal = qtyBid * price;

            document.getElementById("editBiddingQtyBidCalc").value = qtyBid;
            document.getElementById("editBiddingValueCalc").value = "Rp " + totalVal.toLocaleString("id-ID");
        }

        function filterBiddingMasterPicker(searchVal) {
            var s = (searchVal || "").toLowerCase().trim();
            var select = document.getElementById("addBiddingMasterPicker");
            if (!select) return;
            var opts = select.options;
            for (var i = 1; i < opts.length; i++) {
                var txt = opts[i].text.toLowerCase();
                if (!s || txt.includes(s)) {
                    opts[i].style.display = "";
                } else {
                    opts[i].style.display = "none";
                }
            }
        }

        function onBiddingMasterSelected(partId) {
            if (!partId) return;
            var select = document.getElementById("addBiddingMasterPicker");
            var selectedOpt = select.options[select.selectedIndex];
            if (!selectedOpt || !selectedOpt.value) return;

            document.getElementById("biddingMasterDataIdInput").value = partId;
            document.getElementById("biddingBinInput").value = selectedOpt.getAttribute("data-bin") || "";
            document.getElementById("biddingItemNameInput").value = selectedOpt.getAttribute("data-item") || "";
            document.getElementById("biddingDetailInput").value = selectedOpt.getAttribute("data-detail") || "";
            document.getElementById("biddingBudgetCodeInput").value = selectedOpt.getAttribute("data-budget") || "";
            document.getElementById("biddingLineInput").value = selectedOpt.getAttribute("data-line") || "";
            document.getElementById("biddingQtyNeedInput").value = selectedOpt.getAttribute("data-need") || 0;
            document.getElementById("biddingSafetyStockInput").value = selectedOpt.getAttribute("data-safety") || 0;
            document.getElementById("biddingCurrentStockInput").value = selectedOpt.getAttribute("data-stock") || 0;
            document.getElementById("biddingCurrentPriceInput").value = selectedOpt.getAttribute("data-price") || 0;
            document.getElementById("biddingSupplierInput").value = selectedOpt.getAttribute("data-supplier") || "";

            recalcBiddingSummary();
        }

        function onBiddingBinChange(binVal) {
            var b = (binVal || "").trim().toLowerCase();
            if (!b) return;
            var select = document.getElementById("addBiddingMasterPicker");
            for (var i = 1; i < select.options.length; i++) {
                var optBin = (select.options[i].getAttribute("data-bin") || "").trim().toLowerCase();
                if (optBin === b) {
                    select.selectedIndex = i;
                    onBiddingMasterSelected(select.options[i].value);
                    break;
                }
            }
        }

        function recalcBiddingSummary() {
            var need = parseFloat(document.getElementById("biddingQtyNeedInput").value) || 0;
            var safety = parseFloat(document.getElementById("biddingSafetyStockInput").value) || 0;
            var stock = parseFloat(document.getElementById("biddingCurrentStockInput").value) || 0;
            var price = parseFloat(document.getElementById("biddingCurrentPriceInput").value) || 0;

            var qtyBid = Math.max(0, need + safety - stock);
            var totalVal = qtyBid * price;

            document.getElementById("biddingQtyBidCalc").value = qtyBid;
            document.getElementById("biddingValueCalc").value = "Rp " + totalVal.toLocaleString("id-ID");
        }

        function syncSupplierInput(val) {
            var sel = document.getElementById("modalSupplierSelect");
            if (val && val.trim().length > 0) {
                var optExists = Array.from(sel.options).some(o => o.value.toLowerCase() === val.toLowerCase());
                if (!optExists) {
                    sel.value = "";
                } else {
                    sel.value = val;
                }
            }
        }

        function filterProcTable() {
            var search = document.getElementById("procSearchInput").value.toLowerCase();
            var cat = document.getElementById("procCategoryFilter") ? document.getElementById("procCategoryFilter").value.toLowerCase() : "";
            var stock = document.getElementById("procStockFilter") ? document.getElementById("procStockFilter").value : "";

            var rows = document.querySelectorAll("#procTable tbody tr");
            rows.forEach(function(row) {
                var text = row.innerText.toLowerCase();
                var categoryCell = row.cells[3] ? row.cells[3].innerText.toLowerCase() : "";

                var matchesSearch = !search || text.includes(search);
                var matchesCategory = !cat || categoryCell.includes(cat);

                if (matchesSearch && matchesCategory) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function filterBiddingTable() {
            var search = document.getElementById("biddingSearchInput").value.toLowerCase();
            var rows = document.querySelectorAll("#biddingTable tbody tr");
            rows.forEach(function(row) {
                var text = row.innerText.toLowerCase();
                if (!search || text.includes(search)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function openEditMappingModal(id, partInfo, currentLine) {
            document.getElementById("editMappingId").value = id;
            document.getElementById("editMappingPartDisplay").innerText = partInfo;
            var sel = document.getElementById("editMappingLineSelect");
            if (sel) sel.value = currentLine || "";
            var modal = new bootstrap.Modal(document.getElementById("editMappingModal"));
            modal.show();
        }

        function showHistoryPriceModal(masterDataId, itemName) {
            document.getElementById("histPartNumber").innerText = masterDataId;
            document.getElementById("histItemName").innerText = itemName;
            document.getElementById("histCurrentPrice").innerText = "Loading...";

            var tbody = document.getElementById("histTableBody");
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading price history...</td></tr>';

            var modal = new bootstrap.Modal(document.getElementById("historyPriceModal"));
            modal.show();

            fetch('/AdminManagement/GetPriceHistory?masterDataId=' + encodeURIComponent(masterDataId))
                .then(res => res.json())
                .then(data => {
                    if (!data || !data.success) {
                        document.getElementById("histCurrentPrice").innerText = "Rp 0";
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-3">Gagal memuat data riwayat (' + ((data && data.message) ? data.message : 'Error') + ').</td></tr>';
                        return;
                    }

                    document.getElementById("histCurrentPrice").innerText = "Rp " + (data.currentPrice || 0).toLocaleString('id-ID');

                    var records = [];
                    if (data.histories && data.histories.length > 0) {
                        records = data.histories;
                    } else if (data.offers && data.offers.length > 0) {
                        records = data.offers;
                    }

                    if (records.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">Belum ada catatan riwayat perubahan harga untuk sparepart ini.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = "";
                    records.forEach((r, idx) => {
                        var tr = document.createElement("tr");
                        var newP = r.newPrice || 0;
                        var oldP = r.oldPrice || 0;
                        var diff = newP - oldP;
                        var badgeHtml = "";
                        if (oldP > 0 && diff > 0) {
                            badgeHtml = ' <span class="badge bg-danger-subtle text-danger border ms-1" style="font-size:10px;">+Rp ' + diff.toLocaleString('id-ID') + '</span>';
                        } else if (oldP > 0 && diff < 0) {
                            badgeHtml = ' <span class="badge bg-success-subtle text-success border ms-1" style="font-size:10px;">-Rp ' + Math.abs(diff).toLocaleString('id-ID') + '</span>';
                        }

                        tr.innerHTML = '<td class="text-center font-monospace text-muted" style="background-color:#F8FAFC; border-right:1px solid #E2E8F0;">' + (idx + 1) + '</td>' +
                            '<td class="small text-muted font-monospace">' + (r.effectiveDate || '-') + '</td>' +
                            '<td><span class="badge bg-light text-dark border fw-medium">' + (r.supplierName || '-') + '</span></td>' +
                            '<td class="text-end font-monospace fw-bold text-primary">Rp ' + newP.toLocaleString('id-ID') + badgeHtml + '</td>' +
                            '<td><span class="small text-secondary">' + (r.reason || 'Price Update') + '</span></td>' +
                            '<td class="small text-muted">' + (r.updatedBy || 'admin') + '</td>';

                        tbody.appendChild(tr);
                    });
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById("histCurrentPrice").innerText = "Rp 0";
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-3">Terjadi kesalahan koneksi saat memuat data riwayat.</td></tr>';
                });
        }
    </script>
}

<!-- Modal Edit Line Mapping -->
<div class="modal fade" id="editMappingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 0; font-family: Arial, sans-serif;">
            <form asp-action="EditMapping" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editMappingId" />
                <div class="modal-header text-white" style="background-color: #0F4C81; border-radius: 0;">
                    <h6 class="modal-title fw-bold" style="font-family: Arial, sans-serif;"><i class="bi bi-pencil-square me-2"></i>Edit Line Mapping</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="bg-white p-3 border mb-3">
                        <div class="small text-muted mb-1">Sparepart Info</div>
                        <div class="fw-bold text-primary" id="editMappingPartDisplay"></div>
                    </div>
                    <div class="bg-white p-3 border">
                        <label class="form-label small text-secondary mb-1">Production Line *</label>
                        <select name="lineName" id="editMappingLineSelect" class="form-select form-select-sm" style="border-radius:0;">
                            @foreach (var l in Model.AvailableProductionLines)
                            {
                                <option value="@l">@l</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal" style="border-radius:0;">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary" style="border-radius:0; background-color: #0F4C81; border-color: #0F4C81;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal History Price Records -->
<div class="modal fade" id="historyPriceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 0; font-family: Arial, sans-serif;">
            <div class="modal-header text-white" style="background-color: #0F4C81; border-radius: 0;">
                <h6 class="modal-title fw-bold" style="font-family: Arial, sans-serif;"><i class="bi bi-clock-history me-2"></i>History Price & Supplier Records</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light p-3">
                <div class="bg-white p-3 border mb-3">
                    <div class="row align-items-center">
                        <div class="col-md-7">
                            <span class="text-primary font-monospace fw-bold me-2" id="histPartNumber">-</span>
                            <span class="fw-semibold text-dark" id="histItemName">-</span>
                        </div>
                        <div class="col-md-5 text-end">
                            <span class="small text-muted me-1">Current Price:</span>
                            <span class="fw-bold text-success font-monospace" id="histCurrentPrice">Rp 0</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white border p-0">
                    <div class="table-responsive" style="max-height: 350px;">
                        <table class="table table-hover align-middle mb-0" style="font-size: 12px;">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th style="width: 50px;">NO</th>
                                    <th>DATE</th>
                                    <th>SUPPLIER</th>
                                    <th class="text-end">UNIT PRICE (IDR)</th>
                                    <th>CHANGE / SOURCE</th>
                                    <th>UPDATED BY</th>
                                </tr>
                            </thead>
                            <tbody id="histTableBody">
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">Loading history data...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white border-top py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal" style="border-radius:0;">Close</button>
            </div>
        </div>
    </div>
</div>
