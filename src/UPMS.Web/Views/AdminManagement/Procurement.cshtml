@model List<UPMS.Web.Models.Entities.MasterData>

@{
    ViewData["Title"] = "Procurement & Asset Valuation";
}

<!-- EMS Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0B4A8F;">Procurement & Inventory Valuation</h3>
        <p class="text-muted small mb-0">Total asset valuation and inventory stock metrics for procurement planning.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/AdminManagement?tab=approvals" class="btn btn-ems-outline btn-sm"><i class="bi bi-shield-check me-1"></i>Approval Queue</a>
        <button onclick="window.print()" class="btn btn-ems-primary btn-sm"><i class="bi bi-printer me-1"></i>Print Report</button>
    </div>
</div>

<!-- EMS Financial Valuation Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ems-kpi-card ems-kpi-blue p-3">
            <div class="ems-kpi-title"><i class="bi bi-safe"></i>TOTAL INVENTORY VALUATION</div>
            <div class="ems-kpi-lg-value ems-text-blue">Rp @(((decimal)(ViewBag.TotalValuation ?? 0m)).ToString("N0"))</div>
            <div class="ems-kpi-sub fw-semibold">100.00% of Active Asset Valuation</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ems-kpi-card ems-kpi-green p-3">
            <div class="ems-kpi-title"><i class="bi bi-check2-square"></i>TOTAL MASTER ITEMS</div>
            <div class="ems-kpi-lg-value ems-text-green">@(Model?.Count.ToString("N0") ?? "0")</div>
            <div class="ems-kpi-sub fw-semibold">Active catalog spareparts</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ems-kpi-card ems-kpi-amber p-3">
            <div class="ems-kpi-title"><i class="bi bi-exclamation-octagon"></i>CRITICAL LOW STOCK ITEMS</div>
            <div class="ems-kpi-lg-value ems-text-amber">@(Model?.Count(m => (m.CurrentStock ?? 0) <= (m.SafetyStock ?? 0)).ToString("N0") ?? "0")</div>
            <div class="ems-kpi-sub fw-semibold">Items requiring immediate reorder</div>
        </div>
    </div>
</div>

<!-- EMS Table Card -->
<div class="ems-filter-card">
    <div class="ems-filter-header">
        <span><i class="bi bi-table me-2 text-primary"></i>Master Inventory Valuation Breakdown</span>
    </div>
    <div class="p-0">
        <div class="table-responsive">
            <table class="table-ems">
                <thead>
                    <tr>
                        <th>PART NUMBER</th>
                        <th>ITEM NAME</th>
                        <th>BIN</th>
                        <th>CATEGORY</th>
                        <th class="text-end">CURRENT STOCK</th>
                        <th class="text-end">UNIT PRICE (IDR)</th>
                        <th class="text-end">TOTAL VALUATION (IDR)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            decimal unitPrice = item.CurrentUnitPrice ?? 0m;
                            decimal itemValuation = (item.CurrentStock ?? 0) * unitPrice;
                            <tr>
                                <td><span class="font-monospace fw-bold text-primary">@item.Id</span></td>
                                <td class="fw-semibold">@item.Item</td>
                                <td><span class="badge bg-light text-dark font-monospace border">@(item.Bin ?? "-")</span></td>
                                <td><span class="small text-secondary">@(item.Category ?? "-")</span></td>
                                <td class="text-end fw-bold">@(item.CurrentStock ?? 0)</td>
                                <td class="text-end font-monospace">Rp @unitPrice.ToString("N0")</td>
                                <td class="text-end font-monospace fw-bold text-primary">Rp @itemValuation.ToString("N0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No master data recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
