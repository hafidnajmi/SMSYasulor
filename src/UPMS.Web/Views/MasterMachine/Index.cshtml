@model UPMS.Web.Models.ViewModels.MasterMachineViewModel
@{
    ViewData["Title"] = "Master Machine";
}

<style>
    .ems-search-input:focus,
    .ems-search-input:focus-visible {
        box-shadow: none !important;
        border-color: #ced4da !important;
        outline: none !important;
    }
</style>

<!-- Title Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81;">Master Machine Registry</h3>
        <p class="text-muted small mb-0">Production machinery master data, line assignments, and model specifications.</p>
    </div>
</div>


<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="ems-kpi-card ems-kpi-blue">
            <div class="ems-kpi-title"><i class="bi bi-building"></i> USED LINES</div>
            <div class="ems-kpi-value text-primary">@Model.TotalLines</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ems-kpi-card ems-kpi-cyan">
            <div class="ems-kpi-title"><i class="bi bi-cpu"></i> TOTAL MACHINES</div>
            <div class="ems-kpi-value" style="color:#0284C7;">@Model.TotalMachines</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ems-kpi-card ems-kpi-success">
            <div class="ems-kpi-title"><i class="bi bi-check-circle"></i> ACTIVE MACHINES</div>
            <div class="ems-kpi-value text-success">@Model.ActiveMachines</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ems-kpi-card ems-kpi-warning">
            <div class="ems-kpi-title"><i class="bi bi-exclamation-circle"></i> UNMAPPED MACHINES</div>
            <div class="ems-kpi-value text-warning">@Model.UnmappedMachines</div>
        </div>
    </div>
</div>

<!-- Filter & Search Panel -->
<div class="ems-filter-card mb-3">
    <div class="ems-filter-header">
        <span><i class="bi bi-funnel me-1 text-primary"></i>Filter &amp; Search Machinery</span>
    </div>
    <div class="p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
            <div class="col-md-4">
                <label class="form-label small fw-bold text-secondary mb-1">Search Line Code</label>
                <input type="text" name="lineSearch" value="@Model.LineSearch" class="form-control form-control-sm ems-search-input" placeholder="e.g. B11, J3, UP1..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Status Filter</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="all" selected="@(Model.StatusFilter == "all" ? "selected" : null)">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active" ? "selected" : null)">Active Only</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive" ? "selected" : null)">Inactive Only</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Search Query</label>
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm ems-search-input" placeholder="Machine code, name, model..." />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-ems-primary btn-sm flex-fill"><i class="bi bi-funnel"></i> Apply</button>
                <a href="@Url.Action("Index")" class="btn btn-ems-outline btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Main Content: Two-panel layout (Line list | Machine detail table) -->
<div class="row g-0" style="border: 1px solid var(--color-border); background: #fff; min-height: 720px;">

    <!-- LEFT: Production Line List -->
    <div class="col-md-3 d-flex flex-column" style="border-right: 1px solid var(--color-border); max-height: 720px;">
        <div style="padding: 8px 12px; background: #F8FAFC; border-bottom: 1px solid var(--color-border);">
            <span class="fw-bold" style="font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #475569;">
                <i class="bi bi-building me-1"></i>Production Lines
            </span>
        </div>
        <div id="left-lines-container" style="flex:1; overflow-y:auto;">
            @if (!Model.Lines.Any())
            {
                <div class="text-center text-muted py-5" style="font-size:12px;">
                    <i class="bi bi-building-slash d-block fs-3 mb-2 text-muted"></i>
                    No lines found.
                </div>
            }
            else
            {
                @foreach (var ln in Model.Lines)
                {
                    var isActive = ln.LineCode == Model.SelectedLine;

                    <a href="@Url.Action("Index", new { selectedLine=ln.LineCode, lineSearch=Model.LineSearch, statusFilter=Model.StatusFilter, search=Model.Search })"
                       class="line-sidebar-link"
                       style="display:block; text-decoration:none; padding:10px 12px;
                              border-bottom: 1px solid #F1F5F9;
                              background: @(isActive ? "#EFF6FF" : "#fff");
                              border-left: 3px solid @(isActive ? "#0F4C81" : "transparent");
                              transition: background .1s;"
                       onmouseover="if(!@(isActive ? "true" : "false"))this.style.background='#F8FAFC'"
                       onmouseout="if(!@(isActive ? "true" : "false"))this.style.background='#fff'">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold" style="color:@(isActive ? "#0F4C81" : "#111827"); font-size:13px;">@ln.LineCode</span>
                            <span class="badge @(ln.ActiveMachines > 0 ? "bg-success" : "bg-secondary") font-monospace" style="font-size:10px;">@ln.ActiveMachines active</span>
                        </div>
                        <div class="text-muted" style="font-size:11px;">Area: @ln.Area</div>
                        <div class="d-flex gap-3 mt-2" style="font-size:11px;">
                            <span><span class="fw-bold" style="color:#0F4C81;">@ln.TotalMachines</span> <span class="text-muted">Machines</span></span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>

    <!-- RIGHT: Machine Detail Panel -->
    <div id="right-detail-container" class="col-md-9 d-flex flex-column" data-selected-line="@Model.SelectedLine" style="min-height: 720px; transition: opacity 0.15s ease-in-out;">
        @if (Model.SelectedLine == null)
        {
            <div class="text-center text-muted py-5 px-4 my-auto">
                <i class="bi bi-cpu d-block fs-1 mb-3 text-muted" style="opacity:.3;"></i>
                <div class="fw-semibold mb-1" style="font-size:14px; color:#94A3B8;">Select a Production Line</div>
                <div style="font-size:12px; color:#CBD5E1;">Click on a line from the panel on the left to view its registered machines.</div>
            </div>
        }
        else
        {
            <!-- Detail sub-header -->
            <div style="padding: 10px 16px; background: #F8FAFC; border-bottom: 1px solid var(--color-border); display:flex; align-items:center; justify-content:space-between;">
                <div>
                    <span class="fw-bold" style="font-size:13px; color:#0F4C81;">
                        <i class="bi bi-building me-1"></i>Production Line @Model.SelectedLine
                    </span>
                    <span class="text-muted ms-2" style="font-size:12px;">Total: <strong>@Model.Machines.Count</strong> machines registered</span>
                </div>
                <button type="button" class="btn btn-ems-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addMachineModal">
                    <i class="bi bi-plus-lg me-1"></i>Add Machine
                </button>
            </div>

            <!-- Content Area (Flex column with mt-auto for footer) -->
            <div class="d-flex flex-column flex-fill justify-content-between">
                <div>
                    <!-- Table toolbar -->
                    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #F1F5F9; background:#FAFBFC;">
                        <span class="text-muted" style="font-size:11px;">
                            Showing <strong>@Model.Machines.Count</strong> machines for line <strong>@Model.SelectedLine</strong>
                        </span>
                        <form method="get" asp-action="Index" class="d-flex align-items-center detail-search-form" style="width: 310px;">
                            <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
                            <input type="hidden" name="lineSearch" value="@Model.LineSearch" />
                            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white text-muted border-end-0" style="font-size:12px;"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm border-start-0 ps-0 ems-search-input" placeholder="Search code, name, type..." style="font-size:12px;" />
                                @if (!string.IsNullOrEmpty(Model.Search))
                                {
                                    <a href="@Url.Action("Index", new { selectedLine=Model.SelectedLine, lineSearch=Model.LineSearch, statusFilter=Model.StatusFilter })" class="btn btn-sm btn-light border text-muted detail-ajax-link" title="Clear search" style="font-size:11px;"><i class="bi bi-x-lg"></i></a>
                                }
                                <button class="btn btn-ems-primary btn-sm px-2" type="submit" style="font-size:11px;">Search</button>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table-ems mb-0">
                            <thead>
                                <tr>
                                    <th style="width:36px;">NO</th>
                                    <th>MACHINE CODE</th>
                                    <th>MACHINE NAME</th>
                                    <th>LINE</th>
                                    <th>AREA</th>
                                    <th>TYPE</th>
                                    <th>MANUFACTURER</th>
                                    <th>MODEL / SERIES</th>
                                    <th class="text-center">STATUS</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Machines.Any())
                                {
                                    int rowNo = 1;
                                    foreach (var m in Model.Machines)
                                    {
                                        var isActive = (m.Status ?? "active").Equals("active", StringComparison.OrdinalIgnoreCase);
                                        <tr>
                                            <td class="col-mono text-muted text-center">@rowNo</td>
                                            <td class="text-nowrap"><span class="font-monospace fw-bold text-primary">@m.MachineCode</span></td>
                                            <td class="fw-semibold">@m.MachineName</td>
                                            <td class="text-nowrap"><span class="badge bg-light text-dark font-monospace border">@(m.Line ?? "-")</span></td>
                                            <td class="text-nowrap"><span class="small text-secondary">@(m.Area ?? "-")</span></td>
                                            <td class="text-nowrap"><span class="small text-secondary">@(m.MachineType ?? "-")</span></td>
                                            <td class="small text-muted text-nowrap">@(m.Manufacturer ?? "-")</td>
                                            <td class="small text-muted font-monospace text-nowrap">@(m.Model ?? "-")</td>
                                            <td class="text-center text-nowrap">
                                                @if (isActive)
                                                {
                                                    <span class="badge-ems-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-ems-danger">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-center text-nowrap">
                                                <div class="d-inline-flex align-items-center gap-1">
                                                    <button type="button" class="btn-ems-icon-action text-primary" title="Edit Machine"
                                                            data-bs-toggle="modal" data-bs-target="#editMachineModal"
                                                            data-id="@m.Id"
                                                            data-code="@m.MachineCode"
                                                            data-name="@m.MachineName"
                                                            data-line="@m.Line"
                                                            data-area="@m.Area"
                                                            data-type="@m.MachineType"
                                                            data-manufacturer="@m.Manufacturer"
                                                            data-model="@m.Model"
                                                            data-status="@m.Status">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>

                                                    <form asp-action="ToggleStatus" asp-route-id="@m.Id" asp-route-selectedLine="@Model.SelectedLine" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        @if (isActive)
                                                        {
                                                            <button type="submit" class="btn-ems-icon-action text-warning" title="Deactivate Machine">
                                                                <i class="bi bi-power"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="btn-ems-icon-action text-success" title="Reactivate Machine">
                                                                <i class="bi bi-play-circle"></i>
                                                            </button>
                                                        }
                                                    </form>

                                                    <form asp-action="Delete" asp-route-id="@m.Id" asp-route-selectedLine="@Model.SelectedLine" method="post" class="d-inline" onsubmit="return executeSecureDelete(this, 'mesin @m.MachineCode');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn-ems-icon-action text-danger" title="Delete Machine">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        rowNo++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="10" class="text-center text-muted py-4" style="font-size:12px;">
                                            <i class="bi bi-cpu d-block fs-4 mb-2 opacity-25"></i>
                                            No machine records found for line <strong>@Model.SelectedLine</strong>.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer Summary (Pinned at bottom) -->
                <div class="d-flex align-items-center justify-content-between px-3 py-2 mt-auto" style="border-top:1px solid var(--color-border); background:#FAFBFC;">
                    <span class="text-muted" style="font-size:11px;">Line @Model.SelectedLine Registry Summary</span>
                    <span class="text-muted" style="font-size:11px;">Showing <strong>@Model.Machines.Count</strong> items</span>
                </div>
            </div>
        }
    </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: Add Machine -->
<!-- ============================================================ -->
<div class="modal fade" id="addMachineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background:#0F4C81;">
                <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-cpu me-2"></i>Register New Machine</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Machine Code *</label>
                            <input type="text" name="MachineCode" id="add-machine-code" class="form-control form-control-sm font-monospace fw-bold text-primary" required placeholder="e.g. MAC-B19-BLOSUCSYS" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Machine Name *</label>
                            <input type="text" name="MachineName" id="add-machine-name" class="form-control form-control-sm" required placeholder="e.g. Blow & Suction System" oninput="autoGenerateAddMachineCode()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Production Line *</label>
                            <select name="Line" id="add-line" class="form-select form-select-sm" required onchange="autoSetArea(this.value, 'add-area'); autoGenerateAddMachineCode();">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Area</label>
                            <select name="Area" id="add-area" class="form-select form-select-sm" onchange="onAreaChange(this.value, 'add-line', null); autoGenerateAddMachineCode();">
                                <option value="UP1" selected>UP1</option>
                                <option value="UP2">UP2</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Machine Type</label>
                            <input type="text" name="MachineType" class="form-control form-control-sm" placeholder="e.g. Filler, Capper, Conveyor" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Status</label>
                            <select name="Status" class="form-select form-select-sm">
                                <option value="active" selected>Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Manufacturer</label>
                            <input type="text" name="Manufacturer" class="form-control form-control-sm" placeholder="e.g. Bosch, Krones, Tetra Pak" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Model / Series</label>
                            <input type="text" name="Model" class="form-control form-control-sm" placeholder="e.g. FX-2000 Series" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm px-4"><i class="bi bi-save me-1"></i> Save Machine</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: Edit Machine -->
<!-- ============================================================ -->
<div class="modal fade" id="editMachineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background:#0F4C81;">
                <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Machine Specification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="edit-id" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Machine Code *</label>
                            <input type="text" name="MachineCode" id="edit-code" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Machine Name *</label>
                            <input type="text" name="MachineName" id="edit-name" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Production Line *</label>
                            <select name="Line" id="edit-line" class="form-select form-select-sm" required onchange="autoSetArea(this.value, 'edit-area')">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Area</label>
                            <select name="Area" id="edit-area" class="form-select form-select-sm" onchange="onAreaChange(this.value, 'edit-line', null)">
                                <option value="UP1">UP1</option>
                                <option value="UP2">UP2</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Machine Type</label>
                            <input type="text" name="MachineType" id="edit-type" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Status</label>
                            <select name="Status" id="edit-status" class="form-select form-select-sm">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Manufacturer</label>
                            <input type="text" name="Manufacturer" id="edit-manufacturer" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Model / Series</label>
                            <input type="text" name="Model" id="edit-model" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm px-4"><i class="bi bi-save me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const allLinesData = [
            @foreach(var line in Model.Lines)
            {
                @: { code: "@line.LineCode", area: "@line.Area" },
            }
        ];

        function onAreaChange(areaVal, lineSelectId, keepCode) {
            var lineSelect = document.getElementById(lineSelectId);
            if (!lineSelect) return;
            areaVal = (areaVal || 'UP1').toUpperCase();

            lineSelect.innerHTML = '';

            var filtered = allLinesData.filter(function(item) {
                return item.area.toUpperCase() === areaVal;
            });

            if (filtered.length === 0) {
                var opt = document.createElement('option');
                opt.value = '';
                opt.textContent = '-- No lines available --';
                lineSelect.appendChild(opt);
                return;
            }

            filtered.forEach(function(item) {
                var opt = document.createElement('option');
                opt.value = item.code;
                opt.textContent = item.code;
                if (keepCode && item.code.toUpperCase() === keepCode.toUpperCase()) {
                    opt.selected = true;
                }
                lineSelect.appendChild(opt);
            });

            if (!lineSelect.value && lineSelect.options.length > 0) {
                lineSelect.selectedIndex = 0;
            }

            if (lineSelectId === 'add-line') {
                autoGenerateAddMachineCode();
            }
        }

        function autoSetArea(lineVal, areaSelectId) {
            var target = document.getElementById(areaSelectId);
            if (!target || !lineVal) return;
            lineVal = lineVal.trim().toUpperCase();
            var lineObj = allLinesData.find(function(i) { return i.code.toUpperCase() === lineVal; });
            var newArea = lineObj ? lineObj.area : 'UP1';
            target.value = newArea;
            onAreaChange(newArea, areaSelectId === 'add-area' ? 'add-line' : 'edit-line', lineVal);
        }

        function autoGenerateAddMachineCode() {
            var codeInput = document.getElementById('add-machine-code');
            var nameInput = document.getElementById('add-machine-name');
            var lineSelect = document.getElementById('add-line');

            if (!codeInput || !nameInput || !lineSelect) return;

            var lineVal = (lineSelect.value || 'LINE').trim().toUpperCase();
            var nameVal = (nameInput.value || '').trim();

            if (!nameVal) {
                codeInput.value = 'MAC-' + lineVal + '-';
                return;
            }

            var words = nameVal.split(/[^a-zA-Z0-9]+/).filter(Boolean);
            var slug = '';

            if (words.length === 1) {
                slug = words[0].substring(0, 10).toUpperCase();
            } else if (words.length > 1) {
                slug = words.map(function(w) {
                    return w.substring(0, 3).toUpperCase();
                }).join('');
                if (slug.length > 12) {
                    slug = slug.substring(0, 12);
                }
            }

            codeInput.value = 'MAC-' + lineVal + '-' + slug;
        }

        document.addEventListener('DOMContentLoaded', function () {
            var addArea = document.getElementById('add-area');
            if (addArea) {
                onAreaChange(addArea.value, 'add-line', '@Model.SelectedLine');
            }

            var addModalElem = document.getElementById('addMachineModal');
            if (addModalElem) {
                addModalElem.addEventListener('show.bs.modal', function () {
                    var detailContainer = document.getElementById('right-detail-container');
                    var selectedLine = (detailContainer ? detailContainer.getAttribute('data-selected-line') : '') || '@Model.SelectedLine';
                    
                    if (selectedLine) {
                        var lineObj = allLinesData.find(function(i) { return i.code.toUpperCase() === selectedLine.toUpperCase(); });
                        var lineArea = lineObj ? lineObj.area : 'UP1';
                        
                        var addArea = document.getElementById('add-area');
                        if (addArea) {
                            addArea.value = lineArea;
                        }
                        onAreaChange(lineArea, 'add-line', selectedLine);
                    } else {
                        var addArea = document.getElementById('add-area');
                        if (addArea) {
                            onAreaChange(addArea.value, 'add-line', null);
                        }
                    }

                    autoGenerateAddMachineCode();
                });
            }

            var editModal = document.getElementById('editMachineModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    document.getElementById('edit-id').value           = button.getAttribute('data-id') || '';
                    document.getElementById('edit-code').value         = button.getAttribute('data-code') || '';
                    document.getElementById('edit-name').value         = button.getAttribute('data-name') || '';
                    
                    var lineVal = button.getAttribute('data-line') || '';
                    var areaVal = button.getAttribute('data-area') || '';
                    if (!areaVal) {
                        var lineObj = allLinesData.find(function(i) { return i.code.toUpperCase() === lineVal.toUpperCase(); });
                        areaVal = lineObj ? lineObj.area : 'UP1';
                    }
                    var editAreaSelect = document.getElementById('edit-area');
                    editAreaSelect.value = areaVal;
                    onAreaChange(areaVal, 'edit-line', lineVal);

                    document.getElementById('edit-type').value         = button.getAttribute('data-type') || '';
                    document.getElementById('edit-manufacturer').value = button.getAttribute('data-manufacturer') || '';
                    document.getElementById('edit-model').value        = button.getAttribute('data-model') || '';
                    document.getElementById('edit-status').value       = (button.getAttribute('data-status') || 'active').toLowerCase();
                });
            }

            // Intercept clicks on links inside detail panel or sidebar links
            document.addEventListener('click', function (e) {
                var a = e.target.closest('.detail-ajax-link, .line-sidebar-link');
                if (a && a.href && !a.href.startsWith('javascript:')) {
                    e.preventDefault();
                    loadDetailAjax(a.href);
                }
            });

            // Intercept search form submit inside detail panel
            document.addEventListener('submit', function (e) {
                var form = e.target.closest('.detail-search-form');
                if (form) {
                    e.preventDefault();
                    var formData = new FormData(form);
                    var params = new URLSearchParams(formData);
                    var url = form.action + '?' + params.toString();
                    loadDetailAjax(url);
                }
            });
        });

        function loadDetailAjax(url) {
            var container = document.getElementById('right-detail-container');
            if (!container) {
                window.location.href = url;
                return;
            }
            
            container.style.opacity = '0.6';

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function(res) { return res.text(); })
                .then(function(html) {
                    var parser = new DOMParser();
                    var doc = parser.parseFromString(html, 'text/html');
                    
                    var newDetail = doc.getElementById('right-detail-container');
                    if (newDetail) {
                        container.innerHTML = newDetail.innerHTML;
                    }

                    var newLeft = doc.getElementById('left-lines-container');
                    var oldLeft = document.getElementById('left-lines-container');
                    if (newLeft && oldLeft) {
                        oldLeft.innerHTML = newLeft.innerHTML;
                    }

                    container.style.opacity = '1';
                    history.pushState(null, '', url);
                })
                .catch(function() {
                    container.style.opacity = '1';
                    window.location.href = url;
                });
        }
    </script>
}
