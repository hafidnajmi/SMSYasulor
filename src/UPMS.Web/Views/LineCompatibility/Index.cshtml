@model UPMS.Web.Models.ViewModels.LineCompatibilityViewModel
@{
    ViewData["Title"] = "Line Compatibility";
}

<style>
    .ems-search-input:focus,
    .ems-search-input:focus-visible {
        box-shadow: none !important;
        border-color: #ced4da !important;
        outline: none !important;
    }
</style>

<!-- Title Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81;">Line Compatibility</h3>
        <p class="text-muted small mb-0">Manage sparepart compatibility mapping for each production line.</p>
    </div>
</div>

<!-- KPI Cards -->
@{
    var totalLines    = Model.LinesHealth.Count;
    var totalMappings = Model.LinesHealth.Sum(l => l.CompatibleParts);
    var totalMachines = Model.LinesHealth.Sum(l => l.TotalMachines);
}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ems-kpi-card ems-kpi-blue">
            <div class="ems-kpi-title"><i class="bi bi-building"></i> PRODUCTION LINES</div>
            <div class="ems-kpi-value text-primary">@totalLines</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ems-kpi-card ems-kpi-success">
            <div class="ems-kpi-title"><i class="bi bi-diagram-3"></i> TOTAL MAPPINGS</div>
            <div class="ems-kpi-value text-success">@totalMappings</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ems-kpi-card ems-kpi-cyan">
            <div class="ems-kpi-title"><i class="bi bi-cpu"></i> TOTAL MACHINES</div>
            <div class="ems-kpi-value" style="color:#0284C7;">@totalMachines</div>
        </div>
    </div>
</div>

<!-- Filter & Search Panel -->
<div class="ems-filter-card mb-3">
    <div class="ems-filter-header">
        <span><i class="bi bi-funnel me-1 text-primary"></i>Filter &amp; Search Lines</span>
    </div>
    <div class="p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="subTab" value="line" />
            <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
            <div class="col-md-4">
                <label class="form-label small fw-bold text-secondary mb-1">Search Line Code</label>
                <input type="text" name="lineSearch" value="@Model.LineSearch" class="form-control form-control-sm" placeholder="e.g. B11, S6, UP1..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Sort By</label>
                <select name="lineSort" class="form-select form-select-sm">
                    <option value="line_code" selected="@(Model.LineSort == "line_code" ? "selected" : null)">Line Code (A-Z)</option>
                    <option value="parts"     selected="@(Model.LineSort == "parts"     ? "selected" : null)">Most Spareparts</option>
                    <option value="machines"  selected="@(Model.LineSort == "machines"  ? "selected" : null)">Most Machines</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-ems-primary btn-sm flex-fill"><i class="bi bi-funnel"></i> Apply</button>
                <a href="@Url.Action("Index", new { subTab = "line" })" class="btn btn-ems-outline btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
            <div class="col-md-3 text-end text-muted" style="font-size:12px; padding-bottom:4px;">
                <i class="bi bi-info-circle me-1"></i>@Model.LinesHealth.Count line(s) found
            </div>
        </form>
    </div>
</div>

<!-- Main Content: Two-panel layout (Line list | Detail) -->
<div class="row g-0" style="border: 1px solid var(--color-border); background: #fff; min-height: 720px;">

    <!-- LEFT: Production Line List -->
    <div class="col-md-3 d-flex flex-column" style="border-right: 1px solid var(--color-border); max-height: 720px;">
        <!-- Section header -->
        <div style="padding: 8px 12px; background: #F8FAFC; border-bottom: 1px solid var(--color-border);">
            <span class="fw-bold" style="font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #475569;">
                <i class="bi bi-building me-1"></i>Production Lines
            </span>
        </div>
        <div id="left-lines-container" style="flex:1; overflow-y:auto;">
            @if (!Model.LinesHealth.Any())
            {
                <div class="text-center text-muted py-5" style="font-size:12px;">
                    <i class="bi bi-building-slash d-block fs-3 mb-2 text-muted"></i>
                    No production lines found.
                </div>
            }
            else
            {
                @foreach (var ln in Model.LinesHealth)
                {
                    var isActive = ln.LineCode == Model.SelectedLine;

                    <a href="@Url.Action("Index", new { subTab="line", selectedLine=ln.LineCode, lineSearch=Model.LineSearch, lineSort=Model.LineSort, kpiTab=Model.KpiTab })"
                       class="line-sidebar-link"
                       style="display:block; text-decoration:none; padding:10px 12px;
                              border-bottom: 1px solid #F1F5F9;
                              background: @(isActive ? "#EFF6FF" : "#fff");
                              border-left: 3px solid @(isActive ? "#0F4C81" : "transparent");
                              transition: background .1s;"
                       onmouseover="if(!@(isActive ? "true" : "false"))this.style.background='#F8FAFC'"
                       onmouseout="if(!@(isActive ? "true" : "false"))this.style.background='#fff'">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold" style="color:@(isActive ? "#0F4C81" : "#111827"); font-size:13px;">@ln.LineCode</span>
                        </div>
                        <div class="text-muted" style="font-size:11px;">Area: @ln.Area</div>
                        <div class="d-flex gap-3 mt-2" style="font-size:11px;">
                            <span><span class="fw-bold" style="color:#0F4C81;">@ln.TotalMachines</span> <span class="text-muted">Mach</span></span>
                            <span><span class="fw-bold text-success">@ln.CompatibleParts</span> <span class="text-muted">Parts</span></span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>

    <!-- RIGHT: Detail Panel -->
    <div id="right-detail-container" class="col-md-9 d-flex flex-column" style="min-height: 720px; transition: opacity 0.15s ease-in-out;">
        @if (Model.SelectedLine == null)
        {
            <div class="text-center text-muted py-5 px-4 my-auto">
                <i class="bi bi-arrow-left-circle d-block fs-1 mb-3 text-muted" style="opacity:.3;"></i>
                <div class="fw-semibold mb-1" style="font-size:14px; color:#94A3B8;">Select a Production Line</div>
                <div style="font-size:12px; color:#CBD5E1;">Click on a line from the panel on the left to view its sparepart compatibility data.</div>
            </div>
        }
        else
        {
            var lnData = Model.SelectedLineData;
            var isPartsActive = Model.KpiTab != "machines";

            <!-- Detail sub-header -->
            <div style="padding: 10px 16px; background: #F8FAFC; border-bottom: 1px solid var(--color-border); display:flex; align-items:center; justify-content:space-between;">
                <div>
                    <span class="fw-bold" style="font-size:13px; color:#0F4C81;">
                        <i class="bi bi-building me-1"></i>@Model.SelectedLine
                    </span>
                    <span class="text-muted ms-2" style="font-size:12px;">Area: @(lnData?.Area ?? "-")</span>
                    <span class="text-muted ms-2" style="font-size:12px;">Last Updated: @(lnData?.LastActivity.HasValue == true && lnData.LastActivity.Value > DateTime.MinValue ? lnData.LastActivity.Value.ToString("dd MMM yyyy") : "N/A")</span>
                </div>
            </div>

            <!-- Sub-KPI selector tabs (Instant JS Switching) -->
            <div style="display:flex; border-bottom: 1px solid var(--color-border);">
                <button type="button" id="tab-btn-parts" onclick="switchDetailTab('parts')"
                   style="flex:1; text-align:center; padding:10px 8px; font-size:12px; cursor:pointer; font-weight:@(isPartsActive ? "700" : "400");
                          color:@(isPartsActive ? "#0F4C81" : "#6B7280");
                          border:none; border-bottom: 2px solid @(isPartsActive ? "#0F4C81" : "transparent");
                          background: @(isPartsActive ? "#fff" : "#F8FAFC"); transition: all .1s;">
                    <i class="bi bi-tools me-1"></i>@(lnData?.CompatibleParts ?? 0) Spareparts
                </button>
                <button type="button" id="tab-btn-machines" onclick="switchDetailTab('machines')"
                   style="flex:1; text-align:center; padding:10px 8px; font-size:12px; cursor:pointer; font-weight:@(!isPartsActive ? "700" : "400");
                          color:@(!isPartsActive ? "#0F4C81" : "#6B7280");
                          border:none; border-bottom: 2px solid @(!isPartsActive ? "#0F4C81" : "transparent");
                          background: @(!isPartsActive ? "#fff" : "#F8FAFC"); transition: all .1s;">
                    <i class="bi bi-cpu me-1"></i>@(lnData?.TotalMachines ?? 0) Machines
                </button>
            </div>

            <!-- Content Area -->
            <div class="d-flex flex-column flex-fill justify-content-between">

                @* ── PARTS TABLE PANEL ── *@
                <div id="tab-parts-panel" class="d-flex flex-column flex-fill justify-content-between" style="display: @(isPartsActive ? "flex" : "none") !important;">
                    <div>
                        <!-- Table toolbar -->
                        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #F1F5F9; background:#FAFBFC;">
                            <span class="text-muted" style="font-size:11px;">
                                Showing <strong>@Model.CompatibleParts.Count</strong> of <strong>@Model.PartsTotalCount</strong> spareparts for line <strong>@Model.SelectedLine</strong>
                            </span>
                            <form method="get" asp-action="Index" class="d-flex align-items-center detail-search-form" style="width: 310px;">
                                <input type="hidden" name="subTab" value="line" />
                                <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
                                <input type="hidden" name="kpiTab" value="parts" />
                                <input type="hidden" name="lineSearch" value="@Model.LineSearch" />
                                <input type="hidden" name="lineSort" value="@Model.LineSort" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0" style="font-size:12px;"><i class="bi bi-search"></i></span>
                                    <input type="text" name="detailSearch" value="@Model.DetailSearch" class="form-control form-control-sm border-start-0 ps-0 ems-search-input" placeholder="Search Part #, Item, Machine..." style="font-size:12px;" />
                                    @if (!string.IsNullOrEmpty(Model.DetailSearch))
                                    {
                                        <a href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="parts", lineSearch=Model.LineSearch, lineSort=Model.LineSort })" class="btn btn-sm btn-light border text-muted detail-ajax-link" title="Clear search" style="font-size:11px;"><i class="bi bi-x-lg"></i></a>
                                    }
                                    <button class="btn btn-ems-primary btn-sm px-2" type="submit" style="font-size:11px;">Search</button>
                                </div>
                            </form>
                        </div>
                        <div class="table-responsive">
                            <table class="table-ems mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:36px;">NO</th>
                                        <th>PART NUMBER</th>
                                        <th>ITEM NAME</th>
                                        <th>MACHINE</th>
                                        <th>BIN</th>
                                        <th>CATEGORY</th>
                                        <th class="text-end">LEAD TIME</th>
                                        <th class="text-end">STOCK</th>
                                        <th class="text-end">UNIT PRICE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CompatibleParts.Any())
                                    {
                                        int rowNo = (Model.PartsPage - 1) * 10 + 1;
                                        foreach (var p in Model.CompatibleParts)
                                        {
                                            <tr>
                                                <td class="col-mono text-muted text-center">@rowNo</td>
                                                <td class="text-nowrap"><span class="font-monospace fw-bold text-primary">@p.Id</span></td>
                                                <td style="min-width:160px; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@p.Item"><span class="fw-bold">@p.Item</span></td>
                                                <td style="max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@p.Machine"><span class="small text-secondary">@p.Machine</span></td>
                                                <td class="text-nowrap"><span class="badge bg-light text-dark border font-monospace">@p.Bin</span></td>
                                                <td class="text-nowrap"><span class="small text-secondary">@p.Category</span></td>
                                                <td class="text-end font-monospace text-nowrap">@(p.LeadTime > 0 ? $"{p.LeadTime:N0} mth" : "—")</td>
                                                <td class="text-end font-monospace text-nowrap">@p.CurrentStock pcs</td>
                                                <td class="text-end font-monospace fw-semibold text-nowrap">Rp @p.CurrentPrice.ToString("N0")</td>
                                            </tr>
                                            rowNo++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4" style="font-size:12px;">
                                                <i class="bi bi-tools d-block fs-4 mb-2 opacity-25"></i>
                                                No spareparts registered for line <strong>@Model.SelectedLine</strong>.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* Pagination Footer *@
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 mt-auto" style="border-top:1px solid var(--color-border); background:#FAFBFC;">
                        <span class="text-muted" style="font-size:11px;">Page @Model.PartsPage of @Model.PartsTotalPages</span>
                        <div class="d-flex gap-1">
                            @if (Model.PartsPage > 1)
                            {
                                <a class="btn btn-ems-outline btn-sm detail-ajax-link" href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="parts", partsPage=Model.PartsPage-1, lineSearch=Model.LineSearch, lineSort=Model.LineSort })">‹ Prev</a>
                            }
                            else
                            {
                                <button class="btn btn-ems-outline btn-sm" disabled>‹ Prev</button>
                            }
                            @if (Model.PartsPage < Model.PartsTotalPages)
                            {
                                <a class="btn btn-ems-outline btn-sm detail-ajax-link" href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="parts", partsPage=Model.PartsPage+1, lineSearch=Model.LineSearch, lineSort=Model.LineSort })">Next ›</a>
                            }
                            else
                            {
                                <button class="btn btn-ems-outline btn-sm" disabled>Next ›</button>
                            }
                        </div>
                    </div>
                </div>

                @* ── MACHINES TABLE PANEL ── *@
                <div id="tab-machines-panel" class="d-flex flex-column flex-fill justify-content-between" style="display: @(!isPartsActive ? "flex" : "none") !important;">
                    <div>
                        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #F1F5F9; background:#FAFBFC;">
                            <span class="text-muted" style="font-size:11px;">
                                <strong>@Model.MachinesInLine.Count</strong> machines registered in line <strong>@Model.SelectedLine</strong>
                            </span>
                            <form method="get" asp-action="Index" class="d-flex align-items-center detail-search-form" style="width: 310px;">
                                <input type="hidden" name="subTab" value="line" />
                                <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
                                <input type="hidden" name="kpiTab" value="machines" />
                                <input type="hidden" name="lineSearch" value="@Model.LineSearch" />
                                <input type="hidden" name="lineSort" value="@Model.LineSort" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0" style="font-size:12px;"><i class="bi bi-search"></i></span>
                                    <input type="text" name="detailSearch" value="@Model.DetailSearch" class="form-control form-control-sm border-start-0 ps-0 ems-search-input" placeholder="Search machine code/name..." style="font-size:12px;" />
                                    @if (!string.IsNullOrEmpty(Model.DetailSearch))
                                    {
                                        <a href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="machines", lineSearch=Model.LineSearch, lineSort=Model.LineSort })" class="btn btn-sm btn-light border text-muted detail-ajax-link" title="Clear search" style="font-size:11px;"><i class="bi bi-x-lg"></i></a>
                                    }
                                    <button class="btn btn-ems-primary btn-sm px-2" type="submit" style="font-size:11px;">Search</button>
                                </div>
                            </form>
                        </div>
                        <div class="table-responsive">
                            <table class="table-ems mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:36px;">NO</th>
                                        <th>MACHINE CODE</th>
                                        <th>MACHINE NAME</th>
                                        <th>LINE</th>
                                        <th>AREA</th>
                                        <th>TYPE</th>
                                        <th>MANUFACTURER</th>
                                        <th>MODEL / SERIES</th>
                                        <th class="text-center">STATUS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.MachinesInLine.Any())
                                    {
                                        int rowNo = 1;
                                        foreach (var m in Model.MachinesInLine)
                                        {
                                            var isActive = (m.Status ?? "active").Equals("active", StringComparison.OrdinalIgnoreCase);
                                            <tr>
                                                <td class="col-mono text-muted text-center">@rowNo</td>
                                                <td class="text-nowrap"><span class="font-monospace fw-bold text-primary">@m.MachineCode</span></td>
                                                <td class="fw-bold">@m.MachineName</td>
                                                <td class="text-nowrap"><span class="badge bg-light text-dark font-monospace border">@(m.Line ?? "-")</span></td>
                                                <td class="text-nowrap"><span class="small text-secondary">@(m.Area ?? "-")</span></td>
                                                <td class="text-nowrap"><span class="small text-secondary">@(m.MachineType ?? "-")</span></td>
                                                <td class="small text-muted text-nowrap">@(m.Manufacturer ?? "-")</td>
                                                <td class="small text-muted font-monospace text-nowrap">@(m.Model ?? "-")</td>
                                                <td class="text-center text-nowrap">
                                                    @if (isActive)
                                                    {
                                                        <span class="badge-ems-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-ems-danger">Inactive</span>
                                                    }
                                                </td>
                                            </tr>
                                            rowNo++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4" style="font-size:12px;">
                                                <i class="bi bi-cpu d-block fs-4 mb-2 opacity-25"></i>
                                                No machines registered for line <strong>@Model.SelectedLine</strong>.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div><!-- /Content Area -->
        }
    </div><!-- /RIGHT -->

</div><!-- /Main Content -->

</div><!-- /Main Content -->

<!-- Add Sparepart Mapping Modal -->
<div class="modal fade" id="addMappingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:0; border: 1px solid var(--color-border);">
            <div class="modal-header py-2 px-3" style="background:#0F4C81; color:#fff; border-radius:0;">
                <h6 class="modal-title mb-0 fw-bold" style="font-size:13px;">
                    <i class="bi bi-plus-circle me-2"></i>Register Line Compatibility
                </h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddLineMapping" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Production Line</label>
                        @if (Model.SelectedLine != null)
                        {
                            <input type="text" class="form-control form-control-sm font-monospace" value="@Model.SelectedLine" readonly style="background:#F8FAFC;" />
                            <input type="hidden" name="lineName" value="@Model.SelectedLine" />
                        }
                        else
                        {
                            <select name="lineName" class="form-select form-select-sm" required>
                                <option value="">[Select Line]</option>
                                @foreach (var ln in Model.LinesHealth)
                                {
                                    <option value="@ln.LineCode">@ln.LineCode — Area @ln.Area</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="mb-1">
                        <label class="form-label small fw-bold text-secondary mb-1">Sparepart Part Number <span class="text-danger">*</span></label>
                        <input type="text" name="sparepartId" class="form-control form-control-sm font-monospace" placeholder="e.g. UPF-10001" required />
                        <div class="text-muted mt-1" style="font-size:11px;">Enter the exact Part Number / Sparepart ID.</div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3" style="background:#F8FAFC;">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Register</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchDetailTab(tab) {
            var pPanel = document.getElementById('tab-parts-panel');
            var mPanel = document.getElementById('tab-machines-panel');
            var pBtn   = document.getElementById('tab-btn-parts');
            var mBtn   = document.getElementById('tab-btn-machines');

            if (!pPanel || !mPanel) return;

            if (tab === 'parts') {
                pPanel.style.setProperty('display', 'flex', 'important');
                mPanel.style.setProperty('display', 'none', 'important');
                
                if (pBtn) {
                    pBtn.style.fontWeight = '700';
                    pBtn.style.color = '#0F4C81';
                    pBtn.style.borderBottom = '2px solid #0F4C81';
                    pBtn.style.background = '#fff';
                }
                if (mBtn) {
                    mBtn.style.fontWeight = '400';
                    mBtn.style.color = '#6B7280';
                    mBtn.style.borderBottom = '2px solid transparent';
                    mBtn.style.background = '#F8FAFC';
                }
            } else {
                pPanel.style.setProperty('display', 'none', 'important');
                mPanel.style.setProperty('display', 'flex', 'important');

                if (mBtn) {
                    mBtn.style.fontWeight = '700';
                    mBtn.style.color = '#0F4C81';
                    mBtn.style.borderBottom = '2px solid #0F4C81';
                    mBtn.style.background = '#fff';
                }
                if (pBtn) {
                    pBtn.style.fontWeight = '400';
                    pBtn.style.color = '#6B7280';
                    pBtn.style.borderBottom = '2px solid transparent';
                    pBtn.style.background = '#F8FAFC';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Intercept clicks on links inside detail panel or sidebar links
            document.addEventListener('click', function (e) {
                var a = e.target.closest('.detail-ajax-link, .line-sidebar-link');
                if (a && a.href && !a.href.startsWith('javascript:')) {
                    e.preventDefault();
                    loadDetailAjax(a.href);
                }
            });

            // Intercept search form submit inside detail panel
            document.addEventListener('submit', function (e) {
                var form = e.target.closest('.detail-search-form');
                if (form) {
                    e.preventDefault();
                    var formData = new FormData(form);
                    var params = new URLSearchParams(formData);
                    var url = form.action + '?' + params.toString();
                    loadDetailAjax(url);
                }
            });
        });

        function loadDetailAjax(url) {
            var container = document.getElementById('right-detail-container');
            if (!container) {
                window.location.href = url;
                return;
            }
            
            container.style.opacity = '0.6';

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function(res) { return res.text(); })
                .then(function(html) {
                    var parser = new DOMParser();
                    var doc = parser.parseFromString(html, 'text/html');
                    
                    var newDetail = doc.getElementById('right-detail-container');
                    if (newDetail) {
                        container.innerHTML = newDetail.innerHTML;
                    }

                    var newLeft = doc.getElementById('left-lines-container');
                    var oldLeft = document.getElementById('left-lines-container');
                    if (newLeft && oldLeft) {
                        oldLeft.innerHTML = newLeft.innerHTML;
                    }

                    container.style.opacity = '1';
                    history.pushState(null, '', url);
                })
                .catch(function() {
                    container.style.opacity = '1';
                    window.location.href = url;
                });
        }
    </script>
}
