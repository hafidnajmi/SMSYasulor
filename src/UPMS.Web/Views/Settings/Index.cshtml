@model IEnumerable<UPMS.Web.Models.Entities.User>

@{
    ViewData["Title"] = "Settings & User Management";
}

<!-- Title Header & Actions -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81;">Settings &amp; User Management</h3>
        <p class="text-muted small mb-0">Pengelolaan pengguna sistem, peranan (role), hak akses menu, dan syarat approval transaksi.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-ems-primary btn-sm" onclick="openAddUserModal()">
            <i class="bi bi-person-plus me-1"></i>Tambah User Baru
        </button>
    </div>
</div>

<!-- 1. User List Card -->
<div class="card shadow-sm border-0 mb-4" style="border-radius:0;">
    <div class="card-header bg-white py-2 px-3 fw-bold small border-bottom" style="color: #0F4C81;">
        <i class="bi bi-people-fill me-2"></i>Daftar Pengguna Sistem (@Model.Count() User)
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table-ems mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th>USERNAME</th>
                        <th>NAMA LENGKAP</th>
                        <th>ROLE</th>
                        <th class="text-center">STATUS</th>
                        <th>LAST LOGIN</th>
                        <th class="text-center" style="width: 140px;">AKSI</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            bool isRootAdmin = string.Equals(u.Username, "admin", StringComparison.OrdinalIgnoreCase);
                            string roleBadgeClass = u.Role?.ToLower() switch
                            {
                                "admin" => "bg-primary text-white",
                                "supervisor" => "bg-purple text-white",
                                "manager" => "bg-info text-dark",
                                "technician" => "bg-teal text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr class="table-row-hover">
                                <td class="text-secondary small font-monospace">@u.Id</td>
                                <td class="fw-bold text-primary font-monospace">
                                    @u.Username
                                    @if (isRootAdmin)
                                    {
                                        <span class="badge bg-warning text-dark border ms-1" style="font-size: 9px;">ROOT</span>
                                    }
                                </td>
                                <td class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(u.FullName) ? "-" : u.FullName)</td>
                                <td>
                                    <span class="badge @roleBadgeClass px-2 py-1" style="font-size: 10px; text-transform: uppercase;">
                                        @u.Role
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 10px;">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: 10px;">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted font-monospace">
                                    @(u.LastLogin.HasValue ? u.LastLogin.Value.ToString("dd MMM yyyy HH:mm") : "Never")
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 btn-edit-user"
                                                style="font-size:11px; height:24px; line-height:22px;"
                                                data-user='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(u))'
                                                onclick="handleEditUserClick(this)"
                                                title="Edit User & Permissions">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>

                                        @if (!isRootAdmin)
                                        {
                                            <form asp-action="ToggleStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") py-0 px-2" style="font-size:11px; height:24px; line-height:22px;"
                                                        title="@(u.IsActive ? "Deactivate User" : "Activate User")">
                                                    <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                                </button>
                                            </form>

                                            <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return executeSecureDelete(this, 'user @u.Username');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:11px; height:24px; line-height:22px;" title="Delete User">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                Belum ada data pengguna tersimpan.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

