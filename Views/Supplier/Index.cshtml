@model List<UPMS.Web.Models.Entities.Supplier>

@{
    ViewData["Title"] = "Master Supplier";
    string search = ViewBag.Search as string ?? "";
    int totalCount = ViewBag.TotalCount as int? ?? 0;
}

<style>
    .table-ems tbody tr {
        transition: background-color 0.12s ease-in-out;
    }
    .table-ems tbody tr:hover {
        background-color: #EFF6FF !important;
    }
</style>

<!-- Title Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81;">Master Supplier</h3>
        <p class="text-muted small mb-0">Manage registered vendors, suppliers, contact details, and procurement partners.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-ems-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
            <i class="bi bi-plus-lg me-1"></i>Add Supplier
        </button>
    </div>
</div>

<!-- Header KPI Card -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ems-kpi-card ems-kpi-blue p-3">
            <div class="ems-kpi-title text-primary d-flex justify-content-between align-items-center">
                <span><i class="bi bi-truck me-1"></i> TOTAL REGISTERED SUPPLIERS</span>
            </div>
            <div class="ems-kpi-value text-primary mt-2">
                @totalCount.ToString("N0")
            </div>
            <div class="text-muted small mt-1">Active vendor partners in database</div>
        </div>
    </div>
</div>

<!-- Filter Panel -->
<div class="ems-filter-card mb-4">
    <div class="ems-filter-header">
        <span><i class="bi bi-funnel me-1 text-primary"></i>Search &amp; Filter Suppliers</span>
        <span class="text-muted fw-normal small">@totalCount item(s) found</span>
    </div>
    <div class="p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end" id="filterForm">
            <div class="col-md-10">
                <label class="form-label small fw-bold text-secondary mb-1">Search Query</label>
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Supplier Name, PIC, Email, Phone, Address..." />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-ems-primary btn-sm text-nowrap w-100"><i class="bi bi-search"></i> Search</button>
                <a href="/Supplier" class="btn btn-ems-outline btn-sm text-nowrap" title="Reset Search"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table Card -->
<div class="card shadow-sm border-0 mb-4" style="border-radius:0;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table-ems mb-0">
                <thead>
                    <tr>
                        <th style="width: 50px;" class="text-center">NO</th>
                        <th>SUPPLIER NAME</th>
                        <th>CONTACT PERSON (PIC)</th>
                        <th>EMAIL</th>
                        <th>PHONE</th>
                        <th>ADDRESS</th>
                        <th class="text-center" style="width: 100px;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int page = ViewBag.Page as int? ?? 1;
                        int pageSize = ViewBag.PageSize as int? ?? 50;
                        int no = ((Math.Max(1, page) - 1) * pageSize) + 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-monospace text-muted" style="background-color:#F8FAFC; border-right:1px solid #E2E8F0;">@(no++)</td>
                                <td class="align-middle fw-semibold text-primary">@item.Name</td>
                                <td class="align-middle text-dark">
                                    @(string.IsNullOrWhiteSpace(item.Pic) ? "-" : item.Pic)
                                </td>
                                <td class="align-middle text-muted">
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="text-decoration-none"><i class="bi bi-envelope me-1"></i>@item.Email</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="align-middle text-muted font-monospace">
                                    @(string.IsNullOrWhiteSpace(item.Phone) ? "-" : item.Phone)
                                </td>
                                <td class="align-middle text-muted small" style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(item.Address) ? "-" : item.Address)
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <button type="button" class="btn-ems-icon-action text-primary" onclick="openEditSupplierModal(@item.Id)" title="Edit Supplier">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return executeSecureDelete(this, 'supplier @item.Name');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="search" value="@search" />
                                            <button type="submit" class="btn-ems-icon-action text-danger" title="Delete Supplier">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-truck d-block fs-3 mb-2 opacity-25"></i>
                                No suppliers found. Click "+ Add Supplier" to register a new vendor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination Footer -->
    @{
        int curPage = ViewBag.Page as int? ?? 1;
        int curPageSize = ViewBag.PageSize as int? ?? 50;
        int maxPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)curPageSize));
        int startRow = totalCount > 0 ? ((curPage - 1) * curPageSize) + 1 : 0;
        int endRow = Math.Min(curPage * curPageSize, totalCount);
    }
    <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
        <div class="small text-muted font-monospace">
            Showing <strong>@startRow</strong> to <strong>@endRow</strong> of <strong>@totalCount.ToString("N0")</strong> suppliers
            @if (!string.IsNullOrEmpty(search))
            {
                <span class="badge bg-warning-subtle text-dark border ms-1">Filtered</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <form method="get" class="d-inline-block me-2">
                <input type="hidden" name="search" value="@search" />
                <input type="hidden" name="page" value="1" />
                <select name="pageSize" onchange="this.form.submit()" class="form-select form-select-sm font-monospace" style="width: auto;">
                    <option value="50" selected="@(curPageSize == 50 ? "selected" : null)">50 per page</option>
                    <option value="100" selected="@(curPageSize == 100 ? "selected" : null)">100 per page</option>
                    <option value="300" selected="@(curPageSize >= 300 ? "selected" : null)">Show All (@totalCount.ToString("N0"))</option>
                </select>
            </form>

            @if (curPage > 1)
            {
                <a href="/Supplier?page=@(curPage - 1)&pageSize=@curPageSize&search=@search"
                   class="btn btn-sm btn-outline-secondary py-1 px-3">
                    <i class="bi bi-chevron-left me-1"></i>Prev
                </a>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-3" disabled><i class="bi bi-chevron-left me-1"></i>Prev</button>
            }

            <span class="badge bg-primary px-3 py-2 font-monospace">Page @curPage of @maxPages</span>

            @if (curPage < maxPages)
            {
                <a href="/Supplier?page=@(curPage + 1)&pageSize=@curPageSize&search=@search"
                   class="btn btn-sm btn-outline-secondary py-1 px-3">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-3" disabled>Next<i class="bi bi-chevron-right ms-1"></i></button>
            }
        </div>
    </div>
</div>

<!-- 1. Add Supplier Modal -->
<div class="modal fade" id="addSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:0; border: 1px solid var(--color-border);">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="search" value="@search" />
                <div class="modal-header py-2 px-3" style="background:#0F4C81; color:#fff; border-radius:0;">
                    <h6 class="modal-title fw-normal mb-0" style="font-size:13px;"><i class="bi bi-plus-circle me-2"></i>Add New Supplier</h6>
                    <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-secondary mb-1">Supplier Name <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control form-control-sm" placeholder="e.g. PT. Global Teknik Indonesia" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Contact Person (PIC)</label>
                            <input type="text" name="Pic" class="form-control form-control-sm" placeholder="e.g. Budi Santoso" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">Phone / WhatsApp</label>
                            <input type="text" name="Phone" class="form-control form-control-sm" placeholder="e.g. 0812-3456-7890" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-secondary mb-1">Email Address</label>
                            <input type="email" name="Email" class="form-control form-control-sm" placeholder="e.g. sales@globalteknik.com" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-secondary mb-1">Address / Office Location</label>
                            <textarea name="Address" class="form-control form-control-sm" rows="2" placeholder="e.g. Kawasan Industri MM2100 Blok C-5, Cikarang"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Save Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. Edit Supplier Modal -->
<div class="modal fade" id="editSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:0; border: 1px solid var(--color-border);">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editSupplierId" />
                <input type="hidden" name="search" value="@search" />
                <div class="modal-header py-2 px-3" style="background:#0F4C81; color:#fff; border-radius:0;">
                    <h6 class="modal-title fw-normal mb-0" style="font-size:13px;"><i class="bi bi-pencil-square me-2"></i>Edit Supplier</h6>
                    <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div id="editSupplierSpinner" class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2 small text-muted">Loading supplier data...</span>
                    </div>
                    <div id="editSupplierFormBody" style="display:none;">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-secondary mb-1">Supplier Name <span class="text-danger">*</span></label>
                                <input type="text" name="Name" id="editSupplierName" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-1">Contact Person (PIC)</label>
                                <input type="text" name="Pic" id="editSupplierPic" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-1">Phone / WhatsApp</label>
                                <input type="text" name="Phone" id="editSupplierPhone" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-secondary mb-1">Email Address</label>
                                <input type="email" name="Email" id="editSupplierEmail" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-secondary mb-1">Address / Office Location</label>
                                <textarea name="Address" id="editSupplierAddress" class="form-control form-control-sm" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light">
                    <button type="button" class="btn btn-ems-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Update Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openEditSupplierModal(id) {
            const modalElem = document.getElementById('editSupplierModal');
            const bsModal = new bootstrap.Modal(modalElem);

            document.getElementById('editSupplierSpinner').style.display = 'block';
            document.getElementById('editSupplierFormBody').style.display = 'none';
            bsModal.show();

            try {
                const response = await fetch(`/Supplier/DetailsJson?id=${id}`);
                if (!response.ok) throw new Error('Supplier not found');
                const supplier = await response.json();

                document.getElementById('editSupplierId').value = supplier.id;
                document.getElementById('editSupplierName').value = supplier.name || '';
                document.getElementById('editSupplierPic').value = supplier.pic || '';
                document.getElementById('editSupplierPhone').value = supplier.phone || '';
                document.getElementById('editSupplierEmail').value = supplier.email || '';
                document.getElementById('editSupplierAddress').value = supplier.address || '';

                document.getElementById('editSupplierSpinner').style.display = 'none';
                document.getElementById('editSupplierFormBody').style.display = 'block';
            } catch (err) {
                document.getElementById('editSupplierSpinner').innerHTML = `<div class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>Failed to load supplier: ${err.message}</div>`;
            }
        }
    </script>
}
