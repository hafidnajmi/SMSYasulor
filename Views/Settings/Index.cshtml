<!-- 2B. Pengaturan Hak Akses Technician Card -->
@{
    var techUserEntity = ViewBag.TechUser as UPMS.Web.Models.Entities.User;
}
<div class="ms-card mb-4">
    <div class="ms-card-header d-flex justify-content-between align-items-center">
        <span>Pengaturan Akses Menu "Login as Technician" (Field Operator Scope)</span>
        <span class="text-secondary font-monospace" style="font-size: 11px;">Account: technician</span>
    </div>
    <div class="p-3">
        <form asp-action="SaveTechnicianPermissions" method="post">
            @Html.AntiForgeryToken()
            <p class="text-secondary small mb-3">
                Tentukan scope dan hak akses modul yang dapat diakses oleh user saat menggunakan fitur <strong>Login as Technician</strong>:
            </p>

            <div class="row g-3 mb-4">
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" name="CanBarangKeluar" value="1" id="techBk" @(techUserEntity?.CanBarangKeluar == 1 ? "checked" : "") />
                        <label class="form-check-label text-dark small fw-semibold text-nowrap" for="techBk">Barang Keluar</label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" name="CanBarangMasuk" value="1" id="techBm" @(techUserEntity?.CanBarangMasuk == 1 ? "checked" : "") />
                        <label class="form-check-label text-dark small fw-semibold text-nowrap" for="techBm">Barang Masuk</label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" name="CanMasterData" value="1" id="techMd" @(techUserEntity?.CanMasterData == 1 ? "checked" : "") />
                        <label class="form-check-label text-dark small fw-semibold text-nowrap" for="techMd">Spareparts Catalog</label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" name="CanRiwayat" value="1" id="techRw" @(techUserEntity?.CanRiwayat == 1 ? "checked" : "") />
                        <label class="form-check-label text-dark small fw-semibold text-nowrap" for="techRw">Transaction Logs</label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" name="CanManagePm" value="1" id="techPm" @(techUserEntity?.CanManagePm == 1 ? "checked" : "") />
                        <label class="form-check-label text-dark small fw-semibold text-nowrap" for="techPm">Manage PM (View)</label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
