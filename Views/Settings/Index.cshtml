<!-- Modal: RBAC User & Permission Drawer -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius:4px; border: 1px solid #CBD5E1;">
            <div class="modal-header py-2 px-3 bg-dark text-white" style="border-radius:0;">
                <h6 class="modal-title fw-semibold mb-0" style="font-size:13px;" id="userModalTitle">
                    Manage User Access &amp; Scope Assignments
                </h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <form id="userForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="userIdInput" value="0" />

                <div class="modal-body p-3 bg-light" style="max-height: 78vh; overflow-y: auto;">
                    <!-- User Info Section -->
                    <div class="bg-white p-3 border mb-3">
                        <div class="fw-semibold small text-dark mb-2 border-bottom pb-1">
                            Identity &amp; Role Assignment
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary mb-1">Username</label>
                                <input type="text" name="Username" id="usernameInput" class="form-control form-control-sm font-monospace" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary mb-1">Nama Lengkap</label>
                                <input type="text" name="FullName" id="fullNameInput" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary mb-1">Password</label>
                                <input type="password" name="rawPassword" id="passwordInput" class="form-control form-control-sm" placeholder="Password" />
                                <span class="form-text text-muted" id="passwordHelp" style="font-size:11px; display:none;">Biarkan kosong jika tidak mengubah password.</span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary mb-1">Role Preset</label>
                                <select name="Role" id="roleSelect" class="form-select form-select-sm" onchange="onRoleSelectChange(this.value, true)">
                                    <option value="admin">Global Administrator (Full Access All 12 Scopes)</option>
                                    <option value="manager">Procurement Contributor (Catalog, Stock, Cost Intel, Supplier)</option>
                                    <option value="supervisor">Operations Contributor (PM Maint, Line Compatibility, Stock)</option>
                                    <option value="technician">Field Operator (PM Maintenance, Barang Masuk/Keluar)</option>
                                    <option value="user" selected>Reader / Viewer (Read-Only Catalog &amp; Transactions)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Admin Lock Banner -->
                    <div id="adminLockBanner" class="alert alert-secondary py-2 px-3 mb-3 border font-monospace small" style="border-radius:0; display:none;">
                        Peranan <strong>Global Administrator</strong> otomatis mengaktifkan seluruh 12 scope modul tanpa batasan.
                    </div>

                    <!-- Scope Matrix -->
                    <div class="bg-white p-3 border">
                        <div class="fw-semibold small text-dark mb-2 border-bottom pb-1">
                            Scope Matrix &amp; Permission Switches
                        </div>

                        <div class="row g-3">
                            <!-- Scope Block 1: Master Data & Catalog -->
                            <div class="col-md-6">
                                <div class="p-3 border bg-light h-100">
                                    <div class="fw-semibold text-dark mb-2" style="font-size:12px;">Scope 1: Master Data &amp; Catalog</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanMasterData" value="1" id="cbMaster">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbMaster">Spareparts Catalog</label>
                                        <div class="text-muted" style="font-size:10.5px;">Akses katalog barang, stok, dan safety stock.</div>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanLineMapping" value="1" id="cbLineMap">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbLineMap">Line Compatibility</label>
                                        <div class="text-muted" style="font-size:10.5px;">Pemetaan kompatibilitas sparepart per line.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Scope Block 2: Stock Operations -->
                            <div class="col-md-6">
                                <div class="p-3 border bg-light h-100">
                                    <div class="fw-semibold text-dark mb-2" style="font-size:12px;">Scope 2: Stock Operations</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanBarangMasuk" value="1" id="cbMasuk">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbMasuk">Barang Masuk</label>
                                        <div class="text-muted" style="font-size:10.5px;">Input transaksi penerimaan barang/stok baru.</div>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanBarangKeluar" value="1" id="cbKeluar">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbKeluar">Barang Keluar</label>
                                        <div class="text-muted" style="font-size:10.5px;">Input transaksi pengeluaran barang/sparepart.</div>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanRiwayat" value="1" id="cbRiwayat">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbRiwayat">Transaction History</label>
                                        <div class="text-muted" style="font-size:10.5px;">Melihat log audit &amp; riwayat transaksi.</div>
                                    </div>
                                    <div class="border-top pt-2 mt-2">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input perm-cb text-danger" type="checkbox" name="RequireApprovalKeluar" value="true" id="cbReqApproval">
                                            <label class="form-check-label small fw-bold text-danger" for="cbReqApproval">
                                                Require Admin Approval for Outgoing Goods
                                            </label>
                                            <div class="text-muted" style="font-size:10.5px;">Pengeluaran barang wajib disetujui Admin.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Scope Block 3: Maintenance & Cost Intelligence -->
                            <div class="col-md-6">
                                <div class="p-3 border bg-light h-100">
                                    <div class="fw-semibold text-dark mb-2" style="font-size:12px;">Scope 3: Maintenance &amp; Analytics</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanCostIntelligence" value="1" id="cbCostIntel">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbCostIntel">Cost Intelligence</label>
                                        <div class="text-muted" style="font-size:10.5px;">Analisis biaya &amp; penawaran harga vendor.</div>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanManagePm" value="1" id="cbManagePm">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbManagePm">PM Schedule Viewer</label>
                                        <div class="text-muted" style="font-size:10.5px;">Melihat jadwal Preventive Maintenance (PM).</div>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanManagePmEdit" value="1" id="cbManagePmEdit">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbManagePmEdit">PM Schedule Editor</label>
                                        <div class="text-muted" style="font-size:10.5px;">Membuat, mengedit &amp; menghapus jadwal PM.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Scope Block 4: Administration & Governance -->
                            <div class="col-md-6">
                                <div class="p-3 border bg-light h-100">
                                    <div class="fw-semibold text-dark mb-2" style="font-size:12px;">Scope 4: Administration &amp; Governance</div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanAdminMgmt" value="1" id="cbAdmin">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbAdmin">Admin Management Portal</label>
                                        <div class="text-muted" style="font-size:10.5px;">Portal perbandingan procurement &amp; persetujuan.</div>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanSupplierData" value="1" id="cbSupplier">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbSupplier">Master Supplier</label>
                                        <div class="text-muted" style="font-size:10.5px;">Pengelolaan vendor &amp; supplier resmi.</div>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanSettings" value="1" id="cbSettings">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbSettings">Settings &amp; User Management</label>
                                        <div class="text-muted" style="font-size:10.5px;">Manajemen akun pengguna &amp; hak akses RBAC.</div>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input perm-cb" type="checkbox" name="CanEmailSettings" value="1" id="cbEmailSettings">
                                        <label class="form-check-label small fw-semibold text-dark" for="cbEmailSettings">Email &amp; Auto-Alert Settings</label>
                                        <div class="text-muted" style="font-size:10.5px;">Pengaturan SMTP &amp; notifikasi email otomatis.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer py-2 px-3 bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-ems-primary btn-sm px-3 text-nowrap">
                        Simpan Perubahan RBAC
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDeletePasswordVisibility() {
            const input = document.getElementById('deleteProtectionPasswordInput');
            const btn = document.getElementById('deletePasswordToggleBtn');
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = 'Sembunyikan';
            } else {
                input.type = 'password';
                btn.textContent = 'Tampilkan';
            }
        }

        function openAddUserModal() {
            document.getElementById('userModalTitle').textContent = 'Tambah User Baru — RBAC Access';
            document.getElementById('userForm').action = '/Settings/CreateUser';
            document.getElementById('userIdInput').value = 0;
            document.getElementById('usernameInput').value = '';
            document.getElementById('usernameInput').readOnly = false;
            document.getElementById('fullNameInput').value = '';
            document.getElementById('passwordInput').value = '';
            document.getElementById('passwordInput').required = true;
            document.getElementById('passwordHelp').style.display = 'none';

            document.getElementById('roleSelect').value = 'user';
            document.getElementById('roleSelect').disabled = false;
            onRoleSelectChange('user');

            const modalElement = document.getElementById('userModal');
            let modalInstance = bootstrap.Modal.getInstance(modalElement);
            if (!modalInstance) {
                modalInstance = new bootstrap.Modal(modalElement);
            }
            modalInstance.show();
        }

        function handleEditUserClick(btn) {
            try {
                const userData = JSON.parse(btn.getAttribute('data-user'));
                openEditUserModal(userData);
            } catch (e) {
                console.error("Error parsing user JSON data:", e);
            }
        }

        function setCbChecked(id, isChecked) {
            const el = document.getElementById(id);
            if (el) el.checked = !!isChecked;
        }

        function getPropVal(obj, pascal, camel) {
            if (!obj) return 0;
            if (obj[pascal] !== undefined && obj[pascal] !== null) return obj[pascal];
            if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
            return 0;
        }

        function openEditUserModal(user) {
            if (!user) return;
            const username = user.Username || user.username || '';
            document.getElementById('userModalTitle').textContent = `Manage Access (${username})`;
            document.getElementById('userForm').action = '/Settings/EditUser';
            document.getElementById('userIdInput').value = getPropVal(user, 'Id', 'id');

            const isRootAdmin = username.toLowerCase() === 'admin';

            const usernameInput = document.getElementById('usernameInput');
            usernameInput.value = username;
            usernameInput.readOnly = isRootAdmin;

            document.getElementById('fullNameInput').value = user.FullName || user.fullName || '';

            const passwordInput = document.getElementById('passwordInput');
            passwordInput.value = '';
            passwordInput.required = false;
            document.getElementById('passwordHelp').style.display = 'block';

            const role = (user.Role || user.role || 'user').toLowerCase();
            const roleSelect = document.getElementById('roleSelect');
            roleSelect.value = role;
            roleSelect.disabled = isRootAdmin;

            if (role === 'admin' || isRootAdmin) {
                onRoleSelectChange('admin');
            } else {
                document.getElementById('adminLockBanner').style.display = 'none';
                document.querySelectorAll('.perm-cb').forEach(cb => cb.disabled = false);

                setCbChecked('cbMaster', getPropVal(user, 'CanMasterData', 'canMasterData') === 1);
                setCbChecked('cbLineMap', getPropVal(user, 'CanLineMapping', 'canLineMapping') === 1);
                setCbChecked('cbSupplier', getPropVal(user, 'CanSupplierData', 'canSupplierData') === 1);
                setCbChecked('cbAdmin', getPropVal(user, 'CanAdminMgmt', 'canAdminMgmt') === 1);
                setCbChecked('cbMasuk', getPropVal(user, 'CanBarangMasuk', 'canBarangMasuk') === 1);
                setCbChecked('cbKeluar', getPropVal(user, 'CanBarangKeluar', 'canBarangKeluar') === 1);
                setCbChecked('cbRiwayat', getPropVal(user, 'CanRiwayat', 'canRiwayat') === 1);

                const reqApp = getPropVal(user, 'RequireApprovalKeluar', 'requireApprovalKeluar');
                setCbChecked('cbReqApproval', reqApp === true || reqApp === 1);

                setCbChecked('cbCostIntel', getPropVal(user, 'CanCostIntelligence', 'canCostIntelligence') === 1);
                setCbChecked('cbManagePm', getPropVal(user, 'CanManagePm', 'canManagePm') === 1);
                setCbChecked('cbManagePmEdit', getPropVal(user, 'CanManagePmEdit', 'canManagePmEdit') === 1);
                setCbChecked('cbSettings', getPropVal(user, 'CanSettings', 'canSettings') === 1);
                setCbChecked('cbEmailSettings', getPropVal(user, 'CanEmailSettings', 'canEmailSettings') === 1);
            }

            const modalElement = document.getElementById('userModal');
            let modalInstance = bootstrap.Modal.getInstance(modalElement);
            if (!modalInstance) {
                modalInstance = new bootstrap.Modal(modalElement);
            }
            modalInstance.show();
        }

        function onRoleSelectChange(role, isManualChange = false) {
            const isAdmin = (role === 'admin');
            const banner = document.getElementById('adminLockBanner');
            const cbs = document.querySelectorAll('.perm-cb');

            if (isAdmin) {
                banner.style.display = 'block';
                cbs.forEach(cb => {
                    if (cb.id === 'cbReqApproval') {
                        cb.checked = false;
                    } else {
                        cb.checked = true;
                    }
                    cb.disabled = true;
                });
            } else {
                banner.style.display = 'none';
                cbs.forEach(cb => cb.disabled = false);

                if (isManualChange) {
                    if (role === 'supervisor') {
                        setCbValues(true, true, true, false, true, true, true, false, true, false, false);
                    } else if (role === 'manager') {
                        setCbValues(true, false, true, false, false, false, true, false, true, false, false);
                    } else if (role === 'technician') {
                        setCbValues(true, true, false, false, true, true, true, true, false, false, false);
                    } else { // user
                        setCbValues(true, false, false, false, true, true, true, true, false, false, false);
                    }
                }
            }
        }

        function setCbValues(master, lineMap, supplier, admin, masuk, keluar, riwayat, reqApproval, costIntel, set, emailSet) {
            setCbChecked('cbMaster', master);
            setCbChecked('cbLineMap', lineMap);
            setCbChecked('cbSupplier', supplier);
            setCbChecked('cbAdmin', admin);
            setCbChecked('cbMasuk', masuk);
            setCbChecked('cbKeluar', keluar);
            setCbChecked('cbRiwayat', riwayat);
            setCbChecked('cbReqApproval', reqApproval);
            setCbChecked('cbCostIntel', costIntel);
            setCbChecked('cbSettings', set);
            setCbChecked('cbEmailSettings', emailSet);
        }
    </script>
}

