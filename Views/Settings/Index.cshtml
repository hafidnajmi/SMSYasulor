@model IEnumerable<UPMS.Web.Models.Entities.User>

@{
    ViewData["Title"] = "Settings & User Management";

    int totalUsers = Model.Count();
    int activeUsers = Model.Count(u => u.IsActive);
    int adminCount = Model.Count(u => string.Equals(u.Role, "admin", StringComparison.OrdinalIgnoreCase) || string.Equals(u.Username, "admin", StringComparison.OrdinalIgnoreCase));
    int managerCount = Model.Count(u => string.Equals(u.Role, "manager", StringComparison.OrdinalIgnoreCase));
    int supervisorCount = Model.Count(u => string.Equals(u.Role, "supervisor", StringComparison.OrdinalIgnoreCase));
    int techCount = Model.Count(u => string.Equals(u.Role, "technician", StringComparison.OrdinalIgnoreCase) || string.Equals(u.Username, "technician", StringComparison.OrdinalIgnoreCase));
    int viewerCount = totalUsers - (adminCount + managerCount + supervisorCount + techCount);
    if (viewerCount < 0) viewerCount = 0;

    int getActiveScopeCount(UPMS.Web.Models.Entities.User usr)
    {
        int cnt = 0;
        if (usr.CanMasterData == 1) cnt++;
        if (usr.CanBarangMasuk == 1) cnt++;
        if (usr.CanBarangKeluar == 1) cnt++;
        if (usr.CanRiwayat == 1) cnt++;
        if (usr.CanCostIntelligence == 1) cnt++;
        if (usr.CanManagePm == 1) cnt++;
        if (usr.CanManagePmEdit == 1) cnt++;
        if (usr.CanLineMapping == 1) cnt++;
        if (usr.CanSupplierData == 1) cnt++;
        if (usr.CanAdminMgmt == 1) cnt++;
        if (usr.CanSettings == 1) cnt++;
        if (usr.CanEmailSettings == 1) cnt++;
        return cnt;
    }

    string getAzureRoleName(string role, string username)
    {
        if (string.Equals(username, "admin", StringComparison.OrdinalIgnoreCase)) return "Global Administrator";
        return (role?.ToLower()) switch
        {
            "admin" => "Global Administrator",
            "manager" => "Procurement Contributor",
            "supervisor" => "Operations Contributor",
            "technician" => "Field Operator",
            _ => "Reader / Viewer"
        };
    }
}

<style>
    .ms-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 4px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    }
    .ms-card-header {
        background: #ffffff;
        border-bottom: 1px solid #E2E8F0;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 13px;
        color: #1E293B;
        white-space: nowrap;
    }
    .ms-badge-neutral {
        background-color: #F1F5F9;
        color: #334155;
        border: 1px solid #CBD5E1;
        font-weight: 500;
        font-size: 11px;
        border-radius: 3px;
        padding: 2px 8px;
        white-space: nowrap;
        display: inline-block;
    }
    .ms-badge-dark {
        background-color: #1E293B;
        color: #ffffff;
        border: 1px solid #1E293B;
        font-weight: 500;
        font-size: 11px;
        border-radius: 3px;
        padding: 2px 8px;
        white-space: nowrap;
        display: inline-block;
    }
    .table-ms {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        white-space: nowrap;
    }
    .table-ms th {
        background-color: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
        color: #475569;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 10px 14px;
        white-space: nowrap !important;
    }
    .table-ms td {
        border-bottom: 1px solid #F1F5F9;
        padding: 10px 14px;
        font-size: 13px;
        color: #1E293B;
        white-space: nowrap !important;
    }
    .table-ms tr:hover td {
        background-color: #F8FAFC;
    }
    .form-switch .form-check-input {
        width: 2em;
        height: 1.1em;
        cursor: pointer;
    }
    .form-switch .form-check-input:checked {
        background-color: #0F4C81;
        border-color: #0F4C81;
    }
</style>

<!-- Title Header & Actions -->
<div class="ems-page-header mb-4">
    <div>
        <h4 class="fw-semibold mb-1" style="color: #0F172A;">Settings &amp; User Management</h4>
        <p class="text-secondary small mb-0">Role-Based Access Control (RBAC), user accounts, and system configuration.</p>
    </div>
    <div class="ems-page-actions">
        <button type="button" class="btn btn-ems-primary btn-sm px-3" onclick="openAddUserModal()">
            <i class="bi bi-person-plus me-1"></i>Tambah User Baru
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ms-card p-3 h-100">
            <div class="text-secondary small font-monospace fw-semibold text-uppercase" style="font-size: 11px;">Total Registered Users</div>
            <div class="fs-3 fw-semibold mt-1" style="color: #0F172A;">
                @totalUsers.ToString("N0") <span class="fs-6 text-muted fw-normal">Accounts</span>
            </div>
            <div class="text-secondary small mt-1">@activeUsers of @totalUsers accounts currently active</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ms-card p-3 h-100">
            <div class="text-secondary small font-monospace fw-semibold text-uppercase" style="font-size: 11px;">Role Assignments Breakdown</div>
            <div class="d-flex flex-nowrap gap-1 mt-2 overflow-auto">
                <span class="ms-badge-dark text-nowrap">Admin: @adminCount</span>
                <span class="ms-badge-neutral text-nowrap">Manager: @managerCount</span>
                <span class="ms-badge-neutral text-nowrap">Supervisor: @supervisorCount</span>
                <span class="ms-badge-neutral text-nowrap">Tech: @techCount</span>
            </div>
            <div class="text-secondary small mt-2">Built-in RBAC roles enforced</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ms-card p-3 h-100">
            <div class="text-secondary small font-monospace fw-semibold text-uppercase" style="font-size: 11px;">Granular Scopes Managed</div>
            <div class="fs-3 fw-semibold mt-1" style="color: #0F172A;">
                13 <span class="fs-6 text-muted fw-normal">Module Scopes</span>
            </div>
            <div class="text-secondary small mt-1">Fine-grained access switches per user</div>
        </div>
    </div>
</div>

<!-- 1. User List Table Card -->
<div class="ms-card mb-4">
    <div class="ms-card-header d-flex align-items-center justify-content-between">
        <span>Daftar Pengguna Sistem (@Model.Count() User)</span>
        <span class="text-secondary font-monospace" style="font-size:11px; font-weight:normal;">RBAC Security Policy Active</span>
    </div>
    <div class="table-responsive">
        <table class="table-ms align-middle">
            <thead>
                <tr>
                    <th class="text-nowrap" style="width: 60px;">ID</th>
                    <th class="text-nowrap">USER IDENTITY</th>
                    <th class="text-nowrap">NAMA LENGKAP</th>
                    <th class="text-nowrap">ROLE ASSIGNMENT</th>
                    <th class="text-nowrap">ASSIGNED SCOPES &amp; ACCESS</th>
                    <th class="text-center text-nowrap">STATUS</th>
                    <th class="text-nowrap">LAST LOGIN</th>
                    <th class="text-center text-nowrap" style="min-width: 180px;">AKSI</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var u in Model)
                    {
                        bool isRootAdmin = string.Equals(u.Username, "admin", StringComparison.OrdinalIgnoreCase);
                        int scopeCount = getActiveScopeCount(u);
                        string azureRoleName = getAzureRoleName(u.Role, u.Username);

                        <tr>
                            <td class="text-muted font-monospace small text-nowrap">#@u.Id</td>
                            <td class="text-nowrap">
                                <span class="fw-semibold text-dark font-monospace" style="font-size:13px;">@u.Username</span>
                                @if (isRootAdmin)
                                {
                                    <span class="badge bg-light text-secondary border font-monospace ms-1" style="font-size: 9px;">ROOT</span>
                                }
                            </td>
                            <td class="text-secondary text-nowrap">@(string.IsNullOrWhiteSpace(u.FullName) ? "-" : u.FullName)</td>
                            <td class="text-nowrap">
                                @if (isRootAdmin || u.Role?.ToLower() == "admin")
                                {
                                    <span class="ms-badge-dark text-nowrap">@azureRoleName</span>
                                }
                                else
                                {
                                    <span class="ms-badge-neutral text-nowrap">@azureRoleName</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (isRootAdmin || u.Role?.ToLower() == "admin")
                                {
                                    <span class="text-secondary font-monospace text-nowrap" style="font-size:11px;">Full Access (13/13 Scopes)</span>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-1 flex-nowrap text-nowrap">
                                        <span class="text-secondary font-monospace me-1 text-nowrap" style="font-size:11px;">@scopeCount/13 Scopes:</span>
                                        @if (u.CanMasterData == 1) { <span class="badge bg-light text-secondary border px-2 py-1 text-nowrap" style="font-size:10px; font-weight:normal;">Catalog</span> }
                                        @if (u.CanBarangMasuk == 1 || u.CanBarangKeluar == 1) { <span class="badge bg-light text-secondary border px-2 py-1 text-nowrap" style="font-size:10px; font-weight:normal;">Stock Tx</span> }
                                        @if (u.CanManagePm == 1) { <span class="badge bg-light text-secondary border px-2 py-1 text-nowrap" style="font-size:10px; font-weight:normal;">PM Maint</span> }
                                        @if (u.CanAdminMgmt == 1) { <span class="badge bg-light text-secondary border px-2 py-1 text-nowrap" style="font-size:10px; font-weight:normal;">Admin Portal</span> }
                                        @if (u.RequireApprovalKeluar) { <span class="badge bg-light text-danger border px-2 py-1 text-nowrap" style="font-size:10px; font-weight:normal;">Approval Req</span> }
                                    </div>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                @if (u.IsActive)
                                {
                                    <span class="text-success font-monospace text-nowrap" style="font-size: 11px;">Active</span>
                                }
                                else
                                {
                                    <span class="text-secondary font-monospace text-nowrap" style="font-size: 11px;">Inactive</span>
                                }
                            </td>
                            <td class="small text-muted font-monospace text-nowrap">
                                @(u.LastLogin.HasValue ? u.LastLogin.Value.ToString("dd MMM yyyy HH:mm") : "Never")
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="d-flex align-items-center justify-content-center gap-1 text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-edit-user text-nowrap"
                                            style="font-size:11px; height:24px; line-height:22px;"
                                            data-user='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(u))'
                                            onclick="handleEditUserClick(this)">
                                        RBAC
                                    </button>

                                    @if (!isRootAdmin)
                                    {
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2 text-nowrap" style="font-size:11px; height:24px; line-height:22px;"
                                                    title="@(u.IsActive ? "Deactivate User" : "Activate User")">
                                                @(u.IsActive ? "Disable" : "Enable")
                                            </button>
                                        </form>

                                        <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return executeSecureDelete(this, 'user @u.Username');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 text-nowrap" style="font-size:11px; height:24px; line-height:22px;" title="Delete User">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4 text-nowrap">
                            Belum ada data pengguna tersimpan.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

