                        <label class="form-check-label text-dark small fw-semibold text-nowrap" for="techSup">Master Supplier</label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" name="CanAdminMgmt" value="1" id="techAdm" @(techUserEntity?.CanAdminMgmt == 1 ? "checked" : "") />
                        <label class="form-check-label text-dark small fw-semibold text-nowrap" for="techAdm">Admin Portal</label>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
