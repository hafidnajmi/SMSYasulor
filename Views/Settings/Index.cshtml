                        <input class="form-check-input" type="checkbox" name="RequireApprovalKeluar" value="true" id="techApp" @(techUserEntity?.RequireApprovalKeluar == true ? "checked" : "") />
                        <label class="form-check-label text-danger small fw-semibold text-nowrap" for="techApp">Wajib Approval Admin</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <div class="text-secondary small">
                    Hak akses ini berlaku saat pengguna menekan tombol <strong>Login as Technician</strong>.
                </div>
                <button type="submit" class="btn btn-ems-primary btn-sm px-3 text-nowrap">
                    Simpan Hak Akses Technician
                </button>
            </div>
        </form>
    </div>
</div>

<!-- System Timezone Configuration Card -->
<div class="ms-card mb-4">
    <div class="ms-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-2 text-primary"></i>Pengaturan Zona Waktu Sistem (System Timezone)</span>
        <span class="badge bg-primary text-white font-monospace" style="font-size:11px;">@ViewBag.CurrentTimezoneLabel</span>
    </div>
    <div class="p-3">
        <form asp-action="SaveTimezone" method="post" style="max-width: 720px;">
            @Html.AntiForgeryToken()
            <div class="row align-items-end g-3">
                <div class="col-md-7">
                    <label class="form-label small fw-semibold text-secondary mb-1">Pilih Zona Waktu Operasional</label>
                    <select name="timezoneId" class="form-select form-select-sm font-monospace" required>
                        @{
                            string currentTz = ViewBag.CurrentTimezone as string ?? "Asia/Jakarta";
                        }
                        <option value="Asia/Jakarta" selected="@(currentTz == "Asia/Jakarta" || currentTz == "SE Asia Standard Time")">Asia/Jakarta (WIB — UTC+7:00, Western Indonesia)</option>
                        <option value="Asia/Makassar" selected="@(currentTz == "Asia/Makassar")">Asia/Makassar (WITA — UTC+8:00, Central Indonesia)</option>
                        <option value="Asia/Jayapura" selected="@(currentTz == "Asia/Jayapura")">Asia/Jayapura (WIT — UTC+9:00, Eastern Indonesia)</option>
                        <option value="Asia/Singapore" selected="@(currentTz == "Asia/Singapore")">Asia/Singapore (SGT — UTC+8:00, Singapore)</option>
                        <option value="Asia/Tokyo" selected="@(currentTz == "Asia/Tokyo")">Asia/Tokyo (JST — UTC+9:00, Japan)</option>
                        <option value="UTC" selected="@(currentTz == "UTC")">UTC (Coordinated Universal Time — UTC+0:00)</option>
                        <option value="Europe/London" selected="@(currentTz == "Europe/London")">Europe/London (GMT/BST — UTC+0:00 / UTC+1:00)</option>
                        <option value="America/New_York" selected="@(currentTz == "America/New_York")">America/New_York (EST/EDT — UTC-5:00)</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <button type="submit" class="btn btn-ems-primary btn-sm w-100 text-nowrap" style="height: 31px;">
                        <i class="bi bi-save me-1"></i>Simpan Zona Waktu
                    </button>
                </div>
            </div>
            <div class="form-text text-muted mt-2 d-flex justify-content-between align-items-center" style="font-size:11px;">
                <span><i class="bi bi-info-circle me-1"></i>Zona waktu ini digunakan untuk seluruh transaksi, tanggal laporan, alert email, dan header dashboard.</span>
                <span class="fw-semibold text-dark font-monospace"><i class="bi bi-calendar-event me-1"></i>Waktu Sistem: @ViewBag.CurrentTimeNow</span>
            </div>
        </form>
    </div>
</div>

