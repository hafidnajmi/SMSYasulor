@section Scripts {
<script>
    function toggleEmailRecipientSection(isChecked) {
        const el = document.getElementById('emailRecipientSection');
        if (el) el.style.display = isChecked ? 'block' : 'none';
    }

    function openViewModal(id, title, version, type, status, description, actionRequired, releaseDate, updatedAt, author) {
        document.getElementById('viewModalTitle').textContent = title;
        document.getElementById('viewVersionTag').textContent = version;
        document.getElementById('viewReleaseDate').textContent = releaseDate;
        document.getElementById('viewUpdatedAt').textContent = updatedAt;
        document.getElementById('viewAuthor').textContent = author;
        
        const statusBadge = document.getElementById('viewStatusBadge');
        statusBadge.textContent = (status || 'PUBLISHED').toUpperCase();

        const badge = document.getElementById('viewTypeBadge');
        badge.textContent = type;

        // Format description with bullets
        const lines = (description || '').split('\n');
        let html = '';
        lines.forEach(line => {
            const trimmed = line.trim();
            if (trimmed.startsWith('-') || trimmed.startsWith('*') || trimmed.startsWith('•')) {
                html += '<div class="d-flex align-items-start mb-1"><span class="me-2 text-muted">&bull;</span><span>' + escapeHtml(trimmed.replace(/^[-*•]\s*/, '')) + '</span></div>';
            } else if (trimmed) {
                html += '<p class="mb-2">' + escapeHtml(trimmed) + '</p>';
            }
        });
        document.getElementById('viewChangelogBody').innerHTML = html || '<span class="text-muted">No additional details provided.</span>';

        const modal = new bootstrap.Modal(document.getElementById('viewDetailModal'));
        modal.show();
    }

    function togglePopupDuration(prefix, isChecked) {
        const wrapper = document.getElementById(prefix + 'PopupDurationWrapper');
        if (wrapper) wrapper.style.display = isChecked ? 'block' : 'none';
    }

    function onPopupPresetChange(prefix, value) {
        const customCol = document.getElementById(prefix + 'CustomDurationCol');
        const hiddenInput = document.getElementById(prefix + (prefix === 'create' ? 'PopupDurationDays' : 'PopupDurationDays'));
        const customInput = document.getElementById(prefix + 'PopupDurationCustom');
        
        if (value === 'custom') {
            if (customCol) customCol.style.display = 'block';
            if (hiddenInput && customInput) hiddenInput.value = customInput.value || 7;
        } else {
            if (customCol) customCol.style.display = 'none';
            if (hiddenInput) hiddenInput.value = value;
        }
    }

    function onCustomDurationInput(prefix, value) {
        const hiddenInput = document.getElementById(prefix + (prefix === 'create' ? 'PopupDurationDays' : 'PopupDurationDays'));
        if (hiddenInput) {
            hiddenInput.value = parseInt(value, 10) > 0 ? parseInt(value, 10) : 7;
        }
    }

    function openEditModal(id, title, version, type, status, releaseDate, description, actionRequired, audience, showPopup, popupDurationDays, isActive) {
        document.getElementById('editId').value = id;
        document.getElementById('editTitle').value = title;
        document.getElementById('editVersion').value = version;
        document.getElementById('editUpdateType').value = type;
        document.getElementById('editReleaseStatus').value = status || 'Published';
        document.getElementById('editReleaseDate').value = releaseDate || '';
        document.getElementById('editDescription').value = description;
        document.getElementById('editTargetAudience').value = audience || 'All Users';
        
        document.getElementById('editShowPopupAlert').checked = showPopup;
        togglePopupDuration('edit', showPopup);

        const duration = parseInt(popupDurationDays, 10) > 0 ? parseInt(popupDurationDays, 10) : 7;
        document.getElementById('editPopupDurationDays').value = duration;

        const presetSelect = document.getElementById('editPopupDurationPreset');
        const customCol = document.getElementById('editCustomDurationCol');
        const customInput = document.getElementById('editPopupDurationCustom');

        if (['3', '7', '14', '30'].includes(duration.toString())) {
            presetSelect.value = duration.toString();
            if (customCol) customCol.style.display = 'none';
        } else {
            presetSelect.value = 'custom';
            if (customCol) customCol.style.display = 'block';
            if (customInput) customInput.value = duration;
        }

        document.getElementById('editIsActive').checked = isActive;

        const modal = new bootstrap.Modal(document.getElementById('editUpdateModal'));
        modal.show();
    }

    function openResendModal(id, title, version, recipients) {
        document.getElementById('resendId').value = id;
        document.getElementById('resendReleaseInfo').textContent = `${title} (${version})`;
        document.getElementById('resendRecipients').value = recipients;

        const modal = new bootstrap.Modal(document.getElementById('resendEmailModal'));
        modal.show();
    }

    function sendPreviewTestEmail() {
        const title = document.getElementById('createTitle').value;
        const version = document.getElementById('createVersion').value;
        const type = document.getElementById('createUpdateType').value;
        const desc = document.getElementById('createDescription').value;

        const testEmail = prompt('Enter destination email address to receive TEST PREVIEW:', '@defaultReceiver');
        if (!testEmail || !testEmail.trim()) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const params = new URLSearchParams();
        params.append('title', title);
        params.append('version', version);
        params.append('updateType', type);
        params.append('description', desc);
        params.append('testEmail', testEmail.trim());

        fetch('/DeveloperUpdates/SendTestEmail', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: params.toString()
        })
        .then(r => r.json())
        .then(res => {
            alert(res.message);
        })
        .catch(err => {
            console.error(err);
            alert('Failed to send test email.');
        });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}
