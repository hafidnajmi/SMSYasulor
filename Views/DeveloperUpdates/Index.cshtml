@model IEnumerable<UPMS.Web.Models.Entities.SystemUpdate>
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "System Updates & Release Notes";
    string currentType = ViewBag.SelectedType as string ?? "all";
    string currentStatus = ViewBag.SelectedStatus as string ?? "all";
    string selectedFilter = ViewBag.SelectedFilter as string ?? "all";
    string searchQuery = ViewBag.SearchQuery as string ?? "";
    string defaultReceiver = ViewBag.DefaultReceiverEmail as string ?? "";
    bool emailEnabled = ViewBag.EmailEnabled != null && (bool)ViewBag.EmailEnabled;
}

<style>
    /* Uniform Font strictly scoped to Developer Updates portal & its modals so layout/sidebar font is never overridden */
    .dev-portal, .dev-portal *,
    #createUpdateModal, #createUpdateModal *,
    #viewDetailModal, #viewDetailModal *,
    #editUpdateModal, #editUpdateModal *,
    #resendEmailModal, #resendEmailModal * {
        font-family: 'Avenir Next', 'Avenir', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', Roboto, 'Helvetica Neue', Arial, sans-serif !important;
        letter-spacing: -0.01em;
    }

    .dev-portal {
        color: #032954;
    }

    .dev-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 14px;
        margin-bottom: 16px;
    }

    .dev-title {
        font-size: 19px;
        font-weight: 600;
        color: #032954;
        margin: 0;
    }

    .dev-subtitle {
        font-size: 13px;
        color: #64748b;
        margin-top: 2px;
        margin-bottom: 0;
    }

    /* Clean Connected Stats Bar with Radius 0 (Connected / Terhubung) */
    .dev-summary-bar {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: stretch;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0px !important;
        margin-bottom: 16px;
    }

    .dev-stat-box {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: #ffffff;
        border: none;
        border-right: 1px solid #e2e8f0;
        border-radius: 0px !important;
        font-size: 12.5px;
        color: #64748b;
        line-height: 1.3;
    }

    .dev-stat-box:last-child {
        border-right: none;
    }

    .dev-stat-box strong {
        color: #032954;
        font-weight: 600;
    }

    /* Clean Single Filter Card with Radius 0 */
    .dev-filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0px !important;
        padding: 12px 16px;
        margin-bottom: 16px;
    }

    /* Clean Bordered Table with Smooth Scrolling & Sticky Header */
    .dev-table-container {
        border: 1px solid #e2e8f0;
        border-radius: 0px !important;
        background: #ffffff;
        max-height: calc(100vh - 290px);
        min-height: 260px;
        overflow-y: auto !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        position: relative;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 #f8fafc;
    }

    .dev-table-container::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .dev-table-container::-webkit-scrollbar-track {
        background: #f8fafc;
    }
    .dev-table-container::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 0px;
    }
    .dev-table-container::-webkit-scrollbar-thumb:hover {
        background-color: #94a3b8;
    }

    .dev-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
    }

    .dev-table th {
        font-size: 11.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        padding: 10px 14px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        text-align: left;
        position: sticky;
        top: 0;
        z-index: 5;
        box-shadow: 0 1px 0 #e2e8f0;
    }

    .dev-table td {
        padding: 12px 14px;
        vertical-align: top;
        border-bottom: 1px solid #f1f5f9;
        font-size: 13px;
        color: #1e293b;
    }

    .dev-table tr:last-child td {
        border-bottom: none;
    }

    .dev-table tr:hover td {
        background-color: #fafbfc;
    }

    .dev-action-btn {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0px !important;
        color: #64748b;
        padding: 4px 7px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.15s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .dev-action-btn:hover {
        border-color: #032954;
        color: #032954;
        background: #f0f4f9;
    }

    .dev-publish-btn {
        background: #032954;
        border: 1px solid #032954;
        border-radius: 0px !important;
        color: #ffffff;
        padding: 4px 7px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .dev-publish-btn:hover {
        background: #021f3f;
        border-color: #021f3f;
        color: #ffffff;
    }

    /* Enforce 0px radius across the portal and modals to match enterprise design */
    .dev-portal .form-control,
    .dev-portal .form-select,
    .dev-portal .input-group-text,
    .dev-portal .btn,
    .dev-filter-card,
    .dev-summary-bar,
    .dev-stat-box,
    #createUpdateModal .modal-content,
    #createUpdateModal .form-control,
    #createUpdateModal .form-select,
    #createUpdateModal .btn,
    #viewDetailModal .modal-content,
    #viewDetailModal .btn,
    #editUpdateModal .modal-content,
    #editUpdateModal .form-control,
    #editUpdateModal .form-select,
    #editUpdateModal .btn,
    #resendEmailModal .modal-content,
    #resendEmailModal .form-control,
    #resendEmailModal .btn {
        border-radius: 0px !important;
    }
</style>

<div class="dev-portal">
    <!-- Header -->
    <div class="dev-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="dev-title">System Updates &amp; Release Notes</h4>
            <p class="dev-subtitle">Documentation of release history, draft updates, bug fixes, and system notifications.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-1 fw-medium" style="border-radius: 0px !important; font-size: 13px; border-color: #cbd5e1; color: #032954; background: #f8fafc;" onclick="if(window.previewLoginPopupModal) window.previewLoginPopupModal();" title="Preview how the Login Pop-up Modal looks for users">
                <i class="bi bi-window-stack me-1 text-primary"></i> Preview Pop-up
            </button>
            <a asp-controller="EmailSettings" asp-action="Index" class="dev-action-btn" style="font-size: 13px; border-radius: 0px !important;" title="Configure SMTP Email Delivery">
                <i class="bi bi-gear me-1"></i> SMTP Settings
            </a>
            <button type="button" class="btn btn-sm text-white px-3 py-1 fw-medium" style="border-radius: 0px !important; font-size: 13px; background: #032954; border: 1px solid #032954;" data-bs-toggle="modal" data-bs-target="#createUpdateModal">
                <i class="bi bi-plus-lg me-1"></i> Create Update
            </button>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 mb-3" role="alert" style="border-radius: 0px !important; font-size: 13px; color: #032954; background: #fafafa;">
            <div class="d-flex align-items-center">
                <i class="bi bi-check2-circle me-2 text-dark fs-6"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 mb-3" role="alert" style="border-radius: 0px !important; font-size: 13px; color: #b45309; background: #fffbeb;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle me-2 text-warning fs-6"></i>
                <div>@TempData["Warning"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 mb-3" role="alert" style="border-radius: 0px !important; font-size: 13px; color: #032954; background: #fafafa;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-circle me-2 text-dark fs-6"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Stats Bar - Connected & Radius 0 -->
    <div>
        <div class="dev-summary-bar">
            <div class="dev-stat-box">Total Logs: <strong>@ViewBag.TotalCount</strong></div>
            <div class="dev-stat-box">Published: <strong>@ViewBag.PublishedCount</strong></div>
            <div class="dev-stat-box">Drafts: <strong>@ViewBag.DraftCount</strong></div>
            <div class="dev-stat-box">Bug Fixes: <strong>@ViewBag.BugFixCount</strong></div>
            <div class="dev-stat-box">Improvements: <strong>@ViewBag.ImprovementCount</strong></div>
            <div class="dev-stat-box">New Features: <strong>@ViewBag.NewFeatureCount</strong></div>
        </div>
    </div>

    <!-- Single Filter Card with Dropdown (Radius 0) -->
    <div class="dev-filter-card">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-5 col-lg-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-dark fw-medium" style="border-radius: 0px !important; font-size: 12.5px; border-color: #cbd5e1;">
                        <i class="bi bi-funnel me-1"></i> Filter:
                    </span>
                    <select name="filter" class="form-select form-select-sm" onchange="this.form.submit()" style="border-radius: 0px !important; font-size: 12.5px; border-color: #cbd5e1; color: #032954; font-weight: 500;">
                        <option value="all" selected="@(selectedFilter == "all" ? "selected" : null)">All Updates (@ViewBag.TotalCount)</option>
                        <option value="status:Published" selected="@(selectedFilter == "status:Published" ? "selected" : null)">Published (@ViewBag.PublishedCount)</option>
                        <option value="status:Draft" selected="@(selectedFilter == "status:Draft" ? "selected" : null)">Drafts (@ViewBag.DraftCount)</option>
                        <option value="type:Bug Fix" selected="@(selectedFilter == "type:Bug Fix" ? "selected" : null)">Bug Fix (@ViewBag.BugFixCount)</option>
                        <option value="type:Improvement" selected="@(selectedFilter == "type:Improvement" ? "selected" : null)">Improvement (@ViewBag.ImprovementCount)</option>
                        <option value="type:New Feature" selected="@(selectedFilter == "type:New Feature" ? "selected" : null)">New Feature (@ViewBag.NewFeatureCount)</option>
                    </select>
                </div>
            </div>

            <div class="col-12 col-md-7 col-lg-5">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" value="@searchQuery" class="form-control" placeholder="Search title, version, changelog..." style="border-radius: 0px !important; font-size: 12.5px; border-color: #cbd5e1;" />
                    <button class="btn text-white" type="submit" style="border-radius: 0px !important; font-size: 12.5px; padding: 5px 16px; background: #032954; border: 1px solid #032954;">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                    @if (!string.IsNullOrWhiteSpace(searchQuery) || selectedFilter != "all")
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 0px !important; font-size: 12.5px; border-color: #cbd5e1; padding: 5px 12px;" title="Reset Filter">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Table of Release Records in Clean Bordered Container -->
    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted border" style="border-radius: 0px !important; background: #ffffff;">
            <i class="bi bi-inbox fs-3 text-secondary opacity-50 d-block mb-2"></i>
            <div class="fw-medium text-dark mb-1">No update records found</div>
            <div class="small text-muted mb-3">Click the "Create Update" button to document a new bug fix, improvement, or release draft.</div>
            <button type="button" class="btn text-white btn-sm px-3" style="border-radius: 0px !important; background: #032954; border: 1px solid #032954;" data-bs-toggle="modal" data-bs-target="#createUpdateModal">
                <i class="bi bi-plus-lg me-1"></i> Create First Update
            </button>
        </div>
    }
    else
    {
        <div class="dev-table-container table-responsive">
            <table class="dev-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">VERSION &amp; STATUS</th>
                        <th style="width: 130px;">CATEGORY</th>
                        <th>UPDATE TITLE &amp; CHANGELOG</th>
                        <th style="width: 170px;">RELEASE DATE &amp; UPDATED</th>
                        <th style="width: 140px;">EMAIL STATUS</th>
                        <th style="width: 140px; text-align: center;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isDraft = item.ReleaseStatus.Equals("Draft", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @item.Version &bull; @(isDraft ? "Draft" : "Published")
                                </div>
                                <div class="text-muted" style="font-size: 11.5px; margin-top: 2px;">
                                    Target: @item.TargetAudience
                                </div>
                            </td>
                            <td>
                                <div class="text-dark fw-medium">
                                    @item.UpdateType
                                </div>
                                @{
                                    var duration = item.PopupDurationDays > 0 ? item.PopupDurationDays : 7;
                                    var relDate = item.ReleaseDate ?? item.CreatedAt;
                                    var expiry = relDate.AddDays(duration);
                                    var isPopupActive = item.ShowPopupAlert && item.ReleaseStatus == "Published" && DateTime.Now <= expiry;
                                    var daysRemaining = isPopupActive ? Math.Max(1, (int)Math.Ceiling((expiry - DateTime.Now).TotalDays)) : 0;
                                }
                                @if (item.ShowPopupAlert)
                                {
                                    if (isPopupActive)
                                    {
                                        <div class="mt-1">
                                            <span class="badge text-white" style="background:#032954; font-size:10px; font-weight:500; border-radius:0px !important;" title="Pop-up reminder is active upon login (@daysRemaining days remaining)">
                                                <i class="bi bi-window-stack me-1"></i>Popup: @(daysRemaining)d left
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-light text-muted border" style="font-size:10px; font-weight:400; border-radius:0px !important;" title="Pop-up reminder duration expired">
                                                <i class="bi bi-clock-history me-1"></i>Popup Expired
                                            </span>
                                        </div>
                                    }
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark" style="font-size: 13.5px;">@item.Title</div>
                                <div class="text-muted text-truncate mt-1" style="max-width: 520px; font-size: 12.5px; line-height: 1.4;">
                                    @item.Description
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 12px; color: #032954;">
                                    <span class="text-muted">Released:</span> 
                                    @(item.ReleaseDate.HasValue ? item.ReleaseDate.Value.ToString("dd MMM yyyy HH:mm") : "- (Draft)")
                                </div>
                                <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
                                    Updated: @((item.UpdatedAt ?? item.CreatedAt).ToString("dd MMM yyyy HH:mm"))
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 12px; color: #032954;">
                                    @(item.SendEmail && item.EmailSentCount > 0 ? $"Email Sent ({item.EmailSentCount})" : "In-App Bell Only")
                                </div>
                                <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
                                    By: @item.CreatedBy
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (isDraft)
                                    {
                                        <form asp-action="PublishDraft" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Publish this draft to the live system and bell notifications now?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dev-publish-btn" title="Publish This Draft Now">
                                                <i class="bi bi-send-check"></i>
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="dev-action-btn" title="Preview Pop-up Card" onclick="if(window.previewLoginPopupModal) window.previewLoginPopupModal(@item.Id);">
                                        <i class="bi bi-window-stack"></i>
                                    </button>
                                    <button type="button" class="dev-action-btn" title="View Release Details" onclick="openViewModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Title))', '@item.Version', '@item.UpdateType', '@item.ReleaseStatus', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Description))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.ActionRequired ?? ""))', '@(item.ReleaseDate.HasValue ? item.ReleaseDate.Value.ToString("dd MMMM yyyy HH:mm") : "-")', '@((item.UpdatedAt ?? item.CreatedAt).ToString("dd MMMM yyyy HH:mm"))', '@item.CreatedBy')">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="dev-action-btn" title="Resend Email Broadcast" onclick="openResendModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Title))', '@item.Version', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.RecipientEmails ?? defaultReceiver))')">
                                        <i class="bi bi-envelope-arrow-up"></i>
                                    </button>
                                    <button type="button" class="dev-action-btn" title="Edit Update" onclick="openEditModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Title))', '@item.Version', '@item.UpdateType', '@item.ReleaseStatus', '@(item.ReleaseDate.HasValue ? item.ReleaseDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Description))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.ActionRequired ?? ""))', '@item.TargetAudience', @(item.ShowPopupAlert.ToString().ToLower()), @(item.PopupDurationDays > 0 ? item.PopupDurationDays : 7), @(item.IsActive.ToString().ToLower()))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this release record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dev-action-btn" title="Delete Update">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODAL 1: Create New Update -->
<div class="modal fade" id="createUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 6px;">
            <form asp-action="Create" method="post" id="createUpdateForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-white border-bottom py-3 px-4" style="border-radius: 6px 6px 0 0;">
                    <div>
                        <h5 class="modal-title fw-semibold text-dark mb-0" style="font-size: 16px;">
                            Create Release Note &amp; Draft Update
                        </h5>
                        <p class="text-muted small mb-0 mt-1" style="font-size: 12px;">Document system changes in a structured format.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Release Status <span class="text-danger">*</span></label>
                            <select name="ReleaseStatus" id="createReleaseStatus" class="form-select form-select-sm" style="border-radius: 4px;" required onchange="toggleReleaseDateSection(this.value)">
                                <option value="Published">Published (Live Release)</option>
                                <option value="Draft">Draft (Save Draft)</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Version <span class="text-danger">*</span></label>
                            <input type="text" name="Version" id="createVersion" class="form-control form-control-sm font-monospace" placeholder="e.g. v2.5.3" value="v2.5.3" style="border-radius: 4px;" required />
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Category <span class="text-danger">*</span></label>
                            <select name="UpdateType" id="createUpdateType" class="form-select form-select-sm" style="border-radius: 4px;" required>
                                <option value="Improvement">Improvement</option>
                                <option value="Bug Fix">Bug Fix</option>
                                <option value="New Feature">New Feature</option>
                                <option value="System Alert">System Alert</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Target Audience</label>
                            <select name="TargetAudience" class="form-select form-select-sm" style="border-radius: 4px;">
                                <option value="All Users">All Users</option>
                                <option value="Admin Only">Admin Only</option>
                                <option value="Technician Only">Technician Only</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Update Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" id="createTitle" class="form-control form-control-sm" placeholder="e.g. UI/UX Enhancements & System Notification Bell" style="border-radius: 4px;" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Changelog Details <span class="text-danger">*</span></label>
                        <textarea name="Description" id="createDescription" rows="5" class="form-control form-control-sm" placeholder="Use dash (-) to format changelog bullet points:&#10;- Optimized component A for faster load times&#10;- Resolved form validation issue on menu B&#10;- Added release status indicator and timestamp" style="border-radius: 4px; font-size: 12.5px; line-height: 1.5;" required></textarea>
                    </div>

                    <!-- Email Broadcast Options -->
                    <div class="pt-3 border-top mb-2">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" name="SendEmail" value="true" id="checkSendEmail" onchange="toggleEmailRecipientSection(this.checked)">
                            <label class="form-check-label small fw-semibold text-dark" for="checkSendEmail">
                                Automatically Broadcast Email to Team (via SMTP)
                            </label>
                        </div>
                        <small class="text-muted d-block" style="font-size: 11.5px;">If saved as Draft, email and bell notifications will not be sent until the draft is published.</small>

                        <div id="emailRecipientSection" style="display: none;" class="mt-3 pt-2 border-top">
