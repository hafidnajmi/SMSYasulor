<!-- MODAL 4: Resend Email Broadcast Modal -->
<div class="modal fade" id="resendEmailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 6px;">
            <form asp-action="ResendEmail" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="resendId" />
                <div class="modal-header bg-white border-bottom py-3 px-4" style="border-radius: 6px 6px 0 0;">
                    <h5 class="modal-title fw-semibold text-dark mb-0" style="font-size: 16px;">
                        Kirim Ulang Email Broadcast
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Rilis yang Dikirimkan:</label>
                        <div class="p-2 bg-light border rounded-1 small" id="resendReleaseInfo"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Daftar Email Penerima <span class="text-danger">*</span></label>
                        <textarea name="customRecipients" id="resendRecipients" rows="3" class="form-control form-control-sm" placeholder="user1@domain.com, user2@domain.com" style="border-radius: 4px;" required></textarea>
                        <small class="text-muted" style="font-size: 11px;">Pisahkan antar email dengan koma atau baris baru.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4 border-top" style="border-radius: 0 0 6px 6px;">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius: 4px;" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-dark btn-sm px-4" style="border-radius: 4px;">Kirim Sekarang</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleEmailRecipientSection(isChecked) {
        const el = document.getElementById('emailRecipientSection');
        if (el) el.style.display = isChecked ? 'block' : 'none';
    }

    function openViewModal(id, title, version, type, status, description, actionRequired, releaseDate, updatedAt, author) {
        document.getElementById('viewModalTitle').textContent = title;
        document.getElementById('viewVersionTag').textContent = version;
        document.getElementById('viewReleaseDate').textContent = releaseDate;
        document.getElementById('viewUpdatedAt').textContent = updatedAt;
        document.getElementById('viewAuthor').textContent = author;
        
        const statusBadge = document.getElementById('viewStatusBadge');
        statusBadge.textContent = (status || 'PUBLISHED').toUpperCase();

        const badge = document.getElementById('viewTypeBadge');
        badge.textContent = type;

        // Format description with bullets
        const lines = description.split('\n');
        let html = '';
        lines.forEach(line => {
            const trimmed = line.trim();
            if (trimmed.startsWith('-') || trimmed.startsWith('*') || trimmed.startsWith('•')) {
                html += '<div class="d-flex align-items-start mb-1"><span class="me-2 text-muted">&bull;</span><span>' + escapeHtml(trimmed.replace(/^[-*•]\s*/, '')) + '</span></div>';
            } else if (trimmed) {
                html += '<p class="mb-2">' + escapeHtml(trimmed) + '</p>';
            }
        });
        document.getElementById('viewChangelogBody').innerHTML = html || '<span class="text-muted">Tidak ada rincian tambahan.</span>';

        const actionContainer = document.getElementById('viewActionContainer');
        const actionText = document.getElementById('viewActionText');
        if (actionRequired && actionRequired.trim()) {
            actionText.textContent = actionRequired;
            actionContainer.style.display = 'block';
        } else {
            actionContainer.style.display = 'none';
        }

        const modal = new bootstrap.Modal(document.getElementById('viewDetailModal'));
        modal.show();
    }

    function openEditModal(id, title, version, type, status, releaseDate, description, actionRequired, audience, showPopup, isActive) {
        document.getElementById('editId').value = id;
        document.getElementById('editTitle').value = title;
        document.getElementById('editVersion').value = version;
        document.getElementById('editUpdateType').value = type;
        document.getElementById('editReleaseStatus').value = status || 'Published';
        document.getElementById('editReleaseDate').value = releaseDate || '';
        document.getElementById('editDescription').value = description;
        document.getElementById('editActionRequired').value = actionRequired || '';
        document.getElementById('editTargetAudience').value = audience || 'All Users';
        document.getElementById('editShowPopupAlert').checked = showPopup;
        document.getElementById('editIsActive').checked = isActive;

        const modal = new bootstrap.Modal(document.getElementById('editUpdateModal'));
        modal.show();
    }

    function openResendModal(id, title, version, recipients) {
        document.getElementById('resendId').value = id;
        document.getElementById('resendReleaseInfo').textContent = `${title} (${version})`;
        document.getElementById('resendRecipients').value = recipients;

        const modal = new bootstrap.Modal(document.getElementById('resendEmailModal'));
        modal.show();
    }

    function sendPreviewTestEmail() {
        const title = document.getElementById('createTitle').value;
        const version = document.getElementById('createVersion').value;
        const type = document.getElementById('createUpdateType').value;
        const desc = document.getElementById('createDescription').value;
        const action = document.getElementById('createActionRequired').value;

        const testEmail = prompt('Masukkan email tujuan untuk menerima TEST PREVIEW:', '@defaultReceiver');
        if (!testEmail || !testEmail.trim()) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const params = new URLSearchParams();
        params.append('title', title);
        params.append('version', version);
        params.append('updateType', type);
        params.append('description', desc);
        params.append('actionRequired', action);
        params.append('testEmail', testEmail.trim());

        fetch('/DeveloperUpdates/SendTestEmail', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: params.toString()
        })
        .then(r => r.json())
        .then(res => {
            alert(res.message);
        })
        .catch(err => {
            console.error(err);
            alert('Gagal mengirim test email.');
        });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}
