@model IEnumerable<UPMS.Web.Models.Entities.SystemUpdate>
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Pembaruan Sistem & Catatan Rilis";
    string currentType = ViewBag.SelectedType as string ?? "all";
    string currentStatus = ViewBag.SelectedStatus as string ?? "all";
    string searchQuery = ViewBag.SearchQuery as string ?? "";
    string defaultReceiver = ViewBag.DefaultReceiverEmail as string ?? "";
    bool emailEnabled = ViewBag.EmailEnabled != null && (bool)ViewBag.EmailEnabled;
}

<style>
    /* Uniform Font: Segoe UI / Inter / Helvetica Neue (Matching the SAS reference image) */
    *, *::before, *::after,
    .dev-portal, .dev-portal * {
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', Roboto, 'Helvetica Neue', Arial, sans-serif !important;
        letter-spacing: -0.01em;
    }

    .dev-portal {
        color: #0f172a;
    }

    .dev-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 14px;
        margin-bottom: 16px;
    }

    .dev-title {
        font-size: 19px;
        font-weight: 600;
        color: #0f172a;
        margin: 0;
    }

    .dev-subtitle {
        font-size: 13px;
        color: #64748b;
        margin-top: 2px;
        margin-bottom: 0;
    }

    /* Clean Bordered Stats Bar */
    .dev-summary-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
    }

    .dev-stat-box {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        font-size: 12.5px;
        color: #64748b;
        line-height: 1.3;
    }

    .dev-stat-box strong {
        color: #0f172a;
        font-weight: 600;
    }

    /* Clean Bordered Filter Navigation */
    .dev-filter-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e2e8f0;
    }

    .dev-filter-links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .dev-filter-btn {
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        background: #ffffff;
        color: #0f172a;
        font-size: 12.5px;
        padding: 5px 12px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s ease;
        line-height: 1.3;
    }

    .dev-filter-btn:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
        color: #0f172a;
    }

    .dev-filter-btn.active {
        border: 1px solid #0f172a;
        background: #0f172a;
        color: #ffffff;
        font-weight: 500;
    }

    .dev-filter-btn.active:hover {
        background: #1e293b;
        border-color: #1e293b;
        color: #ffffff;
    }

    /* Clean Bordered Table */
    .dev-table-container {
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        background: #ffffff;
        overflow: hidden;
    }

    .dev-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
    }

    .dev-table th {
        font-size: 11.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        padding: 10px 14px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        text-align: left;
    }

    .dev-table td {
        padding: 12px 14px;
        vertical-align: top;
        border-bottom: 1px solid #f1f5f9;
        font-size: 13px;
        color: #0f172a;
    }

    .dev-table tr:last-child td {
        border-bottom: none;
    }

    .dev-table tr:hover td {
        background-color: #fafbfc;
    }

    .dev-action-btn {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        color: #64748b;
        padding: 4px 7px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.15s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .dev-action-btn:hover {
        border-color: #0f172a;
        color: #0f172a;
        background: #f8fafc;
    }

    .dev-publish-btn {
        background: #0f172a;
        border: 1px solid #0f172a;
        border-radius: 4px;
        color: #ffffff;
        padding: 4px 7px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .dev-publish-btn:hover {
        background: #1e293b;
        border-color: #1e293b;
        color: #ffffff;
    }
</style>

<div class="dev-portal">
    <!-- Header -->
    <div class="dev-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="dev-title">Pembaruan Sistem &amp; Catatan Rilis</h4>
            <p class="dev-subtitle">Dokumentasi riwayat rilis, draf pembaruan, perbaikan bug, dan notifikasi sistem.</p>
        </div>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a asp-controller="EmailSettings" asp-action="Index" class="dev-action-btn" style="font-size: 13px;" title="Konfigurasi Pengiriman Email SMTP">
                <i class="bi bi-gear me-1"></i> Pengaturan SMTP
            </a>
            <button type="button" class="btn btn-dark btn-sm px-3 py-1 fw-medium" style="border-radius: 4px; font-size: 13px;" data-bs-toggle="modal" data-bs-target="#createUpdateModal">
                <i class="bi bi-plus-lg me-1"></i> Buat Pembaruan
            </button>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 mb-3" role="alert" style="border-radius: 4px; font-size: 13px; color: #0f172a; background: #fafafa;">
            <div class="d-flex align-items-center">
                <i class="bi bi-check2-circle me-2 text-dark fs-6"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 mb-3" role="alert" style="border-radius: 4px; font-size: 13px; color: #0f172a; background: #fafafa;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-circle me-2 text-dark fs-6"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Stats Bar with Clean 1px Borders -->
    <div class="dev-summary-bar">
        <div class="dev-stat-box">Total Catatan: <strong>@ViewBag.TotalCount</strong></div>
        <div class="dev-stat-box">Rilis Aktif: <strong>@ViewBag.PublishedCount</strong></div>
        <div class="dev-stat-box">Draf: <strong>@ViewBag.DraftCount</strong></div>
        <div class="dev-stat-box">Perbaikan Bug: <strong>@ViewBag.BugFixCount</strong></div>
        <div class="dev-stat-box">Peningkatan: <strong>@ViewBag.ImprovementCount</strong></div>
        <div class="dev-stat-box">Fitur Baru: <strong>@ViewBag.NewFeatureCount</strong></div>
    </div>

    <!-- Filter Nav with Clean 1px Border Buttons -->
    <div class="dev-filter-nav">
        <div class="dev-filter-links">
            <a asp-action="Index" asp-route-type="all" asp-route-status="all" asp-route-search="@searchQuery"
               class="dev-filter-btn @(currentType == "all" && currentStatus == "all" ? "active" : "")">
                Semua (@ViewBag.TotalCount)
            </a>
            <a asp-action="Index" asp-route-type="@currentType" asp-route-status="Published" asp-route-search="@searchQuery"
               class="dev-filter-btn @(currentStatus.Equals("Published", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                Rilis (@ViewBag.PublishedCount)
            </a>
            <a asp-action="Index" asp-route-type="@currentType" asp-route-status="Draft" asp-route-search="@searchQuery"
               class="dev-filter-btn @(currentStatus.Equals("Draft", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                Draf (@ViewBag.DraftCount)
            </a>
            <a asp-action="Index" asp-route-type="Bug Fix" asp-route-status="@currentStatus" asp-route-search="@searchQuery"
               class="dev-filter-btn @(currentType == "Bug Fix" ? "active" : "")">
                Bug Fix (@ViewBag.BugFixCount)
            </a>
            <a asp-action="Index" asp-route-type="Improvement" asp-route-status="@currentStatus" asp-route-search="@searchQuery"
               class="dev-filter-btn @(currentType == "Improvement" ? "active" : "")">
                Improvement (@ViewBag.ImprovementCount)
            </a>
            <a asp-action="Index" asp-route-type="New Feature" asp-route-status="@currentStatus" asp-route-search="@searchQuery"
               class="dev-filter-btn @(currentType == "New Feature" ? "active" : "")">
                Fitur Baru (@ViewBag.NewFeatureCount)
            </a>
        </div>

        <form method="get" asp-action="Index" class="d-flex align-items-center">
            <input type="hidden" name="type" value="@currentType" />
            <input type="hidden" name="status" value="@currentStatus" />
            <div class="input-group input-group-sm" style="width: 260px;">
                <input type="text" name="search" value="@searchQuery" class="form-control" placeholder="Cari catatan..." style="border-radius: 4px 0 0 4px; font-size: 12.5px; border: 1px solid #e2e8f0; border-right: none;" />
                <button class="btn btn-dark" type="submit" style="border-radius: 0 4px 4px 0; font-size: 12.5px; padding: 5px 14px; border: 1px solid #0f172a;"><i class="bi bi-search me-1"></i> Cari</button>
                @if (!string.IsNullOrWhiteSpace(searchQuery) || currentType != "all" || currentStatus != "all")
                {
                    <a asp-action="Index" class="btn btn-outline-secondary ms-1" style="border-radius: 4px; font-size: 12.5px; border: 1px solid #e2e8f0; padding: 5px 10px;" title="Reset Pencarian"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>

    <!-- Table of Release Records in Clean Bordered Container -->
    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted border" style="border-radius: 4px; background: #ffffff;">
            <i class="bi bi-inbox fs-3 text-secondary opacity-50 d-block mb-2"></i>
            <div class="fw-medium text-dark mb-1">Belum ada catatan pembaruan</div>
            <div class="small text-muted mb-3">Klik tombol "Buat Pembaruan" untuk menambahkan perbaikan atau draf rilis baru.</div>
            <button type="button" class="btn btn-dark btn-sm px-3" style="border-radius: 4px;" data-bs-toggle="modal" data-bs-target="#createUpdateModal">
                <i class="bi bi-plus-lg me-1"></i> Buat Pembaruan Pertama
            </button>
        </div>
    }
    else
    {
        <div class="dev-table-container table-responsive">
            <table class="dev-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">Versi &amp; Status</th>
                        <th style="width: 130px;">Kategori</th>
                        <th>Judul Pembaruan &amp; Rincian Perubahan</th>
                        <th style="width: 170px;">Tanggal Rilis &amp; Update</th>
                        <th style="width: 130px;">Email Status</th>
                        <th style="width: 140px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isDraft = item.ReleaseStatus.Equals("Draft", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @item.Version &bull; @(isDraft ? "Draft" : "Rilis")
                                </div>
                                <div class="text-muted" style="font-size: 11.5px; margin-top: 2px;">
                                    Target: @item.TargetAudience
                                </div>
                            </td>
                            <td>
                                <div class="text-dark fw-medium">
                                    @item.UpdateType
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark" style="font-size: 13.5px;">@item.Title</div>
                                <div class="text-muted text-truncate mt-1" style="max-width: 520px; font-size: 12.5px; line-height: 1.4;">
                                    @item.Description
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.ActionRequired))
                                {
                                    <div class="mt-1" style="font-size: 11.5px; color: #64748b;">
                                        <i class="bi bi-info-circle me-1"></i><span class="text-dark fw-medium">Action:</span> @item.ActionRequired
                                    </div>
                                }
                            </td>
                            <td>
                                <div style="font-size: 12px; color: #0f172a;">
                                    <span class="text-muted">Rilis:</span> 
                                    @(item.ReleaseDate.HasValue ? item.ReleaseDate.Value.ToString("dd MMM yyyy HH:mm") : "- (Belum Rilis)")
                                </div>
                                <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
                                    Update: @((item.UpdatedAt ?? item.CreatedAt).ToString("dd MMM yyyy HH:mm"))
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 12px; color: #0f172a;">
                                    @(item.SendEmail && item.EmailSentCount > 0 ? $"Email Terkirim ({item.EmailSentCount})" : "In-App Lonceng")
                                </div>
                                <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
                                    By: @item.CreatedBy
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (isDraft)
                                    {
                                        <form asp-action="PublishDraft" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Publikasikan draf ini ke sistem dan ikon lonceng sekarang?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dev-publish-btn" title="Publikasikan Draf Ini Sekarang">
                                                <i class="bi bi-send-check"></i>
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="dev-action-btn" title="Lihat Rincian Rilis" onclick="openViewModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Title))', '@item.Version', '@item.UpdateType', '@item.ReleaseStatus', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Description))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.ActionRequired ?? ""))', '@(item.ReleaseDate.HasValue ? item.ReleaseDate.Value.ToString("dd MMMM yyyy HH:mm") : "-")', '@((item.UpdatedAt ?? item.CreatedAt).ToString("dd MMMM yyyy HH:mm"))', '@item.CreatedBy')">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="dev-action-btn" title="Kirim Ulang Email Broadcast" onclick="openResendModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Title))', '@item.Version', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.RecipientEmails ?? defaultReceiver))')">
                                        <i class="bi bi-envelope-arrow-up"></i>
                                    </button>
                                    <button type="button" class="dev-action-btn" title="Edit Update" onclick="openEditModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Title))', '@item.Version', '@item.UpdateType', '@item.ReleaseStatus', '@(item.ReleaseDate.HasValue ? item.ReleaseDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Description))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.ActionRequired ?? ""))', '@item.TargetAudience', @(item.ShowPopupAlert.ToString().ToLower()), @(item.IsActive.ToString().ToLower()))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus catatan rilis ini?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dev-action-btn" title="Hapus Update">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODAL 1: Create New Update -->
<div class="modal fade" id="createUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 6px;">
            <form asp-action="Create" method="post" id="createUpdateForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-white border-bottom py-3 px-4" style="border-radius: 6px 6px 0 0;">
                    <div>
                        <h5 class="modal-title fw-semibold text-dark mb-0" style="font-size: 16px;">
                            Buat Catatan Rilis &amp; Draf Pembaruan
                        </h5>
                        <p class="text-muted small mb-0 mt-1" style="font-size: 12px;">Dokumentasikan perubahan sistem secara terstruktur.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Status Rilis <span class="text-danger">*</span></label>
                            <select name="ReleaseStatus" id="createReleaseStatus" class="form-select form-select-sm" style="border-radius: 4px;" required onchange="toggleReleaseDateSection(this.value)">
                                <option value="Published">Published (Rilis)</option>
                                <option value="Draft">Draft (Simpan Draf)</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Versi Rilis <span class="text-danger">*</span></label>
                            <input type="text" name="Version" id="createVersion" class="form-control form-control-sm font-monospace" placeholder="e.g. v2.5.3" value="v2.5.3" style="border-radius: 4px;" required />
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Kategori <span class="text-danger">*</span></label>
                            <select name="UpdateType" id="createUpdateType" class="form-select form-select-sm" style="border-radius: 4px;" required>
                                <option value="Improvement">Improvement (Peningkatan)</option>
                                <option value="Bug Fix">Bug Fix (Perbaikan Bug)</option>
                                <option value="New Feature">New Feature (Fitur Baru)</option>
                                <option value="System Alert">System Alert (Pemberitahuan Sistem)</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Target Pengguna</label>
                            <select name="TargetAudience" class="form-select form-select-sm" style="border-radius: 4px;">
                                <option value="All Users">Semua Pengguna</option>
                                <option value="Admin Only">Khusus Admin</option>
                                <option value="Technician Only">Khusus Teknisi</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Judul Pembaruan <span class="text-danger">*</span></label>
                        <input type="text" name="Title" id="createTitle" class="form-control form-control-sm" placeholder="Contoh: Penyempurnaan Tampilan UI/UX & Notifikasi Lonceng Sistem" style="border-radius: 4px;" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Rincian Perubahan / Changelog <span class="text-danger">*</span></label>
                        <textarea name="Description" id="createDescription" rows="5" class="form-control form-control-sm" placeholder="Gunakan tanda strip (-) untuk membuat poin changelog:&#10;- Pembaruan komponen A untuk performa lebih cepat&#10;- Perbaikan bug validasi form pada menu B&#10;- Penambahan indikator status rilis dan tanggal update" style="border-radius: 4px; font-size: 12.5px; line-height: 1.5;" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Petunjuk / Tindakan Pengguna (Action Required) <span class="text-muted fw-normal">(Opsional)</span></label>
                        <input type="text" name="ActionRequired" id="createActionRequired" class="form-control form-control-sm" placeholder="Contoh: Klik ikon lonceng di pojok kanan atas untuk melihat ringkasan rilis." style="border-radius: 4px;" />
                    </div>

                    <!-- Email Broadcast Options -->
                    <div class="p-3 bg-light border rounded-1 mb-2">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" name="SendEmail" value="true" id="checkSendEmail" onchange="toggleEmailRecipientSection(this.checked)">
                            <label class="form-check-label small fw-semibold text-dark" for="checkSendEmail">
                                Kirim Email Broadcast Otomatis ke Tim (via SMTP)
                            </label>
                        </div>
                        <small class="text-muted d-block" style="font-size: 11.5px;">Jika disimpan sebagai Draf, email dan lonceng belum akan aktif hingga draf dipublikasikan.</small>

                        <div id="emailRecipientSection" style="display: none;" class="mt-3 pt-2 border-top">
                            <label class="form-label small fw-semibold text-dark mb-1">
                                Daftar Email Penerima (Pisahkan dengan tanda koma):
                            </label>
                            <input type="text" name="customRecipients" id="customRecipients" class="form-control form-control-sm" value="@defaultReceiver" placeholder="e.g. user1@yasulor.com, user2@yasulor.com" style="border-radius: 4px;" />
                            <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
                                <span class="text-muted small" style="font-size: 11.5px;">
                                    Status SMTP: <strong>@(emailEnabled ? "Aktif & Siap Kirim" : "Belum Diaktifkan di Email Settings")</strong>
                                </span>
                                <button type="button" class="btn btn-outline-secondary btn-xs py-1 px-2" style="font-size: 11px; border-radius: 4px;" onclick="sendPreviewTestEmail()">
                                    <i class="bi bi-send-check me-1"></i> Kirim Test Email Preview
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4 border-top" style="border-radius: 0 0 6px 6px;">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius: 4px;" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-dark btn-sm px-4" style="border-radius: 4px;">
                        Simpan Catatan Rilis
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: View Update Details -->
<div class="modal fade" id="viewDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 6px;">
            <div class="modal-header bg-white border-bottom py-3 px-4" style="border-radius: 6px 6px 0 0;">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 12px; color: #64748b;">
                        <span id="viewStatusBadge" class="fw-semibold text-dark">PUBLISHED</span>
                        <span>&bull;</span>
                        <span id="viewTypeBadge" class="text-dark">IMPROVEMENT</span>
                    </div>
                    <h5 class="modal-title fw-semibold text-dark mb-0" id="viewModalTitle">Judul Update</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                <div class="row g-2 border-bottom pb-2 mb-3 small">
                    <div class="col-md-3 col-6">
                        <span class="text-muted">Versi:</span>
                        <strong class="text-dark d-block" id="viewVersionTag">v1.0.0</strong>
                    </div>
                    <div class="col-md-4 col-6">
                        <span class="text-muted">Tanggal Rilis:</span>
                        <strong class="text-dark d-block" id="viewReleaseDate">-</strong>
                    </div>
                    <div class="col-md-5 col-12">
                        <span class="text-muted">Terakhir Diperbarui:</span>
                        <span class="text-dark d-block" id="viewUpdatedAt">-</span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="fw-semibold text-dark small text-uppercase mb-2" style="font-size: 11.5px;">Rincian Perubahan &amp; Peningkatan:</div>
                    <div class="p-3 bg-light border rounded-1" id="viewChangelogBody" style="font-size: 13px; line-height: 1.6;"></div>
                </div>

                <div id="viewActionContainer" style="display: none;" class="p-3 bg-light border rounded-1 mb-3">
                    <div class="fw-semibold text-dark small text-uppercase mb-1" style="font-size: 11.5px;">Tindakan yang Diperlukan:</div>
                    <div id="viewActionText" class="text-dark small"></div>
                </div>

                <div class="text-muted small mt-3" style="font-size: 11.5px;">
                    Dipublikasikan oleh: <strong id="viewAuthor" class="text-dark">Developer</strong>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-4 border-top" style="border-radius: 0 0 6px 6px;">
                <button type="button" class="btn btn-outline-secondary btn-sm px-4" style="border-radius: 4px;" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 3: Edit Update Modal -->
<div class="modal fade" id="editUpdateModal" tabindex="-1" aria-hidden="true">
