                <input type="hidden" name="id" id="editId" />
                <div class="modal-header bg-white border-bottom py-3 px-4" style="border-radius: 6px 6px 0 0;">
                    <h5 class="modal-title fw-semibold text-dark mb-0" style="font-size: 16px;">
                        Edit Catatan Rilis
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Status Rilis</label>
                            <select name="releaseStatus" id="editReleaseStatus" class="form-select form-select-sm" style="border-radius: 4px;" required>
                                <option value="Published">Published (Rilis)</option>
                                <option value="Draft">Draft (Simpan Draf)</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Versi</label>
                            <input type="text" name="version" id="editVersion" class="form-control form-control-sm font-monospace" style="border-radius: 4px;" required />
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Kategori</label>
                            <select name="updateType" id="editUpdateType" class="form-select form-select-sm" style="border-radius: 4px;" required>
                                <option value="Improvement">Improvement</option>
                                <option value="Bug Fix">Bug Fix</option>
                                <option value="New Feature">New Feature</option>
                                <option value="System Alert">System Alert</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Target</label>
                            <select name="targetAudience" id="editTargetAudience" class="form-select form-select-sm" style="border-radius: 4px;">
                                <option value="All Users">Semua Pengguna</option>
                                <option value="Admin Only">Khusus Admin</option>
                                <option value="Technician Only">Khusus Teknisi</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8 col-12">
                            <label class="form-label small fw-semibold text-dark mb-1">Judul Pembaruan</label>
                            <input type="text" name="title" id="editTitle" class="form-control form-control-sm" style="border-radius: 4px;" required />
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label small fw-semibold text-dark mb-1">Tanggal Rilis (Opsional)</label>
                            <input type="datetime-local" name="releaseDate" id="editReleaseDate" class="form-control form-control-sm" style="border-radius: 4px;" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Rincian Perubahan / Changelog</label>
                        <textarea name="description" id="editDescription" rows="5" class="form-control form-control-sm" style="border-radius: 4px; font-size: 12.5px; line-height: 1.5;" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Petunjuk Pengguna (Action Required)</label>
