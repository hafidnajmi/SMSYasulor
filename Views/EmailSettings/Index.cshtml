@model UPMS.Web.Controllers.EmailSettingsViewModel

@{
    ViewData["Title"] = "Email Settings";
}

<!-- Title Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81;">Email &amp; Auto-Alert Settings</h3>
        <p class="text-muted small mb-0">Konfigurasi SMTP server, email pengirim/penerima, dan jadwal auto-alert laporan stok kritis.</p>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()

    <!-- Enable/Disable Master Switch Banner -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:0;">
        <div class="card-body p-3 d-flex align-items-center justify-content-between bg-white border">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded bg-primary-subtle text-primary">
                    <i class="bi bi-envelope-at-fill fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Status Fitur Email &amp; Auto-Alert</h6>
                    <span class="small text-muted">Aktifkan atau nonaktifkan seluruh integrasi email otomatis dalam sistem</span>
                </div>
            </div>
            <div class="form-check form-switch fs-5">
                <input class="form-check-input" type="checkbox" asp-for="EmailEnabled" role="switch" id="emailEnabledSwitch" onchange="updateEmailStatusBadge(this.checked)">
                <label class="form-check-label ms-2 align-middle" for="emailEnabledSwitch">
                    <span id="emailStatusBadge" class="badge @(Model.EmailEnabled ? "bg-success" : "bg-secondary")" style="font-size:12px;">
                        @(Model.EmailEnabled ? "AKTIF" : "NONAKTIF")
                    </span>
                </label>
            </div>
        </div>
    </div>


    <!-- Auto-Alert & Auto-RFQ Schedule Info -->
    <div class="card border-0 mb-4" style="border-radius:0; border: 1px solid #d0d0d0 !important;">
        <div class="card-header bg-white py-2 px-3 fw-bold small border-bottom" style="color: #0F4C81; border-radius:0;">
            Jadwal Pengiriman Otomatis (Auto-Alert &amp; Auto-RFQ)
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-bordered mb-0" style="font-size:13px; border-radius:0;">
                <thead style="background-color:#f5f5f5;">
                    <tr>
                        <th class="px-3 py-2 text-secondary fw-bold" style="width:150px;">TIPE</th>
                        <th class="px-3 py-2 text-secondary fw-bold" style="width:90px;">FREKUENSI</th>
                        <th class="px-3 py-2 text-secondary fw-bold">INTERVAL KIRIM</th>
                        <th class="px-3 py-2 text-secondary fw-bold">TERAKHIR DIKIRIM</th>
                        <th class="px-3 py-2 text-secondary fw-bold">PENGIRIMAN BERIKUTNYA</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="px-3 py-2">
                            <span style="font-size:11px; font-weight:bold; color:#0F4C81; background-color:#e8f0fb; padding:2px 7px; border:1px solid #b0c4e8;">AUTO-ALERT</span>
                        </td>
                        <td class="px-3 py-2 fw-bold" style="color:#0F4C81;">FAST</td>
                        <td class="px-3 py-2">Setiap <strong>2 Minggu</strong> (14 hari)</td>
                        <td class="px-3 py-2 text-muted">@ViewData["LastSentFast"]</td>
                        <td class="px-3 py-2">@ViewData["NextSentFast"]</td>
                    </tr>
                    <tr style="background-color:#fafafa;">
                        <td class="px-3 py-2">
                            <span style="font-size:11px; font-weight:bold; color:#0F4C81; background-color:#e8f0fb; padding:2px 7px; border:1px solid #b0c4e8;">AUTO-ALERT</span>
                        </td>
                        <td class="px-3 py-2 fw-bold" style="color:#0F4C81;">SLOW</td>
                        <td class="px-3 py-2">Setiap <strong>1 Bulan</strong> (30 hari)</td>
                        <td class="px-3 py-2 text-muted">@ViewData["LastSentSlow"]</td>
                        <td class="px-3 py-2">@ViewData["NextSentSlow"]</td>
                    </tr>
                    <tr>
                        <td class="px-3 py-2">
                            <span style="font-size:11px; font-weight:bold; color:#885500; background-color:#fff8e6; padding:2px 7px; border:1px solid #d4b86a;">AUTO-RFQ</span>
                        </td>
                        <td class="px-3 py-2 fw-bold" style="color:#885500;">FAST</td>
                        <td class="px-3 py-2">Setiap <strong>2 Minggu</strong> (14 hari)</td>
                        <td class="px-3 py-2 text-muted">@ViewData["RfqLastSentFast"]</td>
                        <td class="px-3 py-2">@ViewData["RfqNextSentFast"]</td>
                    </tr>
                    <tr style="background-color:#fafafa;">
                        <td class="px-3 py-2">
                            <span style="font-size:11px; font-weight:bold; color:#885500; background-color:#fff8e6; padding:2px 7px; border:1px solid #d4b86a;">AUTO-RFQ</span>
                        </td>
                        <td class="px-3 py-2 fw-bold" style="color:#885500;">SLOW</td>
                        <td class="px-3 py-2">Setiap <strong>1 Bulan</strong> (30 hari)</td>
                        <td class="px-3 py-2 text-muted">@ViewData["RfqLastSentSlow"]</td>
                        <td class="px-3 py-2">@ViewData["RfqNextSentSlow"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-2 px-3" style="font-size:11px; color:#777; border-radius:0;">
            <strong>Auto-Alert:</strong> Semua item stok &lt; Safety Stock, dikelompokkan per frekuensi. &nbsp;|&nbsp;
            <strong>Auto-RFQ:</strong> Hanya item dengan centang Alert aktif di Sparepart Catalog, disertai nama supplier dari Admin Portal. Timestamp tersimpan di database.
        </div>
    </div>


    <div class="row g-4">
        <!-- 1. Stock Report & Auto-Alert SMTP Card -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius:0;">
                <div class="card-header bg-white py-2 px-3 fw-bold small border-bottom" style="color: #0F4C81;">
                    <i class="bi bi-gear-fill me-2 text-primary"></i>Konfigurasi SMTP Report &amp; Auto-Alert
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-bold text-secondary mb-1">SMTP Server Host</label>
                            <input type="text" asp-for="SmtpServer" class="form-control form-control-sm" placeholder="e.g. smtp.office365.com" id="smtpServerInput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Port</label>
                            <input type="number" asp-for="SmtpPort" class="form-control form-control-sm" placeholder="587" id="smtpPortInput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Email Pengirim (Sender)</label>
                        <input type="email" asp-for="SenderEmail" class="form-control form-control-sm" placeholder="notification@company.com" id="senderEmailInput" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Password / App Password</label>
                        <input type="password" asp-for="SenderPassword" class="form-control form-control-sm" placeholder="••••••••••••" id="senderPasswordInput" />
                        <span class="form-text text-muted" style="font-size:11px;">Biarkan kosong jika tidak ingin mengubah password yang tersimpan.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Email Penerima Laporan (Receiver)</label>
                        <input type="text" asp-for="ReceiverEmail" class="form-control form-control-sm" id="receiverEmailInput" placeholder="admin@domain.com, manager@domain.com" />
                        <span class="form-text text-muted" style="font-size:11px;">Bisa memasukkan lebih dari 1 email (pisahkan dengan koma, contoh: <code>admin@domain.com, manager@domain.com</code>).</span>
                    </div>

                    <hr class="my-3 text-muted" />

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-ems-outline btn-sm" onclick="testSmtpConnection()">
                            <i class="bi bi-lightning-charge text-warning me-1"></i>Test Koneksi SMTP
                        </button>
                        <button type="button" class="btn btn-ems-outline btn-sm" onclick="sendTestReport()">
                            <i class="bi bi-send-check text-success me-1"></i>Kirim Percobaan Email
                        </button>
                    </div>

                    <div id="smtpTestStatus" class="mt-2 small"></div>
                </div>
            </div>
        </div>

        <!-- 2. RFQ / Bidding SMTP Card -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius:0;">
                <div class="card-header bg-white py-2 px-3 fw-bold small border-bottom" style="color: #0F4C81;">
                    <i class="bi bi-file-earmark-spreadsheet me-2 text-info"></i>Konfigurasi SMTP RFQ &amp; Supplier Bidding
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-bold text-secondary mb-1">SMTP Server RFQ</label>
                            <input type="text" asp-for="SmtpServerRfq" class="form-control form-control-sm" placeholder="smtp.office365.com" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Port</label>
                            <input type="number" asp-for="SmtpPortRfq" class="form-control form-control-sm" placeholder="587" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Email Pengirim RFQ</label>
                        <input type="email" asp-for="SenderEmailRfq" class="form-control form-control-sm" placeholder="procurement@company.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Password RFQ</label>
                        <input type="password" asp-for="SenderPasswordRfq" class="form-control form-control-sm" placeholder="••••••••••••" id="rfqPasswordInput" />
                        <span class="form-text text-muted" style="font-size:11px;">Biarkan kosong jika tidak ingin mengubah password yang tersimpan.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Email Penerima RFQ (Receiver)</label>
                        <input type="text" asp-for="ReceiverEmailRfq" class="form-control form-control-sm" id="receiverEmailRfqInput" placeholder="procurement@domain.com, rfq@domain.com" />
                        <span class="form-text text-muted" style="font-size:11px;">Bisa memasukkan lebih dari 1 email penerima RFQ (pisahkan dengan koma atau titik koma).</span>
                    </div>

                    <hr class="my-3 text-muted" />

                    <!-- RFQ Test Button -->
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-ems-outline btn-sm" onclick="sendTestRfq()" id="btnSendTestRfq">
                            <i class="bi bi-send-check text-warning me-1"></i>Kirim Percobaan RFQ
                        </button>
                    </div>
                    <div id="rfqTestStatus" class="mt-2 small"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Save Buttons Footer -->
    <div class="mt-4 d-flex justify-content-end gap-2">
        <a href="/" class="btn btn-ems-outline btn-sm">Batal</a>
        <button type="submit" class="btn btn-ems-primary btn-sm px-4">
            <i class="bi bi-check-circle me-1"></i>Simpan Pengaturan Email
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function updateEmailStatusBadge(isCheck) {
            const badge = document.getElementById('emailStatusBadge');
            if (isCheck) {
                badge.className = 'badge bg-success';
                badge.innerText = 'AKTIF';
            } else {
                badge.className = 'badge bg-secondary';
                badge.innerText = 'NONAKTIF';
            }
        }

        async function testSmtpConnection() {
            const statusDiv = document.getElementById('smtpTestStatus');
            statusDiv.innerHTML = '<span class="text-secondary"><i class="spinner-border spinner-border-sm me-1"></i>Mencoba koneksi ke SMTP Server...</span>';

            const server = document.getElementById('smtpServerInput').value;
            const port = document.getElementById('smtpPortInput').value;
            const email = document.getElementById('senderEmailInput').value;
            const password = document.getElementById('senderPasswordInput').value;

            try {
                const res = await fetch('/EmailSettings/TestSmtpConnection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ server, port, email, password })
                });
                const data = await res.json();

                if (data.success) {
                    statusDiv.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>${data.message}</span>`;
                } else {
                    statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>${data.message}</span>`;
                }
            } catch (err) {
                statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>Error: ${err.message}</span>`;
            }
        }

        async function sendTestReport() {
            const statusDiv = document.getElementById('smtpTestStatus');
            statusDiv.innerHTML = '<span class="text-secondary"><i class="spinner-border spinner-border-sm me-1"></i>Menyusun dan mengirim email laporan stok...</span>';

            const server = document.getElementById('smtpServerInput').value;
            const port = document.getElementById('smtpPortInput').value;
            const sender = document.getElementById('senderEmailInput').value;
            const pass = document.getElementById('senderPasswordInput').value;
            const receiver = document.getElementById('receiverEmailInput').value;

            try {
                const res = await fetch('/EmailSettings/SendTestReport', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ server, port, sender, pass, receiver })
                });
                const data = await res.json();

                if (data.success) {
                    statusDiv.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>${data.message}</span>`;
                } else {
                    statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>${data.message}</span>`;
                }
            } catch (err) {
                statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>Error: ${err.message}</span>`;
            }
        }

        async function sendTestRfq() {
            const btn = document.getElementById('btnSendTestRfq');
            const statusDiv = document.getElementById('rfqTestStatus');
            btn.disabled = true;
            statusDiv.innerHTML = '<span class="text-secondary"><i class="spinner-border spinner-border-sm me-1"></i>Menyusun dan mengirim email RFQ draft...</span>';

            const pass = document.getElementById('rfqPasswordInput').value;
            const receiver = document.getElementById('receiverEmailRfqInput').value;

            try {
                const res = await fetch('/EmailSettings/SendTestRfq', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ pass, receiver })
                });
                const data = await res.json();

                if (data.success) {
                    statusDiv.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>${data.message}</span>`;
                } else {
                    statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>${data.message}</span>`;
                }
            } catch (err) {
                statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>Error: ${err.message}</span>`;
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}
