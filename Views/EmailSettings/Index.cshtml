@model UPMS.Web.Controllers.EmailSettingsViewModel

@{
    ViewData["Title"] = "Email Settings";
}

<!-- Title Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81;">Email &amp; Auto-Alert Settings</h3>
        <p class="text-muted small mb-0">Konfigurasi SMTP server, email pengirim/penerima, dan jadwal auto-alert laporan stok kritis.</p>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()

    <!-- Enable/Disable Master Switch Banner -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius:0;">
        <div class="card-body p-3 d-flex align-items-center justify-content-between bg-white border">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded bg-primary-subtle text-primary">
                    <i class="bi bi-envelope-at-fill fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Status Fitur Email &amp; Auto-Alert</h6>
                    <span class="small text-muted">Aktifkan atau nonaktifkan seluruh integrasi email otomatis dalam sistem</span>
                </div>
            </div>
            <div class="form-check form-switch fs-5">
                <input class="form-check-input" type="checkbox" asp-for="EmailEnabled" role="switch" id="emailEnabledSwitch" onchange="updateEmailStatusBadge(this.checked)">
                <label class="form-check-label ms-2 align-middle" for="emailEnabledSwitch">
                    <span id="emailStatusBadge" class="badge @(Model.EmailEnabled ? "bg-success" : "bg-secondary")" style="font-size:12px;">
                        @(Model.EmailEnabled ? "AKTIF" : "NONAKTIF")
                    </span>
                </label>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 1. Stock Report & Auto-Alert SMTP Card -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius:0;">
                <div class="card-header bg-white py-2 px-3 fw-bold small border-bottom" style="color: #0F4C81;">
                    <i class="bi bi-gear-fill me-2 text-primary"></i>Konfigurasi SMTP — Report &amp; Auto-Alert
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-bold text-secondary mb-1">SMTP Server Host</label>
                            <input type="text" asp-for="SmtpServer" class="form-control form-control-sm" placeholder="e.g. smtp.office365.com" id="smtpServerInput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Port</label>
                            <input type="number" asp-for="SmtpPort" class="form-control form-control-sm" placeholder="587" id="smtpPortInput" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Email Pengirim (Sender)</label>
                        <input type="email" asp-for="SenderEmail" class="form-control form-control-sm" placeholder="notification@company.com" id="senderEmailInput" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Password / App Password</label>
                        <input type="password" asp-for="SenderPassword" class="form-control form-control-sm" placeholder="••••••••••••" id="senderPasswordInput" />
                        <span class="form-text text-muted" style="font-size:11px;">Biarkan kosong jika tidak ingin mengubah password yang tersimpan.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Email Penerima Laporan (Receiver)</label>
                        <input type="email" asp-for="ReceiverEmail" class="form-control form-control-sm" placeholder="admin.sparepart@company.com" />
                        <span class="form-text text-muted" style="font-size:11px;">Email ini yang akan menerima laporan stok &amp; peringatan stok kritis.</span>
                    </div>

                    <hr class="my-3 text-muted" />

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-ems-outline btn-sm" onclick="testSmtpConnection()">
                            <i class="bi bi-lightning-charge text-warning me-1"></i>Test Koneksi SMTP
                        </button>
                        <button type="button" class="btn btn-ems-outline btn-sm" onclick="sendTestReport()">
                            <i class="bi bi-send-check text-success me-1"></i>Kirim Percobaan Email
                        </button>
                    </div>

                    <div id="smtpTestStatus" class="mt-2 small"></div>
                </div>
            </div>
        </div>

        <!-- 2. RFQ / Bidding SMTP Card -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100" style="border-radius:0;">
                <div class="card-header bg-white py-2 px-3 fw-bold small border-bottom" style="color: #0F4C81;">
                    <i class="bi bi-file-earmark-spreadsheet me-2 text-info"></i>Konfigurasi SMTP — RFQ &amp; Supplier Bidding
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-bold text-secondary mb-1">SMTP Server RFQ</label>
                            <input type="text" asp-for="SmtpServerRfq" class="form-control form-control-sm" placeholder="smtp.office365.com" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Port</label>
                            <input type="number" asp-for="SmtpPortRfq" class="form-control form-control-sm" placeholder="587" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Email Pengirim RFQ</label>
                        <input type="email" asp-for="SenderEmailRfq" class="form-control form-control-sm" placeholder="procurement@company.com" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Password RFQ</label>
                        <input type="password" asp-for="SenderPasswordRfq" class="form-control form-control-sm" placeholder="••••••••••••" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Save Buttons Footer -->
    <div class="mt-4 d-flex justify-content-end gap-2">
        <a href="/" class="btn btn-ems-outline btn-sm">Batal</a>
        <button type="submit" class="btn btn-ems-primary btn-sm px-4">
            <i class="bi bi-check-circle me-1"></i>Simpan Pengaturan Email
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function updateEmailStatusBadge(isCheck) {
            const badge = document.getElementById('emailStatusBadge');
            if (isCheck) {
                badge.className = 'badge bg-success';
                badge.innerText = 'AKTIF';
            } else {
                badge.className = 'badge bg-secondary';
                badge.innerText = 'NONAKTIF';
            }
        }

        async function testSmtpConnection() {
            const statusDiv = document.getElementById('smtpTestStatus');
            statusDiv.innerHTML = '<span class="text-secondary"><i class="spinner-border spinner-border-sm me-1"></i>Mencoba koneksi ke SMTP Server...</span>';

            const server = document.getElementById('smtpServerInput').value;
            const port = document.getElementById('smtpPortInput').value;
            const email = document.getElementById('senderEmailInput').value;
            const password = document.getElementById('senderPasswordInput').value;

            try {
                const res = await fetch('/EmailSettings/TestSmtpConnection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ server, port, email, password })
                });
                const data = await res.json();

                if (data.success) {
                    statusDiv.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>${data.message}</span>`;
                } else {
                    statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>${data.message}</span>`;
                }
            } catch (err) {
                statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>Error: ${err.message}</span>`;
            }
        }

        async function sendTestReport() {
            const statusDiv = document.getElementById('smtpTestStatus');
            statusDiv.innerHTML = '<span class="text-secondary"><i class="spinner-border spinner-border-sm me-1"></i>Menyusun dan mengirim email laporan stok...</span>';

            try {
                const res = await fetch('/EmailSettings/SendTestReport', { method: 'POST' });
                const data = await res.json();

                if (data.success) {
                    statusDiv.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>${data.message}</span>`;
                } else {
                    statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>${data.message}</span>`;
                }
            } catch (err) {
                statusDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>Error: ${err.message}</span>`;
            }
        }
    </script>
}
