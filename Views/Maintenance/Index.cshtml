        function getSelectedScheduleMonth(modalPrefix) {
            var dateInputId = modalPrefix === 'add' ? 'addScheduledDate' : 'editScheduledDate';
            var dateInput = document.getElementById(dateInputId);
            if (dateInput && dateInput.value) {
                var parts = dateInput.value.split('-');
                if (parts.length >= 2) {
                    return parseInt(parts[1], 10);
                }
            }
            return null;
        }

        function onAddScheduledDateChanged() {
            var checkedLines = Array.from(document.querySelectorAll('.add-line-check:checked')).map(c => c.value);
            if (checkedLines.length > 0) {
                autoSuggestSpareparts('add', false);
