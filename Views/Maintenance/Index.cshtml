        function addSparepartRow(modalPrefix, itemData) {
            var tbody = document.getElementById(modalPrefix + 'SparepartTableBody');
            if (!tbody) return;

            itemData = itemData || { sparepartId: '', sparepartName: '', quantity: 1, unit: 'Pcs', notes: '', bin: '-', status: 'Pending', isCompleted: false };

            var rawNotes = itemData.notes || '';
            var binText = (itemData.bin && itemData.bin !== '-')
                ? itemData.bin
                : rawNotes.replace(/^\[(CEK|GANTI)\]\s*/i, '').replace(/^Bin:\s*/i, '').trim();

            var initialPartNo = itemData.sparepartId || (itemData.sparepartName ? itemData.sparepartName : '-');
            var initialItemName = itemData.sparepartName || itemData.sparepartId || '-';
            var qtyDisplay = (itemData.quantity || 1) + ' ' + (itemData.unit || 'Pcs');

            var isCompleted = itemData.isCompleted || itemData.status === 'Completed' || itemData.status === 'Sudah Diganti';
            var statusBadge = isCompleted
                ? `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 10px;" title="Telah dikeluarkan di Barang Keluar (PM)"><i class="bi bi-check-circle-fill me-1"></i>Completed</span>`
                : `<span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1" style="font-size: 10px;" title="Belum ada transaksi di Barang Keluar (PM)"><i class="bi bi-clock me-1"></i>Pending</span>`;

            var tr = document.createElement('tr');
            tr.className = 'sparepart-row align-middle';
            tr.innerHTML = `
                <td width="130" class="px-2 py-1">
                    <span class="fw-bold text-primary" style="font-size: 11px;">${escapeHtml(initialPartNo)}</span>
                    <input type="hidden" name="itemSparepartIds" class="sp-id-input" value="${escapeHtml(itemData.sparepartId || itemData.sparepartName)}" />
                </td>
                <td class="px-2 py-1">
                    <span class="fw-semibold text-dark" style="font-size: 11px;">${escapeHtml(initialItemName)}</span>
                    <input type="hidden" name="itemSparepartNames" class="sp-name-input" value="${escapeHtml(initialItemName)}" />
                </td>
                <td width="90" class="px-2 py-1">
                    <span class="text-muted fw-semibold" style="font-size: 11px;">${escapeHtml(binText || '-')}</span>
                    <input type="hidden" name="itemNotes" class="sp-bin-input" value="${escapeHtml(binText)}" />
                </td>
                <td width="70" class="px-2 py-1 text-center">
                    <span class="fw-bold text-dark" style="font-size: 11px;">${escapeHtml(qtyDisplay)}</span>
                    <input type="hidden" name="itemQuantities" value="${itemData.quantity || 1}" />
                    <input type="hidden" name="itemUnits" value="${escapeHtml(itemData.unit || 'Pcs')}" />
                </td>
                <td width="110" class="px-2 py-1 text-center">
                    ${statusBadge}
                </td>
            `;
            tbody.appendChild(tr);
        }

        function syncRowNotes(element) {
            var tr = element.closest('tr');
            if (!tr) return;
            var actionSel = tr.querySelector('.sp-action-type');
            var textInput = tr.querySelector('.sp-notes-text');
            var hiddenNotes = tr.querySelector('.sp-notes-hidden');
            if (!hiddenNotes) return;

            var action = actionSel ? actionSel.value : '[CEK]';
            if (actionSel) {
                if (action === '[GANTI]') {
                    actionSel.className = 'form-select form-select-sm py-0 px-1 sp-action-type fw-bold text-danger';
                } else {
                    actionSel.className = 'form-select form-select-sm py-0 px-1 sp-action-type fw-bold text-primary';
                }
            }
            var text = textInput ? textInput.value.replace(/^\[(CEK|GANTI)\]\s*/i, '').trim() : '';
            hiddenNotes.value = action + (text ? ' ' + text : '');
        }

