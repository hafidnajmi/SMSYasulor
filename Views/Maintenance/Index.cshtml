        function switchPmTab(targetId) {
            var activeViewInput = document.getElementById('activeViewInput');
            var calendarPane = document.getElementById('calendar-view');
            var listPane = document.getElementById('list-view');
            var calendarTabBtn = document.getElementById('calendar-tab');
            var listTabBtn = document.getElementById('list-tab');

            var viewMode = (targetId === 'list-view' ? 'list' : 'calendar');
            if (activeViewInput) activeViewInput.value = viewMode;

            if (targetId === 'list-view') {
                if (calendarPane) {
                    calendarPane.classList.remove('show', 'active');
                    calendarPane.style.display = 'none';
                }
                if (listPane) {
                    listPane.classList.add('show', 'active');
                    listPane.style.display = 'block';
                }
                if (calendarTabBtn) calendarTabBtn.classList.remove('active');
                if (listTabBtn) listTabBtn.classList.add('active');
            } else {
                if (listPane) {
                    listPane.classList.remove('show', 'active');
                    listPane.style.display = 'none';
                }
                if (calendarPane) {
                    calendarPane.classList.add('show', 'active');
                    calendarPane.style.display = 'block';
                }
                if (listTabBtn) listTabBtn.classList.remove('active');
                if (calendarTabBtn) calendarTabBtn.classList.add('active');
            }

            try {
                var currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('view', viewMode);
                window.history.replaceState({ url: currentUrl.toString() }, '', currentUrl.toString());
            } catch(e) {}
        }

        function closeModal(modalId) {
            var el = document.getElementById(modalId);
            if (!el) return;

            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    var modalInstance = bootstrap.Modal.getInstance(el) || bootstrap.Modal.getOrCreateInstance(el);
                    if (modalInstance) modalInstance.hide();
                } else if (typeof $ !== 'undefined' && $.fn && $.fn.modal) {
                    $(el).modal('hide');
                }
            } catch (err) {
                console.warn("Bootstrap modal hide warning:", err);
            }

            el.style.display = 'none';
            el.classList.remove('show');
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            var backdrops = document.querySelectorAll('.modal-backdrop');
            backdrops.forEach(function(b) { b.remove(); });
        }

