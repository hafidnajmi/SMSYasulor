                <button type="button" class="btn-close btn-close-white" onclick="closeModal('dragDropChoiceModal')" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 text-center">
                <div class="mb-2 fs-6 fw-bold text-dark" id="dragDropPmTitle">Line PM</div>
