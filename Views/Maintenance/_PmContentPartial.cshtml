                                </label>
                            </div>
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP1" type="checkbox" id="chk_UP1_4" checked onchange="togglePmSeries('UP1', 4, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP1_4">
                                    <span>Compliance %</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#D97706; display:inline-block;"></span>
