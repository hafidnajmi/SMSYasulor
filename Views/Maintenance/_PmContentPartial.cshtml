                    </div>
                </div>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; width: 100%; height: 350px;">
                    <canvas id="pmPerformanceChartUP1"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Maintenance Performance UP2 (Full Width) -->
    <div class="col-12">
        <div class="card shadow-sm" style="border-radius:4px; border: 1px solid var(--color-border);">
            <div class="card-header bg-white py-2.5 px-3 d-flex align-items-center justify-content-between gap-2" style="border-bottom: 1px solid var(--color-border);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up-arrow text-success fs-6"></i>
                    <h6 class="mb-0 fw-bold text-dark" style="font-size:14px; letter-spacing:0.02em;">
                        Maintenance Performance UP2 @selectedYear
                    </h6>
                </div>
                <!-- Power BI-style Series Filter Dropdown for UP2 -->
                <div class="dropdown multiselect-dropdown ms-auto" style="min-width: 170px;">
                    <button class="multiselect-button dropdown-toggle" type="button" onclick="toggleMultiselectMenu(this, event)">
                        <span class="text-truncate" style="font-size:12px; font-weight:600;"><i class="bi bi-funnel-fill text-success me-1"></i> Filter Seri Data</span>
                    </button>
                    <div class="multiselect-menu p-2" style="width: 220px; right: 0; left: auto; margin-top: 4px;">
                        <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                            <span class="fw-bold text-muted" style="font-size:11px;">Filter Seri Data</span>
                            <div class="btn-group btn-group-sm flex-shrink-0">
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1" onclick="toggleAllSeries('UP2', true)">Semua</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 ms-1" onclick="toggleAllSeries('UP2', false)">Reset</button>
                            </div>
                        </div>
                        <div class="options-list">
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP2" type="checkbox" id="chk_UP2_0" checked onchange="togglePmSeries('UP2', 0, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP2_0">
                                    <span>Planning</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#64748B; display:inline-block;"></span>
                                </label>
                            </div>
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP2" type="checkbox" id="chk_UP2_1" checked onchange="togglePmSeries('UP2', 1, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP2_1">
                                    <span>Execute / Realization</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#10B981; display:inline-block;"></span>
                                </label>
                            </div>
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP2" type="checkbox" id="chk_UP2_2" checked onchange="togglePmSeries('UP2', 2, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP2_2">
                                    <span>Missed</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#EF4444; display:inline-block;"></span>
                                </label>
                            </div>
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP2" type="checkbox" id="chk_UP2_3" checked onchange="togglePmSeries('UP2', 3, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP2_3">
                                    <span>Revision</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#3B82F6; display:inline-block;"></span>
                                </label>
                            </div>
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP2" type="checkbox" id="chk_UP2_4" checked onchange="togglePmSeries('UP2', 4, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP2_4">
                                    <span>Compliance %</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#D97706; display:inline-block;"></span>
                                </label>
                            </div>
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP2" type="checkbox" id="chk_UP2_5" checked onchange="togglePmSeries('UP2', 5, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP2_5">
                                    <span>Target (90%)</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#DC2626; display:inline-block;"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; width: 100%; height: 350px;">
                    <canvas id="pmPerformanceChartUP2"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Plugin to position compliance line points exactly in the center between Planning bar and Execute bar
        const centerLineBetweenBarsPlugin = {
            id: 'centerLineBetweenBars',
            beforeDatasetsDraw(chart) {
                const metaPlan = chart.getDatasetMeta(0); // PLANNING (bar 0)
                const metaExec = chart.getDatasetMeta(1); // EXECUTE (bar 1)
                const metaComp = chart.getDatasetMeta(4); // COMPLIANCE (line 4)

                if (metaPlan && metaExec && metaComp && metaPlan.data && metaExec.data && metaComp.data) {
                    metaComp.data.forEach((point, index) => {
                        const planElem = metaPlan.data[index];
                        const execElem = metaExec.data[index];
                        if (planElem && execElem) {
                            point.x = (planElem.x + execElem.x) / 2;
                        }
                    });
                }
            }
        };

        // Shared custom data labels plugin for bars and compliance line percentage
        const customDataLabelsPlugin = {
            id: 'pmChartCustomLabels',
            afterDatasetsDraw(chart) {
                const { ctx } = chart;
                
                // 1. Draw Bar Data Labels (Crisp Dark text above each bar)
                chart.data.datasets.forEach((dataset, datasetIndex) => {
                    const meta = chart.getDatasetMeta(datasetIndex);
                    if (!meta || !meta.visible || dataset.type !== 'bar') return;

                    meta.data.forEach((element, index) => {
                        const val = dataset.data[index];
                        if (val !== null && val !== undefined && val > 0) {
                            ctx.save();
                            ctx.font = 'bold 10px Arial, sans-serif';
                            ctx.fillStyle = '#0F172A';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'bottom';
                            ctx.fillText(val, element.x, element.y - 2);
                            ctx.restore();
                        }
                    });
                });

                // 2. Draw Compliance Line Percentage Labels (Bold Royal Blue text above yellow dots)
                chart.data.datasets.forEach((dataset, datasetIndex) => {
                    if (dataset.id !== 'complianceLine') return;
                    const meta = chart.getDatasetMeta(datasetIndex);
                    if (!meta || !meta.visible) return;

                    meta.data.forEach((element, index) => {
                        const val = dataset.data[index];
                        if (val !== null && val !== undefined && val > 0) {
                            ctx.save();
                            ctx.font = 'bold 11px Arial, sans-serif';
                            ctx.fillStyle = '#1D4ED8'; // Crisp Royal Blue from Excel chart
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'bottom';
                            ctx.fillText(Math.round(val) + '%', element.x, element.y - 8);
                            ctx.restore();
                        }
                    });
                });
            }
        };

        function buildDatasets(rawData) {
            const planData = rawData.map(d => d.Planning);
            const executeData = rawData.map(d => d.Execute);
            const missedData = rawData.map(d => d.Missed);
            const revisionData = rawData.map(d => d.Revision);
            const complianceData = rawData.map(d => {
                if (d.CompliancePct !== null && d.CompliancePct !== undefined) return d.CompliancePct;
                const denom = d.Planning > 0 ? d.Planning : d.TotalPlanned;
                return denom > 0 ? Math.round((d.Execute / denom) * 100 * 10) / 10 : null;
            });
            const targetData = Array(12).fill(90);

            return [
                { type: 'bar', label: 'PLANNING', data: planData, backgroundColor: '#64748B', borderColor: '#475569', borderWidth: 1.5, yAxisID: 'y' },
                { type: 'bar', label: 'EXECUTE', data: executeData, backgroundColor: '#10B981', borderColor: '#059669', borderWidth: 1.5, yAxisID: 'y' },
                { type: 'bar', label: 'MISSED', data: missedData, backgroundColor: '#EF4444', borderColor: '#DC2626', borderWidth: 1.5, yAxisID: 'y' },
                { type: 'bar', label: 'REVISION', data: revisionData, backgroundColor: '#3B82F6', borderColor: '#2563EB', borderWidth: 1.5, yAxisID: 'y' },
                { type: 'line', id: 'complianceLine', label: 'COMPLIANCE', data: complianceData, borderColor: '#D97706', backgroundColor: '#F59E0B', borderWidth: 2.5, pointRadius: 4, pointHoverRadius: 6, pointBackgroundColor: '#FFFFFF', pointBorderColor: '#D97706', pointBorderWidth: 2, yAxisID: 'y1', tension: 0.1 },
                { type: 'line', label: 'TARGET (90%)', data: targetData, borderColor: '#DC2626', borderWidth: 2.5, borderDash: [6,3], pointRadius: 0, fill: false, yAxisID: 'y1' }
            ];
        }

        function createChartInstance(canvasId, labels, datasets, globalInstanceKey) {
            const ctxEl = document.getElementById(canvasId);
            if (!ctxEl) return;

            if (window[globalInstanceKey]) {
                window[globalInstanceKey].destroy();
            }

            window[globalInstanceKey] = new Chart(ctxEl, {
                data: { labels: labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    layout: {
                        padding: {
                            top: 25,
                            left: 10,
                            right: 10,
                            bottom: 5
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, font: { size: 10, weight: 'bold' }, boxWidth: 8, padding: 10 } },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.9)',
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) label += ': ';
                                    if (context.parsed.y !== null) {
                                        if (context.dataset.yAxisID === 'y1') label += context.parsed.y + '%';
                                        else label += context.parsed.y;
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 9, weight: 'bold' } } },
                        y: { 
                            type: 'linear', 
                            display: true, 
                            position: 'left', 
                            min: 0,
                            max: 27.5,
                            title: { display: true, text: 'Jumlah PM', font: { size: 10, weight: 'bold' } }, 
                            grid: { color: 'rgba(0, 0, 0, 0.05)' }, 
                            ticks: { 
                                stepSize: 5,
                                precision: 0,
                                callback: function(v) {
                                    return v <= 25 ? v : '';
                                }
                            } 
                        },
                        y1: { 
                            type: 'linear', 
                            display: true, 
                            position: 'right', 
                            min: 0, 
                            max: 110, 
                            title: { display: true, text: 'Compliance %', font: { size: 10, weight: 'bold' } }, 
                            grid: { drawOnChartArea: false }, 
                            ticks: { 
                                stepSize: 20,
                                callback: function(v) { 
                                    return v <= 100 ? v + '%' : ''; 
                                } 
                            } 
                        }
                    }
                },
                plugins: [centerLineBetweenBarsPlugin, customDataLabelsPlugin]
            });
        }

        window.togglePmSeries = function(area, datasetIndex, isChecked) {
            const instanceKey = area === 'UP1' ? 'pmChartInstanceUP1' : 'pmChartInstanceUP2';
            const chart = window[instanceKey];
            if (chart) {
                chart.setDatasetVisibility(datasetIndex, isChecked);
                chart.update();
            }
        };

        window.toggleAllSeries = function(area, isChecked) {
            const instanceKey = area === 'UP1' ? 'pmChartInstanceUP1' : 'pmChartInstanceUP2';
            const chart = window[instanceKey];
            const checkboxes = document.querySelectorAll('.chk-series-' + area);
            checkboxes.forEach((chk, index) => {
                chk.checked = isChecked;
                if (chart) {
                    chart.setDatasetVisibility(index, isChecked);
                }
            });
            if (chart) {
                chart.update();
            }
        };

        window.initPmPerformanceCharts = function() {
            if (typeof Chart === 'undefined') {
                setTimeout(window.initPmPerformanceCharts, 80);
                return;
            }

            const rawDataUP1 = @Html.Raw(ViewBag.MonthlyPerformanceUP1Json ?? "[]");
            const labelsUP1 = rawDataUP1.map(d => d.ShortMonthName || d.MonthName);
            const datasetsUP1 = buildDatasets(rawDataUP1);

            const rawDataUP2 = @Html.Raw(ViewBag.MonthlyPerformanceUP2Json ?? "[]");
            const labelsUP2 = rawDataUP2.map(d => d.ShortMonthName || d.MonthName);
            const datasetsUP2 = buildDatasets(rawDataUP2);

            createChartInstance('pmPerformanceChartUP1', labelsUP1, datasetsUP1, 'pmChartInstanceUP1');
            createChartInstance('pmPerformanceChartUP2', labelsUP2, datasetsUP2, 'pmChartInstanceUP2');
        };

        if (typeof Chart !== 'undefined') {
            window.initPmPerformanceCharts();
        } else {
            document.addEventListener('DOMContentLoaded', window.initPmPerformanceCharts);
            setTimeout(window.initPmPerformanceCharts, 150);
        }
    })();
</script>
