@using System.Text.Encodings.Web
@model IEnumerable<UPMS.Web.Models.Entities.PmSchedule>
@{
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    int selectedMonth = ViewBag.SelectedMonth ?? DateTime.Now.Month;
    var allLines = ViewBag.AllLines as List<string> ?? new List<string>();
    var machines = ViewBag.Machines as List<UPMS.Web.Models.Entities.MachineMaster> ?? new List<UPMS.Web.Models.Entities.MachineMaster>();
    var technicians = ViewBag.Technicians as List<string> ?? new List<string>();
    var monthEvents = ViewBag.MonthEvents as List<UPMS.Web.Models.Entities.PmSchedule> ?? new List<UPMS.Web.Models.Entities.PmSchedule>();
    var selectedLines = ViewBag.SelectedLines as List<string> ?? new List<string>();
    var selectedMachineNames = ViewBag.SelectedMachines as List<string> ?? new List<string>();
    var selectedTechnicians = ViewBag.SelectedTechnicians as List<string> ?? new List<string>();
    var sparepartCounts = ViewBag.SparepartItemCounts as Dictionary<int, int> ?? new Dictionary<int, int>();

    DateTime firstDayOfMonth = new DateTime(selectedYear, selectedMonth, 1);
    int daysInMonth = DateTime.DaysInMonth(selectedYear, selectedMonth);
    int startDayOfWeek = (int)firstDayOfMonth.DayOfWeek; // 0 = Sunday

    string monthName = firstDayOfMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("id-ID"));
    DateTime prevMonthDate = firstDayOfMonth.AddMonths(-1);
    DateTime nextMonthDate = firstDayOfMonth.AddMonths(1);

    bool canEditPm = ViewBag.CanEditPm != null ? (bool)ViewBag.CanEditPm : true;
}

<!-- Status Summary KPI Cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-status="P" asp-route-search="@ViewBag.SearchQuery" asp-route-view="@ViewBag.CurrentView"
           class="card pm-kpi-card pm-kpi-card-p shadow-sm @(ViewBag.SelectedStatus == "P" ? "border-dark border-2" : "")"
           title="Klik untuk filter status Planning">
            <span class="pm-kpi-title">Planning</span>
            <span class="pm-kpi-count">@ViewBag.PlanningCount</span>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-status="E" asp-route-search="@ViewBag.SearchQuery" asp-route-view="@ViewBag.CurrentView"
           class="card pm-kpi-card pm-kpi-card-e shadow-sm @(ViewBag.SelectedStatus == "E" ? "border-success border-2" : "")"
           title="Klik untuk filter status Execute">
            <span class="pm-kpi-title">Execute</span>
            <span class="pm-kpi-count">@ViewBag.ExecuteCount</span>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-status="R" asp-route-search="@ViewBag.SearchQuery" asp-route-view="@ViewBag.CurrentView"
           class="card pm-kpi-card pm-kpi-card-r shadow-sm @(ViewBag.SelectedStatus == "R" ? "border-info border-2" : "")"
           title="Klik untuk filter status Revision">
            <span class="pm-kpi-title">Revision</span>
            <span class="pm-kpi-count">@ViewBag.RevisionCount</span>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-status="M" asp-route-search="@ViewBag.SearchQuery" asp-route-view="@ViewBag.CurrentView"
           class="card pm-kpi-card pm-kpi-card-m shadow-sm @(ViewBag.SelectedStatus == "M" ? "border-warning border-2" : "")"
           title="Klik untuk filter status Missed">
            <span class="pm-kpi-title">Missed</span>
            <span class="pm-kpi-count">@ViewBag.MissedCount</span>
        </a>
    </div>
</div>

<!-- Filter Bar & Navigation -->
<div class="card p-3 mb-3" style="border-radius:0;">
    <form method="get" asp-action="Index" id="pmFilterForm">
        <input type="hidden" name="view" id="activeViewInput" value="@(ViewBag.CurrentView ?? "calendar")" />
        
        <!-- Row 1: Bulan, Tahun, Line PM, Teknisi / PIC -->
        <div class="row g-2 mb-2">
            <div class="col-md-2 col-6">
                <label class="form-label small text-muted mb-1">Bulan</label>
                <select name="month" class="form-select form-select-sm" onchange="submitPmFilterForm()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var mDate = new DateTime(2026, m, 1);
                        <option value="@m" selected="@(m == selectedMonth)">@mDate.ToString("MMMM", new System.Globalization.CultureInfo("id-ID"))</option>
                    }
                </select>
            </div>

            <div class="col-md-2 col-6">
                <label class="form-label small text-muted mb-1">Tahun</label>
                <select name="year" class="form-select form-select-sm" onchange="submitPmFilterForm()">
                    @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 3; y++)
                    {
                        <option value="@y" selected="@(y == selectedYear)">@y</option>
                    }
                </select>
            </div>

            <!-- Line Multi-Select Filter -->
            <div class="col-md-4 col-6">
                <label class="form-label small text-muted mb-1">Line PM</label>
                <div class="dropdown multiselect-dropdown">
                    <button class="multiselect-button dropdown-toggle" type="button" onclick="toggleMultiselectMenu(this, event)" id="filterLineBtn">
                        <span id="filterLineLabel" class="text-truncate">@(selectedLines.Any() ? string.Join(", ", selectedLines) : "Semua Line")</span>
                    </button>
                    <div class="multiselect-menu p-2">
                        <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                            <input type="text" class="form-control form-control-sm multiselect-search me-2" placeholder="Cari line..." onkeyup="filterMultiSelectOptions(this)" />
                            <div class="btn-group btn-group-sm flex-shrink-0">
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1" onclick="selectAllInMenu(this, true)">Semua</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1" onclick="selectAllInMenu(this, false)">Reset</button>
                            </div>
                        </div>
                        <div class="options-list">
                            @foreach (var l in allLines)
                            {
                                bool isChecked = selectedLines.Contains(l, StringComparer.OrdinalIgnoreCase);
                                <div class="multiselect-option option-item">
                                    <input class="form-check-input line-filter-check" type="checkbox" name="line" value="@l" id="filter_line_@l" @(isChecked ? "checked" : "") onchange="onFilterLineChanged()" />
                                    <label class="form-check-label" for="filter_line_@l">@l</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Teknisi / PIC Multi-Select Filter -->
            <div class="col-md-4 col-6">
                <label class="form-label small text-muted mb-1">Teknisi / PIC</label>
                <div class="dropdown multiselect-dropdown">
                    <button class="multiselect-button dropdown-toggle" type="button" onclick="toggleMultiselectMenu(this, event)" id="filterTechBtn">
                        <span id="filterTechLabel" class="text-truncate">@(selectedTechnicians.Any() ? string.Join(", ", selectedTechnicians) : "Semua Teknisi")</span>
                    </button>
                    <div class="multiselect-menu p-2">
                        <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                            <input type="text" class="form-control form-control-sm multiselect-search me-2" placeholder="Cari teknisi..." onkeyup="filterMultiSelectOptions(this)" />
                            <div class="btn-group btn-group-sm flex-shrink-0">
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1" onclick="selectAllInMenu(this, true)">Semua</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1" onclick="selectAllInMenu(this, false)">Reset</button>
                            </div>
                        </div>
                        <div class="options-list">
                            @foreach (var tech in technicians)
                            {
                                bool isChecked = selectedTechnicians.Contains(tech, StringComparer.OrdinalIgnoreCase);
                                var safeTechId = tech.Replace(" ", "_").Replace(".", "_");
                                <div class="multiselect-option option-item">
                                    <input class="form-check-input tech-filter-check" type="checkbox" name="technician" value="@tech" id="filter_tech_@safeTechId" @(isChecked ? "checked" : "") onchange="updateFilterTechLabel()" />
                                    <label class="form-check-label" for="filter_tech_@safeTechId">@tech</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Status & Global Search Input -->
        <div class="row g-2 align-items-end">
            <div class="col-md-3 col-6">
                <label class="form-label small text-muted mb-1">Status PM</label>
                <select name="status" class="form-select form-select-sm" onchange="submitPmFilterForm()" style="border-radius: 0px !important;">
                    <option value="">Semua Status</option>
                    <option value="P" selected="@(ViewBag.SelectedStatus == "P")">P - Planning</option>
                    <option value="E" selected="@(ViewBag.SelectedStatus == "E")">E - Execute</option>
                    <option value="R" selected="@(ViewBag.SelectedStatus == "R")">R - Revision</option>
                    <option value="M" selected="@(ViewBag.SelectedStatus == "M")">M - Missed</option>
                </select>
            </div>

            <div class="col-md-7 col-6">
                <label class="form-label small text-muted mb-1">Cari Kata Kunci (Line / Mesin / Teknisi / Catatan)</label>
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Ketik pencarian kata kunci..." value="@ViewBag.SearchQuery" style="border-radius: 0px !important;" />
            </div>

            <div class="col-md-2 col-12 d-flex align-items-center gap-1">
                <button type="submit" class="btn btn-ems-primary btn-sm flex-fill fw-semibold" title="Cari / Apply Filter" style="border-radius: 0px !important;">
                    <i class="bi bi-search me-1"></i>Cari
                </button>
                @if (selectedLines.Any() || selectedMachineNames.Any() || selectedTechnicians.Any() || !string.IsNullOrEmpty(ViewBag.SelectedStatus) || !string.IsNullOrEmpty(ViewBag.SearchQuery))
                {
                    <a asp-action="Index" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-view="@ViewBag.CurrentView" class="btn btn-outline-danger btn-sm" title="Reset Filter" style="border-radius: 0px !important;">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </div>
    </form>
</div>

<!-- View Mode Switch Tabs -->
<ul class="nav nav-tabs mb-3" id="pmViewTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(ViewBag.CurrentView != "list" ? "active fw-bold text-primary" : "text-secondary")" id="calendar-tab" type="button" role="tab" onclick="switchPmTab('calendar-view')" style="border-radius: 0px !important;">
            <i class="bi bi-calendar3 me-1"></i>Tampilan Kalender
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(ViewBag.CurrentView == "list" ? "active fw-bold text-primary" : "text-secondary")" id="list-tab" type="button" role="tab" onclick="switchPmTab('list-view')" style="border-radius: 0px !important;">
            <i class="bi bi-list-task me-1"></i>Tampilan List Tabel (@Model.Count())
        </button>
    </li>
</ul>

<div class="tab-content" id="pmViewTabContent">
    <!-- CALENDAR VIEW TAB -->
    <div class="tab-pane fade @(ViewBag.CurrentView != "list" ? "show active" : "")" id="calendar-view" role="tabpanel" style="@(ViewBag.CurrentView == "list" ? "display:none;" : "display:block;")">
        <div class="pm-calendar-card">
            <!-- Navigation Month Bar -->
            <div class="pm-calendar-header">
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Index" asp-route-year="@prevMonthDate.Year" asp-route-month="@prevMonthDate.Month" asp-route-status="@ViewBag.SelectedStatus" asp-route-technician="@(selectedTechnicians.Any() ? string.Join(",", selectedTechnicians) : "")" asp-route-search="@ViewBag.SearchQuery" asp-route-view="@ViewBag.CurrentView" class="btn btn-outline-secondary btn-sm px-2 py-1">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <h5 class="mb-0 fw-bold text-dark me-2">@monthName</h5>
                    <a asp-action="Index" asp-route-year="@nextMonthDate.Year" asp-route-month="@nextMonthDate.Month" asp-route-status="@ViewBag.SelectedStatus" asp-route-technician="@(selectedTechnicians.Any() ? string.Join(",", selectedTechnicians) : "")" asp-route-search="@ViewBag.SearchQuery" asp-route-view="@ViewBag.CurrentView" class="btn btn-outline-secondary btn-sm px-2 py-1">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" asp-route-year="@DateTime.Now.Year" asp-route-month="@DateTime.Now.Month" asp-route-status="@ViewBag.SelectedStatus" asp-route-technician="@(selectedTechnicians.Any() ? string.Join(",", selectedTechnicians) : "")" asp-route-search="@ViewBag.SearchQuery" asp-route-view="@ViewBag.CurrentView" class="btn btn-outline-primary btn-sm px-3">
                        <i class="bi bi-clock me-1"></i>Bulan Ini
                    </a>
                </div>
            </div>

            <!-- Calendar Grid (With Mobile Scroll Wrapper) -->
            <div class="pm-calendar-wrapper">
                <div class="pm-calendar-grid">
                    <!-- Day Headers (Sun-Sat) -->
                    <div class="pm-day-header text-danger">Minggu</div>
                    <div class="pm-day-header">Senin</div>
                    <div class="pm-day-header">Selasa</div>
                    <div class="pm-day-header">Rabu</div>
                    <div class="pm-day-header">Kamis</div>
                    <div class="pm-day-header">Jumat</div>
                    <div class="pm-day-header text-primary">Sabtu</div>

                    <!-- Padding empty cells before 1st of month -->
                    @for (int p = 0; p < startDayOfWeek; p++)
                    {
                        <div class="pm-day-cell other-month"></div>
                    }

                    <!-- Days 1..daysInMonth -->
                    @for (int day = 1; day <= daysInMonth; day++)
                    {
                        DateTime currentDate = new DateTime(selectedYear, selectedMonth, day);
                        bool isToday = currentDate.Date == DateTime.Now.Date;
                        var dayEvents = monthEvents.Where(e => e.ScheduledDate.Date == currentDate.Date).ToList();

                        <div class="pm-day-cell @(isToday ? "is-today" : "")"
                             data-date="@currentDate.ToString("yyyy-MM-dd")"
                             ondragover="onPmDragOver(event)"
                             ondragenter="onPmDragEnter(event)"
                             ondragleave="onPmDragLeave(event)"
                             ondrop="onPmDrop(event, '@currentDate.ToString("yyyy-MM-dd")')">
                            <div class="pm-day-number">
                                <span class="@(isToday ? "pm-day-number-badge" : "")">@day</span>
                                @if (canEditPm)
                                {
                                    <span class="pm-add-btn" title="Tambah Jadwal PM Tanggal Ini" onclick="openAddModalForDate('@currentDate.ToString("yyyy-MM-dd")')">
                                        <i class="bi bi-plus-circle-fill"></i>
                                    </span>
                                }
                            </div>

                            <!-- Render PM Tags on Date -->
                            @foreach (var pm in dayEvents)
                            {
                                string statusClass = pm.Status.ToUpper() switch
                                {
                                    "P" => "pm-tag-p",
                                    "E" => "pm-tag-e",
                                    "R" => "pm-tag-r",
                                    "M" => "pm-tag-m",
                                    _ => "pm-tag-p"
                                };

                                int spCount = sparepartCounts.TryGetValue(pm.Id, out int cnt) ? cnt : 0;

                                <div class="pm-tag @statusClass d-flex align-items-center justify-content-between" 
                                     draggable="@(canEditPm ? "true" : "false")"
                                     ondragstart="@(canEditPm ? $"onPmDragStart(event, {pm.Id}, '{JavaScriptEncoder.Default.Encode(pm.Title)}', '{pm.ScheduledDate.ToString("yyyy-MM-dd")}')" : "return false;")"
                                     onclick="openEditModal(@pm.Id, '@JavaScriptEncoder.Default.Encode(pm.Title)', '@pm.ScheduledDate.ToString("yyyy-MM-dd")', '@pm.Status', '@pm.MachineId', '@JavaScriptEncoder.Default.Encode(pm.MachineName ?? "")', '@JavaScriptEncoder.Default.Encode(pm.Technician ?? "")', '@JavaScriptEncoder.Default.Encode(pm.Notes ?? "")', '@JavaScriptEncoder.Default.Encode(pm.UpArea ?? "")')"
                                     style="cursor: pointer;"
                                     title="@(canEditPm ? "Seret kartu ini ke tanggal lain untuk memindahkan/duplikasi | " : "Klik untuk melihat detail PM | ")Line: @pm.Title | Mesin: @pm.MachineName @(spCount > 0 ? $"| Sparepart: {spCount} Part" : "")">
                                    <div class="d-flex align-items-center text-truncate">
                                        @if (canEditPm)
                                        {
                                            <i class="bi bi-grip-vertical text-secondary me-1 opacity-75" style="font-size:11px;"></i>
                                        }
                                        <span class="text-truncate">@pm.Title</span>
                                    </div>
                                    @if (spCount > 0)
                                    {
                                        <span class="badge bg-dark text-white rounded-pill px-1 ms-1 flex-shrink-0" style="font-size:9px;" title="@spCount sparepart terdaftar">
                                            <i class="bi bi-box-seam"></i> @spCount
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Remaining grid padding cells for 35 or 42 total slots -->
                    @{
                        int totalCellsUsed = startDayOfWeek + daysInMonth;
                        int remainingCells = (totalCellsUsed <= 35) ? 35 - totalCellsUsed : 42 - totalCellsUsed;
                    }
                    @for (int r = 0; r < remainingCells; r++)
                    {
                        <div class="pm-day-cell other-month"></div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE LIST VIEW TAB -->
    <div class="tab-pane fade @(ViewBag.CurrentView == "list" ? "show active" : "")" id="list-view" role="tabpanel" style="@(ViewBag.CurrentView == "list" ? "display:block;" : "display:none;")">
        <div class="card p-0" style="border-radius:0;">
            <div class="table-responsive">
                <table class="table table-hover table-ems align-middle mb-0" style="font-size:12px;">
                    <thead class="table-light">
                        <tr>
                            <th width="40">No</th>
                            <th width="110">Tanggal</th>
                            <th>Line PM</th>
                            <th>Mesin PM</th>
                            <th width="120" class="text-center">Status</th>
                            <th>Teknisi / PIC</th>
                            <th>Catatan</th>
                            <th width="120" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle fs-4 d-block mb-1"></i>
                                    Tidak ada jadwal PM ditemukan untuk filter ini.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int no = 1;
                            foreach (var item in Model)
                            {
                                string statusBadgeClass = item.Status.ToUpper() switch
                                {
                                    "P" => "pm-tag-p",
                                    "E" => "pm-tag-e",
                                    "R" => "pm-tag-r",
                                    "M" => "pm-tag-m",
                                    _ => "pm-tag-p"
                                };

                                <tr>
                                    <td>@(no++)</td>
                                    <td class="fw-bold">@item.ScheduledDate.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-bold text-primary">@item.Title</td>
                                    <td>@(item.MachineName ?? "-")</td>
                                    <td class="text-center">
                                        <span class="pm-tag @statusBadgeClass d-inline-block px-3 py-1 text-center">
                                            <span>
                                                @(item.Status.ToUpper() switch {
                                                    "P" => "Planning",
                                                    "E" => "Execute",
                                                    "R" => "Revision",
                                                    "M" => "Missed",
                                                    _ => item.Status
                                                })
                                            </span>
                                        </span>
                                    </td>
                                    <td>@(item.Technician ?? "-")</td>
                                    <td>@(item.Notes ?? "-")</td>
                                    <td class="text-center">
                                        @if (canEditPm)
                                        {
                                            <button class="btn btn-outline-primary btn-sm p-1 px-2" title="Edit"
                                                    onclick="openEditModal(@item.Id, '@JavaScriptEncoder.Default.Encode(item.Title)', '@item.ScheduledDate.ToString("yyyy-MM-dd")', '@item.Status', '@item.MachineId', '@JavaScriptEncoder.Default.Encode(item.MachineName ?? "")', '@JavaScriptEncoder.Default.Encode(item.Technician ?? "")', '@JavaScriptEncoder.Default.Encode(item.Notes ?? "")', '@JavaScriptEncoder.Default.Encode(item.UpArea ?? "")')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm p-1 px-2 ms-1" title="Hapus"
                                                    onclick="triggerDelete(@item.Id, '@JavaScriptEncoder.Default.Encode(item.Title)', this)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-info btn-sm p-1 px-2" title="Lihat Detail PM"
                                                    onclick="openEditModal(@item.Id, '@JavaScriptEncoder.Default.Encode(item.Title)', '@item.ScheduledDate.ToString("yyyy-MM-dd")', '@item.Status', '@item.MachineId', '@JavaScriptEncoder.Default.Encode(item.MachineName ?? "")', '@JavaScriptEncoder.Default.Encode(item.Technician ?? "")', '@JavaScriptEncoder.Default.Encode(item.Notes ?? "")', '@JavaScriptEncoder.Default.Encode(item.UpArea ?? "")')">
                                                <i class="bi bi-eye"></i> Detail
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Dual Maintenance Performance Charts (UP1 & UP2) below Calendar & List views -->
<div class="row g-3 mt-3">
    <!-- Chart 1: Maintenance Performance UP1 (Full Width) -->
    <div class="col-12">
        <div class="card shadow-sm" style="border-radius:4px; border: 1px solid var(--color-border);">
            <div class="card-header bg-white py-2.5 px-3 d-flex align-items-center justify-content-between gap-2" style="border-bottom: 1px solid var(--color-border);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up-arrow text-primary fs-6"></i>
                    <h6 class="mb-0 fw-bold text-dark" style="font-size:14px; letter-spacing:0.02em;">
                        Maintenance Performance UP1 @selectedYear
                    </h6>
                </div>
                <!-- Power BI-style Series Filter Dropdown for UP1 (One-Theme with Line PM) -->
                <div class="dropdown multiselect-dropdown ms-auto" style="min-width: 170px;">
                    <button class="multiselect-button dropdown-toggle" type="button" onclick="toggleMultiselectMenu(this, event)">
                        <span class="text-truncate" style="font-size:12px; font-weight:600;"><i class="bi bi-funnel-fill text-primary me-1"></i> Filter Seri Data</span>
                    </button>
                    <div class="multiselect-menu p-2" style="width: 220px; right: 0; left: auto; margin-top: 4px;">
                        <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                            <span class="fw-bold text-muted" style="font-size:11px;">Filter Seri Data</span>
                            <div class="btn-group btn-group-sm flex-shrink-0">
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1" onclick="toggleAllSeries('UP1', true)">Semua</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 ms-1" onclick="toggleAllSeries('UP1', false)">Reset</button>
                            </div>
                        </div>
                        <div class="options-list">
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP1" type="checkbox" id="chk_UP1_0" checked onchange="togglePmSeries('UP1', 0, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP1_0">
                                    <span>Planning</span>
                                    <span style="width:10px; height:10px; border-radius:50%; background-color:#64748B; display:inline-block;"></span>
                                </label>
                            </div>
                            <div class="multiselect-option option-item">
                                <input class="form-check-input chk-series-UP1" type="checkbox" id="chk_UP1_1" checked onchange="togglePmSeries('UP1', 1, this.checked)" />
                                <label class="form-check-label d-flex align-items-center justify-content-between" for="chk_UP1_1">
