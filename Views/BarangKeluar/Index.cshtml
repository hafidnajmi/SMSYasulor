@model UPMS.Web.Services.PagedResult<UPMS.Web.Models.Entities.BarangKeluar>

@{
    ViewData["Title"] = "Barang Keluar";
    var pics = ViewBag.Pics as List<string> ?? new List<string> { "Raisa", "Priyanto", "Rohmadi", "Yully", "Hussein", "Slamet", "Andra" };
    var lines = ViewBag.Lines as List<string> ?? new List<string> { "B01", "B02", "B03", "B04", "B05", "B06", "B24", "B25", "PACKING", "UTILITY" };
    var maintTypes = ViewBag.MaintenanceTypes as List<string> ?? new List<string> { "PM", "Breakdown", "Improvement", "Trial", "Stock Correction", "Others" };
}

@{
    var currentDept = ViewBag.ActiveDept as string ?? Context.Request.Cookies["SMS_ACTIVE_DEPT"] ?? "Filling";
}

<!-- EMS Title Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-1" style="color: #0F4C81;">Barang Keluar</h3>
            <span class="badge bg-primary px-3 py-2 fw-bold" style="font-size: 11px; border-radius: 0; font-family: Arial, sans-serif !important;">
                @currentDept.ToUpper()
            </span>
        </div>
        <p class="text-muted small mb-0">Record &amp; Riwayat Pengeluaran Sparepart — Form Pengambilan Barang Technician UP @currentDept.ToUpper()</p>
    </div>
</div>

<form asp-action="Submit" method="post" id="keluarForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="masterDataId" name="MasterDataId" />

    <div class="row g-3 mb-4">
        <!-- Left Card: Record Outgoing Issue / Informasi -->
        <div class="col-lg-4 col-md-5">
            <div class="card border shadow-sm h-100 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-1 border-bottom">
                    <h6 class="fw-semibold mb-0 text-danger" style="font-size: 14px;"><i class="bi bi-box-arrow-up-right me-2"></i>Record Outgoing Issue</h6>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning fw-normal" style="font-size: 10px;">Stock Decrement</span>
                </div>

                <!-- Barcode / BIN / Part # Lookup Search -->
                <div class="mb-3 position-relative">
                    <label class="form-label small fw-medium text-secondary mb-1">Barcode / BIN / Part Number Lookup</label>
                    <div class="input-group input-group-sm mb-1">
                        <input type="text" id="barcodeLookup" class="form-control form-control-sm font-monospace" placeholder="Scan barcode (hands-free rapid scan)..." autofocus onkeydown="if(event.key==='Enter'||event.key==='Tab'){event.preventDefault();lookupBarcode();}" oninput="handleBarcodeScannerInput(this)" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" onclick="lookupBarcode()"><i class="bi bi-search"></i> Lookup</button>
                    </div>
                    <div id="lookupStatusToast" class="small fw-semibold mt-1 py-1 px-2 rounded-1" style="font-size: 11px; display: none;"></div>
                    <button type="button" id="btnScanCamera" class="btn btn-ems-primary btn-sm w-100 mt-1 mb-1 fw-medium" onclick="openCameraModal()">
                        <i class="bi bi-camera-fill me-1"></i> Scan Barcode via Camera
                    </button>
                    <div id="keluarSearchResults" class="list-group position-absolute w-100 shadow" style="z-index: 1050; display: none; max-height: 200px; overflow-y: auto;"></div>
                </div>

                <hr class="my-2 text-muted opacity-25" />

                <!-- Tanggal Pengeluaran (Locked / Non-Editable Real-time Timestamp) -->
                <div class="mb-3">
                    <label class="form-label small fw-medium text-secondary mb-1">Tanggal &amp; Waktu</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-calendar-event text-primary"></i></span>
                        <input type="datetime-local" id="keluarTanggal" name="Tanggal" class="form-control form-control-sm bg-light text-muted font-monospace" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" readonly tabindex="-1" style="pointer-events: none; cursor: not-allowed;" />
                    </div>
                    <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Tanggal &amp; jam pengeluaran otomatis terisi real-time saat ini (tidak dapat diubah).</div>
                </div>

                <hr class="my-2 text-muted opacity-25" />

                <!-- Multi-Scan Cart Container -->
                <div class="mt-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label small fw-medium text-secondary mb-0"><i class="bi bi-list-check me-1 text-primary"></i>Daftar Barang Di-Scan (<span id="cartCount" class="fw-semibold">0</span>)</label>
                        <button type="button" class="btn btn-link p-0 text-danger text-decoration-none small fw-normal" onclick="clearScannedCart()" style="font-size: 11px;">Bersihkan List</button>
                    </div>
                    <div id="scannedCartList" class="d-flex flex-column gap-2 overflow-auto mb-2" style="max-height: 250px;">
                        <div class="text-center text-muted py-3 small bg-light border rounded fst-italic fw-normal" id="cartEmptyPlaceholder" style="font-size: 11px;">
                            Scan barcode atau cari item untuk menambahkan ke daftar pengeluaran.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Card: Detail Pengeluaran -->
        <div class="col-lg-8 col-md-7">
            <div class="card border shadow-sm h-100 p-3 bg-white">
                <div class="pb-2 mb-3 border-bottom">
                    <h6 class="fw-semibold mb-0" style="color: #1E293B; font-size: 14px;">Detail Pengeluaran</h6>
                </div>

                <!-- Part Number & BIN -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-medium text-secondary mb-1">Part Number</label>
                        <input type="text" id="keluarPartNumber" name="PartNumber" class="form-control form-control-sm font-monospace bg-light" placeholder="Kode Part Number..." readonly />
                        <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Kode Part Number sparepart (auto-fill).</div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-medium text-secondary mb-0">BIN Location</label>
                            <span id="keluarBinStatus" class="small fw-normal" style="font-size: 11px;"></span>
                        </div>
                        <input type="text" id="keluarBin" name="Bin" class="form-control form-control-sm font-monospace text-uppercase" placeholder="Ketik BIN / Scan..." oninput="onKeluarBinInput(this.value); syncFormToActiveCart();" />
                        <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Kode BIN lokasi penyimpanan barang.</div>
                    </div>
                </div>

                <!-- Items Name -->
                <div class="mb-3">
                    <label class="form-label small fw-medium text-secondary mb-1">Item Name *</label>
                    <input type="text" id="keluarItemName" name="ItemName" class="form-control form-control-sm" placeholder="Otomatis dari BIN / ketik manual..." required oninput="syncFormToActiveCart()" />
                    <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Nama sparepart (terisi otomatis jika BIN/Part Number terdaftar).</div>
                </div>

                <!-- Actual Usage Line & Mesin -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-medium text-secondary mb-1">Actual Usage Line *</label>
                        <select name="Line" id="lineSelect" class="form-select form-select-sm" required onchange="onLineChange(this.value); syncFormToActiveCart();">
                            <option value="">Pilih Line</option>
                            @foreach (var l in lines)
                            {
                                <option value="@l">@l</option>
                            }
                        </select>
                        <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Pilih line (area produksi) tempat sparepart ini digunakan.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-medium text-secondary mb-1">Mesin *</label>
                        <select name="MachineId" id="machineSelect" class="form-select form-select-sm" disabled onchange="syncFormToActiveCart()">
                            <option value="">Pilih Mesin</option>
                        </select>
                        <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Pilih nama mesin tempat sparepart digunakan (wajib jika tersedia).</div>
                    </div>
                </div>

                <!-- QTY & PIC -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-medium text-secondary mb-1">QTY *</label>
                        <input type="number" id="keluarQty" name="Qty" class="form-control form-control-sm" required min="1" value="1" placeholder="Masukkan QTY..." oninput="syncFormToActiveCart()" />
                        <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Masukkan jumlah fisik sparepart yang dikeluarkan.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-medium text-secondary mb-1">PIC Technician *</label>
                        <select name="Pic" id="picSelect" class="form-select form-select-sm" required onchange="syncFormToActiveCart()">
                            <option value="">Pilih PIC</option>
                            @foreach (var pic in pics)
                            {
                                <option value="@pic" selected="@(User.Identity?.Name?.Equals(pic, StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@pic</option>
                            }
                        </select>
                        <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Pilih nama personel yang mengambil sparepart.</div>
                    </div>
                </div>

                <!-- Maintenance Type -->
                <div class="mb-3">
                    <label class="form-label small fw-medium text-secondary mb-1">Maintenance Type *</label>
                    <select name="MaintenanceType" id="maintTypeSelect" class="form-select form-select-sm" required onchange="syncFormToActiveCart()">
                        <option value="">Pilih Maint. Type</option>
                        @foreach (var mt in maintTypes)
                        {
                            <option value="@mt">@mt</option>
                        }
                    </select>
                    <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Pilih jenis pemeliharaan mesin (wajib diisi).</div>
                </div>

                <!-- Action Note / Remarks -->
                <div class="mb-3">
                    <label class="form-label small fw-medium text-secondary mb-1">Remarks / Catatan (Optional)</label>
                    <textarea name="ActionNote" id="keluarRemarks" class="form-control form-control-sm" rows="2" placeholder="Catatan atau keterangan tambahan (satu-satunya field opsional)." oninput="syncFormToActiveCart()"></textarea>
                    <div class="form-text small text-muted fw-normal" style="font-size: 11px;">Catatan atau keterangan tambahan (satu-satunya field opsional).</div>
                </div>

                <!-- Buttons: 1 Single Primary Action Button -->
                <div class="d-flex align-items-center justify-content-between gap-2 pt-3 border-top mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 fw-normal" onclick="resetKeluarForm()"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</button>
                    <button type="button" id="mainProcessBtn" class="btn btn-success btn-md px-4 py-2 fw-medium shadow-sm flex-grow-1" onclick="handleUnifiedSubmit()" style="background-color: #059669; border-color: #059669; font-size: 14px;">
                        <i class="bi bi-check2-circle me-1 fs-6"></i> Simpan &amp; Proses Pengeluaran Barang
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- History Card -->
<div class="card border shadow-sm mb-4 bg-white">
    <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-primary"><i class="bi bi-clock-history me-2"></i>Riwayat Transaksi Barang Keluar</span>
        <span class="text-muted small">@Model?.TotalCount.ToString("N0") record(s)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="text-center bg-light text-secondary border-end" style="width: 60px; font-weight: 600;">NO</th>
                        <th>DATE</th>
                        <th>PART NUMBER</th>
                        <th>BIN</th>
                        <th>ITEM NAME</th>
                        <th class="text-end">QTY</th>
                        <th>LINE</th>
                        <th>MAINT. TYPE</th>
                        <th>PIC</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Items.Any())
                    {
                        int rowNo = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center font-monospace small fw-medium text-dark border-end" style="background-color: #F8FAFC; width: 60px;">@(rowNo++)</td>
                                <td class="small text-muted font-monospace">@item.Tanggal.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><span class="small text-secondary font-monospace">@(item.PartNumber ?? item.MasterDataId ?? "-")</span></td>
                                <td><span class="badge bg-light text-dark border">@(item.Bin ?? "-")</span></td>
                                <td class="fw-normal">@item.ItemName</td>
                                <td class="text-end text-danger fw-normal">@item.Qty</td>
                                <td><span class="badge bg-light text-dark border">@(item.Line ?? "-")</span></td>
                                <td class="small text-secondary">@(item.MaintenanceType ?? "-")</td>
                                <td class="small">@(item.Pic ?? "-")</td>
                                <td>
                                    @if (item.ApprovalStatus == "Approved" || string.IsNullOrEmpty(item.ApprovalStatus))
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (item.ApprovalStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">Belum ada riwayat transaksi barang keluar.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Camera Barcode Scanner Modal - Powered by Quagga2 & Native BarcodeDetector -->
<style>
/* Fix Quagga2 canvas overlay — canvas must sit ON TOP of video, not below it */
#quagga-viewport { position: relative; width: 100%; background: #000; border: 2px solid #0B4A8F; border-radius: 4px; overflow: hidden; min-height: 280px; }
#quagga-viewport video { width: 100% !important; height: auto !important; display: block !important; object-fit: cover; }
#quagga-viewport canvas { position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; }
</style>
<div class="modal fade" id="cameraScanModal" tabindex="-1" aria-labelledby="cameraScanModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:500px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 px-3 d-flex align-items-center justify-content-between" style="background:#0F4C81; color:#fff; border-radius:0;">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="modal-title fw-normal mb-0" id="cameraScanModalLabel" style="font-size:13px; font-family: Arial, sans-serif;"><i class="bi bi-camera-fill text-warning me-1"></i>Camera Barcode Scanner</h6>
                    <span id="cameraFacingBadge" class="badge bg-primary small"><i class="bi bi-camera me-1"></i> Kamera</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-light border-0 px-2 py-1 small fw-medium text-dark d-flex align-items-center gap-1 shadow-sm" onclick="cycleCameraDevice()" title="Ganti Perangkat Kamera / Lensa Belakang">
                        <i class="bi bi-arrow-repeat text-primary fs-6"></i> <span style="font-size: 12px;">Ganti Kamera</span>
                    </button>
                    <button type="button" class="btn-close btn-close-white" onclick="stopCameraModal()"></button>
                </div>
            </div>
            <div class="modal-body p-2">
                <div id="cameraSelectContainer" class="mb-2" style="display:none;">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-secondary fw-medium" style="font-size:11px;"><i class="bi bi-camera-video me-1 text-primary"></i> Pilih Kamera:</span>
                        <select id="cameraSelect" class="form-select form-select-sm fw-medium" onchange="switchToCamera(this.value)"></select>
                    </div>
                </div>
                <!-- Quagga2 will inject <video> then <canvas> inside this div -->
                <div id="quagga-viewport">
                    <div id="quagga-loading" style="min-height:280px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#94a3b8;font-size:13px;text-align:center;padding:15px;">
                        <div class="spinner-border text-primary mb-2" role="status"></div>
                        <div>Membuka kamera...</div>
                    </div>
                    <!-- Red scan guide line (z-index above canvas) -->
                    <div id="scanLine" style="display:none;position:absolute;top:50%;left:5%;right:5%;height:2px;background:rgba(255,0,0,0.9);box-shadow:0 0 8px red;pointer-events:none;z-index:20;"></div>
                </div>
                <div id="cameraStatus" class="alert alert-info py-2 px-3 small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i> Inisialisasi scanner...
                </div>
                <div id="scanDebug" style="display:none;font-size:11px;color:#475569;margin-top:6px;max-height:70px;overflow:auto;padding:4px 8px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:4px;"></div>
            </div>
            <div class="modal-footer py-2 px-3 bg-light d-flex justify-content-between">
                <div class="d-flex gap-1">
                    <input type="file" id="barcodeFileInput" accept="image/*" style="display:none;" onchange="handleFileScan(event)" />
                    <button type="button" class="btn btn-outline-primary btn-sm" style="font-size:12px;" onclick="document.getElementById('barcodeFileInput').click()">
                        <i class="bi bi-image me-1"></i> Upload Foto
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" style="font-size:12px;" onclick="toggleDebug()">
                        <i class="bi bi-bug me-1"></i> Debug
                    </button>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" onclick="stopCameraModal()"><i class="bi bi-x-lg me-1"></i> Tutup</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Barcode decoders: Quagga2 + Html5Qrcode fallback -->
    <script src="https://cdn.jsdelivr.net/npm/@@ericblade/quagga2/dist/quagga.min.js"></script>
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
    let availableCameraDevices = [];
    let currentFacingMode = "environment"; // default to back camera
    let currentDeviceId = null;
    let lastScannedCode = null;
    let scanCooldown = false;
    let debugVisible = false;
    var scannerDebounceTimer = null;
    var isLookupInFlight = false;

    function updateFacingBadge(rawLabel, isUserFacing) {
        var badge = document.getElementById('cameraFacingBadge');
        if (!badge) return;

        var lower = (rawLabel || '').toLowerCase();
        if (isUserFacing || lower.includes('front') || lower.includes('user') || lower.includes('selfie')) {
            badge.className = "badge bg-info text-dark small";
            badge.innerHTML = '<i class="bi bi-person-bounding-box me-1"></i> Kamera Depan';
        } else if (lower.includes('wide') || lower.includes('ultra')) {
            badge.className = "badge bg-primary small";
            badge.innerHTML = '<i class="bi bi-camera-fill me-1"></i> Kamera Belakang (Wide)';
        } else {
            badge.className = "badge bg-primary small";
            badge.innerHTML = '<i class="bi bi-camera-fill me-1"></i> Kamera Belakang';
        }
    }

    function formatCameraSelectLabel(rawLabel, index, totalCams) {
        if (!rawLabel) return '📷 Kamera ' + (index + 1);
        
        // Remove technical hardware serial numbers e.g. (30c9:0010) or [USB-001]
        var cleaned = rawLabel.replace(/\s*\([\w:]+\)/gi, '').replace(/\s*\[[\w:]+\]/gi, '').trim();
        var lower = cleaned.toLowerCase();

        if (lower.includes('back') || lower.includes('rear') || lower.includes('environment') || lower.includes('camera2 0')) {
            return '📷 Kamera Belakang ' + (totalCams > 2 ? (index + 1) : '') + (index === 0 ? ' (Utama)' : '');
        }
        if (lower.includes('front') || lower.includes('user') || lower.includes('facing front') || lower.includes('camera2 1')) {
            return '👤 Kamera Depan (Selfie)';
        }
        return '📷 ' + (cleaned || ('Kamera ' + (index + 1)));
    }

    function cycleCameraDevice() {
        if (availableCameraDevices && availableCameraDevices.length > 1) {
            var activeTrack = cameraStream ? cameraStream.getVideoTracks()[0] : null;
            var activeSettings = activeTrack && activeTrack.getSettings ? activeTrack.getSettings() : {};
            var activeId = currentDeviceId || activeSettings.deviceId;
            
            var currentIndex = availableCameraDevices.findIndex(function(d) { return d.deviceId === activeId; });
            var nextIndex = (currentIndex + 1) % availableCameraDevices.length;
            if (nextIndex < 0) nextIndex = 0;
            
            var nextDev = availableCameraDevices[nextIndex];
            if (nextDev && nextDev.deviceId) {
                currentDeviceId = nextDev.deviceId;
                
                var labelLower = (nextDev.label || '').toLowerCase();
                if (labelLower.includes('front') || labelLower.includes('user') || labelLower.includes('selfie')) {
                    currentFacingMode = 'user';
                } else {
                    currentFacingMode = 'environment';
                }
                
                switchToCamera(currentDeviceId);
            }
        } else {
            // Fallback toggle for smartphones / devices where enumerateDevices only reported single lens initially
            currentFacingMode = (currentFacingMode === "environment") ? "user" : "environment";
            currentDeviceId = null;
            updateFacingBadge('', currentFacingMode === 'user');
            startCameraStream(null);
        }
    }

    function switchToCamera(deviceId) {
        if (!deviceId) return;
        currentDeviceId = deviceId;
        startCameraStream(deviceId);
    }

    function handleBarcodeScannerInput(el) {
        if (isLookupInFlight) {
            if (el) el.value = "";
            return;
        }

        var val = (el ? el.value : '').trim();
        
        // Hide search dropdown during barcode scanning
        var resultsBox = document.getElementById("keluarSearchResults");
        if (resultsBox) resultsBox.style.display = "none";
        if (typeof keluarRefTimeout !== 'undefined') clearTimeout(keluarRefTimeout);

        if (val.length >= 3) {
            clearTimeout(scannerDebounceTimer);
            // Hands-free rapid scan: auto-lookup after short typing pause or fast scanner input burst
            scannerDebounceTimer = setTimeout(function() {
                var currentVal = (el ? el.value : '').trim();
                if (currentVal.length >= 3) {
                    lookupBarcode();
                }
            }, 120);
        }
    }

    function showLookupToast(message, type) {
        var toast = document.getElementById("lookupStatusToast");
        if (!toast) return;
        
        if (type === "success") {
            toast.className = "small fw-semibold mt-1 py-1 px-2 rounded-1 bg-success-subtle text-success border border-success-subtle";
            toast.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + message;
        } else {
            toast.className = "small fw-semibold mt-1 py-1 px-2 rounded-1 bg-danger-subtle text-danger border border-danger-subtle";
            toast.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + message;
        }
        toast.style.display = "block";

        setTimeout(function() {
            if (toast) toast.style.display = "none";
        }, 3000);
    }

    function lookupBarcode(overrideQuery) {
        if (typeof scannerDebounceTimer !== 'undefined') clearTimeout(scannerDebounceTimer);
        if (typeof keluarRefTimeout !== 'undefined') clearTimeout(keluarRefTimeout);

        var lookupInput = document.getElementById("barcodeLookup");
        var query = (overrideQuery || (lookupInput ? lookupInput.value : '')).trim();

        // Synchronously clear input & hide dropdown NOW so next scan starts in a clean 0-character input box!
        if (lookupInput) {
            lookupInput.value = "";
            lookupInput.focus();
        }
        var resultsBox = document.getElementById("keluarSearchResults");
        if (resultsBox) resultsBox.style.display = "none";

        if (!query) return;

        isLookupInFlight = true;

        fetch('/BarangKeluar/LookupBarcode?query=' + encodeURIComponent(query))
            .then(r => r.json())
            .then(data => {
                isLookupInFlight = false;
                if (data && data.masterDataId) {
                    document.getElementById("masterDataId").value = data.masterDataId || '';
                    document.getElementById("keluarItemName").value = data.itemName || '';
                    document.getElementById("keluarBin").value = data.bin || '';
                    
                    // Add item sequentially to scanned cart
                    addItemToScannedCart({
                        masterDataId: data.masterDataId,
                        id: data.masterDataId,
                        itemName: data.itemName,
                        bin: data.bin
                    });
                    playScanSuccess();
                    showLookupToast('<b>' + (data.itemName || query) + '</b> ditambahkan ke list!', 'success');
                } else {
                    playNotFoundBeep();
                    showLookupToast('Part / BIN <b>' + query + '</b> tidak ditemukan di database!', 'warning');
                }
                if (lookupInput) {
                    lookupInput.value = "";
                    lookupInput.focus();
                }
            })
            .catch(err => {
                isLookupInFlight = false;
                console.error("Lookup error:", err);
                playNotFoundBeep();
                showLookupToast('Gagal memproses lookup: ' + query, 'warning');
                if (lookupInput) {
                    lookupInput.value = "";
                    lookupInput.focus();
                }
            });
    }

    let cameraStream = null;
    let nativeScanInterval = null;

    function openCameraModal() {
        try {
            var modalEl = document.getElementById('cameraScanModal');
            if (!modalEl) return;

            modalEl.classList.add('show');
            modalEl.style.display = 'block';
            modalEl.removeAttribute('aria-hidden');
            modalEl.setAttribute('aria-modal', 'true');

            var backdrop = document.querySelector('.modal-backdrop');
            if (!backdrop) {
                backdrop = document.createElement('div');
                backdrop.className = 'modal-backdrop fade show';
                document.body.appendChild(backdrop);
            }

            document.body.classList.add('modal-open');
            document.body.style.overflow = 'hidden';

            setTimeout(function() {
                startCameraStream(currentDeviceId);
            }, 50);
        } catch (e) {
            console.error("openCameraModal error:", e);
            startCameraStream(currentDeviceId);
        }
    }

    function startCameraStream(deviceId) {
        stopQuagga();

        if (location.protocol !== 'https:' && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
            setStatus('warning', '<i class="bi bi-shield-lock me-1"></i> <strong>Akses Kamera Dibatasi:</strong> Browser memblokir kamera di jaringan HTTP non-localhost. Gunakan HTTPS atau localhost.');
        } else {
            setStatus('info', '<i class="bi bi-camera-video me-1"></i> Membuka kamera...');
        }

        var loadingEl = document.getElementById('quagga-loading');
        if (loadingEl) loadingEl.style.display = 'flex';

        var vp = document.getElementById('quagga-viewport');
        if (!vp) return;

        // Clean previous video/canvas elements
        vp.querySelectorAll('video, canvas, #readerTarget').forEach(function(el) { el.remove(); });

        var videoEl = document.createElement('video');
        videoEl.id = 'cameraLiveVideo';
        videoEl.setAttribute('autoplay', '');
        videoEl.setAttribute('playsinline', '');
        videoEl.setAttribute('muted', '');
        videoEl.style.width = '100%';
        videoEl.style.height = '280px';
        videoEl.style.objectFit = 'cover';
        vp.appendChild(videoEl);

        var constraints = deviceId 
            ? { video: { deviceId: { exact: deviceId } } } 
            : { video: { facingMode: { ideal: currentFacingMode } } };

        navigator.mediaDevices.getUserMedia(constraints)
            .then(function(stream) {
                cameraStream = stream;
                videoEl.srcObject = stream;
                videoEl.play().catch(function(){});

                if (loadingEl) loadingEl.style.display = 'none';
                var scanLine = document.getElementById('scanLine');
                if (scanLine) scanLine.style.display = 'block';

                setStatus('ready', '<i class="bi bi-upc-scan me-1"></i> <strong>Scanner Aktif!</strong> Arahkan barcode ke kamera.');

                // Update badge with clean label (drops raw hardware string like 30c9:0010)
                var activeTrack = stream.getVideoTracks()[0];
                var settings = activeTrack && activeTrack.getSettings ? activeTrack.getSettings() : {};
                var isUser = (settings.facingMode === 'user' || currentFacingMode === 'user');
                updateFacingBadge(activeTrack ? activeTrack.label : '', isUser);

                // Populate camera select dropdown and update options
                if (navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
                    navigator.mediaDevices.enumerateDevices().then(function(devices) {
                        var cams = devices.filter(function(d) { return d.kind === 'videoinput'; });
                        availableCameraDevices = cams;

                        var sel = document.getElementById('cameraSelect');
                        var container = document.getElementById('cameraSelectContainer');
                        if (cams.length > 0 && sel) {
                            sel.innerHTML = '';
                            var activeId = deviceId || settings.deviceId;

                            cams.forEach(function(dev, i) {
                                var opt = document.createElement('option');
                                opt.value = dev.deviceId;
                                opt.text = formatCameraSelectLabel(dev.label, i, cams.length);

                                if (dev.deviceId === activeId || (activeId && dev.deviceId === activeId)) {
                                    opt.selected = true;
                                }
                                sel.appendChild(opt);
                            });

                            if (container) {
                                container.style.display = (cams.length > 1) ? 'block' : 'none';
                            }
                        }
                    }).catch(function(e){ console.warn("enumerateDevices error", e); });
                }

                startScannerEngine(videoEl);
            })
            .catch(function(err) {
                console.warn("getUserMedia fallback to video:true", err);
                navigator.mediaDevices.getUserMedia({ video: true })
                    .then(function(stream) {
                        cameraStream = stream;
                        videoEl.srcObject = stream;
                        videoEl.play().catch(function(){});

                        if (loadingEl) loadingEl.style.display = 'none';
                        var scanLine = document.getElementById('scanLine');
                        if (scanLine) scanLine.style.display = 'block';

                        setStatus('ready', '<i class="bi bi-upc-scan me-1"></i> <strong>Scanner Aktif!</strong> Arahkan barcode ke kamera.');
                        var track = stream.getVideoTracks()[0];
                        updateFacingBadge(track ? track.label : '', currentFacingMode === 'user');
                        startScannerEngine(videoEl);
                    })
                    .catch(function(err2) {
                        console.error("Camera access error:", err2);
                        if (loadingEl) loadingEl.style.display = 'none';
                        var msg = (err2.name === 'NotAllowedError' || err2.name === 'PermissionDeniedError')
                            ? 'Akses Kamera Ditolak! Harap beri izin kamera pada icon gembok di address bar.'
                            : 'Gagal membuka kamera: ' + (err2.message || err2.name);
                        setStatus('danger', '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + msg);
                    });
            });
    }

    function startScannerEngine(videoEl) {
        if (nativeScanInterval) clearInterval(nativeScanInterval);

        var rawCanvas = document.createElement('canvas');

        if ('BarcodeDetector' in window) {
            BarcodeDetector.getSupportedFormats().then(function(fmts) {
                var nativeDetector = new BarcodeDetector({ formats: fmts.filter(f => ['code_128','code_39','qr_code','ean_13','upc_a'].includes(f)) });

                nativeScanInterval = setInterval(function() {
                    if (scanCooldown || !videoEl || videoEl.readyState < 2) return;
                    var w = videoEl.videoWidth || 640;
                    var h = videoEl.videoHeight || 480;
                    if (!w || !h) return;

                    rawCanvas.width = w;
                    rawCanvas.height = h;
                    var ctx = rawCanvas.getContext('2d', { willReadFrequently: true });
                    ctx.drawImage(videoEl, 0, 0, w, h);

                    nativeDetector.detect(rawCanvas).then(function(results) {
                        if (results && results.length > 0 && !scanCooldown) {
                            var code = results[0].rawValue;
                            if (code && code !== lastScannedCode) {
                                lastScannedCode = code;
                                scanCooldown = true;
                                onBarcodeDetected(code);
                            }
                        }
                    }).catch(function(){});
                }, 50);
            }).catch(function() {
                startQuaggaFallback(videoEl);
            });
        } else {
            startQuaggaFallback(videoEl);
        }
    }

    function startQuaggaFallback(videoEl) {
        if (typeof Quagga !== 'undefined') {
            try {
                Quagga.init({
                    inputStream: { name: "Live", type: "LiveStream", target: videoEl.parentElement },
                    locator: { patchSize: "medium", halfSample: true },
                    numOfWorkers: 0,
                    decoder: { readers: ["code_128_reader", "code_39_reader", "ean_reader"] }
                }, function(err) {
                    if (!err) {
                        quaggaRunning = true;
                        Quagga.start();
                    }
                });
                Quagga.onDetected(function(result) {
                    var code = result.codeResult && result.codeResult.code;
                    if (!code || scanCooldown || code === lastScannedCode) return;
                    lastScannedCode = code;
                    scanCooldown = true;
                    onBarcodeDetected(code);
                });
            } catch(e) {}
        }
    }

    function handleFileScan(event) {
        var file = event.target.files[0];
        if (!file) return;

        setStatus('info', '<i class="bi bi-hourglass-split me-1"></i> Membaca gambar barcode...');

        if (typeof Html5Qrcode !== 'undefined') {
            var html5QrCode = new Html5Qrcode("quagga-viewport");
            html5QrCode.scanFile(file, true)
                .then(decodedText => {
                    onBarcodeDetected(decodedText);
                })
                .catch(err => {
                    console.error("Html5Qrcode file error:", err);
                    if (typeof Quagga !== 'undefined') {
                        var reader = new FileReader();
                        reader.onload = function(e) {
                            Quagga.decodeSingle({
                                src: e.target.result,
                                numOfWorkers: 0,
                                decoder: { readers: ["code_128_reader", "code_39_reader", "ean_reader"] }
                            }, function(res) {
                                if (res && res.codeResult && res.codeResult.code) {
                                    onBarcodeDetected(res.codeResult.code);
                                } else {
                                    setStatus('warning', '<i class="bi bi-exclamation-triangle me-1"></i> Barcode tidak terdeteksi pada gambar ini.');
                                }
                            });
                        };
                        reader.readAsDataURL(file);
                    } else {
                        setStatus('warning', '<i class="bi bi-exclamation-triangle me-1"></i> Barcode tidak terdeteksi pada gambar ini.');
                    }
                });
        }
    }

    function onBarcodeDetected(code) {
        // Show "detected" status first, then lookup in DB
        setStatus('info', '<i class="bi bi-hourglass-split me-1"></i> Barcode: <strong>' + code + '</strong> — memeriksa database...');

        fetch('/BarangKeluar/LookupBarcode?query=' + encodeURIComponent(code))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.masterDataId) {
                    playScanSuccess();
                    setStatus('success', '<i class="bi bi-check-circle-fill me-1"></i> <strong>✓ Ditemukan &amp; Ditambahkan!</strong> ' + data.itemName + ' [' + code + ']');
                    
                    addItemToScannedCart({
                        masterDataId: data.masterDataId,
                        id: data.masterDataId,
                        itemName: data.itemName,
                        bin: data.bin
                    });

                    setTimeout(function() {
                        scanCooldown = false;
                        lastScannedCode = null;
                        setStatus('ready', '<i class="bi bi-upc-scan me-1"></i> <strong>Scanner aktif!</strong> Siap scan item berikutnya...');
                    }, 1200);
                } else {
                    playNotFoundBeep();
                    setStatus('warning', '<i class="bi bi-exclamation-triangle me-1"></i> Kode <strong>' + code + '</strong> tidak ada di database. Arahkan ke barcode <u>UPF-XXXXX</u>.');
                    setTimeout(function() {
                        scanCooldown = false;
                        lastScannedCode = null;
                        setStatus('ready', '<i class="bi bi-upc-scan me-1"></i> <strong>Scanner aktif!</strong> Arahkan barcode ke kamera...');
                    }, 1800);
                }
            })
            .catch(function(err) {
                console.error(err);
                scanCooldown = false;
                lastScannedCode = null;
            });
    }

    function stopQuagga() {
        if (nativeScanInterval) { clearInterval(nativeScanInterval); nativeScanInterval = null; }
        if (cameraStream) {
            try { cameraStream.getTracks().forEach(function(track) { track.stop(); }); } catch(e) {}
            cameraStream = null;
        }
        if (typeof Quagga !== 'undefined') {
            try { Quagga.stop(); } catch(e) {}
        }
        quaggaRunning = false;
        var scanLine = document.getElementById('scanLine');
        if (scanLine) scanLine.style.display = 'none';
        var loadingEl = document.getElementById('quagga-loading');
        if (loadingEl) loadingEl.style.display = 'flex';
        lastScannedCode = null;
        scanCooldown = false;
        var vp = document.getElementById('quagga-viewport');
        if (vp) {
            vp.querySelectorAll('video, canvas, #readerTarget').forEach(function(el) { el.remove(); });
        }
    }

    function stopCameraModal() {
        try {
            stopQuagga();
            var modalEl = document.getElementById('cameraScanModal');
            if (!modalEl) return;

            modalEl.classList.remove('show');
            modalEl.style.display = 'none';
            modalEl.setAttribute('aria-hidden', 'true');
            modalEl.removeAttribute('aria-modal');

            var backdrops = document.querySelectorAll('.modal-backdrop');
            backdrops.forEach(function(b) { b.remove(); });

            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
        } catch(e) {
            console.error("stopCameraModal error:", e);
        }
    }

    function toggleFacingMode() {
        currentFacingMode = (currentFacingMode === "environment") ? "user" : "environment";
        var badge = document.getElementById("cameraFacingBadge");
        if (badge) {
            badge.innerHTML = currentFacingMode === "environment"
                ? '<i class="bi bi-camera me-1"></i> Belakang'
                : '<i class="bi bi-person-bounding-box me-1"></i> Depan';
        }
        initQuagga();
    }

    function switchToCamera(deviceId) {
        if (!deviceId) return;
        currentDeviceId = deviceId;
        initQuagga(deviceId);
    }

    function setStatus(type, html) {
        var el = document.getElementById("cameraStatus");
        var cls = { info: 'alert-info', warning: 'alert-warning', success: 'alert-success', ready: 'alert-success' };
        el.className = 'alert py-2 px-3 small mt-2 mb-0 text-start ' + (cls[type] || 'alert-info');
        el.innerHTML = html;
    }

    function appendDebug(msg) {
        var el = document.getElementById('scanDebug');
        if (!el) return;
        var line = document.createElement('div');
        line.textContent = new Date().toLocaleTimeString('id-ID', {hour12:false}) + ' ' + msg;
        el.appendChild(line);
        el.scrollTop = el.scrollHeight;
        while (el.children.length > 30) el.removeChild(el.firstChild);
    }

    function toggleDebug() {
        debugVisible = !debugVisible;
        var el = document.getElementById('scanDebug');
        if (el) el.style.display = debugVisible ? 'block' : 'none';
    }

    function playScanSuccess() {
        try {
            var ctx = new (window.AudioContext || window.webkitAudioContext)();
            var osc1 = ctx.createOscillator();
            var gain1 = ctx.createGain();
            osc1.connect(gain1); gain1.connect(ctx.destination);
            osc1.type = 'sine'; osc1.frequency.value = 800;
            gain1.gain.setValueAtTime(0.5, ctx.currentTime);
            gain1.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);
            osc1.start(ctx.currentTime);
            osc1.stop(ctx.currentTime + 0.15);
            var osc2 = ctx.createOscillator();
            var gain2 = ctx.createGain();
            osc2.connect(gain2); gain2.connect(ctx.destination);
            osc2.type = 'sine'; osc2.frequency.value = 1400;
            gain2.gain.setValueAtTime(0.5, ctx.currentTime + 0.12);
            gain2.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.35);
            osc2.start(ctx.currentTime + 0.12);
            osc2.stop(ctx.currentTime + 0.35);
        } catch(e) {}
        try {
            if (window.speechSynthesis) {
                var utter = new SpeechSynthesisUtterance('Barcode terdeteksi');
                utter.lang = 'id-ID';
                utter.rate = 1.0;
                utter.pitch = 1.0;
                window.speechSynthesis.cancel();
                window.speechSynthesis.speak(utter);
            }
        } catch(e) {}
    }

    function playNotFoundBeep() {
        try {
            var ctx = new (window.AudioContext || window.webkitAudioContext)();
            var osc = ctx.createOscillator();
            var gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            osc.type = 'sawtooth'; osc.frequency.value = 300;
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.25);
        } catch(e) {}
    }

    // ── Multi-Scan Cart State & Helpers ─────────────────────────────────────
    var scannedCart = [];
    var activeCartIdx = null;

    function addItemToScannedCart(item) {
        var existingIdx = scannedCart.findIndex(x => x.masterDataId === item.masterDataId);
        if (existingIdx >= 0) {
            activeCartIdx = existingIdx;
        } else {
            scannedCart.push({
                masterDataId: item.masterDataId || item.id || '',
                partNumber: item.masterDataId || item.id || '',
                itemName: item.itemName || item.item || '',
                bin: item.bin || '',
                qty: 1,
                line: item.line || '',
                machineId: null,
                pic: document.getElementById("picSelect") ? document.getElementById("picSelect").value : '',
                maintenanceType: '',
                actionNote: '',
                status: 'Belum diisi'
            });
            activeCartIdx = scannedCart.length - 1;
        }
        renderScannedCart();
        loadCartItemToForm(activeCartIdx);
    }

    function isItemReady(item) {
        if (!item) return false;
        if (!item.line || item.line.trim() === '') return false;
        if (!item.pic || item.pic.trim() === '') return false;
        if (!item.qty || item.qty <= 0) return false;
        if (!item.maintenanceType || item.maintenanceType.trim() === '') return false;
        
        var macSel = document.getElementById("machineSelect");
        if (macSel && !macSel.disabled && macSel.options.length > 1) {
            if (!item.machineId || isNaN(item.machineId) || item.machineId <= 0) {
                return false;
            }
        }
        return true;
    }

    function renderScannedCart() {
        var container = document.getElementById("scannedCartList");
        var countEl = document.getElementById("cartCount");

        if (!container) return;

        if (countEl) countEl.innerText = scannedCart.length;

        if (scannedCart.length === 0) {
            container.innerHTML = '<div class="text-center text-muted py-3 small bg-light border rounded fst-italic fw-normal" style="font-size: 11px;">Scan barcode atau cari item untuk menambahkan ke daftar pengeluaran.</div>';
            return;
        }

        container.innerHTML = "";

        scannedCart.forEach((item, idx) => {
            var isActive = (idx === activeCartIdx);
            var isReady = isItemReady(item);
            item.status = isReady ? 'Siap' : 'Belum diisi';

            var card = document.createElement("div");
            card.className = "card p-2 border rounded-2 shadow-sm " + (isActive ? "border-primary bg-light" : "bg-white");
            card.style.cursor = "pointer";
            var badgeClass = isReady ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning-emphasis border border-warning";
            card.innerHTML = '<div class="d-flex justify-content-between align-items-center"><div onclick="selectCartItem(' + idx + ')" class="flex-grow-1 me-2"><div class="d-flex align-items-center gap-2"><span class="text-primary font-monospace small fw-medium">' + item.partNumber + '</span><span class="small text-dark fw-normal text-truncate" style="max-width: 170px;">' + item.itemName + '</span></div><div class="small text-muted fw-normal mt-1" style="font-size: 11px;">BIN: ' + (item.bin || '-') + ' | QTY: ' + item.qty + ' | Line: ' + (item.line || '-') + ' | Maint: ' + (item.maintenanceType || '-') + '</div></div><div class="d-flex align-items-center gap-1"><span class="badge fw-normal ' + badgeClass + '" style="font-size: 10px;">' + item.status + '</span><button type="button" class="btn btn-sm btn-outline-danger border-0 p-1" onclick="removeCartItem(event, ' + idx + ')"><i class="bi bi-trash"></i></button></div></div>';
            container.appendChild(card);
        });
    }

    function selectCartItem(idx) {
        if (idx < 0 || idx >= scannedCart.length) return;
        activeCartIdx = idx;
        loadCartItemToForm(idx);
        renderScannedCart();
    }

    function loadCartItemToForm(idx) {
        if (idx < 0 || idx >= scannedCart.length) return;
        var item = scannedCart[idx];
        document.getElementById("masterDataId").value = item.masterDataId || '';
        document.getElementById("keluarPartNumber").value = item.partNumber || '';
        document.getElementById("keluarBin").value = item.bin || '';
        document.getElementById("keluarItemName").value = item.itemName || '';
        document.getElementById("keluarQty").value = item.qty || 1;

        if (item.line) {
            document.getElementById("lineSelect").value = item.line;
            onLineChange(item.line, item.machineId);
        } else {
            onLineChange("", null);
        }

        if (item.pic) document.getElementById("picSelect").value = item.pic;
        if (item.maintenanceType) document.getElementById("maintTypeSelect").value = item.maintenanceType;
        if (item.actionNote) document.getElementById("keluarRemarks").value = item.actionNote;
    }

    function syncFormToActiveCart() {
        if (activeCartIdx === null || !scannedCart[activeCartIdx]) return;
        var item = scannedCart[activeCartIdx];
        var binVal = document.getElementById("keluarBin");
        if (binVal) item.bin = binVal.value;
        var nameVal = document.getElementById("keluarItemName");
        if (nameVal) item.itemName = nameVal.value;
        var lineVal = document.getElementById("lineSelect");
        if (lineVal) item.line = lineVal.value;
        var macVal = document.getElementById("machineSelect");
        if (macVal) {
            var selectedMac = macVal.value;
            item.machineId = (selectedMac && selectedMac !== "") ? parseInt(selectedMac) : null;
        }
        var qtyVal = document.getElementById("keluarQty");
        if (qtyVal) item.qty = parseInt(qtyVal.value) || 1;
        var picVal = document.getElementById("picSelect");
        if (picVal) item.pic = picVal.value;
        var mtVal = document.getElementById("maintTypeSelect");
        if (mtVal) item.maintenanceType = mtVal.value;
        var remVal = document.getElementById("keluarRemarks");
        if (remVal) item.actionNote = remVal.value;
        renderScannedCart();
    }

    function handleUnifiedSubmit() {
        if (activeCartIdx !== null && scannedCart[activeCartIdx]) {
            syncFormToActiveCart();
        }

        if (scannedCart.length > 0) {
            submitBatchScannedCart();
            return;
        }

        var form = document.getElementById("keluarForm");
        if (form.checkValidity()) {
            form.submit();
        } else {
            form.reportValidity();
        }
    }

    function removeCartItem(e, idx) {
        e.stopPropagation();
        scannedCart.splice(idx, 1);
        if (activeCartIdx === idx) activeCartIdx = null;
        else if (activeCartIdx > idx) activeCartIdx--;
        renderScannedCart();
    }

    function clearScannedCart() {
        scannedCart = [];
        activeCartIdx = null;
        renderScannedCart();
        resetKeluarForm();
    }

    function getMissingFieldsForItem(item) {
        var missing = [];
        if (!item.line || !item.line.trim()) missing.push("Actual Usage Line");
        
        var macSel = document.getElementById("machineSelect");
        if (macSel && !macSel.disabled && macSel.options.length > 1) {
            if (!item.machineId || isNaN(item.machineId) || item.machineId <= 0) {
                missing.push("Mesin");
            }
        }
        
        if (!item.qty || item.qty <= 0) missing.push("QTY");
        if (!item.pic || !item.pic.trim()) missing.push("PIC Technician");
        if (!item.maintenanceType || !item.maintenanceType.trim()) missing.push("Maintenance Type");
        return missing;
    }

    function submitBatchScannedCart() {
        if (scannedCart.length === 0) return;
        var unreadyItems = scannedCart.filter(x => !isItemReady(x));
        
        if (unreadyItems.length > 0) {
            var errorLines = unreadyItems.map(item => {
                var missing = getMissingFieldsForItem(item);
                var pNum = item.partNumber || item.masterDataId || 'Unspecified';
                var name = item.itemName ? ' (' + item.itemName + ')' : '';
                return '• Part Number [' + pNum + ']' + name + ':\n   ➜ Belum diisi: ' + missing.join(', ');
            });

            alert("⚠️ HARAP LENGKAPI DATA SEBELUM DISIMPAN:\n\n" + errorLines.join("\n\n") + "\n\n(Catatan/Remarks adalah satu-satunya field opsional).");
            
            var firstUnreadyIdx = scannedCart.findIndex(x => !isItemReady(x));
            if (firstUnreadyIdx >= 0) {
                selectCartItem(firstUnreadyIdx);
            }
            return;
        }

        var tDate = document.getElementById("keluarTanggal").value;

        var payload = scannedCart.map(x => ({
            MasterDataId: x.masterDataId,
            PartNumber: x.partNumber || x.masterDataId,
            Bin: x.bin,
            ItemName: x.itemName,
            Qty: x.qty,
            Line: x.line,
            MachineId: x.machineId,
            Pic: x.pic,
            MaintenanceType: x.maintenanceType,
            ActionNote: x.actionNote,
            Tanggal: tDate
        }));

        fetch('/BarangKeluar/SubmitBatch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                alert("✓ " + res.message);
                clearScannedCart();
                location.reload();
            } else {
                alert("Gagal: " + res.message);
            }
        })
        .catch(err => {
            console.error(err);
            alert("Terjadi kesalahan saat memproses transaksi.");
        });
    }

    // ── Live Master Data Search & Form Helpers ──────────────────────────────
    var keluarRefTimeout = null;

    function onKeluarSearchInput(val) {
        clearTimeout(keluarRefTimeout);
        var resultsBox = document.getElementById("keluarSearchResults");
        if (!resultsBox) return;

        if (!val || val.trim().length < 2 || isLookupInFlight) {
            resultsBox.style.display = "none";
            return;
        }

        keluarRefTimeout = setTimeout(function() {
            var lookupVal = document.getElementById("barcodeLookup") ? document.getElementById("barcodeLookup").value.trim() : '';
            if (!lookupVal || lookupVal !== val.trim()) return;

            fetch('/BarangKeluar/SearchMasterData?query=' + encodeURIComponent(val.trim()))
                .then(res => res.json())
                .then(data => {
                    resultsBox.innerHTML = "";
                    if (data && data.length > 0) {
                        data.forEach(item => {
                            var btn = document.createElement("button");
                            btn.type = "button";
                            btn.className = "list-group-item list-group-item-action py-2 px-3 small border-0 border-bottom";
                            btn.innerHTML = '<div class="d-flex justify-content-between align-items-center"><div><strong class="text-primary">' + item.id + '</strong> <span class="ms-2 fw-semibold">' + item.item + '</span></div><span class="badge bg-secondary font-monospace">BIN: ' + item.bin + '</span></div>';
                            btn.onclick = function() {
                                selectKeluarMasterItem(item);
                                resultsBox.style.display = "none";
                            };
                            resultsBox.appendChild(btn);
                        });
                        resultsBox.style.display = "block";
                    } else {
                        resultsBox.style.display = "none";
                    }
                })
                .catch(err => console.error(err));
        }, 350);
    }

    function selectKeluarMasterItem(item) {
        addItemToScannedCart({
            masterDataId: item.id || item.masterDataId,
            id: item.id || item.masterDataId,
            itemName: item.item || item.itemName,
            bin: item.bin
        });
        var input = document.getElementById("barcodeLookup");
        if (input) {
            input.value = "";
            input.focus();
        }
        var resultsBox = document.getElementById("keluarSearchResults");
        if (resultsBox) resultsBox.style.display = "none";
    }

    function onKeluarBinInput(val) {
        var statusEl = document.getElementById("keluarBinStatus");
        var itemEl = document.getElementById("keluarItemName");
        var partEl = document.getElementById("keluarPartNumber");

        if (!val || val.trim().length < 2) {
            if (statusEl) statusEl.innerText = "";
            if (itemEl) itemEl.readOnly = false;
            return;
        }

        fetch('/BarangKeluar/LookupBarcode?query=' + encodeURIComponent(val.trim()))
            .then(res => res.json())
            .then(data => {
                if (data) {
                    document.getElementById("masterDataId").value = data.masterDataId || '';
                    if (itemEl) { itemEl.value = data.itemName || ''; itemEl.readOnly = true; }
                    if (partEl) partEl.value = data.masterDataId || '';
                    if (statusEl) {
                        statusEl.innerText = "Ditemukan di Master Data";
                        statusEl.className = "small fw-semibold text-success";
                    }
                } else {
                    if (itemEl) itemEl.readOnly = false;
                    if (statusEl) {
                        statusEl.innerText = "BIN baru - isi nama item manual";
                        statusEl.className = "small fw-semibold text-warning";
                    }
                }
            })
            .catch(err => console.error(err));
    }

    function onLineChange(line, selectMachineId) {
        var machineSel = document.getElementById("machineSelect");
        if (!machineSel) return;
        machineSel.innerHTML = '<option value="">Pilih Mesin</option>';
        if (!line) {
            machineSel.disabled = true;
            syncFormToActiveCart();
            return;
        }

        fetch('/BarangKeluar/GetMachinesByLine?line=' + encodeURIComponent(line))
            .then(res => res.json())
            .then(machines => {
                if (machines && machines.length > 0) {
                    machines.forEach(m => {
                        var opt = document.createElement("option");
                        opt.value = m.id;
                        opt.innerText = m.code + ' - ' + m.name;
                        machineSel.appendChild(opt);
                    });
                    machineSel.disabled = false;
                    if (selectMachineId) {
                        machineSel.value = selectMachineId;
                    }
                } else {
                    machineSel.disabled = true;
                }
                syncFormToActiveCart();
            })
            .catch(err => {
                console.error(err);
                machineSel.disabled = true;
                syncFormToActiveCart();
            });
    }

    function resetKeluarForm() {
        document.getElementById("keluarForm").reset();
        document.getElementById("masterDataId").value = "";
        document.getElementById("barcodeLookup").value = "";
        document.getElementById("keluarSearchResults").style.display = "none";
        document.getElementById("keluarPartNumber").value = "";
        document.getElementById("keluarItemName").readOnly = false;
        var statusEl = document.getElementById("keluarBinStatus");
        if (statusEl) statusEl.innerText = "";
        var machineSel = document.getElementById("machineSelect");
        if (machineSel) {
            machineSel.innerHTML = '<option value="">Pilih Mesin</option>';
            machineSel.disabled = true;
        }
    }

    document.addEventListener("click", function(e) {
        var box = document.getElementById("keluarSearchResults");
        var search = document.getElementById("barcodeLookup");
        if (box && search && !box.contains(e.target) && !search.contains(e.target)) {
            box.style.display = "none";
        }
    });

    // Global auto-refocus for hands-free scanning mobility:
    // If technician scans without focused input, automatically redirect focus to barcodeLookup
    document.addEventListener("keydown", function(e) {
        var active = document.activeElement;
        if (active && (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.tagName === "SELECT")) {
            return;
        }
        if (e.key && e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey) {
            var lookupInput = document.getElementById("barcodeLookup");
            if (lookupInput) {
                lookupInput.focus();
            }
        }
    });
    </script>
}
