@{
    ViewData["Title"] = "Akses Ditolak";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 mx-auto p-4" style="max-width: 500px; border-radius:0;">
        <i class="bi bi-shield-lock-fill text-danger fs-1 mb-3"></i>
        <h4 class="fw-bold text-danger mb-2">Akses Ditolak (403 Forbidden)</h4>
        <p class="text-muted small mb-4">
            Maaf, akun Anda tidak memiliki hak akses yang cukup untuk membuka menu ini.<br/>
            Silakan hubungi Administrator untuk memperbarui hak akses menu Anda pada Settings &amp; Users.
        </p>
        <div>
            <a href="/" class="btn btn-ems-primary btn-sm px-4">
                <i class="bi bi-house me-1"></i>Kembali ke Beranda
            </a>
        </div>
    </div>
</div>
