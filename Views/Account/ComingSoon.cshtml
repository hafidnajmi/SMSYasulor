@{
    Layout = null;
    var dept = ViewData["Dept"] as string ?? "Process";
    var deptUpper = dept.ToUpper();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UP @deptUpper - Coming Soon | Sparepart Management System</title>
    <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/hafidnajmi/SMSYasulor/main/wwwroot/lib/app_icon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <style>
        * {
            font-family: Arial, sans-serif !important;
            box-sizing: border-box;
        }

        body {
            background-color: #FFFFFF;
            color: #0F172A;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .cs-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            padding: 40px 24px;
        }

        .cs-system-tag {
            display: inline-block;
            color: #0047AB;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 16px;
            border-bottom: 2px solid #0047AB;
            padding-bottom: 4px;
        }

        .cs-title {
            font-size: 32px;
            font-weight: 700;
            color: #0F172A;
            letter-spacing: -0.5px;
            margin-bottom: 16px;
        }

        .cs-description {
            font-size: 15px;
            color: #475569;
            line-height: 1.6;
            margin-bottom: 36px;
        }

        .btn-cs-primary {
            background-color: #0047AB;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 12px 24px;
            border: none;
            border-radius: 0px !important;
            transition: background-color 0.15s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-cs-primary:hover {
            background-color: #003380;
            color: #FFFFFF;
        }

        .btn-cs-secondary {
            background-color: #F1F5F9;
            color: #0047AB;
            border: 1px solid #CBD5E1;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 11px 24px;
            border-radius: 0px !important;
            transition: all 0.15s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-cs-secondary:hover {
            background-color: #E2E8F0;
            color: #003380;
        }

        .cs-footer {
            margin-top: 48px;
            padding-top: 20px;
            border-top: 1px solid #E2E8F0;
            font-size: 12px;
            color: #94A3B8;
        }
    </style>
</head>
<body>
    <div class="cs-container">
        <div class="cs-system-tag">
            DEPARTMENT SYSTEM: UP @deptUpper
        </div>

        <h1 class="cs-title">Coming Soon</h1>

        <p class="cs-description">
            Sistem Terintegrasi Sparepart Management System (SMS) untuk <strong>UP @deptUpper</strong> saat ini sedang dalam tahap pengembangan dan integrasi sistem terpusat.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-3">
            <a href="/Account/Logout" class="btn btn-cs-primary">
                KEMBALI KE HALAMAN LOGIN
            </a>

            <form asp-controller="Account" asp-action="Login" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="username" value="technician" />
                <input type="hidden" name="password" value="technician123" />
                <input type="hidden" name="department" value="Filling" />
                <button type="submit" class="btn btn-cs-secondary">
                    LOGIN AS TECHNICIAN (UP FILLING)
                </button>
            </form>
        </div>

        <div class="cs-footer">
            Sparepart Management System &copy; 2026 Enterprise Suite
        </div>
    </div>
</body>
</html>
