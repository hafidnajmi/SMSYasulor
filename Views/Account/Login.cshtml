@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Sparepart Management System (SMS)</title>
    <link rel="icon" type="image/png" href="/lib/app_icon.png" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #F3F5F8;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, Helvetica, sans-serif !important;
            margin: 0;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 0px !important;
            border: 1px solid #E2E8F0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            padding: 48px 40px 36px;
        }

        .ems-logo-badge {
            background: linear-gradient(135deg, #005BAB 0%, #003870 100%);
            border-radius: 6px;
            padding: 10px 24px;
            display: inline-block;
            box-shadow: 0 4px 12px rgba(0, 91, 171, 0.25);
        }

        .ems-logo-text {
            font-weight: 900;
            font-style: italic;
            font-size: 32px;
            color: #ffffff;
            line-height: 1;
            letter-spacing: 2px;
        }

        .ems-logo-sub {
            font-size: 8.5px;
            color: #E2E8F0;
            font-weight: 500;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-top: 3px;
        }

        .form-label-ems {
            font-size: 11px;
            font-weight: 700;
            color: #334155;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 6px;
            display: block;
        }

        .input-group-ems {
            display: flex;
            width: 100%;
        }

        .input-group-ems .input-group-text {
            background-color: #EBF2FA;
            border: 1px solid #94A3B8;
            border-right: none;
            border-radius: 0px !important;
            color: #64748B;
            padding: 10px 14px;
        }

        .input-group-ems .form-control {
            background-color: #EBF2FA;
            border: 1px solid #94A3B8;
            border-left: none;
            border-radius: 0px !important;
            color: #0F172A;
            font-size: 14px;
            font-weight: 500;
            padding: 10px 12px;
            box-shadow: none;
        }

        .input-group-ems .form-control:focus {
            background-color: #EBF2FA;
            border-color: #1E3A8A;
            box-shadow: none;
        }

        .btn-ems-login {
            background-color: #2B4C7E;
            color: #ffffff;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            padding: 12px;
            border: none;
            border-radius: 0px !important;
            width: 100%;
            transition: background-color 0.2s ease;
        }

        .btn-ems-login:hover {
            background-color: #1E385C;
            color: #ffffff;
        }

        .login-divider {
            border-top: 1px solid #E2E8F0;
            margin: 28px 0 20px;
        }

        .login-footer-text {
            font-size: 11px;
            color: #94A3B8;
            text-align: center;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <!-- Logo Section -->
        <div class="text-center mb-4">
            <img src="/lib/app_icon.png" alt="SMS Logo" style="max-height: 160px; width: auto; object-fit: contain; margin-bottom: 4px;" />
            <h5 class="fw-bold mb-0" style="color: #1E3A8A; letter-spacing: 0.8px; font-size: 15px; margin-top: 0;">SPAREPART MANAGEMENT SYSTEM</h5>
        </div>

        <!-- Validation Error Message -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small rounded-0 mb-3">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <!-- Login Form -->
        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label class="form-label-ems">USERNAME</label>
                <div class="input-group-ems">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" name="username" id="username" class="form-control" placeholder="Username" required autofocus autocomplete="username" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label-ems">PASSWORD</label>
                <div class="input-group-ems">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" id="password" class="form-control" placeholder="••••••••••••" required autocomplete="current-password" />
                </div>
            </div>

            <button type="submit" class="btn btn-ems-login mb-2">
                SIGN IN <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </form>

        <!-- Footer -->
        <div class="login-divider"></div>
        <div class="login-footer-text">
            &copy; 2026 IGS Sparepart Management System<br />
            Security Protocol TLS 1.3 Active
        </div>
    </div>
</body>
</html>
