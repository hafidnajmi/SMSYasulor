        // 1-Click Toggle for Auto-Email Alert Selected
        async function toggleAlertSelected(id, btnElem) {
            try {
                btnElem.style.pointerEvents = 'none';
                const formData = new URLSearchParams();
                formData.append('id', id);

                const response = await fetch('/MasterData/ToggleAlert', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                });
                const data = await response.json();
                if (data.success) {
                    if (data.alertSelected) {
                        btnElem.innerHTML = '<i class="bi bi-bell-fill text-warning fs-6"></i>';
                        btnElem.title = 'Auto Email Alert Active (Click to disable)';
                    } else {
                        btnElem.innerHTML = '<i class="bi bi-bell text-muted opacity-25 fs-6"></i>';
                        btnElem.title = 'Auto Email Alert Disabled (Click to enable)';
                    }
                } else {
                    alert('Failed to toggle alert: ' + (data.message || 'Unknown error'));
                }
            } catch (err) {
                console.error('Failed to toggle alert:', err);
                alert('Error toggling alert: ' + err.message);
            } finally {
                btnElem.style.pointerEvents = 'auto';
            }
        }
        function calcSafetyStockFormula(qtyNeed, ltMonths, frequency) {
            var need = parseFloat(qtyNeed) || 0;
            var lt = parseFloat(ltMonths) || 0;
            var freq = (frequency || "").toUpperCase();

            if (need <= 0 || lt <= 0) return 0;

            var leadTimeNeed = (need / 12.0) * lt;
            var safetyFactor = (freq === "FAST") ? 1.0 : 0.5;
            return Math.round(leadTimeNeed * safetyFactor);
        }

        function recalcAddSafetyStock() {
            var need = document.getElementById("addQtyNeedYear").value;
            var lt = document.getElementById("addLtPerMonth").value;
            var freq = document.getElementById("addFrequency").value;
            document.getElementById("addSafetyStock").value = calcSafetyStockFormula(need, lt, freq);
        }

        function recalcEditSafetyStock() {
            var need = document.getElementById("editQtyNeedYear").value;
            var lt = document.getElementById("editLtPerMonth").value;
            var freq = document.getElementById("editFrequency").value;
            document.getElementById("editSafetyStock").value = calcSafetyStockFormula(need, lt, freq);
        }

        const availableProductionLines = [
            "B4", "B5", "B10", "B11", "B15", "B16", "B17", "B18", "B19", "B20", "B21", "B22", "B24",
            "J3", "J4", "J5",
            "T1", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "T12",
            "S6", "S7", "S8", "S9", "S10", "S14", "S15", "S16", "S18", "S19", "S20",
            "GENERAL", "VACANT", "WASHER"
        ];

        function renderLinePills(containerId, hiddenInputId, previewTextId, currentCsvValue) {
            var container = document.getElementById(containerId);
            var hiddenInput = document.getElementById(hiddenInputId);
            var previewText = document.getElementById(previewTextId);
            if (!container || !hiddenInput) return;

            var activeSet = new Set();
            if (currentCsvValue) {
                currentCsvValue.split(',').forEach(function(item) {
                    var trimmed = item.trim().toUpperCase();
                    if (trimmed) activeSet.add(trimmed);
                });
            }

            container.innerHTML = '';

            var fullLineList = [...availableProductionLines];
            activeSet.forEach(function(code) {
                if (!fullLineList.includes(code)) {
                    fullLineList.push(code);
                }
            });

            fullLineList.forEach(function(code) {
                var isSelected = activeSet.has(code.toUpperCase());
                
                var pill = document.createElement('button');
                pill.type = 'button';
                pill.className = 'btn btn-sm text-nowrap py-1 px-2 ' + (isSelected ? 'btn-primary fw-bold' : 'btn-outline-secondary text-dark bg-white');
                pill.style.fontSize = '11px';
                pill.style.borderRadius = '4px';
                pill.style.minWidth = '40px';
                pill.style.textAlign = 'center';
                pill.style.transition = 'background-color 0.1s ease, border-color 0.1s ease';
                pill.textContent = code;

                pill.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (activeSet.has(code.toUpperCase())) {
                        activeSet.delete(code.toUpperCase());
                    } else {
                        activeSet.add(code.toUpperCase());
                    }
                    
                    var newCsv = Array.from(activeSet).join(', ');
                    hiddenInput.value = newCsv;

                    renderLinePills(containerId, hiddenInputId, previewTextId, newCsv);
                });

                container.appendChild(pill);
            });

            if (previewText) {
                var count = activeSet.size;
                previewText.textContent = count > 0 ? '(' + count + ' Line: ' + Array.from(activeSet).join(', ') + ')' : '(Belum dipilih)';
                previewText.style.color = count > 0 ? '#0F4C81' : '#6B7280';
            }
        }

        function renderUpAreaPills(containerId, hiddenInputId, previewTextId, currentAreaValue) {
            var container = document.getElementById(containerId);
            var hiddenInput = document.getElementById(hiddenInputId);
            var previewText = document.getElementById(previewTextId);
            if (!container || !hiddenInput) return;

            var activeSet = new Set();
            if (currentAreaValue) {
                currentAreaValue.split(',').forEach(function(item) {
                    var trimmed = item.trim().toUpperCase();
                    if (trimmed) activeSet.add(trimmed);
                });
            }
            if (activeSet.size === 0) {
                activeSet.add("UP1");
            }

            container.innerHTML = '';

            ["UP1", "UP2"].forEach(function(area) {
                var isSelected = activeSet.has(area);
                
                var pill = document.createElement('button');
                pill.type = 'button';
                pill.className = 'btn btn-sm text-nowrap py-1 px-3 ' + (isSelected ? 'btn-primary fw-bold' : 'btn-outline-secondary text-dark bg-white');
                pill.style.fontSize = '12px';
                pill.style.borderRadius = '4px';
                pill.style.minWidth = '75px';
                pill.style.textAlign = 'center';
                pill.style.transition = 'background-color 0.1s ease, border-color 0.1s ease';
                pill.textContent = area;

                pill.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (activeSet.has(area)) {
                        if (activeSet.size > 1) {
                            activeSet.delete(area);
                        }
                    } else {
                        activeSet.add(area);
                    }
                    
                    var newCsv = Array.from(activeSet).join(', ');
                    hiddenInput.value = newCsv;

                    renderUpAreaPills(containerId, hiddenInputId, previewTextId, newCsv);
                });

                container.appendChild(pill);
            });

            if (previewText) {
                var resultStr = Array.from(activeSet).join(', ');
                previewText.textContent = '(' + resultStr + ')';
                previewText.style.color = '#0F4C81';
            }
        }

        function filterByStockStatus(status) {
            var input = document.getElementById('stockStatusInput');
            var filterForm = document.getElementById('filterForm');
            if (input) {
                input.value = status;
            }
            if (filterForm) {
                var formData = new FormData(filterForm);
                var params = new URLSearchParams(formData);
                var url = filterForm.action + '?' + params.toString();
                loadMasterDataAjax(url);
            }
        }

        function clearAllAddLines() {
            renderLinePills('addLinePillContainer', 'addLineInput', 'addLinePreviewText', '');
        }

        function clearAllEditLines() {
            renderLinePills('editLinePillContainer', 'editLine', 'editLinePreviewText', '');
        }

        document.addEventListener('DOMContentLoaded', function () {
            renderLinePills('addLinePillContainer', 'addLineInput', 'addLinePreviewText', '');
            renderUpAreaPills('addUpAreaPillContainer', 'addUpAreaInput', 'addUpAreaPreviewText', 'UP1');

            var addModalElem = document.getElementById('addModal');
            if (addModalElem) {
                addModalElem.addEventListener('show.bs.modal', function () {
                    renderLinePills('addLinePillContainer', 'addLineInput', 'addLinePreviewText', '');
                    renderUpAreaPills('addUpAreaPillContainer', 'addUpAreaInput', 'addUpAreaPreviewText', 'UP1');
                });
            }

            // Intercept clicks on pagination links inside spareparts table card
            document.addEventListener('click', function (e) {
                var a = e.target.closest('#spareparts-table-card .page-link');
                if (a && a.href && !a.href.startsWith('javascript:') && !a.parentElement.classList.contains('disabled')) {
                    e.preventDefault();
                    loadMasterDataAjax(a.href);
                }
            });

            // Intercept filter form submit
            var filterForm = document.getElementById('filterForm');
            if (filterForm) {
                filterForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var formData = new FormData(filterForm);
                    var params = new URLSearchParams(formData);
                    var url = filterForm.action + '?' + params.toString();
                    loadMasterDataAjax(url);
                });
            }
        });

        function loadMasterDataAjax(url) {
            var card = document.getElementById('spareparts-table-card');
            if (!card) {
                window.location.href = url;
                return;
            }
            
            card.style.opacity = '0.6';

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function(res) { return res.text(); })
                .then(function(html) {
                    var parser = new DOMParser();
                    var doc = parser.parseFromString(html, 'text/html');
                    
                    var newCard = doc.getElementById('spareparts-table-card');
                    if (newCard) {
                        card.innerHTML = newCard.innerHTML;
                    }

                    card.style.opacity = '1';
                    history.pushState(null, '', url);
                })
                .catch(function() {
                    card.style.opacity = '1';
                    window.location.href = url;
                });
        }

        document.addEventListener('DOMContentLoaded', function() {
            var addModalElem = document.getElementById('addModal');
            if (addModalElem) {
                addModalElem.addEventListener('show.bs.modal', async function () {
                    var idInput = document.getElementById('addPartNumberInput');
                    if (idInput && !idInput.value.trim()) {
                        try {
                            var res = await fetch('/MasterData/GetNextId');
                            if (res.ok) {
                                var data = await res.json();
                                if (data && data.nextId) {
                                    idInput.value = data.nextId;
                                }
                            }
                        } catch (e) {
                            console.error('Error fetching next UPF ID:', e);
                        }
                    }
                });
            }
        });
    </script>
}

