@using Microsoft.EntityFrameworkCore
@model UPMS.Web.Services.PagedResult<UPMS.Web.Models.Entities.MasterData>

@inject UPMS.Web.Data.UpmsDbContext DbContext
@{
    ViewData["Title"] = "Spareparts Catalog";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var lines = ViewBag.Lines as List<string> ?? new List<string>();
    var upAreas = ViewBag.UpAreas as List<string> ?? new List<string>();
    var kpis = ViewBag.Kpis as UPMS.Web.Services.MasterDataKpiSummary ?? new UPMS.Web.Services.MasterDataKpiSummary();
    int pageNum = Model?.PageNumber ?? 1;
    int pageSize = Model?.PageSize ?? 50;
    int startRowNo = (pageNum - 1) * pageSize + 1;

    var curUser = User.Identity?.Name;
    var userEntity = !string.IsNullOrEmpty(curUser) 
        ? DbContext.Users.AsNoTracking().FirstOrDefault(u => u.Username.ToLower() == curUser.ToLower()) 
        : null;

    bool isUserAdmin = (userEntity?.Role?.ToLower() == "admin") || string.Equals(curUser, "admin", StringComparison.OrdinalIgnoreCase);
    bool isTechnician = (userEntity?.Role?.ToLower() == "technician") || string.Equals(curUser, "technician", StringComparison.OrdinalIgnoreCase);

    bool hideActionsAndAlerts = isTechnician || !isUserAdmin;
}

<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

<style>
    /* Barcode Label Card Design - Exact specification matching user screenshot sample */
    .barcode-label-card {
        width: 270px;
        height: 115px;
        border: 1.5px solid #000000;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif !important;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        margin: 6px;
        page-break-inside: avoid;
        break-inside: avoid;
    }

    .barcode-label-header {
        background-color: #B8D9F7;
        border-bottom: 1.5px solid #000000;
        text-align: center;
        font-weight: 700;
        font-size: 13px;
        color: #000000;
        padding: 2px 4px;
        letter-spacing: 0.5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .barcode-label-body {
        display: flex;
        flex: 1;
        height: calc(100% - 25px);
    }

    .barcode-label-left {
        width: 58%;
        border-right: 1.5px solid #000000;
        display: flex;
        flex-direction: column;
    }

    .barcode-label-item {
        height: 50%;
        border-bottom: 1.5px solid #000000;
        font-weight: 700;
        font-size: 11px;
        color: #000000;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2px 4px;
        line-height: 1.1;
        overflow: hidden;
        word-break: break-word;
    }

    .barcode-label-detail {
        height: 50%;
        font-size: 10px;
        color: #000000;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2px 4px;
        line-height: 1.1;
        overflow: hidden;
        word-break: break-word;
    }

    .barcode-label-right {
        width: 42%;
        display: flex;
        flex-direction: column;
    }

    .barcode-label-graphic {
        height: 65%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2px;
        overflow: hidden;
    }

    .barcode-label-graphic svg {
        max-width: 100%;
        max-height: 100%;
        height: 38px;
    }

    .barcode-label-partno {
        height: 35%;
        border-top: 1.5px solid #000000;
        font-weight: 700;
        font-size: 11px;
        color: #000000;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1px 2px;
        white-space: nowrap;
    }

    @@media print {
        body {
            visibility: hidden !important;
        }
    }

    /* Smooth EMS table transitions and consistent Arial styling */
    .table-ems tbody tr {
        transition: background-color 0.12s ease-in-out;
    }
    .table-ems tbody tr:hover {
        background-color: #EFF6FF !important;
    }
    .ems-kpi-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .ems-kpi-card::before {
        display: none !important;
    }
    .ems-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 76, 129, 0.08);
    }
    .part-id-link {
        color: #0F4C81;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
    }
    .part-id-link:hover {
        text-decoration: underline;
        color: #0353E9;
    }
    .part-img-thumb {
        width: 46px;
        height: 46px;
        object-fit: cover;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .part-img-thumb:hover {
        transform: scale(2.2);
        box-shadow: 0 8px 16px rgba(0,0,0,0.25);
        position: relative;
        z-index: 99;
    }
    .detail-img-large {
        max-height: 220px;
        height: 200px;
        max-width: 100%;
        object-fit: contain;
        cursor: zoom-in;
        transition: transform 0.15s ease;
    }
    .detail-img-large:hover {
        transform: scale(1.04);
    }
</style>

<!-- Title Header -->
<div class="ems-page-header mb-3">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0F4C81;">Spareparts Catalog</h3>
        <p class="text-muted small mb-0">Manage and track all sparepart inventory catalog items across UP1 and UP2.</p>
    </div>
    @if (!hideActionsAndAlerts)
    {
        <div class="ems-page-actions">
            <button type="button" class="btn btn-ems-outline btn-sm me-1" onclick="openBatchBarcodeModal()" title="Print Barcode Labels for checked items">
                <i class="bi bi-qr-code-scan me-1 text-primary"></i>Print Barcodes (<span id="batchCountBadge">0</span>)
            </button>
            <a href="#" onclick="return executeSecureExport('/MasterData/ExportExcel?search=@ViewBag.Search&upArea=@ViewBag.UpArea&category=@ViewBag.Category&frequency=@ViewBag.Frequency&line=@ViewBag.Line&stockStatus=@ViewBag.StockStatus', 'Spareparts Catalog');" class="btn btn-ems-outline btn-sm">
                <i class="bi bi-file-earmark-excel me-1 text-success"></i>Export Excel
            </a>
            <button type="button" class="btn btn-ems-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">
                <i class="bi bi-plus-lg me-1"></i>Add Sparepart
            </button>
        </div>
    }
</div>

@{
    var currentStatus = ViewBag.StockStatus as string ?? "";
}

<!-- Header KPI Cards (EMS Theme Responsive 2x2 Mobile Grid - Consistent Heights) -->
<div class="row g-2 g-md-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="ems-kpi-card ems-kpi-danger h-100 d-flex flex-column justify-content-between @(currentStatus == "below" ? "border border-2 border-danger shadow-sm bg-white" : "")" onclick="filterByStockStatus('below')" style="cursor:pointer; transition: all 0.2s ease; min-height:86px;" title="Klik untuk menampilkan sparepart Below Safety Stock">
            <div class="ems-kpi-title text-danger text-nowrap d-flex justify-content-between align-items-center">
                <span class="text-truncate"><i class="bi bi-exclamation-triangle me-1"></i> BELOW SAFETY</span>
            </div>
            <div class="ems-kpi-value text-danger mt-1">
                @kpis.BelowSafetyStock.ToString("N0")
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ems-kpi-card ems-kpi-warning h-100 d-flex flex-column justify-content-between @(currentStatus == "near" ? "border border-2 border-warning shadow-sm bg-white" : "")" onclick="filterByStockStatus('near')" style="cursor:pointer; transition: all 0.2s ease; min-height:86px;" title="Klik untuk menampilkan sparepart Near Safety Stock">
            <div class="ems-kpi-title text-warning text-nowrap d-flex justify-content-between align-items-center">
                <span class="text-truncate"><i class="bi bi-exclamation-circle me-1"></i> NEAR SAFETY</span>
            </div>
            <div class="ems-kpi-value text-warning mt-1">
                @kpis.NearSafetyStock.ToString("N0")
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ems-kpi-card ems-kpi-success h-100 d-flex flex-column justify-content-between @(currentStatus == "normal" ? "border border-2 border-success shadow-sm bg-white" : "")" onclick="filterByStockStatus('normal')" style="cursor:pointer; transition: all 0.2s ease; min-height:86px;" title="Klik untuk menampilkan sparepart Normal Stock">
            <div class="ems-kpi-title text-success text-nowrap d-flex justify-content-between align-items-center">
                <span class="text-truncate"><i class="bi bi-check-circle me-1"></i> NORMAL STOCK</span>
            </div>
            <div class="ems-kpi-value text-success mt-1">
                @kpis.NormalStock.ToString("N0")
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ems-kpi-card ems-kpi-blue h-100 d-flex flex-column justify-content-between @(string.IsNullOrEmpty(currentStatus) ? "border border-2 border-primary shadow-sm bg-white" : "")" onclick="filterByStockStatus('')" style="cursor:pointer; transition: all 0.2s ease; min-height:86px;" title="Klik untuk menampilkan Semua Sparepart">
            <div class="ems-kpi-title text-primary text-nowrap d-flex justify-content-between align-items-center">
                <span class="text-truncate"><i class="bi bi-boxes me-1"></i> TOTAL ITEMS</span>
            </div>
            <div class="ems-kpi-value text-primary mt-1">
                @kpis.TotalSpareparts.ToString("N0")
            </div>
        </div>
    </div>
</div>

<!-- Filter Panel -->
<div class="ems-filter-card mb-4">
    <div class="ems-filter-header">
        <span><i class="bi bi-funnel me-1 text-primary"></i>Filter &amp; Search Spareparts</span>
        <span class="text-muted small">@Model?.TotalCount.ToString("N0") items</span>
    </div>
    <div class="p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end" id="filterForm">
            <input type="hidden" name="stockStatus" id="stockStatusInput" value="@ViewBag.StockStatus" />
            <div class="col-12 col-md-4 col-xl-3">
                <label class="form-label small fw-bold text-secondary mb-1">Search Query</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Part #, Item, BIN, Machine..." />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-secondary mb-1">UP Area</label>
                <select name="upArea" class="form-select form-select-sm">
                    <option value="">[All Areas]</option>
                    @foreach (var area in upAreas)
                    {
                        <option value="@area" selected="@(ViewBag.UpArea == area ? "selected" : null)">@area</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-secondary mb-1">Category</label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">[All Categories]</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(ViewBag.Category == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-secondary mb-1">Frequency</label>
                <select name="frequency" class="form-select form-select-sm">
                    <option value="">[All Frequency]</option>
                    <option value="FAST" selected="@(ViewBag.Frequency == "FAST" ? "selected" : null)">FAST</option>
                    <option value="SLOW" selected="@(ViewBag.Frequency == "SLOW" ? "selected" : null)">SLOW</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-secondary mb-1">Production Line</label>
                <select name="line" class="form-select form-select-sm">
                    <option value="">[All Lines]</option>
                    @foreach (var l in lines)
                    {
                        <option value="@l" selected="@(ViewBag.Line == l ? "selected" : null)">@l</option>
                    }
                </select>
            </div>
            <div class="col-xl-1 col-lg-1 col-md-12 d-flex gap-1" style="min-width: 140px;">
                <button type="submit" class="btn btn-ems-primary btn-sm text-nowrap px-3"><i class="bi bi-funnel"></i> Apply</button>
                <a href="/MasterData" class="btn btn-ems-outline btn-sm text-nowrap" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Master Data Table -->
<div class="ems-filter-card p-0 mb-4" id="spareparts-table-card" style="transition: opacity 0.15s ease-in-out;">
    <div class="table-responsive">
        <table class="table-ems mb-0">
            <thead>
                <tr>
                    <th class="text-center text-nowrap" style="width: 30px;"><input type="checkbox" id="selectAllPartsChk" class="form-check-input" onclick="toggleSelectAllParts(this)" title="Select all for barcode print" /></th>
                    <th class="text-nowrap text-center" style="width: 35px;">NO</th>
                    <th class="text-center text-nowrap" style="width: 40px;">IMG</th>
                    <th class="text-nowrap">UP AREA</th>
                    <th class="text-nowrap">BIN</th>
                    <th class="text-nowrap">PART NUMBER</th>
                    <th class="text-nowrap">LINE</th>
                    <th class="text-nowrap">CATEGORY</th>
                    <th class="text-nowrap">FREQ</th>
                    <th class="text-nowrap">MACHINE</th>
                    <th>ITEM</th>
                    <th>DETAIL</th>
                    <th class="text-nowrap">BRAND</th>
                    <th class="text-end text-nowrap">NEED/YR</th>
                    <th class="text-end text-nowrap" title="Time Between Maintenance (Months)">TBM/MO</th>
                    <th class="text-end text-nowrap" title="Lead Time (Months)">LT/MO</th>
                    <th class="text-end text-nowrap">SAFE</th>
                    <th class="text-end text-nowrap">STOCK</th>
                    <th class="text-end text-nowrap">PRICE</th>
                    <th class="text-nowrap">BUDGET CODE</th>
                    @if (!hideActionsAndAlerts)
                    {
                        <th class="text-center text-nowrap" title="Alert Notification">ALERT</th>
                        <th class="text-center text-nowrap">ACTION</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Items.Any())
                {
                    int rowNo = startRowNo;
                    foreach (var item in Model.Items)
                    {
                        int curr = item.CurrentStock ?? 0;
                        int safe = item.SafetyStock ?? 0;

                        string stkTextClass = "text-dark";
                        if (safe > 0 && curr < safe) { stkTextClass = "text-danger"; }
                        else if (safe > 0 && curr == safe) { stkTextClass = "text-warning"; }
                        else { stkTextClass = "text-dark"; }

                        <tr>
                            <td class="text-center align-middle">
                                <input type="checkbox" class="form-check-input part-select-chk" 
                                       data-id="@item.Id" 
                                       data-bin="@(item.Bin ?? "-")" 
                                       data-item="@(item.Item.Replace("\"", "&quot;"))" 
                                       data-detail="@((item.Detail ?? "-").Replace("\"", "&quot;"))" 
                                       onchange="updateBatchBarcodeCount()" />
                            </td>
                            <td class="col-mono text-muted text-center text-nowrap">@rowNo</td>
                            <td class="text-center align-middle text-nowrap">
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@item.Image" alt="Img" class="part-img-thumb" onclick="openImagePreviewModal('@item.Image')" title="Click for Full Screen Preview" />
                                }
                                else
                                {
                                    <i class="bi bi-image text-muted" style="opacity:0.3; font-size:14px;"></i>
                                }
                            </td>
                            <td class="text-nowrap"><span class="badge bg-light text-dark border">@(item.UpArea ?? "-")</span></td>
                            <td class="text-nowrap"><span class="badge bg-light text-dark border">@(item.Bin ?? "-")</span></td>
                            <td class="text-nowrap">
                                <a href="javascript:void(0)" class="part-id-link" onclick="openDetailModal('@item.Id')">@item.Id</a>
                            </td>
                            <td class="text-nowrap"><span class="badge bg-light text-primary border">@(item.Line ?? "-")</span></td>
                            <td class="text-nowrap"><span class="small text-secondary">@(item.Category ?? "-")</span></td>
                            <td class="text-nowrap">
                                <span class="badge @(item.Frequency == "FAST" ? "badge-ems-success" : "badge-ems-warning")">@(item.Frequency ?? "SLOW")</span>
                            </td>
                            <td class="text-nowrap"><span class="small text-muted">@(item.Machine ?? "-")</span></td>
                            <td class="fw-normal text-dark" style="min-width: 180px;">@item.Item</td>
                            <td style="min-width: 140px;"><span class="small text-muted text-truncate d-inline-block" style="max-width: 160px;" title="@item.Detail">@(item.Detail ?? "-")</span></td>
                            <td class="text-nowrap"><span class="small text-secondary">@(item.Brand ?? "-")</span></td>
                            <td class="text-end text-muted text-nowrap">@(item.QtyNeedYear.HasValue ? item.QtyNeedYear.Value.ToString("0.##") : "-")</td>
                            <td class="text-end text-muted text-nowrap">@(item.TbmPerMonth.HasValue ? item.TbmPerMonth.Value.ToString("0.##") : "-")</td>
                            <td class="text-end text-muted text-nowrap">@(item.LtPerMonth.HasValue ? item.LtPerMonth.Value.ToString("0.##") : "-")</td>
                            <td class="text-end text-muted text-nowrap">@safe</td>
                            <td class="text-end text-nowrap">
                                <span class="fs-6 @stkTextClass">@curr</span>
                            </td>
                            <td class="text-end fw-normal text-nowrap">
                                @if (item.CurrentUnitPrice.HasValue && item.CurrentUnitPrice.Value > 0)
                                {
                                    <span>Rp @(item.CurrentUnitPrice.Value.ToString("N0"))</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-nowrap"><span class="small fw-normal text-success">@(item.BudgetCode ?? "-")</span></td>
                            @if (!hideActionsAndAlerts)
                            {
                                <td class="text-center align-middle text-nowrap">
                                    <button type="button" class="btn btn-link p-0 text-decoration-none" onclick="toggleAlertSelected('@item.Id', this)" title="@(item.AlertSelected ? "Auto Email Alert Active (Click to disable)" : "Auto Email Alert Disabled (Click to enable)")">
                                        @if (item.AlertSelected)
                                        {
                                            <i class="bi bi-bell-fill text-warning fs-6"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-bell text-muted opacity-25 fs-6"></i>
                                        }
                                    </button>
                                </td>
                                <td class="text-center align-middle text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <!-- Barcode Label Icon -->
                                        <button type="button" class="btn-ems-icon-action text-dark" 
                                                onclick="openSingleBarcodeModal('@item.Id', '@(item.Bin?.Replace("'", "\\'") ?? "-")', '@item.Item.Replace("'", "\\'")', '@(item.Detail?.Replace("'", "\\'") ?? "-")')" 
                                                title="Generate Barcode Label (Part Number, BIN, Item &amp; Detail)">
                                            <i class="bi bi-qr-code-scan"></i>
                                        </button>

                                        <!-- View Detail Icon -->
                                        <button type="button" class="btn-ems-icon-action text-info" onclick="openDetailModal('@item.Id')" title="View Detail">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        <!-- Edit Icon -->
                                        <button type="button" class="btn-ems-icon-action text-primary" onclick="openEditModal('@item.Id')" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <!-- Delete Icon -->
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return executeSecureDelete(this, 'sparepart @item.Item');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="search" value="@ViewBag.Search" />
                                            <input type="hidden" name="upAreaFilter" value="@ViewBag.UpArea" />
                                            <input type="hidden" name="categoryFilter" value="@ViewBag.Category" />
                                            <input type="hidden" name="frequencyFilter" value="@ViewBag.Frequency" />
                                            <input type="hidden" name="lineFilter" value="@ViewBag.Line" />
                                            <input type="hidden" name="page" value="@(Model?.PageNumber ?? 1)" />
                                            <button type="submit" class="btn-ems-icon-action text-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                        rowNo++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(hideActionsAndAlerts ? 20 : 22)" class="text-center text-muted py-5">
                            <i class="bi bi-boxes d-block fs-3 mb-2 opacity-25"></i>
                            No master data items match your search criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="p-3 border-top d-flex align-items-center justify-content-between bg-light">
        <span class="small text-muted">Showing page @(Model?.PageNumber ?? 1) of @(Model?.TotalPages ?? 1) (@(Model?.TotalCount ?? 0) items total)</span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model == null || Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@((Model?.PageNumber ?? 1) - 1)" asp-route-search="@ViewBag.Search" asp-route-upArea="@ViewBag.UpArea" asp-route-category="@ViewBag.Category" asp-route-frequency="@ViewBag.Frequency" asp-route-line="@ViewBag.Line">Previous</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@(Model?.PageNumber ?? 1)</span></li>
                <li class="page-item @(Model == null || Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@((Model?.PageNumber ?? 1) + 1)" asp-route-search="@ViewBag.Search" asp-route-upArea="@ViewBag.UpArea" asp-route-category="@ViewBag.Category" asp-route-frequency="@ViewBag.Frequency" asp-route-line="@ViewBag.Line">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- ========================================================================= -->
<!-- DYNAMIC REUSABLE MODALS -->
<!-- ========================================================================= -->

<!-- 1. Add Sparepart Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius:0; border: 1px solid var(--color-border);">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="search" value="@ViewBag.Search" />
                <input type="hidden" name="upAreaFilter" value="@ViewBag.UpArea" />
                <input type="hidden" name="categoryFilter" value="@ViewBag.Category" />
                <input type="hidden" name="frequencyFilter" value="@ViewBag.Frequency" />
                <input type="hidden" name="lineFilter" value="@ViewBag.Line" />
                <input type="hidden" name="page" value="@(Model?.PageNumber ?? 1)" />
                <div class="modal-header py-2 px-3" style="background:#0F4C81; color:#fff; border-radius:0;">
                    <h6 class="modal-title fw-normal mb-0" style="font-size:13px;"><i class="bi bi-plus-circle me-2"></i>Add New Sparepart</h6>
                    <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
