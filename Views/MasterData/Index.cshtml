            color: #000000;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1px 3px;
            line-height: 1.1;
            overflow: hidden;
            word-break: break-word;
        }
        .barcode-label-right {
            width: 42%;
            display: flex;
            flex-direction: column;
        }
        .barcode-label-graphic {
            height: 65%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1px;
            overflow: hidden;
        }
        .barcode-label-graphic svg {
            max-width: 100%;
            max-height: 100%;
            height: 30px;
        }
        .barcode-label-partno {
            height: 35%;
            border-top: 1.5px solid #000000;
            font-weight: bold;
            font-size: 8.5pt;
            color: #000000;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1px;
            white-space: nowrap;
        }
    </style>
