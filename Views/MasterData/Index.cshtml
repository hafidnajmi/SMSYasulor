@section Scripts {
    <script>
        // High-performance AJAX dynamic detail modal loader
        async function openDetailModal(id) {
            const modalElem = document.getElementById('dynamicDetailModal');
            const bsModal = new bootstrap.Modal(modalElem);
            
            document.getElementById('detailModalIdHeader').innerText = id;
            document.getElementById('detailModalSpinner').style.display = 'block';
            document.getElementById('detailModalContent').style.display = 'none';
            
            bsModal.show();

            try {
                const response = await fetch(`/MasterData/DetailsJson?id=${encodeURIComponent(id)}`);
                if (!response.ok) throw new Error('Item not found');
                const item = await response.json();

                document.getElementById('detailItemName').innerText = item.item || '-';
                document.getElementById('detailBin').innerText = item.bin || '-';
                document.getElementById('detailLine').innerText = item.line || '-';
                document.getElementById('detailLineField').innerText = item.line || '-';
                document.getElementById('detailMachine').innerText = item.machine || '-';
                document.getElementById('detailBrand').innerText = item.brand || '-';
                document.getElementById('detailId').innerText = item.id;
                document.getElementById('detailCategory').innerText = item.category || '-';
                document.getElementById('detailUpArea').innerText = item.upArea || '-';
                document.getElementById('detailCurrentStock').innerText = (item.currentStock || 0) + ' pcs';
                document.getElementById('detailSafetyStock').innerText = (item.safetyStock || 0) + ' pcs';
