                document.getElementById('editCurrentStock').value = item.currentStock || 0;
                document.getElementById('editSafetyStock').value = item.safetyStock || 0;
                document.getElementById('editQtyNeedYear').value = item.qtyNeedYear || '';
                document.getElementById('editTbmPerMonth').value = item.tbmPerMonth || '';
                document.getElementById('editLtPerMonth').value = item.ltPerMonth || '';
                document.getElementById('editFrequency').value = item.frequency || 'SLOW';
