<script>
    function escapeHtml(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function toggleSelectAllParts(masterChk) {
        var chks = document.querySelectorAll('.part-select-chk');
        chks.forEach(function(c) {
            c.checked = masterChk.checked;
        });
        updateBatchBarcodeCount();
    }

    function updateBatchBarcodeCount() {
        var chks = document.querySelectorAll('.part-select-chk:checked');
        var badge = document.getElementById('batchCountBadge');
        if (badge) {
            badge.textContent = chks.length;
        }
    }

    function createSingleLabelCard(id, bin, item, detail, index) {
        var safeId = id.replace(/[^a-zA-Z0-9_-]/g, '_');
        var svgId = 'svg_bc_' + safeId + '_' + index + '_' + Math.floor(Math.random() * 10000);
        
        var cardHtml = `
        <div class="barcode-label-card">
            <div class="barcode-label-header">${escapeHtml(bin || '-')}</div>
            <div class="barcode-label-body">
                <div class="barcode-label-left">
                    <div class="barcode-label-item">${escapeHtml(item || '-')}</div>
                    <div class="barcode-label-detail">${escapeHtml(detail || '-')}</div>
                </div>
                <div class="barcode-label-right">
                    <div class="barcode-label-graphic">
                        <svg id="${svgId}"></svg>
                    </div>
                    <div class="barcode-label-partno">${escapeHtml(id || '-')}</div>
                </div>
            </div>
        </div>`;

        return { html: cardHtml, svgId: svgId, code: id };
    }

    function renderLabelBarcodes(items) {
        var container = document.getElementById('barcodePrintContainer');
        if (!container) return;
        container.innerHTML = '';
        var counter = document.getElementById('modalTotalLabelsCount');
        if (counter) counter.textContent = items.length;

        var tasks = [];
        items.forEach(function(it, idx) {
            var res = createSingleLabelCard(it.id, it.bin, it.item, it.detail, idx);
            container.insertAdjacentHTML('beforeend', res.html);
            tasks.push(res);
        });

        setTimeout(function() {
            tasks.forEach(function(t) {
                try {
                    if (typeof JsBarcode === 'function') {
                        JsBarcode('#' + t.svgId, t.code, {
                            format: 'CODE128',
                            width: 1.4,
                            height: 35,
                            displayValue: false,
                            margin: 0
                        });
                    }
                } catch (e) {
                    console.error('JsBarcode error for ' + t.code, e);
                }
            });
        }, 120);
    }

    function openSingleBarcodeModal(id, bin, item, detail) {
        var items = [{ id: id, bin: bin, item: item, detail: detail }];
        renderLabelBarcodes(items);
        var modalElem = document.getElementById('barcodeLabelModal');
        if (modalElem) {
            var modal = new bootstrap.Modal(modalElem);
            modal.show();
        }
    }

    function openBatchBarcodeModal() {
        var chks = document.querySelectorAll('.part-select-chk:checked');
        if (!chks || chks.length === 0) {
            if (typeof showEmsToast === 'function') {
                showEmsToast('warning', 'Pilih minimal 1 sparepart (centang tabel) untuk mencetak barcode.');
            } else {
                alert('Pilih minimal 1 sparepart (centang tabel) untuk mencetak barcode.');
            }
            return;
        }

        var items = [];
        chks.forEach(function(c) {
            items.push({
                id: c.getAttribute('data-id'),
                bin: c.getAttribute('data-bin'),
                item: c.getAttribute('data-item'),
                detail: c.getAttribute('data-detail')
            });
        });

        renderLabelBarcodes(items);
        var modalElem = document.getElementById('barcodeLabelModal');
        if (modalElem) {
            var modal = new bootstrap.Modal(modalElem);
            modal.show();
        }
    }

    function triggerBarcodePrint() {
        var container = document.getElementById('barcodePrintContainer');
        if (!container || !container.innerHTML.trim()) return;

        var iframe = document.getElementById('barcodePrintFrame');
        if (iframe) {
            iframe.remove();
        }

        iframe = document.createElement('iframe');
        iframe.id = 'barcodePrintFrame';
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        iframe.style.opacity = '0';
        document.body.appendChild(iframe);

        var doc = iframe.contentWindow.document;
        doc.open();
        doc.write(`<!DOCTYPE html>
<html>
<head>
