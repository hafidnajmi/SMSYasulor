@{
    ViewData["Title"] = "Dashboard";
    var kpi = ViewBag.Kpi as UPMS.Web.Services.KpiSummary;
    var costInsights = ViewBag.CostInsights as UPMS.Web.Services.CostInsights;
    var topLowStock = ViewBag.TopLowStock as List<UPMS.Web.Models.Entities.MasterData>;
    var recentLogs = ViewBag.RecentLogs as List<UPMS.Web.Models.Entities.AuditLog>;
    var stockDist = ViewBag.StockDist as Dictionary<string, int>;

    int selYear = ViewBag.SelectedYear as int? ?? 0;
    int selMonth = ViewBag.SelectedMonth as int? ?? 0;

    int totalCount = kpi?.TotalSpareparts ?? 0;
    int normalCount = stockDist != null && stockDist.ContainsKey("Normal Stock") ? stockDist["Normal Stock"] : 0;
    int nearCount = stockDist != null && stockDist.ContainsKey("Near Safety Stock") ? stockDist["Near Safety Stock"] : 0;
    int belowCount = kpi?.LowStockCount ?? 0;

    double normalPct = totalCount > 0 ? ((double)normalCount / totalCount) * 100.0 : 0.0;
    double nearPct = totalCount > 0 ? ((double)nearCount / totalCount) * 100.0 : 0.0;
    double belowPct = totalCount > 0 ? ((double)belowCount / totalCount) * 100.0 : 0.0;
}

<!-- Top Header Row -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h3 class="page-title">Welcome back, @(User.Identity?.Name ?? "Admin")</h3>
        <p class="page-subtitle">Here’s what’s happening with your sparepart inventory today.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="text-muted small me-2"><i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy | hh:mm tt")</span>
        
        <!-- Filter Form -->
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-1">
            <select name="month" class="form-select form-select-sm" style="width: 110px;" onchange="this.form.submit()">
                <option value="0" selected="@(selMonth == 0 ? "selected" : null)">All Months</option>
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(selMonth == m ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m)</option>
                }
            </select>
            <select name="year" class="form-select form-select-sm" style="width: 90px;" onchange="this.form.submit()">
                <option value="0" selected="@(selYear == 0 ? "selected" : null)">All Years</option>
                @for (int y = DateTime.Now.Year; y >= 2020; y--)
                {
                    <option value="@y" selected="@(selYear == y ? "selected" : null)">@y</option>
                }
            </select>
        </form>

        <a href="/Dashboard" class="btn btn-ems-outline btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</a>
        <button onclick="window.print()" class="btn btn-ems-primary btn-sm"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

<!-- Top 4 KPI Summary Cards (Python Parity) -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a href="/History?tab=keluar" class="text-decoration-none">
            <div class="ems-kpi-card ems-kpi-blue">
                <div class="ems-kpi-title"><i class="bi bi-currency-dollar text-primary"></i>SPAREPART OUTGOING COST</div>
                <div class="ems-kpi-value text-primary">Rp @((kpi?.OutgoingCostMonth ?? 0m).ToString("N0"))</div>
                <div class="ems-kpi-sub"><i class="bi bi-clock me-1"></i>Total realtime outgoing cost</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/MasterData" class="text-decoration-none">
            <div class="ems-kpi-card ems-kpi-green">
                <div class="ems-kpi-title"><i class="bi bi-boxes text-success"></i>TOTAL INVENTORY VALUE</div>
                <div class="ems-kpi-value text-dark">Rp @((kpi?.TotalInventoryValue ?? 0m).ToString("N0"))</div>
                <div class="ems-kpi-sub"><i class="bi bi-shield-check me-1 text-success"></i>Capital locked in parts</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/MasterData?frequency=FAST" class="text-decoration-none">
            <div class="ems-kpi-card ems-kpi-amber">
                <div class="ems-kpi-title">
                    <i class="bi bi-exclamation-triangle text-warning"></i>CRITICAL STOCK (BELOW SAFETY)
                    @if (belowCount > 0) { <span class="badge bg-danger rounded-pill ms-1">!</span> }
                </div>
                <div class="ems-kpi-value text-danger">@belowCount Items</div>
                <div class="ems-kpi-sub"><i class="bi bi-arrow-repeat me-1 text-danger"></i>Replenishment required</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/AdminManagement?tab=approvals" class="text-decoration-none">
            <div class="ems-kpi-card ems-kpi-cyan">
                <div class="ems-kpi-title">
                    <i class="bi bi-hourglass-split text-info"></i>PENDING APPROVALS
                    @if ((kpi?.PendingApprovals ?? 0) > 0) { <span class="badge bg-danger rounded-pill ms-1">!</span> }
                </div>
                <div class="ems-kpi-value text-dark">@(kpi?.PendingApprovals ?? 0) Transactions</div>
                <div class="ems-kpi-sub"><i class="bi bi-list-check me-1 text-info"></i>Barang Keluar queue</div>
            </div>
        </a>
    </div>
</div>

<!-- Middle Panels Row (Stock Overview Donut + Stock Status Bars + Recent Activity) -->
<div class="row g-3 mb-4">
    <!-- Stock Overview Donut Chart -->
    <div class="col-md-3">
        <div class="ems-filter-card h-100 mb-0">
            <div class="ems-filter-header">
                <span><i class="bi bi-pie-chart me-2 text-primary"></i>Stock Overview</span>
            </div>
            <div class="p-3 d-flex flex-column align-items-center justify-content-center" style="min-height: 200px;">
                <div style="position: relative; width: 140px; height: 140px;">
                    <canvas id="stockStatusChart"></canvas>
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                        <div class="fw-bold fs-5">@totalCount</div>
                        <div class="small text-muted" style="font-size: 10px;">Total Items</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Status Progress Bars -->
    <div class="col-md-3">
        <div class="ems-filter-card h-100 mb-0">
            <div class="ems-filter-header">
                <span><i class="bi bi-bar-chart-steps me-2 text-primary"></i>Stock Status</span>
            </div>
            <div class="p-3 d-flex flex-column justify-content-center gap-3" style="min-height: 200px;">
                <div>
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span><i class="bi bi-check-circle text-success me-1"></i>Normal Stock</span>
                        <span>@normalCount (@normalPct.ToString("F1")%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: @normalPct.ToString("F1")%;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span><i class="bi bi-exclamation-triangle text-warning me-1"></i>Near Safety Stock</span>
                        <span>@nearCount (@nearPct.ToString("F1")%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: @nearPct.ToString("F1")%;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span><i class="bi bi-x-circle text-danger me-1"></i>Below Safety Stock</span>
                        <span>@belowCount (@belowPct.ToString("F1")%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-danger" style="width: @belowPct.ToString("F1")%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Sparepart Activity Table -->
    <div class="col-md-6">
        <div class="ems-filter-card h-100 mb-0">
            <div class="ems-filter-header">
                <span><i class="bi bi-activity me-2 text-primary"></i>Recent Sparepart Activity</span>
                <a href="/History" class="btn btn-sm btn-link text-decoration-none p-0">View all <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table class="table-ems">
                        <thead>
                            <tr>
                                <th>ACTIVITY</th>
                                <th>SPAREPART</th>
                                <th>BY</th>
                                <th>TIME</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentLogs != null && recentLogs.Any())
                            {
                                foreach (var log in recentLogs)
                                {
                                    string icon = log.Action == "INSERT" ? "bi-arrow-down-circle text-success" : log.Action == "DELETE" ? "bi-trash text-danger" : "bi-pencil-square text-warning";
                                    <tr>
                                        <td>
                                            <i class="bi @icon me-2"></i>
                                            <span class="fw-semibold">@log.Action</span>
                                        </td>
                                        <td class="fw-bold text-dark text-truncate" style="max-width: 200px;">@log.TableName (#@log.RecordId)</td>
                                        <td class="small text-muted">@(log.ChangedBy ?? "system")</td>
                                        <td class="col-mono text-muted">@log.ChangedAt.ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No recent SQL Server activity recorded.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lower Panel 1: Operational Insights & Procurement Trends -->
<div class="ems-filter-card mb-4">
    <div class="ems-filter-header">
        <span><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Operational Insights & Procurement Trends</span>
    </div>
    <div class="p-3">
        <!-- 3 Mini KPI Cards -->
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="p-2 border bg-light d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-muted text-uppercase font-monospace" style="font-size: 10px;">HIGHEST COST LINE</div>
                        <div class="fw-bold text-primary">@(costInsights?.HighestCostLine ?? "-")</div>
                    </div>
                    <div class="col-mono text-primary font-monospace fw-bold">Rp @((costInsights?.HighestCostLineAmount ?? 0m).ToString("N0"))</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border bg-light d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-muted text-uppercase font-monospace" style="font-size: 10px;">HIGHEST COST ASSET</div>
                        <div class="fw-bold text-success">@(costInsights?.HighestCostMachine ?? "-")</div>
                    </div>
                    <div class="col-mono text-success font-monospace fw-bold">Rp @((costInsights?.HighestCostMachineAmount ?? 0m).ToString("N0"))</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border bg-light d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-muted text-uppercase font-monospace" style="font-size: 10px;">TOP COST SPAREPART</div>
                        <div class="fw-bold text-warning text-truncate" style="max-width: 160px;" title="@(costInsights?.TopCostSparepart ?? "-")">@(costInsights?.TopCostSparepart ?? "-")</div>
                    </div>
                    <div class="col-mono text-warning font-monospace fw-bold">Rp @((costInsights?.TopCostSparepartAmount ?? 0m).ToString("N0"))</div>
                </div>
            </div>
        </div>

        <div class="small fw-semibold text-secondary mb-2"><i class="bi bi-diagram-3 me-1"></i>Line Cost Distribution</div>
        <div style="min-height: 220px;">
            <canvas id="costPerLineChart"></canvas>
        </div>
        <div class="small text-muted fst-italic mt-2">Sumber: Barang Keluar</div>
    </div>
</div>

<!-- Lower Panel 2: Top 5 Low Stock Sparepart Table -->
<div class="ems-filter-card mb-0">
    <div class="ems-filter-header text-danger">
        <span><i class="bi bi-exclamation-octagon me-2"></i>Top 5 Low Stock Sparepart</span>
        <a href="/MasterData" class="btn btn-sm btn-link text-decoration-none p-0">View all low stock sparepart <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="p-0">
        <div class="table-responsive">
            <table class="table-ems">
                <thead>
                    <tr>
                        <th style="width: 50px;">NO</th>
                        <th>ITEM</th>
                        <th>MACHINE</th>
                        <th>BIN</th>
                        <th class="text-end">STOCK</th>
                        <th class="text-end">SAFE STOCK</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (topLowStock != null && topLowStock.Any())
                    {
                        int no = 1;
                        foreach (var item in topLowStock)
                        {
                            int curr = item.CurrentStock ?? 0;
                            int safe = item.SafetyStock ?? 0;
                            string statusText = curr < safe ? "Below" : "Near";
                            string badgeClass = curr < safe ? "badge-ems-danger" : "badge-ems-warning";

                            <tr>
                                <td class="col-mono">@no</td>
                                <td class="fw-semibold">@item.Item</td>
                                <td class="small text-muted">@(item.Machine ?? "-")</td>
                                <td><span class="badge bg-light text-dark font-monospace border">@(item.Bin ?? "-")</span></td>
                                <td class="text-end fw-bold text-danger">@curr</td>
                                <td class="text-end col-mono">@safe</td>
                                <td><span class="badge @badgeClass">@statusText</span></td>
                            </tr>
                            no++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No low stock data from SQL Server.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Stock Overview Donut Chart
            var stockDistData = @Html.Raw(Json.Serialize(ViewBag.StockDist));
            if (stockDistData) {
                var ctxDonut = document.getElementById('stockStatusChart').getContext('2d');
                new Chart(ctxDonut, {
                    type: 'doughnut',
                    data: {
                        labels: Object.keys(stockDistData),
                        datasets: [{
                            data: Object.values(stockDistData),
                            backgroundColor: ['#10B981', '#F59E0B', '#EF4444'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            // Cost per Production Line Line Chart (Continuous Connected Line with Peak Indicator)
            var costLineData = @Html.Raw(Json.Serialize(ViewBag.CostPerLine));
            if (costLineData && costLineData.length > 0) {
                var labels = costLineData.map(d => d.label || d.Label);
                var values = costLineData.map(d => Number(d.value || d.Value || 0));

                var maxVal = Math.max(...values);
                var maxIndex = values.indexOf(maxVal);

                var pointColors = values.map((v, i) => (i === maxIndex && maxVal > 0) ? '#DC3545' : '#0F4C81');
                var pointRadii = values.map((v, i) => (i === maxIndex && maxVal > 0) ? 6 : 4);
                var pointStyles = values.map((v, i) => (i === maxIndex && maxVal > 0) ? 'triangle' : 'circle');

                var ctxLine = document.getElementById('costPerLineChart').getContext('2d');
                new Chart(ctxLine, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Cost (Rp)',
                            data: values,
                            borderColor: '#0F4C81',
                            borderWidth: 2.5,
                            backgroundColor: 'rgba(15, 76, 129, 0.05)',
                            fill: true,
                            showLine: true,
                            spanGaps: true,
                            tension: 0.15,
                            pointBackgroundColor: pointColors,
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: pointRadii,
                            pointHoverRadius: 8,
                            pointStyle: pointStyles
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        var prefix = (ctx.dataIndex === maxIndex && maxVal > 0) ? '▲ HIGHEST COST: ' : 'Cost: ';
                                        return prefix + 'Rp ' + ctx.parsed.y.toLocaleString();
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 11 }, maxRotation: 45 }
                            },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    font: { size: 11 },
                                    callback: function (val) {
                                        return 'Rp ' + val.toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
