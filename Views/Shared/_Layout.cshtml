                            <span class="nav-icon-box"><i class="bi bi-box-arrow-in-down" style="color:#059669;"></i></span>
                            <span>Stock In</span>
                        </a>
                    }
                    @if (rbacBarangKeluar)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BarangKeluar" ? "active" : "")" asp-controller="BarangKeluar" asp-action="Index" title="Stock Out">
                            <span class="nav-icon-box"><i class="bi bi-box-arrow-up-right" style="color:#DC2626;"></i></span>
                            <span>Stock Out</span>
                        </a>
                    }
                    @if (rbacRiwayat)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "History" ? "active" : "")" asp-controller="History" asp-action="Index" title="Transaction Logs">
                            <span class="nav-icon-box"><i class="bi bi-clock-history" style="color:#0284C7;"></i></span>
                            <span>Transaction Logs</span>
                        </a>
                    }
                }

                @if (rbacManagePm)
                {
                    <div class="ems-nav-header">Maintenance</div>
                    <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Maintenance" asp-action="Index" title="Manage PM">
                        <span class="nav-icon-box"><i class="bi bi-calendar-check" style="color:#16A34A;"></i></span>
                        <span>Manage PM</span>
                    </a>
                    <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" && ViewContext.RouteData.Values["action"]?.ToString() == "PmPlan" ? "active" : "")" asp-controller="Maintenance" asp-action="PmPlan" title="Preventive Maintenance Plan">
                        <span class="nav-icon-box"><i class="bi bi-list-task" style="color:#0284C7;"></i></span>
                        <span>Preventive Maintenance Plan</span>
                    </a>
                }

                @if (rbacCostIntel || rbacLineMapping || rbacSupplierData)
                {
                    <div class="ems-nav-header">Analytics & Mapping</div>
                    @if (rbacCostIntel)
                    {
