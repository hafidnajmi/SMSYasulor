@using Microsoft.EntityFrameworkCore
@inject UPMS.Web.Data.UpmsDbContext DbContext
@{
    var curUser = User.Identity?.Name;
    var userEntity = !string.IsNullOrEmpty(curUser) 
        ? DbContext.Users.AsNoTracking().FirstOrDefault(u => u.Username.ToLower() == curUser.ToLower()) 
        : null;

    bool isUserAdmin = (userEntity?.Role?.ToLower() == "admin") || string.Equals(curUser, "admin", StringComparison.OrdinalIgnoreCase);

    bool rbacMasterData = isUserAdmin || (userEntity?.CanMasterData == 1);
    bool rbacBarangMasuk = isUserAdmin || (userEntity?.CanBarangMasuk == 1);
    bool rbacBarangKeluar = isUserAdmin || (userEntity?.CanBarangKeluar == 1);
    bool rbacRiwayat = isUserAdmin || (userEntity?.CanRiwayat == 1);
    bool rbacManagePm = isUserAdmin || (userEntity?.CanManagePm == 1);
    bool rbacCostIntel = isUserAdmin || (userEntity?.CanCostIntelligence == 1);
    bool rbacLineMapping = isUserAdmin || (userEntity?.CanLineMapping == 1);
    bool rbacSupplierData = isUserAdmin || (userEntity?.CanSupplierData == 1);
    bool rbacAdminMgmt = isUserAdmin || (userEntity?.CanAdminMgmt == 1) || (userEntity?.CanBidding == 1);
    bool rbacSettings = isUserAdmin || (userEntity?.CanSettings == 1);
    bool rbacEmailSettings = isUserAdmin || (userEntity?.CanEmailSettings == 1);
    bool rbacDeveloperUpdates = isUserAdmin;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sparepart Management System (SMS)</title>
    <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/hafidnajmi/SMSYasulor/main/wwwroot/lib/app_icon.png" />
    <!-- Immediate Sidebar Collapsed State Check to prevent layout flicker -->
    <script>
        (function() {
            if (localStorage.getItem('ems_sidebar_collapsed') === 'true') {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>
    <!-- CDN: local wwwroot serving unreliable on Dewacloud, use CDN as primary with local fallback -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if (typeof window.bootstrap === 'undefined') {
            document.write('<script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"><\/script>');
        }
    </script>
    <!-- Inline site.css: avoids dependency on /css/site.css which is 404 on Dewacloud -->
    <style>
:root {
    --color-primary:       #0F4C81;
    --color-primary-hover: #0353E9;
    --color-secondary:     #374151;
    --color-bg:            #F5F6F8;
    --color-card:          #FFFFFF;
    --color-border:        #D1D5DB;
    --color-text:          #111827;
    --color-text-muted:    #6B7280;
    --color-success:       #198754;
    --color-warning:       #F59E0B;
    --color-danger:        #DC3545;
    --font-sans:           Arial, Helvetica, sans-serif;
    --font-mono:           Arial, Helvetica, sans-serif;
    --bs-font-sans-serif:  Arial, Helvetica, sans-serif;
    --bs-font-monospace:   Arial, Helvetica, sans-serif;
    --bs-body-font-family: Arial, Helvetica, sans-serif;
    --sidebar-width:       240px;
    --sidebar-collapsed-width: 64px;
    --topbar-height:       56px;
}
*, *::before, *::after,
body, button, input, select, textarea,
h1, h2, h3, h4, h5, h6,
table, .table, .btn, .form-control, .form-select, .modal,
code, pre, kbd, samp, tt, var,
.font-monospace, .col-code, .col-mono, .col-amount {
    font-family: Arial, Helvetica, sans-serif !important;
}
.modal-header .modal-title,
.modal-header h1, .modal-header h2, .modal-header h3,
.modal-header h4, .modal-header h5, .modal-header h6 {
    font-family: Arial, Helvetica, sans-serif !important;
    font-weight: 400 !important;
    font-size: 13px !important;
}
body {
    font-family: var(--font-sans) !important;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text);
    background-color: var(--color-bg);
    margin: 0;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}
body:not(.modal-open) {
    overflow-y: auto !important;
}
.card, .bk-card, .bm-card, .ems-header, .ems-sidebar, .ems-filter-card, .ems-kpi-card, .bk-history-card, .bm-history-card,
.btn, .btn-sm, .btn-lg, .form-control, .form-select, .input-group-text, .input-group,
.badge, .alert, .modal, .modal-content, .modal-header, .modal-footer, .modal-body, .dropdown-menu,
.bk-icon-badge, .bm-icon-badge, #cameraScanModal, #cameraScanModal *, .btn-ganti-kamera, div[class*="rounded"] {
    border-radius: 0px !important;
}
.ems-icon-badge, .bk-icon-badge, .bm-icon-badge {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    border-radius: 0px !important;
}
.ems-header {
    height: var(--topbar-height);
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1030;
}
.ems-logo-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
}
.ems-logo-box {
    background: linear-gradient(135deg, #0F4C81 0%, #0284C7 100%);
    color: #FFFFFF;
    font-weight: 800;
    font-style: italic;
    font-size: 1.15rem;
    padding: 2px 8px;
    border-radius: 0px !important;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
}
.ems-logo-subtitle {
    font-size: 11px;
    color: var(--color-text-muted);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.ems-user-avatar {
    width: 30px; height: 30px;
    background-color: #111827;
    color: #FFFFFF;
    font-weight: 600; font-size: 12px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 0px !important;
}
.ems-sidebar {
    width: var(--sidebar-width);
    background-color: #FFFFFF;
    border-right: 1px solid var(--color-border);
    position: fixed;
    top: var(--topbar-height);
    bottom: 0; left: 0;
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 1020;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: width 0.2s cubic-bezier(0.2, 0, 0, 1);
}
.ems-sidebar::-webkit-scrollbar {
    width: 4px;
}
.ems-sidebar::-webkit-scrollbar-track {
    background: transparent;
}
.ems-sidebar::-webkit-scrollbar-thumb {
    background-color: #CBD5E1;
    border-radius: 2px;
}
.ems-sidebar::-webkit-scrollbar-thumb:hover {
    background-color: #94A3B8;
}

.ems-nav-header {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748B;
    padding: 1.1rem 1.25rem 0.35rem;
    font-weight: 700;
    white-space: nowrap;
    transition: opacity 0.15s ease;
}

.ems-nav-link {
    color: #334155;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    height: 40px;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    margin: 1px 0;
    border-left: 3px solid transparent;
    border-radius: 0 !important;
    transition: all 0.15s ease;
}

.ems-nav-link:hover {
    background-color: #F8FAFC;
    color: #0F4C81;
}

.ems-nav-link.active {
    background-color: #EFF6FF !important;
    border-left: 3px solid #0F4C81 !important;
    color: #0F4C81 !important;
    font-weight: 700 !important;
    box-shadow: none !important;
}

.ems-nav-link .nav-icon-box {
    width: 24px;
    height: 24px;
    background: transparent !important;
    border-radius: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.ems-nav-link.active .nav-icon-box {
    background: transparent !important;
    color: #0F4C81 !important;
}
.ems-nav-link.active .nav-icon-box i {
    color: #0F4C81 !important;
}

.ems-nav-link i {
    font-size: 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.ems-nav-link span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ems-sidebar-footer {
    padding: 0.25rem 0;
    border-top: 1px solid #E2E8F0;
}

.ems-sidebar-footer button {
    height: 44px;
    padding: 0 1.25rem;
    width: 100%;
    border-radius: 0 !important;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    color: #475569 !important;
    background-color: transparent !important;
    border: none !important;
    font-weight: 500 !important;
    font-size: 13.5px;
    text-decoration: none;
    transition: background-color 0.15s ease;
    box-shadow: none !important;
}

.ems-sidebar-footer button:hover {
    background-color: #F8FAFC !important;
    color: #0F172A !important;
}

.ems-wrapper {
    margin-left: var(--sidebar-width);
    padding-top: var(--topbar-height);
    min-height: 100vh;
    transition: margin-left 0.2s cubic-bezier(0.2, 0, 0, 1);
}

/* ==========================================
   Collapsed Sidebar Rules (Microsoft Azure Style)
   ========================================== */
.sidebar-collapsed .ems-sidebar {
    width: 60px !important;
}
.sidebar-collapsed .ems-wrapper {
    margin-left: 60px !important;
}

/* Group Headers: turn into a clean subtle 1px divider in collapsed mode */
.sidebar-collapsed .ems-nav-header {
    font-size: 0 !important;
    line-height: 0 !important;
    height: 1px !important;
    padding: 0 !important;
    margin: 8px 12px !important;
    background-color: #E5E7EB !important;
    border: none !important;
    overflow: hidden !important;
    opacity: 1 !important;
}
.sidebar-collapsed .ems-nav-header:first-child {
    display: none !important;
}

/* Nav Links in Collapsed Mode */
.sidebar-collapsed .ems-nav-link {
    width: 100% !important;
    height: 40px !important;
    padding: 0 0 0 15px !important;
    margin: 1px 0 !important;
    justify-content: flex-start !important;
    border-radius: 0 !important;
    border-left: 3px solid transparent !important;
    border-top: none !important;
    border-right: none !important;
    border-bottom: none !important;
    background-color: transparent !important;
    box-shadow: none !important;
}
.sidebar-collapsed .ems-nav-link:hover {
    background-color: #F3F4F6 !important;
    color: var(--color-primary) !important;
}
.sidebar-collapsed .ems-nav-link.active {
    background-color: #EFF6FF !important;
    color: var(--color-primary) !important;
    border-left-color: var(--color-primary) !important;
    box-shadow: none !important;
}
.sidebar-collapsed .ems-nav-link span:not(.nav-icon-box) {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    width: 0 !important;
}
.sidebar-collapsed .ems-nav-link .nav-icon-box {
    display: inline-flex !important;
    margin-right: 0 !important;
    width: 24px !important;
    height: 24px !important;
    align-items: center !important;
    justify-content: center !important;
}
.sidebar-collapsed .ems-sidebar-footer button span {
    display: none !important;
}
.sidebar-collapsed .ems-nav-link i {
    font-size: 1.15rem !important;
    width: 24px !important;
    height: 24px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
}

/* Sidebar Footer in Collapsed Mode */
.sidebar-collapsed .ems-sidebar-footer {
    padding: 0.5rem 0 !important;
}
.sidebar-collapsed .ems-sidebar-footer button {
    width: 100% !important;
    height: 40px !important;
    padding: 0 0 0 15px !important;
    justify-content: flex-start !important;
    border-radius: 0 !important;
    border: none !important;
    background-color: transparent !important;
    box-shadow: none !important;
}
.sidebar-collapsed .ems-sidebar-footer button:hover {
    background-color: #FEF2F2 !important;
    color: #DC2626 !important;
}
.sidebar-collapsed .ems-sidebar-footer span {
    display: none !important;
}

.ems-content { padding: 1.5rem 1.75rem; }
.page-title { font-size: 18px; font-weight: 600; color: var(--color-text); margin: 0 0 2px 0; line-height: 1.3; }
.page-subtitle { font-size: 13px; color: var(--color-text-muted); margin: 0; }
.ems-filter-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 0px !important;
    box-shadow: none;
    margin-bottom: 1.25rem;
}
.nav-tabs .nav-link, .ems-nav-tabs .nav-link { border-radius: 0px !important; }
.ems-filter-header {
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid #E5E7EB;
    font-weight: 600; font-size: 13px;
    color: var(--color-text);
    display: flex; align-items: center; justify-content: space-between;
    background-color: #FFFFFF;
}
.ems-kpi-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 0px !important;
    padding: 0.9rem 1.1rem;
    position: relative;
    box-shadow: none;
}
.ems-kpi-card::before { content: ''; position: absolute; top: -1px; left: -1px; right: -1px; height: 4px; }
.ems-kpi-blue::before   { background-color: #0F4C81; }
.ems-kpi-green::before  { background-color: #10B981; }
.ems-kpi-cyan::before   { background-color: #0EA5E9; }
.ems-kpi-amber::before  { background-color: #F59E0B; }
.ems-kpi-purple::before { background-color: #8B5CF6; }
.ems-kpi-slate::before  { background-color: #64748B; }
.ems-kpi-danger::before { background-color: #DC2626; }
.ems-kpi-warning::before{ background-color: #EA580C; }
.ems-kpi-success::before{ background-color: #10B981; }
.ems-kpi-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.4rem; }
.ems-kpi-value { font-size: 1.75rem; font-weight: 700; color: var(--color-text); line-height: 1.2; }
.ems-kpi-sub { font-size: 11px; color: var(--color-text-muted); margin-top: 0.3rem; }
.ems-kpi-lg-value { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; font-family: var(--font-mono); }
.ems-text-amber { color: #D97706 !important; }
.ems-text-green { color: #059669 !important; }
.ems-text-blue  { color: #0F4C81 !important; }
.text-warning { color: #EA580C !important; }
.text-danger  { color: #DC2626 !important; }
.text-dark    { color: #111827 !important; }
.form-control, .form-select { font-family: var(--font-sans); font-size: 13px; color: var(--color-text); border: 1px solid var(--color-border); border-radius: 0px !important; padding: 0.35rem 0.65rem; }
.form-control:focus, .form-select:focus { border-color: #0F4C81; box-shadow: 0 0 0 1px #0F4C81; }
.btn-ems-primary { background-color: #0F4C81; color: #FFFFFF; border: 1px solid #0F4C81; font-weight: 500; font-size: 13px; padding: 0.35rem 0.9rem; border-radius: 0px !important; display: inline-flex; align-items: center; gap: 0.35rem; }
.btn-ems-primary:hover { background-color: #0353E9; border-color: #0353E9; color: #FFFFFF; }
.btn-ems-outline { background-color: #FFFFFF; color: var(--color-secondary); border: 1px solid var(--color-border); font-weight: 500; font-size: 13px; padding: 0.35rem 0.9rem; border-radius: 0px !important; display: inline-flex; align-items: center; gap: 0.35rem; }
.btn-ems-outline:hover { background-color: #F3F4F6; border-color: #9CA3AF; color: var(--color-text); }
.table-ems { width: 100%; font-size: 12px; margin: 0; border-collapse: separate; border-spacing: 0; table-layout: auto; }
.table-ems th { position: sticky; top: 0; z-index: 10; background-color: #F8FAFC !important; color: #475569; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.55rem 0.65rem; border-bottom: 2px solid var(--color-border); vertical-align: middle; white-space: nowrap; box-shadow: 0 1px 0 var(--color-border); }
.table-ems td { padding: 0.5rem 0.65rem; vertical-align: middle; border-bottom: 1px solid #E2E8F0; color: #1E293B; }
.table-ems tbody tr:hover { background-color: #F1F5F9; }
.text-nowrap, .table-ems td.text-nowrap, .table-ems th.text-nowrap { white-space: nowrap !important; }
.table-responsive { max-height: calc(100vh - 270px); min-height: 180px; overflow-x: auto; overflow-y: auto; -webkit-overflow-scrolling: touch; position: relative; border-bottom: 1px solid var(--color-border); }
.modal .table-responsive { max-height: 55vh; }
.recent-activity-card .table-responsive { max-height: 320px; }
.table-responsive::-webkit-scrollbar { width: 6px; height: 8px; }
.table-responsive::-webkit-scrollbar-track { background: #F1F5F9; }
.table-responsive::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 3px; }
.table-responsive::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
.col-code, .col-mono { font-family: var(--font-mono); font-size: 12px; color: var(--color-text-muted); font-weight: 600; }
.col-amount { font-family: var(--font-mono); font-size: 13px; }
.badge-ems-success { background-color: #2E7D32 !important; color: #FFFFFF !important; font-weight: 600; font-size: 11px; padding: 2px 8px; border-radius: 0px !important; }
.badge-ems-warning { background-color: #FEF3C7; color: #92400E; font-weight: 600; font-size: 11px; padding: 2px 8px; border-radius: 0px !important; }
.badge-ems-danger  { background-color: #FEE2E2; color: #991B1B; font-weight: 600; font-size: 11px; padding: 2px 8px; border-radius: 0px !important; }
.badge-ems-info    { background-color: #E0F2FE; color: #0369A1; font-weight: 600; font-size: 11px; padding: 2px 8px; border-radius: 0px !important; }
.ems-card-borderless { background: #FFFFFF; border: none !important; box-shadow: none !important; margin-bottom: 1.25rem; }
.btn-ems-icon-action { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; background: transparent; border: 1px solid transparent; border-radius: 2px !important; padding: 0; font-size: 15px; cursor: pointer; transition: all 0.15s ease-in-out; text-decoration: none; }
.btn-ems-icon-action:hover { background: #F1F5F9; border-color: #CBD5E1; }
.btn-ems-icon-action.text-success:hover { background: #F0FDF4; border-color: #BBF7D0; }
.btn-ems-icon-action.text-primary:hover { background: #EFF6FF; border-color: #BFDBFE; }
.btn-ems-icon-action.text-info:hover    { background: #ECFEFF; border-color: #A5F3FC; }
.btn-ems-icon-action.text-warning:hover { background: #FFFBEB; border-color: #FDE68A; }
.btn-ems-icon-action.text-danger:hover  { background: #FEF2F2; border-color: #FECACA; }

/* Responsive Mobile Layout Adjustments & Touch Optimizations */
.ems-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
}

.ems-mobile-sidebar-header {
    display: none;
}

@@media (max-width: 768px) {
    .ems-page-header {
        flex-direction: column;
        align-items: flex-start !important;
    }
    .ems-page-header .ems-page-actions {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .ems-page-header .ems-page-actions .btn,
    .ems-page-header .ems-page-actions a {
        flex: 1;
        justify-content: center;
        text-align: center;
        white-space: nowrap;
    }
    .ems-header {
        padding: 0 0.75rem !important;
    }
    .ems-header-title {
        font-size: 13px !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 190px;
    }
    .ems-logo-subtitle {
        display: none !important;
    }
    .ems-sidebar {
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
        width: 275px !important;
        box-shadow: 6px 0 25px rgba(0,0,0,0.22);
        z-index: 1045 !important;
        top: 0 !important;
    }
    .ems-sidebar.show-mobile {
        transform: translateX(0) !important;
    }
    .ems-mobile-sidebar-header {
        display: flex !important;
        align-items: center;
        justify-content: space-between;
        padding: 0 0.85rem;
        height: 56px;
        background-color: #FFFFFF;
        color: #111827;
        border-bottom: 1px solid #D1D5DB;
    }
    .ems-nav-link {
        height: 44px !important;
        font-size: 13.5px !important;
        padding: 0 1.25rem !important;
        margin: 1px 0 !important;
        border-radius: 0 !important;
    }
    .ems-nav-link i {
        font-size: 1.2rem !important;
    }
    .ems-wrapper {
        margin-left: 0 !important;
    }
    .ems-content {
        padding: 0.85rem 0.65rem !important;
    }
    .ems-sidebar-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(2px);
        z-index: 1040;
    }
    .ems-sidebar-overlay.show {
        display: block;
    }
    /* Touch Target & Input Sizing */
    .btn-ems-icon-action {
        width: 34px !important;
        height: 34px !important;
        font-size: 16px !important;
    }
    .table-responsive {
        max-height: calc(100vh - 220px) !important;
        box-shadow: inset -10px 0 8px -8px rgba(0, 0, 0, 0.08);
    }
    .modal-dialog {
        margin: 0.5rem !important;
        max-width: calc(100% - 1rem) !important;
    }
    /* Prevent iOS browser auto-zoom on form inputs */
    input[type="text"], input[type="search"], input[type="number"], input[type="password"], input[type="datetime-local"], select, textarea {
        font-size: 14px !important;
    }
}
@@media (max-width: 576px) {
    .ems-header-title {
        max-width: 140px;
        font-size: 12px !important;
    }
    .ems-user-name {
        display: none !important;
    }
}
    </style>
</head>
<body>
    <!-- Top Header Navigation -->
    <header class="ems-header">
        <div class="d-flex align-items-center">
            <!-- Desktop Sidebar Collapse Toggle Button -->
            <button class="btn btn-sm btn-link text-dark p-1 me-2 d-none d-md-flex align-items-center justify-content-center" type="button" id="sidebarToggleBtn" onclick="toggleDesktopSidebar()" title="Toggle Sidebar (Collapse/Expand)" style="width: 32px; height: 32px; font-size: 18px; border-radius: 4px !important; text-decoration: none;">
                <i class="bi bi-list fs-5"></i>
            </button>
            <!-- Mobile Sidebar Toggle Button -->
            <button class="btn btn-sm btn-outline-secondary d-md-none me-2 p-1 px-2" type="button" onclick="toggleMobileSidebar()" title="Toggle Menu" style="min-width:38px; min-height:38px;">
                <i class="bi bi-list fs-5"></i>
            </button>
            <a href="/" class="ems-logo-container">
                <img src="https://raw.githubusercontent.com/hafidnajmi/SMSYasulor/main/wwwroot/lib/app_icon.png" alt="SMS Logo" style="height: 42px; width: auto; object-fit: contain;" class="me-2" />
                <div>
                    <div class="fw-normal text-dark ems-header-title" style="font-size: 15px; line-height: 1.1; font-weight: 400;">Sparepart Management System</div>
                    <div class="ems-logo-subtitle" style="font-weight: 400;">Enterprise Management Suite</div>
                </div>
            </a>
        </div>

        <div class="d-flex align-items-center gap-2 gap-md-3">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- Notification Bell (Icon & Number Only - Simple & Lightweight) -->
                <div class="dropdown me-2 position-relative">
                    <button class="btn btn-link text-dark position-relative p-0 text-decoration-none d-flex align-items-center justify-content-center" type="button" id="topNotifBellBtn" onclick="toggleSystemNotifDropdown(event)" aria-expanded="false" title="System Notifications & Updates" style="background: none; border: none; font-size: 19px; line-height: 1; cursor: pointer; width: 28px; height: 28px;">
                        <i class="bi bi-bell" style="pointer-events: none;"></i>
                        <span id="topNotifBadge" class="position-absolute badge bg-danger text-white border border-white" style="display:none; font-size: 9.5px; top: -4px; right: -7px; padding: 2px 5px; font-weight: 600; pointer-events: none; border-radius: 999px !important;">0</span>
                    </button>
                    <div id="topNotifDropdownMenu" class="dropdown-menu dropdown-menu-end shadow border p-0 mt-2" style="width: 400px; max-width: 92vw; border-radius: 6px !important; font-size: 13px; border-color: #e2e8f0 !important; z-index: 1050; right: 0; left: auto;" aria-labelledby="topNotifBellBtn">
                        <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white" style="border-radius: 6px 6px 0 0;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-bell text-dark fs-6"></i>
                                <span class="fw-semibold text-dark" style="font-size: 13.5px;">System Notifications</span>
                                <span id="topNotifCountText" class="badge bg-light text-dark border fw-normal" style="font-size: 10px; border-radius: 10px !important; padding: 2px 7px;">0 New</span>
                            </div>
                            <button type="button" class="btn btn-link btn-xs text-secondary p-0 text-decoration-none" style="font-size: 11.5px;" onclick="markAllNotificationsAsRead(event)" title="Mark all as read">
                                Mark All Read
                            </button>
                        </div>
                        <div id="topNotifList" class="overflow-auto" style="max-height: 400px;">
                            <div class="p-3 text-center text-muted small">Loading notifications...</div>
                        </div>
                        <div class="p-2 border-top bg-light text-center" style="border-radius: 0 0 6px 6px;">
                            @if (isUserAdmin)
                            {
                                <a asp-controller="DeveloperUpdates" asp-action="Index" class="text-dark small text-decoration-none fw-medium d-inline-flex align-items-center gap-1" style="font-size: 12px;">
                                    <span>Developer Updates Portal</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 11px;">Sparepart Management System &bull; Latest Version</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="dropdown">
                    <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                        <div class="ems-user-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "A")</div>
                        <span class="small fw-semibold text-dark ems-user-name">@User.Identity.Name</span>
                        <i class="bi bi-chevron-down text-muted small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-1">
                        <li><span class="dropdown-item-text text-muted small">Role: <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger small"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </header>

    <!-- Global Toast Container -->
    <div id="ems-toast-container" style="position:fixed; top:70px; right:20px; z-index:10000; pointer-events:none;"></div>

    <div class="ems-sidebar-overlay" onclick="toggleMobileSidebar()"></div>
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="ems-sidebar">
            <div class="ems-mobile-sidebar-header">
