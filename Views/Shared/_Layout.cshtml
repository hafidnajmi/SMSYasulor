                    <span>Dashboard</span>
                </a>

                @if (rbacMasterData)
                {
                    <div class="ems-nav-header">Master Data</div>
                    <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MasterData" ? "active" : "")" asp-controller="MasterData" asp-action="Index" title="Spareparts Catalog">
