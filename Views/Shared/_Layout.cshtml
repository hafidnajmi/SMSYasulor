                        <div class="fw-semibold text-dark text-nowrap" style="font-size: 11.5px; line-height: 1.2; text-overflow: ellipsis; overflow: hidden;">Sparepart Management System</div>
                        <div class="text-muted text-nowrap" style="font-size: 8.5px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.02em; text-overflow: ellipsis; overflow: hidden;">Enterprise Management Suite</div>
