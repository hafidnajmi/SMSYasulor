                            <span class="nav-icon-box"><i class="bi bi-graph-up-arrow" style="color:#0F4C81;"></i></span>
                            <span>Cost Intelligence</span>
                        </a>
                    }

                    @if (rbacLineMapping)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LineCompatibility" ? "active" : "")" asp-controller="LineCompatibility" asp-action="Index" title="Line Compatibility">
                            <span class="nav-icon-box"><i class="bi bi-diagram-3-fill" style="color:#0EA5E9;"></i></span>
                            <span>Line Compatibility</span>
                        </a>
                    }
                    @if (rbacSupplierData)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Supplier" ? "active" : "")" asp-controller="Supplier" asp-action="Index" title="Master Supplier">
                            <span class="nav-icon-box"><i class="bi bi-truck" style="color:#D97706;"></i></span>
                            <span>Master Supplier</span>
                        </a>
                    }
                }

                @if (rbacAdminMgmt || rbacSettings || rbacEmailSettings || rbacDeveloperUpdates)
                {
                    <div class="ems-nav-header">Administration</div>
                    @if (rbacAdminMgmt)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminManagement" ? "active" : "")" asp-controller="AdminManagement" asp-action="Index" title="Admin Portal">
                            <span class="nav-icon-box"><i class="bi bi-shield-check" style="color:#EA580C;"></i></span>
                            <span>Admin Portal</span>
                        </a>
                    }
                    @if (rbacSettings)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index" title="Settings & Users">
                            <span class="nav-icon-box"><i class="bi bi-gear" style="color:#0F4C81;"></i></span>
                            <span>Settings & Users</span>
                        </a>
                    }
                    @if (rbacEmailSettings)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "EmailSettings" ? "active" : "")" asp-controller="EmailSettings" asp-action="Index" title="Email Settings">
                            <span class="nav-icon-box"><i class="bi bi-envelope-at" style="color:#0EA5E9;"></i></span>
                            <span>Email Settings</span>
                        </a>
                    }
                    @if (rbacDeveloperUpdates)
                    {
                        <a class="ems-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DeveloperUpdates" ? "active" : "")" asp-controller="DeveloperUpdates" asp-action="Index" title="Developer Updates & Broadcast">
                            <span class="nav-icon-box"><i class="bi bi-megaphone" style="color:#000000;"></i></span>
                            <span>Developer Updates</span>
                        </a>
                    }
                }
            </div>

            <div class="ems-sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" title="Logout">
                        <i class="bi bi-box-arrow-right fs-6" style="color: #64748B;"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content View -->
        <main class="ems-wrapper">
            <div class="ems-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert" style="border-radius: 0px;">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert" style="border-radius: 0px;">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
