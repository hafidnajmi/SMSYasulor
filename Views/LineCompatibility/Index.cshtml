@model UPMS.Web.Models.ViewModels.LineCompatibilityViewModel
@{
    ViewData["Title"] = "Line Compatibility";
}

<style>
    .ems-search-input:focus,
    .ems-search-input:focus-visible {
        box-shadow: none !important;
        border-color: #ced4da !important;
        outline: none !important;
    }
    .lc-mobile-card {
        border: 1px solid var(--color-border, #e2e8f0);
        border-radius: 0px !important;
        background: #fff;
        padding: 12px;
        margin-bottom: 8px;
    }
</style>

<!-- Title Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="background-color: #0F4C81; width: 44px; height: 44px; border-radius: 0px !important; font-size: 20px;">
            <i class="bi bi-diagram-3-fill"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-0 text-dark" style="font-size: 1.35rem; letter-spacing: -0.02em;">Line Compatibility</h3>
            <p class="text-muted small mb-0">Manage sparepart compatibility mapping for each production line.</p>
        </div>
    </div>
</div>

<!-- KPI Summary Cards -->
@{
    var totalLines    = Model.LinesHealth.Count;
    var totalMappings = Model.LinesHealth.Sum(l => l.CompatibleParts);
    var totalMachines = Model.LinesHealth.Sum(l => l.TotalMachines);
}
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card h-100 border shadow-sm" style="border-radius: 0px !important; border-top: 3px solid #0F4C81 !important;">
            <div class="card-body p-3">
                <div class="text-uppercase small fw-bold text-muted mb-1" style="font-size: 11px; letter-spacing: 0.5px;">
                    <i class="bi bi-building me-1 text-primary"></i> Production Lines
                </div>
                <div class="fs-2 fw-bold text-primary mb-0" style="line-height: 1;">@totalLines</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border shadow-sm" style="border-radius: 0px !important; border-top: 3px solid #10B981 !important;">
            <div class="card-body p-3">
                <div class="text-uppercase small fw-bold text-muted mb-1" style="font-size: 11px; letter-spacing: 0.5px;">
                    <i class="bi bi-tools me-1 text-success"></i> Mapped Spareparts
                </div>
                <div class="fs-2 fw-bold text-success mb-1" style="line-height: 1;">
                    @Model.TotalMappedPartsCount.ToString("N0") <span style="font-size: 1rem; font-weight: 600; color: #10B981;">Items</span>
                </div>
                <div class="text-muted" style="font-size: 11px;">
                    <i class="bi bi-box-seam me-1 text-success"></i>@Model.TotalMappedStockQty.ToString("N0") total stock units (pcs) with defined line
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border shadow-sm" style="border-radius: 0px !important; border-top: 3px solid #0284C7 !important;">
            <div class="card-body p-3">
                <div class="text-uppercase small fw-bold text-muted mb-1" style="font-size: 11px; letter-spacing: 0.5px;">
                    <i class="bi bi-cpu me-1" style="color: #0284C7;"></i> Total Machines
                </div>
                <div class="fs-2 fw-bold mb-0" style="line-height: 1; color: #0284C7;">@totalMachines</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Search Lines Panel -->
<div class="card border mb-3 shadow-sm" style="border-radius: 0px !important;">
    <div class="card-header bg-light py-2 px-3 border-bottom" style="border-radius: 0px !important;">
        <span class="fw-bold small text-secondary"><i class="bi bi-funnel me-1 text-primary"></i> Filter &amp; Search Lines</span>
    </div>
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end line-filter-form">
            <input type="hidden" name="subTab" value="line" />
            <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
            <input type="hidden" name="kpiTab" value="@Model.KpiTab" />
            
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">UP Area</label>
                <select name="areaFilter" class="form-select form-select-sm" style="height: 38px; border-radius: 0px !important;">
                    <option value="">[All Areas]</option>
                    <option value="UP1" selected="@(Model.AreaFilter == "UP1" ? "selected" : null)">UP1</option>
                    <option value="UP2" selected="@(Model.AreaFilter == "UP2" ? "selected" : null)">UP2</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Search Line Code</label>
                <input type="text" name="lineSearch" value="@Model.LineSearch" class="form-control form-control-sm" placeholder="e.g. B11, S6, UP1..." style="height: 38px; border-radius: 0px !important;" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Sort By</label>
                <select name="lineSort" class="form-select form-select-sm" style="height: 38px; border-radius: 0px !important;">
                    <option value="line_code" selected="@(Model.LineSort == "line_code" ? "selected" : null)">Line Code (A-Z)</option>
                    <option value="parts"     selected="@(Model.LineSort == "parts"     ? "selected" : null)">Most Spareparts</option>
                    <option value="machines"  selected="@(Model.LineSort == "machines"  ? "selected" : null)">Most Machines</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1 align-items-center">
                <button type="submit" class="btn btn-ems-primary btn-sm flex-fill d-flex align-items-center justify-content-center gap-1" style="height: 38px; border-radius: 0px !important;">
                    <i class="bi bi-funnel"></i> Apply
                </button>
                <a href="@Url.Action("Index", new { subTab = "line", kpiTab = Model.KpiTab })" class="btn btn-ems-outline btn-sm detail-ajax-link d-flex align-items-center justify-content-center" title="Reset Filters" style="height: 38px; width: 38px; border-radius: 0px !important;">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
                <span class="text-muted text-nowrap ms-2" style="font-size:12px;">
                    <i class="bi bi-info-circle me-1"></i>@Model.LinesHealth.Count line(s)
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Main Content: Two-panel layout (Line list | Detail) -->
<div class="row g-0 border shadow-sm mb-4" style="background: #fff; min-height: 720px; border-radius: 0px !important;">

    <!-- LEFT: Production Line List -->
    <div class="col-md-3 d-flex flex-column border-end" style="max-height: 720px;">
        <!-- Section header -->
        <div style="padding: 10px 14px; background: #F8FAFC; border-bottom: 1px solid var(--color-border, #e2e8f0);">
            <span class="fw-bold" style="font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #475569;">
                <i class="bi bi-building me-1 text-primary"></i>Production Lines
            </span>
        </div>
        <div id="left-lines-container" style="flex:1; overflow-y:auto;">
            @if (!Model.LinesHealth.Any())
            {
                <div class="text-center text-muted py-5" style="font-size:12px;">
                    <i class="bi bi-building-slash d-block fs-3 mb-2 text-muted"></i>
                    No production lines found.
                </div>
            }
            else
            {
                @foreach (var ln in Model.LinesHealth)
                {
                    var isActive = ln.LineCode == Model.SelectedLine;

                    <a href="@Url.Action("Index", new { subTab="line", selectedLine=ln.LineCode, lineSearch=Model.LineSearch, areaFilter=Model.AreaFilter, lineSort=Model.LineSort, kpiTab=Model.KpiTab })"
                       class="line-sidebar-link"
                       style="display:block; text-decoration:none; padding:12px 14px;
                              border-bottom: 1px solid #F1F5F9;
                              background: @(isActive ? "#EFF6FF" : "#fff");
                              border-left: 3px solid @(isActive ? "#0F4C81" : "transparent");
                              transition: background .1s;"
                       onmouseover="if(!@(isActive ? "true" : "false"))this.style.background='#F8FAFC'"
                       onmouseout="if(!@(isActive ? "true" : "false"))this.style.background='#fff'">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold" style="color:@(isActive ? "#0F4C81" : "#111827"); font-size:13px;">@ln.LineCode</span>
                            <span class="badge bg-light text-secondary border" style="font-size: 10px; border-radius: 0px !important;">@ln.Area</span>
                        </div>
                        <div class="d-flex gap-3 mt-2" style="font-size:11px;">
                            <span><span class="fw-bold" style="color:#0F4C81;">@ln.TotalMachines</span> <span class="text-muted">Mach</span></span>
                            <span><span class="fw-bold text-success">@ln.CompatibleParts</span> <span class="text-muted">Parts</span></span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>

    <!-- RIGHT: Detail Panel -->
    <div id="right-detail-container" class="col-md-9 d-flex flex-column" data-selected-line="@Model.SelectedLine" data-selected-area="@(Model.SelectedLineData?.Area ?? "UP1")" style="min-height: 720px; transition: opacity 0.15s ease-in-out;">
        @if (Model.SelectedLine == null)
        {
            <div class="text-center text-muted py-5 px-4 my-auto">
                <i class="bi bi-arrow-left-circle d-block fs-1 mb-3 text-muted" style="opacity:.3;"></i>
                <div class="fw-semibold mb-1" style="font-size:14px; color:#94A3B8;">Select a Production Line</div>
                <div style="font-size:12px; color:#CBD5E1;">Click on a line from the panel on the left to view its sparepart compatibility data.</div>
            </div>
        }
        else
        {
            var lnData = Model.SelectedLineData;
            var isPartsActive = Model.KpiTab != "machines";

            <!-- Detail sub-header -->
            <div style="padding: 12px 16px; background: #F8FAFC; border-bottom: 1px solid var(--color-border, #e2e8f0); display:flex; align-items:center; justify-content:space-between;">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold" style="font-size:14px; color:#0F4C81;">
                        <i class="bi bi-building me-1"></i>@Model.SelectedLine
                    </span>
                    <span class="badge bg-white text-dark border ms-1" style="font-size:11px; border-radius: 0px !important;">Area: @(lnData?.Area ?? "-")</span>
                    <span class="text-muted ms-2" style="font-size:11px;"><i class="bi bi-clock me-1"></i>Last Updated: @(lnData?.LastActivity.HasValue == true && lnData.LastActivity.Value > DateTime.MinValue ? lnData.LastActivity.Value.ToString("dd MMM yyyy") : "N/A")</span>
                </div>
            </div>

            <!-- Sub-KPI selector tabs (Instant JS Switching) -->
            <div style="display:flex; border-bottom: 1px solid var(--color-border, #e2e8f0);">
                <button type="button" id="tab-btn-parts" onclick="switchDetailTab('parts')"
                   style="flex:1; text-align:center; padding:12px 8px; font-size:13px; cursor:pointer; font-weight:@(isPartsActive ? "700" : "500");
                          color:@(isPartsActive ? "#0F4C81" : "#6B7280");
                          border:none; border-bottom: 3px solid @(isPartsActive ? "#0F4C81" : "transparent");
                          border-radius: 0px !important;
                          background: @(isPartsActive ? "#fff" : "#F8FAFC"); transition: all .1s;">
                    <i class="bi bi-tools me-1"></i>@(lnData?.CompatibleParts ?? 0) Spareparts
                </button>
                <button type="button" id="tab-btn-machines" onclick="switchDetailTab('machines')"
                   style="flex:1; text-align:center; padding:12px 8px; font-size:13px; cursor:pointer; font-weight:@(!isPartsActive ? "700" : "500");
                          color:@(!isPartsActive ? "#0F4C81" : "#6B7280");
                          border:none; border-bottom: 3px solid @(!isPartsActive ? "#0F4C81" : "transparent");
                          border-radius: 0px !important;
                          background: @(!isPartsActive ? "#fff" : "#F8FAFC"); transition: all .1s;">
                    <i class="bi bi-cpu me-1"></i>@(lnData?.TotalMachines ?? 0) Machines
                </button>
            </div>

            <!-- Content Area -->
            <div class="d-flex flex-column flex-fill justify-content-between">

                @* ── PARTS PANEL ── *@
                <div id="tab-parts-panel" class="d-flex flex-column flex-fill justify-content-between" style="display: @(isPartsActive ? "flex" : "none") !important;">
                    <div>
                        <!-- Table toolbar -->
                        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #F1F5F9; background:#FAFBFC;">
                            <span class="text-muted" style="font-size:12px;">
                                Showing <strong>@Model.CompatibleParts.Count</strong> of <strong>@Model.PartsTotalCount</strong> spareparts for line <strong>@Model.SelectedLine</strong>
                            </span>
                            <form method="get" asp-action="Index" class="d-flex align-items-center detail-search-form" style="width: 320px;">
                                <input type="hidden" name="subTab" value="line" />
                                <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
                                <input type="hidden" name="kpiTab" value="parts" />
                                <input type="hidden" name="lineSearch" value="@Model.LineSearch" />
                                <input type="hidden" name="lineSort" value="@Model.LineSort" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0" style="font-size:12px; border-radius: 0px !important;"><i class="bi bi-search"></i></span>
                                    <input type="text" name="detailSearch" value="@Model.DetailSearch" class="form-control form-control-sm border-start-0 ps-0 ems-search-input" placeholder="Search Part #, Item, Machine..." style="font-size:12px; height: 38px; border-radius: 0px !important;" />
                                    @if (!string.IsNullOrEmpty(Model.DetailSearch))
                                    {
                                        <a href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="parts", lineSearch=Model.LineSearch, lineSort=Model.LineSort })" class="btn btn-sm btn-light border text-muted detail-ajax-link d-flex align-items-center justify-content-center" title="Clear search" style="font-size:11px; height: 38px; border-radius: 0px !important;"><i class="bi bi-x-lg"></i></a>
                                    }
                                    <button class="btn btn-ems-primary btn-sm px-3" type="submit" style="font-size:12px; height: 38px; border-radius: 0px !important;">Search</button>
                                </div>
                            </form>
                        </div>

                        <!-- Desktop Table -->
                        <div class="table-responsive d-none d-md-block">
                            <table class="table-ems mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:36px;">NO</th>
                                        <th>PART NUMBER</th>
                                        <th>ITEM NAME</th>
                                        <th>MACHINE</th>
                                        <th>BIN</th>
                                        <th>CATEGORY</th>
                                        <th class="text-end">LEAD TIME</th>
                                        <th class="text-end">STOCK</th>
                                        <th class="text-end">UNIT PRICE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CompatibleParts.Any())
                                    {
                                        int rowNo = (Model.PartsPage - 1) * 10 + 1;
                                        foreach (var p in Model.CompatibleParts)
                                        {
                                            <tr>
                                                <td class="col-mono text-muted text-center">@rowNo</td>
                                                <td class="text-nowrap"><span class="font-monospace fw-bold text-primary">@p.Id</span></td>
                                                <td style="min-width:160px; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@p.Item"><span class="fw-bold">@p.Item</span></td>
                                                <td style="max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@p.Machine"><span class="small text-secondary">@p.Machine</span></td>
                                                <td class="text-nowrap"><span class="badge bg-light text-dark border font-monospace" style="border-radius: 0px !important;">@p.Bin</span></td>
                                                <td class="text-nowrap"><span class="small text-secondary">@p.Category</span></td>
                                                <td class="text-end font-monospace text-nowrap">@(p.LeadTime > 0 ? $"{p.LeadTime:N0} mth" : "—")</td>
                                                <td class="text-end font-monospace text-nowrap">@p.CurrentStock pcs</td>
                                                <td class="text-end font-monospace fw-semibold text-nowrap">Rp @p.CurrentPrice.ToString("N0")</td>
                                            </tr>
                                            rowNo++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4" style="font-size:12px;">
                                                <i class="bi bi-tools d-block fs-4 mb-2 opacity-25"></i>
                                                No spareparts registered for line <strong>@Model.SelectedLine</strong>.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card List -->
                        <div class="d-block d-md-none p-2">
                            @if (Model.CompatibleParts.Any())
                            {
                                foreach (var p in Model.CompatibleParts)
                                {
                                    <div class="lc-mobile-card">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <span class="font-monospace fw-bold text-primary" style="font-size:13px;">@p.Id</span>
                                            <span class="badge bg-light text-dark border font-monospace" style="font-size:10px; border-radius:0px !important;">@p.Bin</span>
                                        </div>
                                        <div class="fw-bold mb-1" style="font-size:13px; color:#1E293B;">@p.Item</div>
                                        <div class="small text-secondary mb-2" style="font-size:11px;">Machine: @p.Machine | Category: @p.Category</div>
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="font-size:11px;">
                                            <span class="text-muted">Stock: <strong class="text-dark">@p.CurrentStock pcs</strong></span>
                                            <span class="font-monospace fw-bold text-primary">Rp @p.CurrentPrice.ToString("N0")</span>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-4" style="font-size:12px;">
                                    <i class="bi bi-tools d-block fs-4 mb-2 opacity-25"></i>
                                    No spareparts registered for line <strong>@Model.SelectedLine</strong>.
                                </div>
                            }
                        </div>

                    </div>

                    @* Pagination Footer *@
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 mt-auto" style="border-top:1px solid var(--color-border, #e2e8f0); background:#FAFBFC;">
                        <span class="text-muted" style="font-size:12px;">Page @Model.PartsPage of @Model.PartsTotalPages</span>
                        <div class="d-flex gap-1">
                            @if (Model.PartsPage > 1)
                            {
                                <a class="btn btn-ems-outline btn-sm detail-ajax-link" style="height: 38px; border-radius: 0px !important; display: inline-flex; align-items: center;" href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="parts", partsPage=Model.PartsPage-1, lineSearch=Model.LineSearch, lineSort=Model.LineSort })">‹ Prev</a>
                            }
                            else
                            {
                                <button class="btn btn-ems-outline btn-sm" style="height: 38px; border-radius: 0px !important;" disabled>‹ Prev</button>
                            }
                            @if (Model.PartsPage < Model.PartsTotalPages)
                            {
                                <a class="btn btn-ems-outline btn-sm detail-ajax-link" style="height: 38px; border-radius: 0px !important; display: inline-flex; align-items: center;" href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="parts", partsPage=Model.PartsPage+1, lineSearch=Model.LineSearch, lineSort=Model.LineSort })">Next ›</a>
                            }
                            else
                            {
                                <button class="btn btn-ems-outline btn-sm" style="height: 38px; border-radius: 0px !important;" disabled>Next ›</button>
                            }
                        </div>
                    </div>
                </div>

                @* ── MACHINES PANEL ── *@
                <div id="tab-machines-panel" class="d-flex flex-column flex-fill justify-content-between" style="display: @(!isPartsActive ? "flex" : "none") !important;">
                    <div>
                        <!-- Toolbar -->
                        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #F1F5F9; background:#FAFBFC;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted" style="font-size:12px;">
                                    <strong>@Model.MachinesInLine.Count</strong> machines registered in line <strong>@Model.SelectedLine</strong>
                                </span>
                                <button type="button" class="btn btn-ems-primary btn-sm px-3 d-flex align-items-center gap-1" style="height: 38px; font-size:12px; border-radius: 0px !important;" data-bs-toggle="modal" data-bs-target="#addMachineModal" data-line="@Model.SelectedLine" data-area="@(lnData?.Area ?? "UP1")">
                                    <i class="bi bi-plus-lg me-1"></i>Add Machine
                                </button>
                            </div>
                            <form method="get" asp-action="Index" class="d-flex align-items-center detail-search-form" style="width: 320px;">
                                <input type="hidden" name="subTab" value="line" />
                                <input type="hidden" name="selectedLine" value="@Model.SelectedLine" />
                                <input type="hidden" name="kpiTab" value="machines" />
                                <input type="hidden" name="lineSearch" value="@Model.LineSearch" />
                                <input type="hidden" name="lineSort" value="@Model.LineSort" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0" style="font-size:12px; border-radius: 0px !important;"><i class="bi bi-search"></i></span>
                                    <input type="text" name="detailSearch" value="@Model.DetailSearch" class="form-control form-control-sm border-start-0 ps-0 ems-search-input" placeholder="Search machine code/name..." style="font-size:12px; height: 38px; border-radius: 0px !important;" />
                                    @if (!string.IsNullOrEmpty(Model.DetailSearch))
                                    {
                                        <a href="@Url.Action("Index", new { subTab="line", selectedLine=Model.SelectedLine, kpiTab="machines", lineSearch=Model.LineSearch, lineSort=Model.LineSort })" class="btn btn-sm btn-light border text-muted detail-ajax-link d-flex align-items-center justify-content-center" title="Clear search" style="font-size:11px; height: 38px; border-radius: 0px !important;"><i class="bi bi-x-lg"></i></a>
                                    }
                                    <button class="btn btn-ems-primary btn-sm px-3" type="submit" style="font-size:12px; height: 38px; border-radius: 0px !important;">Search</button>
                                </div>
                            </form>
                        </div>

                        <!-- Desktop Table -->
                        <div class="table-responsive d-none d-md-block">
                            <table class="table-ems mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:36px;">NO</th>
                                        <th>MACHINE CODE</th>
                                        <th>MACHINE NAME</th>
                                        <th>LINE</th>
                                        <th>AREA</th>
                                        <th>TYPE</th>
                                        <th>MANUFACTURER</th>
                                        <th>MODEL / SERIES</th>
                                        <th class="text-center">STATUS</th>
                                        <th class="text-center">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.MachinesInLine.Any())
                                    {
                                        int rowNo = 1;
                                        foreach (var m in Model.MachinesInLine)
                                        {
                                            var isActive = (m.Status ?? "active").Equals("active", StringComparison.OrdinalIgnoreCase);
                                            <tr>
                                                <td class="col-mono text-muted text-center">@rowNo</td>
                                                <td class="text-nowrap"><span class="font-monospace fw-bold text-primary">@m.MachineCode</span></td>
                                                <td class="fw-bold">@m.MachineName</td>
                                                <td class="text-nowrap"><span class="badge bg-light text-dark font-monospace border" style="border-radius: 0px !important;">@(m.Line ?? "-")</span></td>
                                                <td class="text-nowrap"><span class="small text-secondary">@(m.Area ?? "-")</span></td>
                                                <td class="text-nowrap"><span class="small text-secondary">@(m.MachineType ?? "-")</span></td>
                                                <td class="small text-muted text-nowrap">@(m.Manufacturer ?? "-")</td>
                                                <td class="small text-muted font-monospace text-nowrap">@(m.Model ?? "-")</td>
