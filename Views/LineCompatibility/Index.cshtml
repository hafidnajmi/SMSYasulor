@section Scripts {
    <script>
        var currentKpiTab = '@Model.KpiTab' || 'parts';

        function autoGenerateAddMachineCode() {
            var codeInput = document.getElementById('add-machine-code');
            var nameInput = document.getElementById('add-machine-name');
            var lineInput = document.getElementById('add-machine-line');
            var lineVal = (lineInput && lineInput.value ? lineInput.value : '@Model.SelectedLine' || 'LINE').trim().toUpperCase();

            if (!codeInput || !nameInput) return;
            var nameVal = (nameInput.value || '').trim();

            if (!nameVal) {
                codeInput.value = 'MAC-' + lineVal + '-';
                return;
            }

            var words = nameVal.split(/[^a-zA-Z0-9]+/).filter(Boolean);
            var slug = '';

            if (words.length === 1) {
                slug = words[0].substring(0, 10).toUpperCase();
            } else if (words.length > 1) {
                slug = words.map(function(w) {
                    return w.substring(0, 3).toUpperCase();
                }).join('');
                if (slug.length > 12) {
                    slug = slug.substring(0, 12);
                }
            }

            codeInput.value = 'MAC-' + lineVal + '-' + slug;
        }

        function switchDetailTab(tab) {
            currentKpiTab = tab;
            var pPanel = document.getElementById('tab-parts-panel');
            var mPanel = document.getElementById('tab-machines-panel');
            var pBtn   = document.getElementById('tab-btn-parts');
            var mBtn   = document.getElementById('tab-btn-machines');

            if (!pPanel || !mPanel) return;

            if (tab === 'parts') {
                pPanel.style.setProperty('display', 'flex', 'important');
                mPanel.style.setProperty('display', 'none', 'important');
                
                if (pBtn) {
                    pBtn.style.fontWeight = '700';
                    pBtn.style.color = '#0F4C81';
                    pBtn.style.borderBottom = '3px solid #0F4C81';
                    pBtn.style.background = '#fff';
                }
                if (mBtn) {
                    mBtn.style.fontWeight = '500';
                    mBtn.style.color = '#6B7280';
                    mBtn.style.borderBottom = '3px solid transparent';
                    mBtn.style.background = '#F8FAFC';
                }
            } else {
                pPanel.style.setProperty('display', 'none', 'important');
                mPanel.style.setProperty('display', 'flex', 'important');

                if (mBtn) {
                    mBtn.style.fontWeight = '700';
                    mBtn.style.color = '#0F4C81';
                    mBtn.style.borderBottom = '3px solid #0F4C81';
                    mBtn.style.background = '#fff';
                }
                if (pBtn) {
                    pBtn.style.fontWeight = '500';
                    pBtn.style.color = '#6B7280';
                    pBtn.style.borderBottom = '3px solid transparent';
                    pBtn.style.background = '#F8FAFC';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var addModal = document.getElementById('addMachineModal');
            if (addModal) {
                addModal.addEventListener('show.bs.modal', function (event) {
                    var button = event ? event.relatedTarget : null;
                    var detailContainer = document.getElementById('right-detail-container');

                    var currentLine = (button && button.getAttribute('data-line')) || 
                                      (detailContainer ? detailContainer.getAttribute('data-selected-line') : '') || 
                                      '@Model.SelectedLine';

                    var currentArea = (button && button.getAttribute('data-area')) || 
                                      (detailContainer ? detailContainer.getAttribute('data-selected-area') : '') || 
                                      'UP1';

                    var lineInput = document.getElementById('add-machine-line');
                    var areaInput = document.getElementById('add-machine-area');
                    var nameInput = document.getElementById('add-machine-name');

                    if (lineInput) lineInput.value = currentLine;
                    if (areaInput) areaInput.value = currentArea;
                    if (nameInput) nameInput.value = '';

                    autoGenerateAddMachineCode();
                });
            }

            var editModal = document.getElementById('editMachineModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    document.getElementById('edit-id').value           = button.getAttribute('data-id') || '';
                    document.getElementById('edit-code').value         = button.getAttribute('data-code') || '';
                    document.getElementById('edit-name').value         = button.getAttribute('data-name') || '';
                    document.getElementById('edit-line').value         = button.getAttribute('data-line') || '@Model.SelectedLine';
                    document.getElementById('edit-area').value         = button.getAttribute('data-area') || '@Model.SelectedLineData?.Area';
                    document.getElementById('edit-type').value         = button.getAttribute('data-type') || '';
                    document.getElementById('edit-manufacturer').value = button.getAttribute('data-manufacturer') || '';
                    document.getElementById('edit-model').value        = button.getAttribute('data-model') || '';
                    document.getElementById('edit-status').value       = (button.getAttribute('data-status') || 'active').toLowerCase();
                });
            }

            var deleteModal = document.getElementById('deleteMachineModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    document.getElementById('delete-id').value = button.getAttribute('data-id') || '';
                    document.getElementById('delete-code-display').innerText = button.getAttribute('data-code') || '';
                });
            }

            // Intercept link clicks (sidebar lines & pagination & clear search)
            document.addEventListener('click', function (e) {
                var a = e.target.closest('.detail-ajax-link, .line-sidebar-link');
                if (a && a.href && !a.href.startsWith('javascript:')) {
                    e.preventDefault();
                    loadDetailAjax(a.href);
                }
            });

            // Intercept form submissions (GET filters & POST actions/modals)
            document.addEventListener('submit', function (e) {
                var form = e.target;
                if (!form) return;

                // 1. GET search form inside detail
                if (form.classList.contains('detail-search-form')) {
                    e.preventDefault();
                    var formData = new FormData(form);
                    var params = new URLSearchParams(formData);
                    var url = form.action + '?' + params.toString();
                    loadDetailAjax(url);
                    return;
                }

                // 2. GET line filter form at top
                if (form.classList.contains('line-filter-form')) {
                    e.preventDefault();
                    var formData = new FormData(form);
                    var params = new URLSearchParams(formData);
                    var url = form.action + '?' + params.toString();
                    loadDetailAjax(url);
                    return;
                }

                // 3. POST actions (CreateMachine, EditMachine, DeleteMachine, ToggleStatus, AddLineMapping, etc.)
                if (form.method && form.method.toUpperCase() === 'POST') {
                    e.preventDefault();

                    var submitBtn = form.querySelector('button[type="submit"]');
                    var originalText = submitBtn ? submitBtn.innerHTML : '';
                    var isIconButton = submitBtn && (submitBtn.classList.contains('btn-ems-icon-action') || submitBtn.closest('td') || submitBtn.offsetWidth < 50);

                    if (submitBtn) {
                        submitBtn.disabled = true;
                        if (isIconButton) {
                            submitBtn.style.opacity = '0.4';
                        } else {
                            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';
                        }
                    }

                    fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(function(res) {
                        var contentType = res.headers.get('content-type') || '';
                        if (contentType.indexOf('application/json') !== -1) {
                            return res.json();
                        }
                        return { success: true, message: 'Action processed.' };
                    })
                    .then(function(data) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            if (isIconButton) {
                                submitBtn.style.opacity = '1';
                            } else {
                                submitBtn.innerHTML = originalText;
                            }
                        }

                        // Close modal if form was inside a modal
                        var modalEl = form.closest('.modal');
                        if (modalEl) {
                            var bsModal = (window.bootstrap && window.bootstrap.Modal) ? window.bootstrap.Modal.getOrCreateInstance(modalEl) : null;
                            if (bsModal) {
                                bsModal.hide();
                            }
                            if (typeof clearModalLocks === 'function') {
                                clearModalLocks();
                            }
                            setTimeout(function() {
                                if (typeof clearModalLocks === 'function') clearModalLocks();
                            }, 150);
                        }

                        if (data.success !== false) {
                            if (typeof showEmsToast === 'function') {
                                showEmsToast('success', data.message || 'Operation successful.');
                            }

                            // Dynamic target URL construction
                            var targetUrl = new URL(window.location.href);
                            if (data.selectedLine) {
                                targetUrl.searchParams.set('selectedLine', data.selectedLine);
                            }
                            if (data.kpiTab) {
                                targetUrl.searchParams.set('kpiTab', data.kpiTab);
                                currentKpiTab = data.kpiTab;
                            } else {
                                targetUrl.searchParams.set('kpiTab', currentKpiTab);
                            }
                            targetUrl.searchParams.set('subTab', 'line');

                            loadDetailAjax(targetUrl.toString());
                        } else {
                            if (typeof showEmsToast === 'function') {
                                showEmsToast('danger', data.message || 'An error occurred.');
                            }
                        }
                    })
                    .catch(function(err) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            if (isIconButton) {
                                submitBtn.style.opacity = '1';
                            } else {
                                submitBtn.innerHTML = originalText;
                            }
                        }
                        if (typeof showEmsToast === 'function') {
                            showEmsToast('danger', 'System error while executing action.');
                        }
                    });
                }
            });
        });

        function loadDetailAjax(url) {
            var container = document.getElementById('right-detail-container');
            if (!container) {
                window.location.href = url;
                return;
            }
            
            container.style.opacity = '0.6';

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function(res) { return res.text(); })
                .then(function(html) {
                    var parser = new DOMParser();
                    var doc = parser.parseFromString(html, 'text/html');
                    
                    var newDetail = doc.getElementById('right-detail-container');
                    if (newDetail) {
                        container.innerHTML = newDetail.innerHTML;
                    }

                    var newLeft = doc.getElementById('left-lines-container');
                    var oldLeft = document.getElementById('left-lines-container');
                    if (newLeft && oldLeft) {
                        oldLeft.innerHTML = newLeft.innerHTML;
                    }

                    // Re-apply tab active state
                    switchDetailTab(currentKpiTab);

                    // Ensure backdrop and scroll locks are cleaned up
                    if (typeof clearModalLocks === 'function') {
                        clearModalLocks();
                    }

                    container.style.opacity = '1';
                    history.pushState(null, '', url);
                })
                .catch(function() {
                    container.style.opacity = '1';
                    window.location.href = url;
                });
        }
    </script>
}
